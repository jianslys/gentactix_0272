      <div class="od-head" id="orderDocDragBar">
        <span id="orderDocTitle">当前命令详情</span>
        <button type="button" class="ob-close" id="orderDocCloseBtn" onclick="closeOrderDocModal()" title="关闭">×</button>
      </div>
      <div class="od-body" id="orderDocBody"></div>
    </div>
    <div id="combatLogWin" role="dialog" aria-label="作战日志">
      <div class="cl-head" id="combatLogDragBar">
        <span id="combatLogTitle">作战日志</span>
        <button class="cl-close" id="combatLogCloseBtn" title="关闭">×</button>
      </div>
      <div class="cl-body" id="combatLogBody"></div>
    </div>
    <div id="tarkovWin" role="dialog" aria-label="单兵装备与搜刮">
      <div class="tk-head" id="tarkovDragBar">
        <span id="tarkovTitle">单兵装备栏</span>
        <button class="cl-close" id="tarkovCloseBtn" style="color:#f4f4f5;" onclick="closeTarkovModal()" title="关闭">×</button>
      </div>
      <div class="tk-body" id="tarkovBody"></div>
      <div id="tkInspectBar"><span style="color:#a1a1aa;">点击任意物品查看底层 attrs[] 属性详情</span></div>
    </div>
    <div id="catalogWin" role="dialog" aria-label="德军装备总库">
      <div class="tk-head">
        <span id="catalogTitle">📚 单源装备总库 (items_catalog.json)</span>
        <div style="display:flex;gap:8px;align-items:center;">
          <button type="button" class="tk-btn" id="btnCatalogReload" onclick="loadItemCatalog(true)">🔄 热重载 JSON</button>
          <button class="cl-close" style="color:#f4f4f5;" onclick="toggleCatalogModal(false)" title="关闭">×</button>
        </div>
      </div>
      <div class="cat-bar">
        <input type="text" class="cat-input" id="catSearchInp" placeholder="检索型号名 / ID / 口径 / 引信 / 脚架..." oninput="renderCatalogModal()" />
        <div id="catKindTabs" style="display:flex;flex-wrap:wrap;gap:4px;"></div>
      </div>
      <div class="cat-list" id="catListBody"></div>
    </div>
    <div id="unitContextMenu" role="menu" aria-label="兵牌右键菜单"></div>
    <div id="missionDraftDock" aria-label="独立任务下达窗口容器"></div>
    <div id="eventDraftDock" aria-label="独立事件安排窗口容器"></div>
    <div id="reorgSplitWin" role="dialog" aria-label="🪖 编制管理 (ORBAT)">
      <div class="tk-head" id="reorgDragBar">
        <span id="reorgTitle">🪖 编制管理 (ORBAT)</span>
        <button type="button" class="cl-close" style="color:#f4f4f5;" onclick="closeReorgSplitWin()" title="关闭">×</button>
      </div>
      <div class="mod-body-dark" id="reorgBody"></div>
    </div>
    <div id="heavyCrewWin" role="dialog" aria-label="重武器架设与操炮编制">
      <div class="tk-head" id="heavyDragBar">
        <span id="heavyTitle">⚙ 重武器架设、打包 &amp; 操炮人数表</span>
        <button type="button" class="cl-close" style="color:#f4f4f5;" onclick="closeHeavyCrewWin()" title="关闭">×</button>
      </div>
      <div class="mod-body-dark" id="heavyBody"></div>
    </div>

    <div id="legendDock">
      <div id="legendCard" role="dialog" aria-label="图例">
        <div class="lg-head">
          <span>图 例</span>
          <button class="lg-close" id="legendCloseBtn" title="收起">×</button>
        </div>
        <div class="lg-list" id="legendList"></div>
      </div>
      <button id="legendToggleBtn" type="button">图 例</button>
    </div>

    <div id="hud-top">
      <strong>Gentactix V4.0</strong>
      <span class="pill" id="lblTurn">T0 · 0.0h · 8m/px</span>
      <span class="pill" id="lblLod">LOD: auto</span>
      <span class="pill" id="lblRenderer" style="cursor:pointer;" onclick="toggleRendererMode()" title="点击切换 WebGL2 / Canvas2D-Fallback 双轨渲染">Renderer: init</span>
      <label>身份:
        <select id="selCommander" style="display:none;"></select>
        <select id="selActor" onchange="onActorChange()"></select>
      </label>
      <button id="btnModeInspect" class="active" onclick="setToolMode('inspect')">选看/射界</button>
      <button id="btnModeMove" onclick="setToolMode('draft_order')">草稿机动令</button>
      <button id="btnModeAo" onclick="setToolMode('draft_ao')">草稿划定AO</button>
      <button id="btnModeFrontline" onclick="setToolMode('draft_frontline')">草稿画战线</button>
      <button id="btnModePixel" onclick="setToolMode('edit_pixel')">开局改地貌</button>
      <button class="primary" onclick="commitTurn(16/3600)">推进步长 (+16s)</button>
      <button id="btnSimPlay" onclick="toggleSimPlay()">▶ 运行</button>
      <button id="btnCatalog" onclick="toggleCatalogModal()" title="查看 single-source items_catalog.json（无射程上限/枪弹分离/引信/脚架/装备 attrs[]）">📚 装备总库</button>
      <button onclick="focusUnits()">定位部队</button>
      <button onclick="toggleFullscreen()">全屏</button>
      <button onclick="toggleSidebar()">面板</button>
    </div>

    <div id="hud-bottom">
      <span id="lblCursor">坐标: (-, -) | 图层: L0地形 · L1通联/AO · L2草稿 · L3武器LOS遮罩</span>
      &nbsp;|&nbsp;
      <label><input type="checkbox" id="chkL1" checked onchange="render()" /> L1事实线</label>
      <label><input type="checkbox" id="chkL2" checked onchange="render()" /> L2草稿线</label>
      <label><input type="checkbox" id="chkL3" checked onchange="render()" /> L3武器LOS</label>
    </div>
  </div>

  <div id="sidebar">
    <!-- 1. r16 导入与开局前像素编辑 -->
    <div class="card">
      <h3>.r16 1:1 地形导入 &amp; 开局像素容器 <span id="lblPreGame" class="pill">开局可编辑</span></h3>
      <div class="row">
        <input type="file" id="fileR16" accept=".r16,.raw,.r8" style="max-width:170px;" />
        W:<input type="number" id="impW" value="64" style="width:48px;" />
        H:<input type="number" id="impH" value="64" style="width:48px;" />
      </div>
      <div class="row">
        低:<input type="number" id="impLow" value="0" style="width:52px;" />m
        高:<input type="number" id="impHigh" value="1200" style="width:56px;" />m
        <label><input type="checkbox" id="impFlipY" /> FlipY</label>
        <button onclick="importR16File()">导入1:1(.r16)</button>
      </div>
      <div class="row">
        特征通道(1:1): <input type="file" id="fileFeatR16" accept=".r16,.raw,.r8" style="max-width:120px;" />
        <select id="selImportFeat"></select>
      </div>
      <div class="row" style="border-top:1px solid #1e293b; padding-top:4px;">
        笔刷特征:
        <select id="selBrushFeat"></select>
        高程(m):<input type="number" id="inpBrushElev" placeholder="不改" style="width:58px;" />
        <button onclick="resetDemo()">重置演示图</button>
      </div>
    </div>

    <!-- 2. 选中单位、武器 L3 LOS 与兵牌皮肤 -->
    <div class="card">
      <h3>单位详情 · L3射界 · 兵牌外观</h3>
      <div id="unitInfo" style="color:var(--muted);">点击沙盘兵牌（点击上级聚合牌可下钻展开直属下级）</div>
      <div class="row" id="weaponRow" style="display:none;">
        武器LOS: <select id="selWeapon" onchange="fetchWeaponLos()"></select>
        <button onclick="clearWeaponLos()">清LOS</button>
      </div>
      <div class="row" id="skinRow" style="display:none;">
        颜色:<input type="color" id="inpSkinColor" value="#38bdf8" style="width:36px;padding:0;" />
        自定义名:<input type="text" id="inpSkinLabel" placeholder="兵牌标识" style="width:92px;" />
        <button onclick="applySkin()">套皮肤(禁改层级)</button>
      </div>
      <div class="row" id="reorgRow" style="display:none;">
        <button onclick="splitSelectedSquad()">拆半/分队</button>
        <button onclick="mergeSquadPiecesUi()">班内直并(&lt;=15)</button>
        <button onclick="startReorgEventUi()">排+定时整编(允许0干部)</button>
      </div>
    </div>

    <!-- 3. 显隐控制表与聚合状态 -->
    <div class="card">
      <h3>显隐控制表 (Auto LOD / 钉住 / 隐藏)</h3>
      <div style="max-height:140px; overflow-y:auto;">
        <table>
          <thead><tr><th>单位</th><th>层</th><th>限制级</th><th>显示</th></tr></thead>
          <tbody id="visTableBody"></tbody>
        </table>
      </div>
    </div>

    <!-- 4. 双向作战日志终端、分兵种战线与单指挥官权限读线审计 -->
    <div class="card">
      <h3>双向作战日志 &amp; 分兵种战线 <span class="pill" id="lblScopeCount">可读线: 0</span></h3>
      <div class="row">
        准则:<select id="selDoctrine">
          <option value="attack">attack (进攻推进)</option>
          <option value="assault">assault (强攻突击)</option>
          <option value="defend">defend (防御固守)</option>
          <option value="hold">hold (原地死守)</option>
          <option value="withdraw">withdraw (交替撤退)</option>
        </select>
        目标(r,c):<input type="text" id="inpOrderTarget" value="24,38" style="width:60px;" />
        <button onclick="stageBaguwenOrder()">加入草稿</button>
      </div>
      <div class="row" style="border-top:1px solid #1e293b; padding-top:4px;">
        战线兵种:<select id="selLineMask">
          <option value="1">1 · 步兵防线</option>
          <option value="3" selected>3 · 步坦突击前锋</option>
          <option value="4">4 · 重武器/反坦克棱线</option>
          <option value="8">8 · 侦察侧翼警戒</option>
          <option value="16">16 · 炮兵/后勤支援</option>
          <option value="31">31 · 全兵种通用战线</option>
        </select>
        正面朝向:<select id="selLineNormal">
          <option value="0,1" selected>向东 (+E)</option>
          <option value="0,-1">向西 (-W)</option>
          <option value="-1,0">向北 (-N)</option>
          <option value="1,0">向南 (+S)</option>
        </select>
        <button onclick="finishFrontlineDraft()">完成战线</button>
        <button onclick="clearActiveFrontlinePts()">清点</button>
      </div>
      <div class="logbox" id="draftList">草稿箱为空</div>
      <div style="font-weight:600;color:var(--warn);">上行作战日志收件箱（断连直接没有东西）:</div>
      <div class="logbox" id="uplinkBox">加载中...</div>
    </div>
  </div>
</div>

<script>
const TERRAIN_COLORS = {
  0: [38, 48, 38],    // PLAIN 平原
  1: [24, 62, 34],    // FOREST 森林
  2: [7, 8, 12],      // MOUNTAIN 高山深黑
  3: [36, 56, 52],    // SWAMP 沼泽
  4: [16, 58, 108],   // WATER 水域
  5: [72, 68, 76],    // URBAN 城镇
  10: [92, 74, 52],   // DIRT_ROAD
  11: [130, 105, 70], // HIGHWAY
  12: [90, 90, 105],  // RAIL
  13: [190, 145, 70], // BRIDGE
  14: [95, 95, 110],  // AIRFIELD
};
const TERRAIN_NAMES = {
  0: "平原", 1: "森林", 2: "山地", 3: "沼泽", 4: "水域", 5: "城镇",
  10: "土路", 11: "干线公路", 12: "铁路", 13: "桥梁", 14: "机场",
};
const ECHELON_ORDER = { squad: 0, platoon: 1, company: 2, battalion: 3, regiment: 4, brigade: 5, division: 6 };

const DEFAULT_FEATURE_CATALOG = {
  plain: { name: "平原" },
  forest: { name: "森林" },
  mountain: { name: "山地" },
  swamp: { name: "沼泽" },
  water: { name: "水域" },
  urban: { name: "城镇" },
  dirt_road: { name: "土路" },
  highway: { name: "干线公路" },
  rail: { name: "铁路" },
  bridge: { name: "桥梁" },
  airfield: { name: "机场" },
};
const TILE_SIZE = 256;
const MAX_CACHED_TILES = 160;
const MAX_TILE_CONCURRENCY = 8;

let STATE = null;
let VIEW = { offsetX: 40, offsetY: 60, pxSize: 11, dragging: false, lastX: 0, lastY: 0 };
let TOOL_MODE = "inspect";
let SELECTED_PIECE_ID = null;
let SELECTED_COMMANDER_ID = null;
let ACTOR = { kind: "commander", id: "" };
let OB_TAB = "mission"; // null | "mission" | "event"
let OB_EXPAND = { soldiers: false, gear: false, supplies: false, ground: true };
let DIRECT_PICK = null; // { targetKind, targetId, action }
let REPICK_STEP = null; // { targetKind, targetId, stepIdx }
let PLAN_HOVER_POS = null; // [exactR, exactC] for live planning rubber-band preview
let DIRECT_OPTS = { move_mode: "normal", fire_mode: "stop_to_fire", follow_target: false, append: false };
let EVENT_PICK = null; // { op, pieceId, label, extra }
let QUEUED_TURN_OPS = { radio_silence: [], lay_wire: [], cargo_transfer: [] };
let HIGHLIGHT_OVERLAY = null; // { unitId, cmdId, zoneIds, lineIds, pts, expiresAt }
let MP_STATE = { claimedCommanderId: "", seatToken: "", syncBarrier: false, pollTimer: null, lastRevision: 0 };
let CMD_DRAW = null; // { role, label, color, pts }
let ERASE_MODE = false;
let ERASE_DRAWING = false;
let ERASE_LINE_PTS = []; // [[mx, my], ...] in canvas screen coords
let ERASE_HOVER = null; // { kind: "direct"|"frontline", targetKind?, targetId?, lineId?, pts, dispCircle? }
let SIM_TIMER = null;
const RENDER_POS = {};
const FLOAT_TEXTS = []; // { r, c, text, color, born }
let SHOOT_HOVER = null; // { mx, my, r, c, blocked, distM, dispM, hitProb, weapon, rangeM, targetName }
let DRILLED_IDS = new Set();
let VIS_MODES = {}; // entityId -> "auto" | "pin" | "hide"
let LOS_DATA = null;
let DRAFTS = { baguwen_orders: [], ao_zones: [], ao_preview: null, typed_frontlines: [], active_frontline_pts: [] };
let AO_DRAG_START = null;
let TERRAIN_CANVAS = document.createElement("canvas");
let TERRAIN_FLAT_U8 = null;
let ELEV_FLAT_U16 = null;
let LOADED_TERRAIN_REV = null;
let VIEW_INITIALIZED = false;

// === Dual-Track Viewport Tile Streaming (WebGL2 Primary + Canvas2D Fallback) ===
const urlParams = new URLSearchParams(window.location.search || "");
let FORCE_CANVAS2D = urlParams.get("renderer") === "2d";
let TILE_STREAM_SUPPORTED = true; // falls back to /api/terrain_raw.bin only if /api/tile returns 404
const TILE_CACHE = new Map(); // key `${rev}:${tr}:${tc}` -> { w, h, rev, tr, tc, rgba, tex, c2d, lastUsed }
const TILE_INFLIGHT = new Set();
let TILE_ACTIVE_FETCHES = 0;
let TILE_FETCH_QUEUE = [];
let TILE_USE_SEQ = 0;

let GL = null;
let GL_PROG = null;
let GL_VAO = null;
let GL_LOC_RECT = null;
let GL_LOC_RES = null;
let GL_LOC_TEX = null;
let GL_LOC_PLAIN_TEX = null;
let GL_LOC_TILE_UV = null;
let GL_LOC_HAS_PLAIN = null;
let GL_TEX_PLAIN = null;
let GL_PLAIN_READY = false;
let GL_TEX_FIELD = null;
let GL_FIELD_READY = false;
let GL_FIELD_REV = -1;
let C2D_FIELD_CANVAS = null;
let C2D_FIELD_REV = -1;
let C2D_LOS_CANVAS = null;
let C2D_LOS_KEY = null;
let GL_LOC_FIELD_TEX = null;
let GL_LOC_HAS_FIELD = null;
let GL_LOC_GRID_SZ = null;
let ENABLE_KRAFT_PAPER = true;
const LAYER_FLAGS = {
  forestFill: true,
  forestTrees: true,
  gridLines: true,
  cmdRadius: true,
  cmdLinks: true,
  losShadow: true,
  units: true,
};
const TACTICAL_MARK_FLAGS = {
  march: false,
  attack: false,
  occupyLine: false,
  blocked: false,
  retreat: false,
};
let PLAIN_PATTERN = null;
let PLAIN_TEX_IMG = new Image();
let FOREST_TREE_IMGS = [];
let FOREST_TREE_READY = false;
let RENDERER_MODE = "Canvas2D-Fallback";

function loadArtAssets() {
  PLAIN_TEX_IMG.onload = () => {
    PLAIN_PATTERN = ctx.createPattern(PLAIN_TEX_IMG, "repeat");
    if (GL) {
      GL_TEX_PLAIN = GL.createTexture();
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_PLAIN);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MIN_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MAG_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_S, GL.REPEAT);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_T, GL.REPEAT);
      GL.texImage2D(GL.TEXTURE_2D, 0, GL.RGBA, GL.RGBA, GL.UNSIGNED_BYTE, PLAIN_TEX_IMG);
      GL_PLAIN_READY = true;
    }
    requestAnimationFrame(render);
  };
  PLAIN_TEX_IMG.src = "/assets/textures/kraft_paper_texture_1794661743078.jpg";

  FOREST_TREE_IMGS = [0, 1, 2, 3].map(idx => {
    const img = new Image();
    img.onload = () => {
      FOREST_TREE_READY = true;
      requestAnimationFrame(render);
    };
    img.src = `/assets/vectors/forest_tree_${idx}.svg`;
    return img;
  });
}

function updateRendererBadge() {
  const lbl = document.getElementById("lblRenderer");
  if (!lbl) return;
  lbl.textContent = `Renderer: ${RENDERER_MODE}`;
  lbl.className = "pill " + (RENDERER_MODE === "WebGL2" ? "badge-ok" : "badge-warn");
}

function initDualTrackRenderer() {
  const glCanvas = document.getElementById("glCanvas");
  GL = null;
  GL_PROG = null;
  GL_TEX_PLAIN = null;
  GL_PLAIN_READY = false;
  if (!FORCE_CANVAS2D && glCanvas) {
    try {
      const ctxGl = glCanvas.getContext("webgl2", { antialias: false, alpha: false, depth: false });
      if (ctxGl) {
        const vsSrc = `#version 300 es
          in vec2 aPos;
          uniform vec4 uRect;
          uniform vec2 uRes;
          uniform vec4 uTileWorld;
          uniform vec2 uGridSize;
          out vec2 vUv;
          out vec2 vWorldPx;
          out vec2 vMapUv;
          void main() {
            vec2 px = uRect.xy + aPos * uRect.zw;
            vec2 ndc = vec2((px.x / max(1.0, uRes.x)) * 2.0 - 1.0, 1.0 - (px.y / max(1.0, uRes.y)) * 2.0);
            gl_Position = vec4(ndc, 0.0, 1.0);
            vUv = aPos;
            vWorldPx = uTileWorld.xy + aPos * uTileWorld.zw;
            vMapUv = vWorldPx / max(vec2(1.0), uGridSize);
          }`;
        const fsSrc = `#version 300 es
          precision highp float;
          in vec2 vUv;
          in vec2 vWorldPx;
          in vec2 vMapUv;
          uniform sampler2D uTex;
          uniform sampler2D uPlainTex;
          uniform sampler2D uFieldTex;
          uniform int uHasPlain;
          uniform int uHasField;
          uniform vec2 uGridSize;
          out vec4 outColor;
          void main() {
            vec3 baseCol = vec3(0.968, 0.970, 0.958);
            if (uHasField == 1) {
              vec2 o = vec2(0.48) / max(vec2(1.0), uGridSize);
              vec2 od = o * 0.7071;
              float fc  = texture(uFieldTex, vMapUv).r;
              float fl  = texture(uFieldTex, vMapUv - vec2(o.x, 0.0)).r;
              float fr  = texture(uFieldTex, vMapUv + vec2(o.x, 0.0)).r;
              float fu  = texture(uFieldTex, vMapUv - vec2(0.0, o.y)).r;
              float fd  = texture(uFieldTex, vMapUv + vec2(0.0, o.y)).r;
              float ful = texture(uFieldTex, vMapUv + vec2(-od.x, -od.y)).r;
              float fur = texture(uFieldTex, vMapUv + vec2( od.x, -od.y)).r;
              float fdl = texture(uFieldTex, vMapUv + vec2(-od.x,  od.y)).r;
              float fdr = texture(uFieldTex, vMapUv + vec2( od.x,  od.y)).r;
              float f = (fc * 1.6 + (fl + fr + fu + fd) + (ful + fur + fdl + fdr) * 0.7) / 8.4;
              float fw = max(0.0005, fwidth(f)) * 0.75;
              float mask = smoothstep(0.18 - fw, 0.18 + fw, f);
              vec3 forestFlat = vec3(0.765, 0.858, 0.565);
              baseCol = mix(baseCol, forestFlat, mask);
            }
            if (uHasPlain == 1) {
              vec3 paper = texture(uPlainTex, vWorldPx / 8.0).rgb;
              vec3 mult = clamp(baseCol * paper * 1.15, 0.0, 1.0);
              outColor = vec4(mix(baseCol, mult, 0.45), 1.0);
            } else {
              outColor = vec4(baseCol, 1.0);
            }
          }`;
        const compile = (type, src) => {
          const sh = ctxGl.createShader(type);
          ctxGl.shaderSource(sh, src);
          ctxGl.compileShader(sh);
          if (!ctxGl.getShaderParameter(sh, ctxGl.COMPILE_STATUS)) {
            console.warn("Shader compile failed:", ctxGl.getShaderInfoLog(sh));
            ctxGl.deleteShader(sh);
            return null;
          }
          return sh;
        };
        const vs = compile(ctxGl.VERTEX_SHADER, vsSrc);
        const fs = compile(ctxGl.FRAGMENT_SHADER, fsSrc);
        if (vs && fs) {
          const prog = ctxGl.createProgram();
          ctxGl.attachShader(prog, vs);
          ctxGl.attachShader(prog, fs);
          ctxGl.linkProgram(prog);
          if (ctxGl.getProgramParameter(prog, ctxGl.LINK_STATUS)) {
            const vao = ctxGl.createVertexArray();
            ctxGl.bindVertexArray(vao);
            const vbo = ctxGl.createBuffer();
            ctxGl.bindBuffer(ctxGl.ARRAY_BUFFER, vbo);
            ctxGl.bufferData(ctxGl.ARRAY_BUFFER, new Float32Array([
              0, 0,  1, 0,  0, 1,
              0, 1,  1, 0,  1, 1,
            ]), ctxGl.STATIC_DRAW);
            const locPos = ctxGl.getAttribLocation(prog, "aPos");
            ctxGl.enableVertexAttribArray(locPos);
            ctxGl.vertexAttribPointer(locPos, 2, ctxGl.FLOAT, false, 0, 0);
            GL = ctxGl;
            GL_PROG = prog;
            GL_VAO = vao;
            GL_LOC_RECT = ctxGl.getUniformLocation(prog, "uRect");
            GL_LOC_RES = ctxGl.getUniformLocation(prog, "uRes");
            GL_LOC_TEX = ctxGl.getUniformLocation(prog, "uTex");
            GL_LOC_PLAIN_TEX = ctxGl.getUniformLocation(prog, "uPlainTex");
            GL_LOC_TILE_UV = ctxGl.getUniformLocation(prog, "uTileWorld");
            GL_LOC_HAS_PLAIN = ctxGl.getUniformLocation(prog, "uHasPlain");
            GL_LOC_FIELD_TEX = ctxGl.getUniformLocation(prog, "uFieldTex");
            GL_LOC_HAS_FIELD = ctxGl.getUniformLocation(prog, "uHasField");
            GL_LOC_GRID_SZ = ctxGl.getUniformLocation(prog, "uGridSize");
            RENDERER_MODE = "WebGL2";
            if (PLAIN_TEX_IMG.complete && PLAIN_TEX_IMG.naturalWidth > 0) {
              GL_TEX_PLAIN = ctxGl.createTexture();
              ctxGl.bindTexture(ctxGl.TEXTURE_2D, GL_TEX_PLAIN);
              ctxGl.texParameteri(ctxGl.TEXTURE_2D, ctxGl.TEXTURE_MIN_FILTER, ctxGl.LINEAR);
              ctxGl.texParameteri(ctxGl.TEXTURE_2D, ctxGl.TEXTURE_MAG_FILTER, ctxGl.LINEAR);
              ctxGl.texParameteri(ctxGl.TEXTURE_2D, ctxGl.TEXTURE_WRAP_S, ctxGl.REPEAT);
              ctxGl.texParameteri(ctxGl.TEXTURE_2D, ctxGl.TEXTURE_WRAP_T, ctxGl.REPEAT);
              ctxGl.texImage2D(ctxGl.TEXTURE_2D, 0, ctxGl.RGBA, ctxGl.RGBA, ctxGl.UNSIGNED_BYTE, PLAIN_TEX_IMG);
              GL_PLAIN_READY = true;
            }
          }
        }
      }
    } catch (_) {
      GL = null;
    }
  }
  if (!GL) {
    RENDERER_MODE = "Canvas2D-Fallback";
    if (glCanvas) glCanvas.style.display = "none";
  } else if (glCanvas) {
    glCanvas.style.display = "block";
  }
  // Drop stale GL textures if switching away
  if (!GL) {
    for (const ent of TILE_CACHE.values()) ent.tex = null;
  }
  updateRendererBadge();
}

function toggleRendererMode() {
  FORCE_CANVAS2D = !FORCE_CANVAS2D;
  initDualTrackRenderer();
  render();
}

function focusUnits(targetPxSize = null) {
  if (!STATE || !STATE.grid) return;
  const rect = canvas.parentElement.getBoundingClientRect();
  const cw = rect.width || window.innerWidth;
  const ch = rect.height || window.innerHeight;
  let fr = STATE.grid.rows * 0.5, fc = STATE.grid.cols * 0.5;
  if (STATE.grid.focus_px && STATE.grid.focus_px.length === 2) {
    fr = Number(STATE.grid.focus_px[0]);
    fc = Number(STATE.grid.focus_px[1]);
  } else if (STATE.own_pieces && STATE.own_pieces.length > 0) {
    fr = Number(STATE.own_pieces[0].pos[0]);
    fc = Number(STATE.own_pieces[0].pos[1]);
  }
  if (targetPxSize !== null) {
    VIEW.pxSize = targetPxSize;
  } else if (STATE.grid.large_grid && VIEW.pxSize < 8) {
    VIEW.pxSize = 16;
  }
  VIEW.offsetX = cw * 0.5 - (fc + 0.5) * VIEW.pxSize;
  VIEW.offsetY = ch * 0.5 - (fr + 0.5) * VIEW.pxSize;
  render();
}

function getVisibleTileBounds() {
  if (!STATE || !STATE.grid) return null;
  const g = STATE.grid;
  const s = VIEW.pxSize;
  const cw = canvas.width || 1280, ch = canvas.height || 720;
  const c0 = Math.max(0, Math.floor((0 - VIEW.offsetX) / s));
  const r0 = Math.max(0, Math.floor((0 - VIEW.offsetY) / s));
  const c1 = Math.min(g.cols - 1, Math.ceil((cw - VIEW.offsetX) / s));
  const r1 = Math.min(g.rows - 1, Math.ceil((ch - VIEW.offsetY) / s));
  if (c1 < c0 || r1 < r0) return null;
  const maxTr = Math.floor((g.rows - 1) / TILE_SIZE);
  const maxTc = Math.floor((g.cols - 1) / TILE_SIZE);
  return {
    trMin: Math.max(0, Math.floor(r0 / TILE_SIZE)),
    trMax: Math.min(maxTr, Math.floor(r1 / TILE_SIZE)),
    tcMin: Math.max(0, Math.floor(c0 / TILE_SIZE)),
    tcMax: Math.min(maxTc, Math.floor(c1 / TILE_SIZE)),
  };
}

function evictTileCacheIfNeeded() {
  if (TILE_CACHE.size <= MAX_CACHED_TILES) return;
  const entries = Array.from(TILE_CACHE.entries()).sort((a, b) => a[1].lastUsed - b[1].lastUsed);
  const dropCount = TILE_CACHE.size - MAX_CACHED_TILES;
  for (let i = 0; i < dropCount; i++) {
    const [k, ent] = entries[i];
    if (GL && ent.tex) GL.deleteTexture(ent.tex);
    TILE_CACHE.delete(k);
  }
}

function ensureTileUploaded(ent) {
  if (RENDERER_MODE === "WebGL2" && GL && !ent.tex && ent.rgba) {
    const tex = GL.createTexture();
    GL.bindTexture(GL.TEXTURE_2D, tex);
    GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MIN_FILTER, GL.LINEAR);
    GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MAG_FILTER, GL.NEAREST);
    GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_S, GL.CLAMP_TO_EDGE);
    GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_T, GL.CLAMP_TO_EDGE);
    GL.texImage2D(GL.TEXTURE_2D, 0, GL.RGBA, ent.w, ent.h, 0, GL.RGBA, GL.UNSIGNED_BYTE, ent.rgba);
    ent.tex = tex;
  } else if (RENDERER_MODE !== "WebGL2" && !ent.c2d && ent.rgba) {
    const oc = document.createElement("canvas");
    oc.width = ent.w;
    oc.height = ent.h;
    const octx = oc.getContext("2d");
    octx.putImageData(new ImageData(new Uint8ClampedArray(ent.rgba), ent.w, ent.h), 0, 0);
    ent.c2d = oc;
  }
}

function pumpTileQueue() {
  while (TILE_ACTIVE_FETCHES < MAX_TILE_CONCURRENCY && TILE_FETCH_QUEUE.length > 0 && TILE_STREAM_SUPPORTED) {
    const item = TILE_FETCH_QUEUE.shift();
    if (TILE_CACHE.has(item.key)) continue;
    TILE_ACTIVE_FETCHES++;
    fetch(`/api/tile/0/${item.tr}/${item.tc}?rev=${item.rev}`)
      .then(async (res) => {
        if (res.status === 404) {
          TILE_STREAM_SUPPORTED = false;
          await ensureTerrainBinaryFallback();
          rebuildTerrainCanvasFallback();
          render();
          return;
        }
        if (!res.ok) return;
        const w = Number(res.headers.get("x-tile-width") || TILE_SIZE);
        const h = Number(res.headers.get("x-tile-height") || TILE_SIZE);
        const revHdr = Number(res.headers.get("x-terrain-rev") || item.rev);
        const buf = await res.arrayBuffer();
        const rgba = new Uint8Array(buf);
        const ent = { w, h, rev: revHdr, tr: item.tr, tc: item.tc, rgba, tex: null, c2d: null, lastUsed: ++TILE_USE_SEQ };
        TILE_CACHE.set(item.key, ent);
        evictTileCacheIfNeeded();
        requestAnimationFrame(render);
      })
      .catch(() => {})
      .finally(() => {
        TILE_INFLIGHT.delete(item.key);
        TILE_ACTIVE_FETCHES--;
        pumpTileQueue();
      });
  }
}

function requestVisibleTiles() {
  if (!STATE || !STATE.grid || !TILE_STREAM_SUPPORTED) return;
  const g = STATE.grid;
  const rev = g.terrain_revision || 1;
  const b = getVisibleTileBounds();
  if (!b) return;
  const midTr = (b.trMin + b.trMax) * 0.5;
  const midTc = (b.tcMin + b.tcMax) * 0.5;
  const missing = [];
  for (let tr = b.trMin; tr <= b.trMax; tr++) {
    for (let tc = b.tcMin; tc <= b.tcMax; tc++) {
      const key = `${rev}:${tr}:${tc}`;
      const ent = TILE_CACHE.get(key);
      if (ent) {
        ent.lastUsed = ++TILE_USE_SEQ;
      } else if (!TILE_INFLIGHT.has(key)) {
        TILE_INFLIGHT.add(key);
        const dist = Math.hypot(tr - midTr, tc - midTc);
        missing.push({ key, rev, tr, tc, dist });
      }
    }
  }
  if (missing.length > 0) {
    missing.sort((a, b2) => a.dist - b2.dist);
    TILE_FETCH_QUEUE.push(...missing);
    pumpTileQueue();
  }
}

async function ensureTerrainBinaryFallback() {
  if (!STATE || !STATE.grid || TILE_STREAM_SUPPORTED) return;
  const g = STATE.grid;
  if (!g.large_grid) {
    TERRAIN_FLAT_U8 = null;
    ELEV_FLAT_U16 = null;
    LOADED_TERRAIN_REV = g.terrain_revision || null;
    return;
  }
  const rev = g.terrain_revision || 1;
  if (LOADED_TERRAIN_REV === rev && TERRAIN_FLAT_U8 && ELEV_FLAT_U16) return;
  const res = await fetch(`/api/terrain_raw.bin?rev=${rev}`);
  if (!res.ok) return;
  const buf = await res.arrayBuffer();
  const n = g.rows * g.cols;
  TERRAIN_FLAT_U8 = new Uint8Array(buf, 0, n);
  ELEV_FLAT_U16 = (n % 2 === 0)
    ? new Uint16Array(buf, n, n)
    : new Uint16Array(buf.slice(n, n + n * 2));
  LOADED_TERRAIN_REV = rev;
}

function frontlineStyle(mask) {
  const m = Number(mask || 31);
  if (m === 1) return { color: "#38bdf8", label: "步兵" };
  if (m === 3) return { color: "#f97316", label: "步坦前锋" };
  if (m === 4) return { color: "#e879f9", label: "重武器/AT" };
  if (m === 8) return { color: "#a3e635", label: "侦察" };
  if (m === 16) return { color: "#c084fc", label: "炮/勤" };
  return { color: "#facc15", label: `M${m}` };
}

const canvas = document.getElementById("mapCanvas");
const ctx = canvas.getContext("2d");

async function api(path, method = "GET", body = null) {
  const opt = { method, headers: {} };
  if (body !== null) {
    opt.headers["Content-Type"] = "application/json";
    opt.body = JSON.stringify(body);
  }
  const res = await fetch(path, opt);
  const data = await res.json();
  return { ok: res.ok, status: res.status, data };
}

function updateMpBarUi() {
  const sel = document.getElementById("mpSeatSel");
  const pill = document.getElementById("mpStatusPill");
  const claimBtn = document.getElementById("mpClaimBtn");
  const readyBtn = document.getElementById("mpReadyBtn");
  if (!sel || !pill || !STATE) return;
  const cmds = STATE.commanders || [];
  const prev = sel.value || MP_STATE.claimedCommanderId || STATE.active_commander_id || "";
  sel.innerHTML = cmds.map(c => `<option value="${c.id}" ${c.id === prev ? "selected" : ""}>${c.name}</option>`).join("");
  const mp = STATE.mp || {};
  const claimed = mp.claimed_seats || [];
  const readyList = mp.ready_commanders || [];
  const curSeat = sel.value;
  const isMeClaimed = Boolean(MP_STATE.seatToken && MP_STATE.claimedCommanderId === curSeat);
  const isMeReady = curSeat && readyList.includes(curSeat);
  if (claimBtn) {
    claimBtn.textContent = isMeClaimed ? "已认领" : (claimed.includes(curSeat) ? "被占" : "认领");
    claimBtn.style.background = isMeClaimed ? "#0f766e" : "";
    claimBtn.style.color = isMeClaimed ? "#fff" : "";
  }
  if (readyBtn) {
    readyBtn.textContent = isMeReady ? "✓ 已就绪" : "准备";
    readyBtn.style.background = isMeReady ? "#16a34a" : "";
    readyBtn.style.color = isMeReady ? "#fff" : "";
  }
  pill.textContent = claimed.length > 0
    ? `在线${claimed.length} · 就绪${readyList.length}/${claimed.length} · r${STATE.state_revision || MP_STATE.lastRevision}`
    : `单机 · r${STATE.state_revision || MP_STATE.lastRevision}`;
}

async function claimSeat() {
  const sel = document.getElementById("mpSeatSel");
  const cid = sel ? sel.value : (STATE && STATE.active_commander_id);
  if (!cid) return;
  const r = await api("/api/mp/claim_seat", "POST", {
    commander_id: cid,
    seat_token: (MP_STATE.claimedCommanderId === cid && MP_STATE.seatToken) ? MP_STATE.seatToken : undefined,
  });
  if (!r.ok) {
    setActionHint(`席位认领失败: ${(r.data && r.data.reason) || "已被占用"}`);
    setTimeout(() => setActionHint(""), 2400);
    return;
  }
  MP_STATE.claimedCommanderId = cid;
  MP_STATE.seatToken = r.data.seat_token || "";
  if (r.data.state_revision) MP_STATE.lastRevision = Number(r.data.state_revision);
  const selC = document.getElementById("selCommander");
  if (selC && selC.value !== cid) selC.value = cid;
  await refreshState();
}

async function toggleMpReady() {
  const sel = document.getElementById("mpSeatSel");
  const cid = MP_STATE.claimedCommanderId || (sel && sel.value) || (STATE && STATE.active_commander_id);
  if (!cid) return;
  const readyList = (STATE && STATE.mp && STATE.mp.ready_commanders) || [];
  const nextReady = !readyList.includes(cid);
  const r = await api("/api/mp/ready", "POST", {
    commander_id: cid,
    seat_token: MP_STATE.seatToken || undefined,
    ready: nextReady,
  });
  if (!r.ok) {
    setActionHint(`就绪状态同步失败: ${(r.data && r.data.reason) || r.status}`);
    setTimeout(() => setActionHint(""), 2400);
    return;
  }
  await refreshState();
}

async function syncMpStatus() {
  if (!STATE || SIM_TIMER) return;
  try {
    const r = await api("/api/mp/status");
    if (!r.ok || !r.data) return;
    if (STATE.mp) {
      STATE.mp.claimed_seats = r.data.claimed_seats || [];
      STATE.mp.ready_commanders = r.data.ready_commanders || [];
      STATE.mp.all_ready = Boolean(r.data.all_ready);
    }
    const rev = Number(r.data.state_revision || 0);
    if (rev > MP_STATE.lastRevision) {
      await refreshState();
    } else {
      updateMpBarUi();
    }
  } catch (_) {}
}

function openOrderDocModal(title, text, highlightSpec = null) {
  const win = document.getElementById("orderDocWin");
  const ttl = document.getElementById("orderDocTitle");
  const body = document.getElementById("orderDocBody");
  if (win && ttl && body) {
    ttl.textContent = title || "当前命令详情";
    body.textContent = text || "(无生效命令文本)";
    win.classList.add("open");
  }
  if (highlightSpec) {
    HIGHLIGHT_OVERLAY = {
      ...highlightSpec,
      expiresAt: performance.now() + 8000,
    };
    render();
  }
}

function closeOrderDocModal() {
  const win = document.getElementById("orderDocWin");
  if (win) win.classList.remove("open");
  HIGHLIGHT_OVERLAY = null;
  render();
}

(function initOrderDocDrag() {
  const win = document.getElementById("orderDocWin");
  const bar = document.getElementById("orderDocDragBar");
  const closeBtn = document.getElementById("orderDocCloseBtn");
  if (!win || !bar) return;
  ["mousedown", "wheel", "dblclick"].forEach(ev => win.addEventListener(ev, e => e.stopPropagation()));
  let drag = null;
  bar.addEventListener("mousedown", e => {
    if (e.target === closeBtn) return;
    const r = win.getBoundingClientRect();
    win.style.left = r.left + "px";
    win.style.top = r.top + "px";
    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  });
  window.addEventListener("mousemove", e => {
    if (!drag) return;
    win.style.left = Math.max(0, Math.min(window.innerWidth - 160, e.clientX - drag.dx)) + "px";
    win.style.top = Math.max(0, Math.min(window.innerHeight - 60, e.clientY - drag.dy)) + "px";
  });
  window.addEventListener("mouseup", () => { drag = null; });
})();



async function sendEventOp(op, pieceId, targetPx = null, extra = {}) {
  if (!STATE) return false;
  if (extra && extra.queue_turn) {
    if (op === "lay_wire") {
      QUEUED_TURN_OPS.lay_wire.push({ piece_id: pieceId, target_px: targetPx, duration_h: extra.duration_h || 0.25 });
    } else if (op === "radio_silence" || op === "set_radio_channel") {
      QUEUED_TURN_OPS.radio_silence.push({
        entity_id: extra.entity_id || pieceId,
        radio_silence: extra.radio_silence,
        radio_channel: extra.radio_channel,
      });
    } else if (op === "cargo_transfer") {
      QUEUED_TURN_OPS.cargo_transfer.push({
        piece_id: pieceId,
        target_piece_id: extra.target_piece_id,
        food_t: Number(extra.food_t || 0),
        ammo_t: Number(extra.ammo_t || 0),
        fuel_t: Number(extra.fuel_t || 0),
        duration_h: extra.duration_h || 0.25,
      });
    }
    setActionHint(`已加入本回合提交队列 (${op})，点击「单步」转发执行`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK) setActionHint(""); }, 2200);
    renderOrbatCard();
    return true;
  }
  const payload = {
    op,
    player_commander_id: STATE.active_commander_id,
    piece_id: pieceId,
    target_px: targetPx || undefined,
    ...extra,
  };
  delete payload.queue_turn;
  const r = await api("/api/unit_op", "POST", payload);
  if (!r.ok) {
    setActionHint(`事件执行失败: ${(r.data && r.data.reason) || r.status}`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK) setActionHint(""); }, 2600);
    return false;
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    syncUiFromState();
  } else {
    await refreshState();
  }
  setActionHint(`事件已发起: ${op}${r.data && r.data.event_id ? " (#" + r.data.event_id + ")" : ""}`);
  setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK) setActionHint(""); }, 2000);
  render();
  return true;
}

