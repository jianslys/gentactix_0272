let REORG_WIN_STATE = {
  open: false,
  targetKind: "unit",
  targetId: null,
  leftUnitId: null,
  rightUnitId: null,
  leftSoldierIds: new Set(),
  rightSoldierIds: new Set(),
  mergeIds: new Set(),
  reorgIds: new Set(),
  nominalContainer: "infantry",
  lockCounterName: false,
  newCustomName: "",
  targetEchelon: "team",
  splitTakeCount: 1,
};
let HEAVY_WIN_STATE = { open: false, targetKind: "unit", targetId: null, weapon: "", mode: "unmanned", operatorPieceId: "", soldierIds: new Set(), packTargetId: "", immediate: true };

function escHtml(v) {
  return String(v ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function resolveTargetEntity(targetKind, targetId) {
  if (!STATE) return null;
  if (targetKind === "commander") {
    const cmd = (STATE.commanders || []).find(c => c.id === targetId);
    if (!cmd) return null;
    const hqPiece = (STATE.own_pieces || []).find(sp => sp.is_hq_piece && (sp.id === cmd.hq_piece_id || sp.direct_commander_id === cmd.id)) || null;
    const nco = Number(cmd.hq_nco ?? (hqPiece ? hqPiece.nco : 0) ?? 0);
    const officer = Number(cmd.hq_officer ?? (hqPiece ? hqPiece.officer : 0) ?? 0);
    const caps = new Set(Array.isArray(hqPiece?.capabilities) ? hqPiece.capabilities : []);
    const weapons = hqPiece?.weapons || cmd.weapons || [];
    return {
      isHQ: true,
      targetKind: "commander",
      targetId: cmd.id,
      pieceId: cmd.hq_piece_id || hqPiece?.id || "",
      cmd,
      piece: hqPiece,
      name: cmd.name,
      level: cmd.rank || "platoon",
      pos: cmd.pos || cmd.px || [0, 0],
      alive: cmd.alive !== false && (cmd.persons === undefined || Number(cmd.persons) > 0),
      persons: Number(cmd.persons ?? hqPiece?.persons ?? 0),
      nco,
      officer,
      kind: hqPiece?.kind || "hq_squad",
      soldiers: hqPiece?.soldiers || cmd.hq_soldiers || [],
      weapons,
      capabilities: caps,
      hasEngineerCap: Boolean(hqPiece?.has_engineer_cap),
      canOperateRadio: (hqPiece ? hqPiece.can_operate_radio !== false : (nco + officer > 0)) && weapons.some(w => (w.model || "").includes("radio") || w.model === "hq_radio"),
      radioChannel: cmd.radio_channel || "A",
      radioSilence: Boolean(cmd.radio_silence),
      taskQueue: hqPiece?.task_queue || [],
      baseSpeedKmh: Number(hqPiece?.base_speed_kmh || 4.5),
    };
  }
  const p = (STATE.own_pieces || []).find(x => x.id === targetId);
  if (!p) return null;
  const nco = Number(p.nco ?? 0);
  const officer = Number(p.officer ?? 0);
  const caps = new Set(Array.isArray(p.capabilities) ? p.capabilities : []);
  const weapons = p.weapons || [];
  return {
    isHQ: false,
    targetKind: "unit",
    targetId: p.id,
    pieceId: p.id,
    cmd: null,
    piece: p,
    name: p.name,
    level: p.level || "squad",
    pos: p.pos || p.px || [0, 0],
    alive: Number(p.persons || 0) > 0 || Boolean(p.vehicle_model) || Boolean(p.deployed_weapon),
    persons: Number(p.persons || 0),
    nco,
    officer,
    kind: p.kind || "",
    soldiers: p.soldiers || [],
    weapons,
    capabilities: caps,
    hasEngineerCap: Boolean(p.has_engineer_cap),
    canOperateRadio: (p.can_operate_radio !== false) && weapons.some(w => (w.model || "").includes("radio") || w.model === "hq_radio"),
    radioChannel: p.radio_channel || "A",
    radioSilence: Boolean(p.radio_silence),
    taskQueue: p.task_queue || [],
    baseSpeedKmh: Number(p.base_speed_kmh || 4.5),
  };
}

function entityHasEngineerCap(ent) {
  if (!ent) return false;
  if (ent.hasEngineerCap) return true;
  if (ent.capabilities.has("salvage") || ent.capabilities.has("mine_clearing") || ent.capabilities.has("bridge_building") || ent.capabilities.has("airfield_repair")) return true;
  if ((ent.kind || "").includes("engineer") || (ent.kind || "").includes("pioneer") || (ent.kind || "").includes("pion") || (ent.kind || "").includes("sapper") || (ent.name || "").includes("工兵")) return true;
  return (ent.weapons || []).some(w => ["demo_charge", "mine_detector", "pontoon_kit", "bridge_kit", "explosives", "satchel", "flamethrower", "engineer"].some(k => (w.model || "").includes(k)));
}

function makeWinDraggable(winEl, barEl, onFocus) {
  if (!winEl || !barEl) return;
  ["mousedown", "wheel", "dblclick"].forEach(ev => {
    winEl.addEventListener(ev, e => e.stopPropagation());
  });
  winEl.addEventListener("mousedown", () => { if (onFocus) onFocus(); });
  let drag = null;
  barEl.addEventListener("mousedown", e => {
    if (e.target && (e.target.tagName === "BUTTON" || e.target.closest("button"))) return;
    const r = winEl.getBoundingClientRect();
    winEl.style.left = r.left + "px";
    winEl.style.top = r.top + "px";
    winEl.style.transform = "none";
    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  });
  const onMove = e => {
    if (!drag) return;
    winEl.style.left = Math.max(8, Math.min(window.innerWidth - 180, e.clientX - drag.dx)) + "px";
    winEl.style.top = Math.max(8, Math.min(window.innerHeight - 60, e.clientY - drag.dy)) + "px";
  };
  const onUp = () => { drag = null; };
  window.addEventListener("mousemove", onMove);
  window.addEventListener("mouseup", onUp);
}

// ---------- 1. Right-click Context Menu on Unit Counter ----------
function closeUnitContextMenu() {
  const m = document.getElementById("unitContextMenu");
  if (m) m.classList.remove("open");
}

function focusOnEntity(targetKind, targetId) {
  const ent = resolveTargetEntity(targetKind, targetId);
  if (!ent) return;
  if (targetKind === "commander") selectCommander(targetId);
  else selectPiece(targetId);
  const canvasEl = document.getElementById("mapCanvas");
  if (canvasEl && ent.pos) {
    VIEW.offsetX = canvasEl.width * 0.5 - (ent.pos[1] + 0.5) * VIEW.pxSize;
    VIEW.offsetY = canvasEl.height * 0.5 - (ent.pos[0] + 0.5) * VIEW.pxSize;
    render();
  }
}

function openUnitContextMenu(clientX, clientY, counterObj) {
  const menu = document.getElementById("unitContextMenu");
  if (!menu || !counterObj) return;
  if (counterObj.isAggregate) {
    DRILLED_IDS.add(counterObj.id);
    render();
    setActionHint(`已下钻展开聚合牌: ${counterObj.name}，请右键点击具体分队兵牌下达指令`);
    return;
  }
  const tgtKind = counterObj.isHQ ? "commander" : "unit";
  const tgtId = counterObj.id;
  if (tgtKind === "commander") selectCommander(tgtId);
  else selectPiece(tgtId);

  const ent = resolveTargetEntity(tgtKind, tgtId);
  if (!ent) return;
  const perm = canDirectControl(tgtKind, tgtId);
  const posTxt = `(${Math.round(ent.pos[0])},${Math.round(ent.pos[1])})`;
  const hasSoldiers = (ent.soldiers || []).length > 0;

  menu.innerHTML = `
    <div class="ucm-head">
      <span>${escHtml(ent.name)}</span>
      <small>${escHtml(posTxt)}</small>
    </div>
    <div class="ucm-list">
      <div class="ucm-item ${perm.ok && ent.alive ? "" : "disabled"}" data-ucm="mission" title="${perm.ok ? "" : escHtml(perm.reason)}">
        <span>▶ 下达任务 (队列窗口)</span><span class="ucm-kbd">Shift 连环</span>
      </div>
      <div class="ucm-item ${ent.alive ? "" : "disabled"}" data-ucm="event">
        <span>📋 安排事件</span><span class="ucm-kbd">工兵/通联</span>
      </div>
      <div class="ucm-sep"></div>
      <div class="ucm-item" data-ucm="reorg">
        <span>🪖 编制</span><span class="ucm-kbd">ORBAT</span>
      </div>
      <div class="ucm-item" data-ucm="heavy">
        <span>⚙ 重武器架设与操炮</span><span class="ucm-kbd">人数Buff</span>
      </div>
      <div class="ucm-sep"></div>
      <div class="ucm-item ${hasSoldiers ? "" : "disabled"}" data-ucm="tarkov">
        <span>🎒 单兵装备与背包</span><span class="ucm-kbd">${ent.soldiers.length}人</span>
      </div>
      <div class="ucm-item" data-ucm="focus">
        <span>🔭 聚焦定位${!ent.isHQ ? " & 射界LOS" : ""}</span><span class="ucm-kbd">居中</span>
      </div>
    </div>
  `;
  const left = Math.min(window.innerWidth - 230, Math.max(8, clientX));
  const top = Math.min(window.innerHeight - 240, Math.max(8, clientY));
  menu.style.left = left + "px";
  menu.style.top = top + "px";
  menu.classList.add("open");

  menu.querySelectorAll(".ucm-item").forEach(item => {
    item.onclick = (e) => {
      e.stopPropagation();
      if (item.classList.contains("disabled")) return;
      const act = item.getAttribute("data-ucm");
      closeUnitContextMenu();
      if (act === "mission") openMissionWindow(tgtKind, tgtId);
      else if (act === "event") openEventWindow(tgtKind, tgtId);
      else if (act === "reorg") openReorgSplitWin(tgtKind, tgtId);
      else if (act === "heavy") openHeavyCrewWin(tgtKind, tgtId);
      else if (act === "tarkov" && ent.soldiers[0]) openTarkovModal(tgtKind, tgtId, ent.soldiers[0].id);
      else if (act === "focus") {
        focusOnEntity(tgtKind, tgtId);
        if (!ent.isHQ) fetchWeaponLos();
      }
    };
  });
}

// ---------- 2. Independent Multi-Window Mission Drafting (Shift isolation) ----------
function getActiveMissionWindow() {
  return MISSION_WINDOWS.find(w => w.winId === ACTIVE_MISSION_WIN_ID) || MISSION_WINDOWS[MISSION_WINDOWS.length - 1] || null;
}

function focusMissionWindow(winId) {
  ACTIVE_MISSION_WIN_ID = winId;
  const w = getActiveMissionWindow();
  if (w) {
    setActionHint(`【任务窗口 #${w.seq}】点击地图加入目标点（按 Shift 打开独立 #${MISSION_WIN_SEQ} 窗口继续队列编排，右键取消点选）`);
  }
  renderMissionDraftDock();
  render();
}

function closeMissionWindow(winId) {
  MISSION_WINDOWS = MISSION_WINDOWS.filter(w => w.winId !== winId);
  if (ACTIVE_MISSION_WIN_ID === winId) {
    const tail = MISSION_WINDOWS[MISSION_WINDOWS.length - 1];
    ACTIVE_MISSION_WIN_ID = tail ? tail.winId : null;
  }
  if (MISSION_WINDOWS.length === 0) setActionHint("");
  renderMissionDraftDock();
  render();
}

function openMissionWindow(targetKind, targetId, opts = {}) {
  const ent = resolveTargetEntity(targetKind, targetId);
  if (!ent) return null;
  const perm = canDirectControl(targetKind, targetId);
  if (!perm.ok) {
    setActionHint(`无法打开任务窗口: ${perm.reason}`);
    return null;
  }
  const sameUnitCount = MISSION_WINDOWS.filter(w => w.targetId === targetId).length;
  const qLen = Array.isArray(ent.taskQueue) ? ent.taskQueue.length : 0;
  const seq = qLen + sameUnitCount + 1;
  const winId = `mwin-${seq}-${Date.now()}`;
  const isFollowUp = sameUnitCount > 0 || (ent.taskQueue && ent.taskQueue.length > 0);
  const draft = {
    winId,
    seq,
    targetKind,
    targetId,
    pieceId: ent.pieceId,
    targetName: ent.name,
    action: opts.action || "move",
    move_mode: opts.move_mode || "normal",
    fire_mode: opts.fire_mode || ((opts.action || "move") === "attack" ? "normal" : "stop_to_fire"),
    duration_sec: opts.duration_sec !== undefined ? Number(opts.duration_sec) : 16,
    priority_target: opts.priority_target || "any",
    follow_target: Boolean(opts.follow_target),
    append: opts.append !== undefined ? Boolean(opts.append) : isFollowUp,
    waypoints: Array.isArray(opts.waypoints) ? opts.waypoints.map(p => [...p]) : [],
    target_unit_ids: Array.isArray(opts.target_unit_ids) ? [...opts.target_unit_ids] : [],
    etaSteps: [],
    totalMin: 0,
    estimating: false,
    left: Math.min(window.innerWidth - 340, 340 + ((MISSION_WINDOWS.length % 5) * 28)),
    top: Math.min(window.innerHeight - 380, 68 + ((MISSION_WINDOWS.length % 5) * 28)),
  };
  MISSION_WINDOWS.push(draft);
  ACTIVE_MISSION_WIN_ID = winId;
  DIRECT_PICK = null; EVENT_PICK = null; REPICK_STEP = null;
  setActionHint(`【任务窗口 #${seq} · ${ent.name}】左键点击地图添加航路点；按 Shift 立即新开独立 #${seq + 1} 窗口互不覆盖`);
  renderMissionDraftDock();
  render();
  return draft;
}

function shiftToNextMissionWindow() {
  const cur = getActiveMissionWindow();
  if (!cur) return false;
  if (cur.waypoints.length === 0 && cur.action !== "stop" && cur.action !== "retreat") {
    setActionHint(`【任务窗口 #${cur.seq}】当前草稿尚未设定目标点，请先点击地图为 #${cur.seq} 选点再按 Shift 开下一段`);
    renderMissionDraftDock();
    return true;
  }
  openMissionWindow(cur.targetKind, cur.targetId, {
    action: cur.action,
    move_mode: cur.move_mode,
    fire_mode: cur.fire_mode,
    duration_sec: cur.duration_sec,
    priority_target: cur.priority_target,
    follow_target: cur.follow_target,
    append: true,
  });
  return true;
}

async function estimateMissionWindow(win) {
  if (!win || !STATE) return;
  const ent = resolveTargetEntity(win.targetKind, win.targetId);
  if (!ent) return;
  const prefixSteps = [];
  if (win.append) {
    for (const q of (ent.taskQueue || [])) {
      if (q && q.goal) prefixSteps.push({ action: q.action || "move", goal: q.goal, move_mode: q.move_mode || "normal", fire_mode: q.fire_mode || "stop_to_fire" });
    }
    for (const ow of MISSION_WINDOWS) {
      if (ow.winId === win.winId) break;
      if (ow.targetId !== win.targetId) continue;
      for (const wp of ow.waypoints) {
        prefixSteps.push({ action: ow.action, goal: wp, move_mode: ow.move_mode, fire_mode: ow.fire_mode });
      }
    }
  }
  const ownSteps = win.waypoints.map((wp, i) => ({
    action: win.action,
    goal: wp,
    move_mode: win.move_mode,
    fire_mode: win.fire_mode,
    target_unit_id: win.target_unit_ids[i] || undefined,
    follow_target: win.follow_target,
  }));
  if (ownSteps.length === 0) {
    win.etaSteps = [];
    win.totalMin = 0;
    renderMissionDraftDock();
    return;
  }
  win.estimating = true;
  renderMissionDraftDock();
  const allSteps = [...prefixSteps, ...ownSteps];
  const r = await api("/api/estimate_plan_time", "POST", {
    piece_id: win.pieceId || win.targetId,
    steps: allSteps,
  });
  win.estimating = false;
  if (r.ok && r.data && Array.isArray(r.data.steps)) {
    const sliced = r.data.steps.slice(prefixSteps.length);
    win.etaSteps = sliced;
    win.totalMin = sliced.reduce((acc, s) => acc + Number(s.duration_min || 0), 0);
  }
  renderMissionDraftDock();
}

async function confirmMissionWindows(winIds) {
  const list = MISSION_WINDOWS.filter(w => winIds.includes(w.winId));
  if (list.length === 0) return;
  for (let wi = 0; wi < list.length; wi++) {
    const w = list[wi];
    const isInstant = w.action === "stop" || w.action === "retreat";
    if (!isInstant && w.waypoints.length === 0) {
      setActionHint(`窗口 #${w.seq} 尚未在地图点选目标点，无法下达`);
      return;
    }
    if (isInstant) {
      const ok = await sendDirectAction(w.targetKind, w.targetId, w.action, null, (wi > 0 ? true : w.append), null, {
        move_mode: w.move_mode,
        fire_mode: w.fire_mode,
        duration_sec: w.duration_sec,
        priority_target: w.priority_target,
        follow_target: w.follow_target,
      });
      if (!ok) return;
    } else {
      for (let i = 0; i < w.waypoints.length; i++) {
        const doAppend = (wi > 0 || i > 0) ? true : w.append;
        const tgtUid = w.target_unit_ids[i] || null;
        const priTgt = (w.action === "attack" && tgtUid) ? `unit:${tgtUid}` : (w.priority_target || "any");
        const ok = await sendDirectAction(w.targetKind, w.targetId, w.action, w.waypoints[i], doAppend, tgtUid, {
          move_mode: w.move_mode,
          fire_mode: w.fire_mode,
          duration_sec: w.duration_sec,
          priority_target: priTgt,
          follow_target: w.follow_target,
        });
        if (!ok) return;
      }
    }
  }
  for (const wid of winIds) {
    MISSION_WINDOWS = MISSION_WINDOWS.filter(w => w.winId !== wid);
  }
  const tail = MISSION_WINDOWS[MISSION_WINDOWS.length - 1];
  ACTIVE_MISSION_WIN_ID = tail ? tail.winId : null;
  setActionHint(`已将 ${list.length} 组任务指令写入队列`);
  setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK && MISSION_WINDOWS.length === 0) setActionHint(""); }, 2200);
  renderMissionDraftDock();
  renderOrbatCard();
  render();
}

function renderMissionDraftDock() {
  const dock = document.getElementById("missionDraftDock");
  if (!dock) return;
  if (MISSION_WINDOWS.length === 0) {
    dock.innerHTML = "";
    return;
  }
  const activeId = ACTIVE_MISSION_WIN_ID || MISSION_WINDOWS[MISSION_WINDOWS.length - 1].winId;
  dock.innerHTML = MISSION_WINDOWS.map(w => {
    const isAct = w.winId === activeId;
    const isInstant = w.action === "stop" || w.action === "retreat";
    const etaLabel = w.estimating
      ? "物理寻路测算中..."
      : (w.etaSteps.length > 0
          ? `总耗时 ≈ ${w.totalMin.toFixed(1)} 分钟 (终达 ${w.etaSteps[w.etaSteps.length - 1].eta_str || ""})`
          : (isInstant ? "即时生效" : "点击地图加入航路点"));
    return `
      <div class="draft-float-win ${isAct ? "active" : ""}" data-mwin="${w.winId}" style="left:${w.left}px;top:${w.top}px;">
        <div class="dfw-head" data-mwin-drag="${w.winId}">
          <span><span class="dfw-badge">#${w.seq}</span> 任务指令 · ${escHtml(w.targetName)}</span>
          <div style="display:flex;align-items:center;gap:4px;">
            ${isAct ? `<span style="font-size:9.5px;background:#38bdf8;color:#082f49;padding:1px 4px;border-radius:2px;">地图激活</span>` : `<button type="button" class="ob-tq-btn" data-mwin-focus="${w.winId}">激活</button>`}
            <button type="button" class="ob-close" data-mwin-close="${w.winId}" title="关闭此窗口">×</button>
          </div>
        </div>
        <div class="dfw-body">
          <div class="dfw-row">
            <span class="dfw-lbl">动作类型</span>
            <div class="ob-pill-group">
              ${[["move","机动","blue"],["attack","🎯射击","orange"],["stop","🛑驻止","gray"],["retreat","🏃溃退",""]].map(([a, lbl, cls]) =>
                `<button type="button" class="ob-pill ${w.action === a ? `active ${cls}` : ""}" data-mwin-act="${a}" data-wid="${w.winId}">${lbl}</button>`
              ).join("")}
            </div>
          </div>
          ${w.action === "attack" ? `
            <div class="dfw-row">
              <span class="dfw-lbl">射速姿态</span>
              <div class="ob-pill-group">
                ${[
                  ["rapid", "⚡急速射·极限", "red"],
                  ["normal", "🎯正常实战", "orange"],
                  ["probing", "🔍试探冷枪", "blue"],
                  ["precision", "👁精确狙击", "purple"]
                ].map(([fm, lbl, cls]) =>
                  `<button type="button" class="ob-pill-sm ${w.fire_mode === fm ? `active ${cls}` : ""}" data-mwin-fm="${fm}" data-wid="${w.winId}">${lbl}</button>`
                ).join("")}
              </div>
            </div>
            <div class="dfw-row">
              <span class="dfw-lbl">持续时间</span>
              <div class="ob-pill-group">
                ${[
                  [16, "16s · 1步"],
                  [32, "32s · 2步"],
                  [48, "48s · 3步"],
                  [96, "96s · 6步"]
                ].map(([sec, lbl]) =>
                  `<button type="button" class="ob-pill-sm ${(w.duration_sec || 16) === sec ? "active purple" : ""}" data-mwin-dur="${sec}" data-wid="${w.winId}">${lbl}</button>`
                ).join("")}
              </div>
            </div>
            <div class="dfw-row">
              <span class="dfw-lbl">优先目标</span>
              <div class="ob-pill-group">
                ${[
                  ["any", "💥面覆盖"],
                  ["armor", "🛡优先装甲"],
                  ["infantry", "🚶优先步兵"],
                  ["heavy_weapon", "⚙优先重火"]
                ].map(([pt, lbl]) =>
                  `<button type="button" class="ob-pill-sm ${(w.priority_target || "any") === pt ? "active orange" : ""}" data-mwin-pt="${pt}" data-wid="${w.winId}">${lbl}</button>`
                ).join("")}
                ${(w.target_unit_ids.length > 0 && w.target_unit_ids[0]) ? `<span style="font-size:9.5px;color:#f59e0b;padding:2px 4px;border:1px solid #f59e0b;border-radius:2px;">锁定[${w.target_unit_ids[0]}]</span>` : ""}
              </div>
            </div>
          ` : `
            <div class="dfw-row">
              <span class="dfw-lbl">机动模式</span>
              <div class="ob-pill-group">
                ${[["normal","常规"],["fast","快反(寻路)"],["slow","渗透(隐蔽)"]].map(([m, lbl]) =>
                  `<button type="button" class="ob-pill-sm ${w.move_mode === m ? "active" : ""}" data-mwin-mm="${m}" data-wid="${w.winId}">${lbl}</button>`
                ).join("")}
              </div>
            </div>
            <div class="dfw-row">
              <span class="dfw-lbl">接敌姿态</span>
              <div class="ob-pill-group">
                ${[["stop_to_fire","遇敌停射"]].map(([f, lbl]) =>
                  `<button type="button" class="ob-pill-sm ${w.fire_mode === f ? "active purple" : ""}" data-mwin-fm="${f}" data-wid="${w.winId}">${lbl}</button>`
                ).join("")}
                <span style="font-size:9.5px;color:#78716c;margin-left:4px;" title="老旧移动射击已注销，将转为短停跃进复合预制宏">[移射已注销]</span>
              </div>
            </div>
          `}
          <div class="dfw-row" style="justify-content:flex-end;">
            <button type="button" class="dfw-btn" data-mwin-shift="${w.winId}" title="按 Shift 效果：新开下一独立草稿窗">+ 独立分段 (Shift)</button>
          </div>
          <div class="dfw-wps">
            ${w.waypoints.length === 0
              ? `<div style="color:#78716c;font-size:10.5px;">${isInstant ? "此指令无需目标坐标，点击确认即下达" : "请保持本窗口激活，直接左键点击地图添加航路点..."}</div>`
              : w.waypoints.map((wp, idx) => {
                  const st = w.etaSteps[idx];
                  const etaTxt = st ? ` · ${Number(st.duration_min || 0).toFixed(1)}分 (ETA ${st.eta_str || ""})` : "";
                  return `<div class="dfw-wp-item">
                    <span><b>#${idx + 1}</b> (${Number(wp[0]).toFixed(1)}, ${Number(wp[1]).toFixed(1)})${etaTxt}</span>
                    <button type="button" class="ob-tq-btn del" data-mwin-delwp="${idx}" data-wid="${w.winId}">✕</button>
                  </div>`;
                }).join("")}
          </div>
          <div style="font-size:10.5px;color:#0369a1;font-weight:700;">⏱ ${etaLabel}</div>
        </div>
        <div class="dfw-foot">
          <button type="button" class="dfw-btn" data-mwin-clear="${w.winId}">清空点位</button>
          <div style="display:flex;gap:5px;">
            ${MISSION_WINDOWS.length > 1 ? `<button type="button" class="dfw-btn" data-mwin-confirm-all="${w.winId}">全部下达(${MISSION_WINDOWS.length})</button>` : ""}
            <button type="button" class="dfw-btn ${w.action === "retreat" ? "danger" : "primary"}" data-mwin-confirm="${w.winId}">✓ 确认下达</button>
          </div>
        </div>
      </div>
    `;
  }).join("");

  dock.querySelectorAll(".draft-float-win").forEach(winEl => {
    const wid = winEl.getAttribute("data-mwin");
    const dragBar = winEl.querySelector(`[data-mwin-drag="${wid}"]`);
    const winObj = MISSION_WINDOWS.find(x => x.winId === wid);
    makeWinDraggable(winEl, dragBar, () => {
      if (ACTIVE_MISSION_WIN_ID !== wid) focusMissionWindow(wid);
    });
    if (dragBar && winObj) {
      dragBar.addEventListener("mouseup", () => {
        const r = winEl.getBoundingClientRect();
        winObj.left = r.left;
        winObj.top = r.top;
      });
    }
  });
  dock.querySelectorAll("[data-mwin-close]").forEach(btn => btn.onclick = e => { e.stopPropagation(); closeMissionWindow(btn.getAttribute("data-mwin-close")); });
  dock.querySelectorAll("[data-mwin-focus]").forEach(btn => btn.onclick = e => { e.stopPropagation(); focusMissionWindow(btn.getAttribute("data-mwin-focus")); });
  dock.querySelectorAll("[data-mwin-act]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) {
      w.action = btn.getAttribute("data-mwin-act");
      if (w.action === "attack" && (w.fire_mode === "stop_to_fire" || w.fire_mode === "fire_on_the_move")) {
        w.fire_mode = "normal";
      }
      estimateMissionWindow(w);
      render();
    }
  });
  dock.querySelectorAll("[data-mwin-mm]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) { w.move_mode = btn.getAttribute("data-mwin-mm"); estimateMissionWindow(w); render(); }
  });
  dock.querySelectorAll("[data-mwin-fm]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) { w.fire_mode = btn.getAttribute("data-mwin-fm"); estimateMissionWindow(w); render(); }
  });
  dock.querySelectorAll("[data-mwin-dur]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) { w.duration_sec = Number(btn.getAttribute("data-mwin-dur")); renderMissionDraftDock(); }
  });
  dock.querySelectorAll("[data-mwin-pt]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) { w.priority_target = btn.getAttribute("data-mwin-pt"); renderMissionDraftDock(); }
  });
  dock.querySelectorAll("[data-mwin-follow]").forEach(chk => chk.onchange = () => {
    const w = MISSION_WINDOWS.find(x => x.winId === chk.getAttribute("data-mwin-follow"));
    if (w) w.follow_target = chk.checked;
  });
  dock.querySelectorAll("[data-mwin-append]").forEach(chk => chk.onchange = () => {
    const w = MISSION_WINDOWS.find(x => x.winId === chk.getAttribute("data-mwin-append"));
    if (w) { w.append = chk.checked; estimateMissionWindow(w); }
  });
  dock.querySelectorAll("[data-mwin-shift]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    focusMissionWindow(btn.getAttribute("data-mwin-shift"));
    shiftToNextMissionWindow();
  });
  dock.querySelectorAll("[data-mwin-delwp]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    const idx = Number(btn.getAttribute("data-mwin-delwp"));
    if (w) { w.waypoints.splice(idx, 1); w.target_unit_ids.splice(idx, 1); estimateMissionWindow(w); render(); }
  });
  dock.querySelectorAll("[data-mwin-clear]").forEach(btn => btn.onclick = e => {
    e.stopPropagation();
    const w = MISSION_WINDOWS.find(x => x.winId === btn.getAttribute("data-mwin-clear"));
    if (w) { w.waypoints = []; w.target_unit_ids = []; w.etaSteps = []; w.totalMin = 0; renderMissionDraftDock(); render(); }
  });
  dock.querySelectorAll("[data-mwin-confirm]").forEach(btn => btn.onclick = async e => {
    e.stopPropagation();
    await confirmMissionWindows([btn.getAttribute("data-mwin-confirm")]);
  });
  dock.querySelectorAll("[data-mwin-confirm-all]").forEach(btn => btn.onclick = async e => {
    e.stopPropagation();
    await confirmMissionWindows(MISSION_WINDOWS.map(w => w.winId));
  });
}

// ---------- 3. Independent Multi-Window Event Drafting ----------
function getActiveEventWindow() {
  return EVENT_WINDOWS.find(w => w.winId === ACTIVE_EVENT_WIN_ID) || EVENT_WINDOWS[EVENT_WINDOWS.length - 1] || null;
}

function openEventWindow(targetKind, targetId, opts = {}) {
  const ent = resolveTargetEntity(targetKind, targetId);
  if (!ent) return null;
  const seq = EVENT_WIN_SEQ++;
  const winId = `ewin-${seq}-${Date.now()}`;
  const isEng = entityHasEngineerCap(ent);
  const peers = (STATE.own_pieces || []).filter(op => op.id !== ent.pieceId && Number(op.persons || 0) > 0);
  const defCat = opts.category || (isEng ? "engineering" : (ent.canOperateRadio ? "radio" : "supply"));
  const defOp = opts.eng_op || (defCat === "engineering" ? (isEng ? "dig_trench" : "fortify") : (defCat === "radio" ? "set_radio" : "cargo_transfer"));
  const draft = {
    winId,
    seq,
    targetKind,
    targetId,
    pieceId: ent.pieceId,
    targetName: ent.name,
    category: defCat,
    eng_op: defOp,
    demolition_type: opts.demolition_type || "bridge",
    target_px: opts.target_px ? [...opts.target_px] : [Math.round(ent.pos[0]), Math.round(ent.pos[1])],
    in_place: opts.in_place !== undefined ? Boolean(opts.in_place) : true,
    picking_map: false,
    radio_channel: ent.radioChannel || "A",
    radio_silence: ent.radioSilence,
    cargo_target_id: (peers[0] && peers[0].id) || "",
    cargo_ammo_t: 0.05,
    cargo_food_t: 0.0,
    left: Math.min(window.innerWidth - 340, 680 + ((EVENT_WINDOWS.length % 4) * 26)),
    top: Math.min(window.innerHeight - 380, 68 + ((EVENT_WINDOWS.length % 4) * 26)),
  };
  EVENT_WINDOWS.push(draft);
  ACTIVE_EVENT_WIN_ID = winId;
  renderEventDraftDock();
  render();
  return draft;
}

function shiftToNextEventWindow() {
  const cur = getActiveEventWindow();
  if (!cur) return false;
  openEventWindow(cur.targetKind, cur.targetId, { category: cur.category, eng_op: cur.eng_op });
  return true;
}

function closeEventWindow(winId) {
  EVENT_WINDOWS = EVENT_WINDOWS.filter(w => w.winId !== winId);
  if (ACTIVE_EVENT_WIN_ID === winId) {
    const tail = EVENT_WINDOWS[EVENT_WINDOWS.length - 1];
    ACTIVE_EVENT_WIN_ID = tail ? tail.winId : null;
  }
  renderEventDraftDock();
  render();
}

async function submitEventWindow(winId) {
  const w = EVENT_WINDOWS.find(x => x.winId === winId);
  if (!w) return;
  const ent = resolveTargetEntity(w.targetKind, w.targetId);
  if (!ent || !ent.pieceId) {
    setActionHint("当前单位缺少实体兵牌，无法发起事件");
    return;
  }
  const tgtPx = w.in_place ? [Math.round(ent.pos[0]), Math.round(ent.pos[1])] : w.target_px;
  let ok = false;
  if (w.category === "engineering") {
    if (w.eng_op === "demolition") {
      ok = await sendEventOp("demolition", ent.pieceId, tgtPx, { target_type: w.demolition_type || "bridge" });
    } else if (w.eng_op === "fortify") {
      ok = await sendEventOp("fortify", ent.pieceId, tgtPx, {});
    } else {
      ok = await sendEventOp("engineering", ent.pieceId, tgtPx, { eng_op: w.eng_op });
    }
  } else if (w.category === "radio") {
    if (w.eng_op === "lay_wire") {
      ok = await sendEventOp("lay_wire", ent.pieceId, tgtPx, {});
    } else if (w.eng_op === "radio_decoy") {
      ok = await sendEventOp("radio_decoy", ent.pieceId, tgtPx, {});
    } else {
      ok = await sendEventOp("set_radio", ent.pieceId, null, {
        entity_id: w.targetId,
        radio_channel: w.radio_channel,
        radio_silence: w.radio_silence,
      });
    }
  } else if (w.category === "supply") {
    if (w.eng_op === "resupply_pickup") {
      ok = await sendEventOp("resupply_pickup", ent.pieceId, tgtPx, {});
    } else if (w.cargo_target_id) {
      ok = await sendEventOp("cargo_transfer", ent.pieceId, tgtPx, {
        target_piece_id: w.cargo_target_id,
        ammo_t: Number(w.cargo_ammo_t || 0),
        food_t: Number(w.cargo_food_t || 0),
      });
    }
  }
  if (ok) {
    closeEventWindow(winId);
    renderOrbatCard();
  }
}

function renderEventDraftDock() {
  const dock = document.getElementById("eventDraftDock");
  if (!dock) return;
  if (EVENT_WINDOWS.length === 0) {
    dock.innerHTML = "";
    return;
  }
  const activeId = ACTIVE_EVENT_WIN_ID || EVENT_WINDOWS[EVENT_WINDOWS.length - 1].winId;
  dock.innerHTML = EVENT_WINDOWS.map(w => {
    const ent = resolveTargetEntity(w.targetKind, w.targetId);
    if (!ent) return "";
    const isAct = w.winId === activeId;
    const isEng = entityHasEngineerCap(ent);
    const hasRadio = ent.canOperateRadio;
    const peers = (STATE.own_pieces || []).filter(op => op.id !== ent.pieceId && Number(op.persons || 0) > 0);
    return `
      <div class="draft-float-win ${isAct ? "active" : ""}" data-ewin="${w.winId}" style="left:${w.left}px;top:${w.top}px;">
        <div class="dfw-head" data-ewin-drag="${w.winId}">
          <span><span class="dfw-badge">事件 #${w.seq}</span> ${escHtml(ent.name)}</span>
          <div style="display:flex;gap:4px;align-items:center;">
            <button type="button" class="ob-tq-btn" data-ewin-shift="${w.winId}" title="新开独立事件窗">+窗口</button>
            <button type="button" class="ob-close" data-ewin-close="${w.winId}">×</button>
          </div>
        </div>
        <div class="dfw-body">
          <div class="dfw-row">
            <span class="dfw-lbl">分类</span>
            <div class="ob-pill-group">
              <button type="button" class="ob-pill ${w.category === "engineering" ? "active blue" : ""}" data-ewin-cat="engineering" data-wid="${w.winId}">工程/爆破</button>
              <button type="button" class="ob-pill ${w.category === "radio" ? "active orange" : ""}" data-ewin-cat="radio" data-wid="${w.winId}">通联/电台</button>
              <button type="button" class="ob-pill ${w.category === "supply" ? "active" : ""}" data-ewin-cat="supply" data-wid="${w.winId}">补给/交接</button>
            </div>
          </div>
          ${w.category === "engineering" ? `
            ${!isEng ? `<div class="ob-panel-note warn">🔒 非工兵资质（缺少工兵连/爆破筒/探雷器）：高阶工程已禁用，仅可简易掘壕掩体</div>` : `<div class="ob-panel-note nco">✓ 具备工兵资质与工程装备，可执行爆破、布雷、排雷与架桥</div>`}
            <div class="dfw-row" style="gap:4px;">
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "fortify" ? "active" : ""}" data-ewin-op="fortify" data-wid="${w.winId}">🛡 简易掩体</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "dig_trench" ? "active" : ""}" data-ewin-op="dig_trench" data-wid="${w.winId}" ${isEng ? "" : "disabled"}>⛏ 构筑战壕</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "lay_mines" ? "active" : ""}" data-ewin-op="lay_mines" data-wid="${w.winId}" ${isEng ? "" : "disabled"}>💣 布设雷区</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "clear_mines" ? "active" : ""}" data-ewin-op="clear_mines" data-wid="${w.winId}" ${isEng ? "" : "disabled"}>🧹 排雷清障</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "build_bridge" ? "active" : ""}" data-ewin-op="build_bridge" data-wid="${w.winId}" ${isEng ? "" : "disabled"}>🌉 架设桥梁</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "repair_terrain" ? "active" : ""}" data-ewin-op="repair_terrain" data-wid="${w.winId}" ${isEng ? "" : "disabled"}>🛣 修复路桥</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "demolition" ? "active" : ""}" data-ewin-op="demolition" data-wid="${w.winId}" style="color:#991b1b;" ${isEng ? "" : "disabled"}>💥 定点爆破</button>
            </div>
            ${w.eng_op === "demolition" ? `
              <div class="dfw-row">
                <span class="dfw-lbl">爆破目标</span>
                <select data-ewin-demo-type="${w.winId}">
                  <option value="bridge" ${w.demolition_type === "bridge" ? "selected" : ""}>桥梁/路桥设施</option>
                  <option value="fortification" ${w.demolition_type === "fortification" ? "selected" : ""}>永久工事/堡垒</option>
                </select>
              </div>
            ` : ""}
          ` : ""}
          ${w.category === "radio" ? `
            ${!hasRadio ? `<div class="ob-panel-note warn">🔒 缺少无线电台或士官/军官操作手：电台假饵与换频已禁用</div>` : ""}
            <div class="dfw-row">
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "set_radio" ? "active" : ""}" data-ewin-op="set_radio" data-wid="${w.winId}" ${hasRadio ? "" : "disabled"}>📻 换频/静默</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "radio_decoy" ? "active" : ""}" data-ewin-op="radio_decoy" data-wid="${w.winId}" ${hasRadio ? "" : "disabled"}>📡 假电台诱饵</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "lay_wire" ? "active" : ""}" data-ewin-op="lay_wire" data-wid="${w.winId}">☎ 铺设电话线</button>
            </div>
            <div class="dfw-row">
              <label style="display:inline-flex;align-items:center;gap:4px;"><input type="checkbox" data-ewin-sil="${w.winId}" ${w.radio_silence ? "checked" : ""} ${hasRadio ? "" : "disabled"} /> 无线电静默</label>
              <span style="margin-left:auto;">频道:
                <select data-ewin-chan="${w.winId}" ${hasRadio ? "" : "disabled"}>
                  ${["A","B","C","D","E","F","G"].map(ch => `<option value="${ch}" ${w.radio_channel === ch ? "selected" : ""}>${ch}频</option>`).join("")}
                </select>
              </span>
            </div>
            ${ent.isHQ ? `<div class="ob-panel-note">参谋议会状态: ${ent.cmd?.war_council_active ? "生效中" : "双指挥部邻近待机自动同步"} · 改令疲劳=${Number(ent.cmd?.order_churn_score || 0).toFixed(2)}</div>` : ""}
          ` : ""}
          ${w.category === "supply" ? `
            <div class="dfw-row">
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "cargo_transfer" ? "active" : ""}" data-ewin-op="cargo_transfer" data-wid="${w.winId}" ${peers.length ? "" : "disabled"}>📦 友军物资交接</button>
              <button type="button" class="ob-sub-menu-btn ${w.eng_op === "resupply_pickup" ? "active" : ""}" data-ewin-op="resupply_pickup" data-wid="${w.winId}">🛢 就近堆场补给</button>
            </div>
            ${w.eng_op === "cargo_transfer" ? `
              <div class="dfw-row">
                <select data-ewin-cargo-tgt="${w.winId}" style="flex:1;">
                  ${peers.length === 0 ? `<option value="">无友军单位</option>` : peers.map(op => `<option value="${op.id}" ${w.cargo_target_id === op.id ? "selected" : ""}>${escHtml(op.name)}</option>`).join("")}
                </select>
                <span>弹药t:</span><input type="number" step="0.02" min="0" value="${w.cargo_ammo_t}" data-ewin-ammo="${w.winId}" style="width:52px;" />
              </div>
            ` : ""}
          ` : ""}
          <div class="dfw-row" style="border-top:1px dashed #d6d3cd;padding-top:5px;">
            <label style="display:inline-flex;align-items:center;gap:4px;cursor:pointer;">
              <input type="checkbox" data-ewin-inplace="${w.winId}" ${w.in_place ? "checked" : ""} /> 原地格 (${Math.round(ent.pos[0])}, ${Math.round(ent.pos[1])})
            </label>
            ${!w.in_place ? `
              <span style="font-family:Consolas,monospace;font-size:10.5px;">目标:(${w.target_px[0]},${w.target_px[1]})</span>
              <button type="button" class="dfw-btn ${w.picking_map ? "primary" : ""}" data-ewin-pick="${w.winId}">${w.picking_map ? "点击地图选格中..." : "📍 地图点选"}</button>
            ` : ""}
          </div>
        </div>
        <div class="dfw-foot">
          <span style="font-size:10px;color:#78716c;">事件窗口独立队列</span>
          <button type="button" class="dfw-btn primary" data-ewin-submit="${w.winId}">✓ 确认发起</button>
        </div>
      </div>
    `;
  }).join("");

  dock.querySelectorAll(".draft-float-win").forEach(winEl => {
    const wid = winEl.getAttribute("data-ewin");
    const dragBar = winEl.querySelector(`[data-ewin-drag="${wid}"]`);
    const winObj = EVENT_WINDOWS.find(x => x.winId === wid);
    makeWinDraggable(winEl, dragBar, () => {
      if (ACTIVE_EVENT_WIN_ID !== wid) {
        ACTIVE_EVENT_WIN_ID = wid;
        dock.querySelectorAll(".draft-float-win").forEach(el => el.classList.toggle("active", el.getAttribute("data-ewin") === wid));
      }
    });
    if (dragBar && winObj) {
      dragBar.addEventListener("mouseup", () => {
        const r = winEl.getBoundingClientRect();
        winObj.left = r.left; winObj.top = r.top;
      });
    }
  });
  dock.querySelectorAll("[data-ewin-close]").forEach(btn => btn.onclick = e => { e.stopPropagation(); closeEventWindow(btn.getAttribute("data-ewin-close")); });
  dock.querySelectorAll("[data-ewin-shift]").forEach(btn => btn.onclick = e => { e.stopPropagation(); ACTIVE_EVENT_WIN_ID = btn.getAttribute("data-ewin-shift"); shiftToNextEventWindow(); });
  dock.querySelectorAll("[data-ewin-cat]").forEach(btn => btn.onclick = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (!w) return;
    w.category = btn.getAttribute("data-ewin-cat");
    if (w.category === "engineering") w.eng_op = entityHasEngineerCap(resolveTargetEntity(w.targetKind, w.targetId)) ? "dig_trench" : "fortify";
    else if (w.category === "radio") w.eng_op = "set_radio";
    else w.eng_op = "cargo_transfer";
    renderEventDraftDock();
  });
  dock.querySelectorAll("[data-ewin-op]").forEach(btn => btn.onclick = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === btn.getAttribute("data-wid"));
    if (w) { w.eng_op = btn.getAttribute("data-ewin-op"); renderEventDraftDock(); }
  });
  dock.querySelectorAll("[data-ewin-demo-type]").forEach(sel => sel.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === sel.getAttribute("data-ewin-demo-type"));
    if (w) w.demolition_type = sel.value;
  });
  dock.querySelectorAll("[data-ewin-sil]").forEach(chk => chk.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === chk.getAttribute("data-ewin-sil"));
    if (w) w.radio_silence = chk.checked;
  });
  dock.querySelectorAll("[data-ewin-chan]").forEach(sel => sel.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === sel.getAttribute("data-ewin-chan"));
    if (w) w.radio_channel = sel.value;
  });
  dock.querySelectorAll("[data-ewin-cargo-tgt]").forEach(sel => sel.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === sel.getAttribute("data-ewin-cargo-tgt"));
    if (w) w.cargo_target_id = sel.value;
  });
  dock.querySelectorAll("[data-ewin-ammo]").forEach(inp => inp.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === inp.getAttribute("data-ewin-ammo"));
    if (w) w.cargo_ammo_t = Number(inp.value || 0);
  });
  dock.querySelectorAll("[data-ewin-inplace]").forEach(chk => chk.onchange = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === chk.getAttribute("data-ewin-inplace"));
    if (w) { w.in_place = chk.checked; w.picking_map = !chk.checked; renderEventDraftDock(); }
  });
  dock.querySelectorAll("[data-ewin-pick]").forEach(btn => btn.onclick = () => {
    const w = EVENT_WINDOWS.find(x => x.winId === btn.getAttribute("data-ewin-pick"));
    if (w) { ACTIVE_EVENT_WIN_ID = w.winId; w.picking_map = !w.picking_map; setActionHint(w.picking_map ? "请点击地图选择事件目标像素格" : ""); renderEventDraftDock(); }
  });
  dock.querySelectorAll("[data-ewin-submit]").forEach(btn => btn.onclick = async () => await submitEventWindow(btn.getAttribute("data-ewin-submit")));
}

function getUnitSoldierList(unitOrCmd) {
  if (!unitOrCmd) return [];
  if (Array.isArray(unitOrCmd.soldiers) && unitOrCmd.soldiers.length > 0) {
    return unitOrCmd.soldiers;
  }
  if (Array.isArray(unitOrCmd.hq_soldiers) && unitOrCmd.hq_soldiers.length > 0) {
    return unitOrCmd.hq_soldiers;
  }
  const tot = Number(unitOrCmd.persons || 0);
  const nco = Number(unitOrCmd.nco || 0);
  const off = Number(unitOrCmd.officer || 0);
  const list = [];
  const uid = unitOrCmd.id || "u";
  for (let i = 0; i < tot; i++) {
    const isOff = i < off;
    const isNco = !isOff && i < (off + nco);
    list.push({
      id: `${uid}-s${i + 1}`,
      name: isOff ? `军官 #${i + 1}` : (isNco ? `班长/士官 #${i + 1 - off}` : `列兵 #${i + 1 - off - nco}`),
      rank: isOff ? "少尉" : (isNco ? "下士" : "列兵"),
      role: isOff ? "officer" : (isNco ? "nco" : "enlisted"),
      weapon: isOff ? "pistol" : (isNco ? "smg" : "rifle"),
      hp: 100,
      status: "healthy",
      is_cadre: isOff || isNco,
      is_leader: i === 0,
    });
  }
  return list;
}

function formatSoldierRank(s) {
  if (!s) return "列兵";
  if (s.rank) return s.rank;
  if (s.is_cadre || s.role === "officer") return "军官";
  if (s.role === "nco" || s.is_leader) return "班长/士官";
  return "列兵";
}

function checkEchelonGate(cmd, targetEchelon) {
  let highestHQRank = 4;
  let highestHQName = "排指挥部";
  if (cmd) {
    const r = ECHELON_RANKS[(cmd.echelon || "").toLowerCase()] || 4;
    highestHQRank = r;
    highestHQName = normalizeHQName(cmd);
  } else if (STATE && Array.isArray(STATE.commanders) && STATE.commanders.length > 0) {
    let maxR = 0;
    let maxC = null;
    for (const c of STATE.commanders) {
      const cr = ECHELON_RANKS[(c.echelon || "").toLowerCase()] || 4;
      if (cr > maxR) { maxR = cr; maxC = c; }
    }
    if (maxC) {
      highestHQRank = maxR;
      highestHQName = normalizeHQName(maxC);
    }
  }

  const maxAllowedRank = highestHQRank - 1;
  const targetRank = ECHELON_RANKS[(targetEchelon || "").toLowerCase()] || 2;
  const maxAllowedName = ECHELON_NAMES[maxAllowedRank] || "排级";

  if (targetRank > maxAllowedRank) {
    return {
      ok: false,
      highestHQName,
      maxAllowedName: maxAllowedName.replace(/[(（].*?[)）]/g, "").trim(),
      reason: `越级：当前编制树最高为[${highestHQName}]，仅能创建${maxAllowedName.replace(/[(（].*?[)）]/g, "").trim()}及以下编制`
    };
  }
  return { ok: true, highestHQRank, highestHQName, maxAllowedRank, maxAllowedName };
}

function checkSquadMergeRules(leftUnit, rightUnit) {
  if (!leftUnit || !rightUnit) return { ok: false, reason: "请选择待归建合并的分队" };
  const p1 = leftUnit.pos || leftUnit.px || [0, 0];
  const p2 = rightUnit.pos || rightUnit.px || [0, 0];
  const dist = Math.hypot((p1[0] ?? 0) - (p2[0] ?? 0), (p1[1] ?? 0) - (p2[1] ?? 0));
  if (dist > 1.25) {
    return { ok: false, reason: "两分队相距过远 (不在同一像素格，欧氏距离 > 1.25)" };
  }

  const hasAliveLeader = (u) => {
    if (Number(u.cadre || 0) > 0) return true;
    const sols = getUnitSoldierList(u);
    return sols.some(s => (s.is_cadre || s.role === "nco" || s.role === "officer" || s.is_leader) && s.status !== "dead" && (s.hp === undefined || s.hp > 0));
  };

  const leaderAlive = hasAliveLeader(leftUnit) || hasAliveLeader(rightUnit);
  if (!leaderAlive) {
    return {
      ok: false,
      reason: "原班长不在场或已阵亡，战斗小组保持独立实体，禁止合并归建"
    };
  }
  return { ok: true };
}

// ---------- 4. Standalone Split & Reorganize Modal ----------
function closeReorgSplitWin() {
  REORG_WIN_STATE.open = false;
  const el = document.getElementById("reorgSplitWin");
  if (el) el.classList.remove("open");
}

function openReorgSplitWin(targetKind, targetId) {
  const ent = resolveTargetEntity(targetKind, targetId);
  if (!ent) return;
  REORG_WIN_STATE.open = true;
  REORG_WIN_STATE.targetKind = targetKind;
  REORG_WIN_STATE.targetId = targetId;
  REORG_WIN_STATE.leftUnitId = ent.pieceId || (ent.cmd && ent.cmd.subordinate_ids && ent.cmd.subordinate_ids[0]) || ent.targetId;
  REORG_WIN_STATE.leftSoldierIds = new Set();
  REORG_WIN_STATE.rightSoldierIds = new Set();
  REORG_WIN_STATE.nominalContainer = "infantry";
  REORG_WIN_STATE.lockCounterName = false;
  REORG_WIN_STATE.newCustomName = `${ent.name} · 尖兵组`;
  REORG_WIN_STATE.targetEchelon = "team";

  const pos = ent.pos || [0, 0];
  const allOwn = (STATE && STATE.own_pieces || []).filter(op => op.id !== REORG_WIN_STATE.leftUnitId && op.alive !== false);
  allOwn.sort((a, b) => {
    const da = Math.hypot((a.pos?.[0] ?? 0) - pos[0], (a.pos?.[1] ?? 0) - pos[1]);
    const db = Math.hypot((b.pos?.[0] ?? 0) - pos[0], (b.pos?.[1] ?? 0) - pos[1]);
    return da - db;
  });
  REORG_WIN_STATE.rightUnitId = allOwn[0] ? allOwn[0].id : null;
  REORG_WIN_STATE.mergeIds = new Set([REORG_WIN_STATE.leftUnitId]);
  REORG_WIN_STATE.reorgIds = new Set([REORG_WIN_STATE.leftUnitId]);
  renderReorgSplitWin();
}

function renderReorgSplitWin() {
  const win = document.getElementById("reorgSplitWin");
  const body = document.getElementById("reorgBody");
  if (!win || !body || !REORG_WIN_STATE.open) return;
  const ent = resolveTargetEntity(REORG_WIN_STATE.targetKind, REORG_WIN_STATE.targetId);
  if (!ent) { closeReorgSplitWin(); return; }

  const leftPid = REORG_WIN_STATE.leftUnitId || ent.pieceId || ent.targetId;
  const leftPiece = (STATE.own_pieces || []).find(op => op.id === leftPid) || ent.piece || (ent.cmd ? { id: ent.cmd.id, name: ent.cmd.name, level: ent.cmd.echelon || "platoon", persons: ent.cmd.persons, soldiers: ent.cmd.hq_soldiers || [] } : null);
  const leftCmd = (STATE.commanders || []).find(c => c.id === leftPid || (c.subordinate_ids || []).includes(leftPid) || (c.hq_piece_id === leftPid)) || ent.cmd || (STATE.commanders || [])[0];

  const allOwn = (STATE.own_pieces || []).filter(op => op.id !== leftPid && op.alive !== false);
  const leftPos = leftPiece?.pos || leftPiece?.px || ent.pos || [0, 0];
  allOwn.sort((a, b) => {
    const da = Math.hypot((a.pos?.[0] ?? 0) - leftPos[0], (a.pos?.[1] ?? 0) - leftPos[1]);
    const db = Math.hypot((b.pos?.[0] ?? 0) - leftPos[0], (b.pos?.[1] ?? 0) - leftPos[1]);
    return da - db;
  });
  if ((!REORG_WIN_STATE.rightUnitId || REORG_WIN_STATE.rightUnitId === leftPid) && allOwn.length > 0) {
    REORG_WIN_STATE.rightUnitId = allOwn[0].id;
  }
  const rightPiece = (STATE.own_pieces || []).find(op => op.id === REORG_WIN_STATE.rightUnitId) || allOwn[0] || null;

  // 构建所属指挥架构编制树 (ORBAT Hierarchy Tree)
  const treeNodes = [];
  if (leftCmd) {
    const hqPiece = (STATE.own_pieces || []).find(op => op.id === leftCmd.hq_piece_id || (op.is_hq_piece && op.direct_commander_id === leftCmd.id));
    const hqPCount = hqPiece ? hqPiece.persons : (leftCmd.persons || 3);
    treeNodes.push({
      id: hqPiece ? hqPiece.id : leftCmd.id,
      name: leftCmd.name || "排指挥部",
      levelName: "排部指挥组",
      icon: "📁",
      persons: hqPCount,
      isHQ: true,
    });
    for (const subId of (leftCmd.subordinate_ids || [])) {
      const sp = (STATE.own_pieces || []).find(op => op.id === subId && op.alive !== false);
      if (!sp) continue;
      treeNodes.push({
        id: sp.id,
        name: sp.name,
        levelName: sp.level === "team" ? "战斗组" : "步兵班",
        icon: sp.level === "team" ? "🚩" : "🪖",
        persons: sp.persons,
        isHQ: false,
      });
    }
  }
  for (const op of (STATE.own_pieces || [])) {
    if (op.alive === false || treeNodes.some(nd => nd.id === op.id)) continue;
    treeNodes.push({
      id: op.id,
      name: op.name,
      levelName: op.is_hq_piece ? "指挥组" : (op.level === "team" ? "战斗组" : "步兵班"),
      icon: op.is_hq_piece ? "📁" : (op.level === "team" ? "🚩" : "🪖"),
      persons: op.persons,
      isHQ: Boolean(op.is_hq_piece),
    });
  }

  const leftSoldiers = getUnitSoldierList(leftPiece);
  const rightSoldiers = getUnitSoldierList(rightPiece);

  document.getElementById("reorgTitle").textContent = `🪖 编制管理 (ORBAT) · ${ent.name}`;

  body.innerHTML = `
    <!-- 顶部：所属作战编制序列树 (ORBAT Tree) 交互导航 -->
    <div class="orbat-tree-nav">
      <div style="font-size:11px;font-weight:800;color:#38bdf8;display:flex;align-items:center;gap:6px;">
        <span>🌲 作战编制序列树 (ORBAT Hierarchy Tree)</span>
        <span style="font-size:10px;color:#a1a1aa;font-weight:normal;">[点击编制节点直接切换管理]</span>
      </div>
      <div class="orbat-tree-row">
        ${treeNodes.map(nd => {
          const isAct = nd.id === leftPid;
          return `
            <button type="button" class="orbat-tree-pill ${isAct ? 'active' : ''}" data-orbat-pick-unit="${nd.id}" title="点击切换至管理该编制">
              <span>${nd.icon}</span>
              <span><b>${escHtml(nd.name)}</b></span>
              <span style="color:${isAct ? '#ffffff' : '#94a3b8'};font-size:10px;">(${nd.levelName} · ${nd.persons}人)</span>
              ${isAct ? `<span style="background:#0284c7;color:#fff;padding:0 4px;border-radius:2px;font-size:9.5px;">当前</span>` : ''}
            </button>
          `;
        }).join("")}
      </div>
    </div>

    <div class="orbat-dual-wrap">
      <!-- 左栏：选中单位完整编制树与拆组 -->
      <div class="orbat-pane">
        <div class="orbat-pane-head">
          <div>
            <span style="font-weight:800;color:#38bdf8;">[左栏·当前编制] ${escHtml(leftPiece?.name || ent.name)}</span>
            <span style="color:#a1a1aa;font-size:10.5px;">(${leftSoldiers.length}人 · ${leftPiece?.level || "squad"})</span>
          </div>
          <button type="button" class="ob-tq-btn" id="orbatLeftSelectAll">全选/反选</button>
        </div>
        <div class="orbat-tree-list" id="orbatLeftTree">
          ${leftSoldiers.length === 0 ? `<div style="color:#71717a;padding:8px;">暂无存活单兵数据</div>` : leftSoldiers.map(s => {
            const chk = REORG_WIN_STATE.leftSoldierIds.has(s.id) ? "checked" : "";
            const rank = formatSoldierRank(s);
            const wpn = weaponCnName(s.weapon || "rifle");
            const hp = Math.round(s.hp || 100);
            return `
              <div class="orbat-sol-item">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;flex:1;">
                  <input type="checkbox" data-lsol-id="${s.id}" ${chk} />
                  <span style="font-weight:700;color:${s.is_cadre ? '#f59e0b' : '#e4e4e7'};">[${rank}] ${escHtml(s.name)}</span>
                  <span style="color:#a1a1aa;">🔫${wpn}</span>
                </label>
                <span style="font-family:Consolas,monospace;font-size:10px;color:${hp > 50 ? '#4ade80' : '#f87171'};">${hp}%</span>
              </div>
            `;
          }).join("")}
        </div>

        <!-- 直观拆分独立战斗组 (Trupp) -->
        <div class="orbat-trupp-bar">
          <div style="font-weight:700;color:#fbbf24;font-size:11px;display:flex;justify-content:space-between;align-items:center;">
            <span>✂ 拆分为独立战斗组 (Trupp / 尖兵组)</span>
            <span style="font-size:10px;color:#a1a1aa;">勾选单兵，裂变为独立兵牌 ○</span>
          </div>
          <div style="display:flex;gap:4px;flex-wrap:wrap;">
            ${[
              ["infantry", "🚶步兵组"],
              ["scout", "⚡尖兵组"],
              ["heavy_weapon", "🎯机枪组"],
              ["recon", "🔍侦察组"],
              ["engineer", "🔨工兵组"],
              ["medic", "🚑医疗组"],
            ].map(([cid, clbl]) => `
              <button type="button" class="ob-pill-sm ${REORG_WIN_STATE.nominalContainer === cid ? 'active blue' : ''}" data-nom-type="${cid}">${clbl}</button>
            `).join("")}
          </div>
          <div style="display:flex;gap:6px;align-items:center;">
            <input type="text" id="obNewSplitName" value="${escHtml(REORG_WIN_STATE.newCustomName || (leftPiece?.name + ' · 战斗组'))}" style="flex:1;background:#18181b;color:#f4f4f5;border:1px solid #3f3f46;border-radius:3px;padding:3px 6px;font-size:11px;" placeholder="新战斗组名称" />
            <button type="button" class="dfw-btn primary" id="btnOrbatSplit" ${leftSoldiers.length <= 1 || REORG_WIN_STATE.leftSoldierIds.size === 0 ? "disabled" : ""}>
              ✂ 确认拆出组 (已选${REORG_WIN_STATE.leftSoldierIds.size}人)
            </button>
          </div>
        </div>
      </div>

      <!-- 右栏：同格/临近友军与归建合并 -->
      <div class="orbat-pane">
        <div class="orbat-pane-head">
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="font-weight:800;color:#f59e0b;">[右栏·友军]</span>
            <select id="orbatRightUnitSel" style="max-width:210px;background:#18181b;color:#f4f4f5;border:1px solid #3f3f46;font-size:11px;padding:2px 4px;border-radius:3px;">
              ${allOwn.map(op => {
                const d = Math.hypot((op.pos?.[0] ?? 0) - leftPos[0], (op.pos?.[1] ?? 0) - leftPos[1]);
                const cellM = STATE.grid?.cell_m || 8.0;
                const dM = Math.round(d * cellM);
                const tag = d <= 1.25 ? "同格" : `${dM}m`;
                const lvl = op.is_hq_piece ? "排部" : (op.level === "team" ? "组" : "班");
                return `<option value="${op.id}" ${op.id === rightPiece?.id ? "selected" : ""}>[${lvl}] ${escHtml(op.name)} (${tag} · ${op.persons}人)</option>`;
              }).join("")}
            </select>
          </div>
          <button type="button" class="ob-tq-btn" id="orbatRightSelectAll">全选/反选</button>
        </div>
        <div class="orbat-tree-list" id="orbatRightTree">
          ${rightSoldiers.length === 0 ? `<div style="color:#71717a;padding:8px;">暂无存活单兵数据</div>` : rightSoldiers.map(s => {
            const chk = REORG_WIN_STATE.rightSoldierIds.has(s.id) ? "checked" : "";
            const rank = formatSoldierRank(s);
            const wpn = weaponCnName(s.weapon || "rifle");
            const hp = Math.round(s.hp || 100);
            return `
              <div class="orbat-sol-item">
                <label style="display:flex;align-items:center;gap:6px;cursor:pointer;flex:1;">
                  <input type="checkbox" data-rsol-id="${s.id}" ${chk} />
                  <span style="font-weight:700;color:${s.is_cadre ? '#f59e0b' : '#e4e4e7'};">[${rank}] ${escHtml(s.name)}</span>
                  <span style="color:#a1a1aa;">🔫${wpn}</span>
                </label>
                <span style="font-family:Consolas,monospace;font-size:10px;color:${hp > 50 ? '#4ade80' : '#f87171'};">${hp}%</span>
              </div>
            `;
          }).join("")}
        </div>

        <!-- 归建合并操作 -->
        <div style="background:#27272a;border:1px solid #3f3f46;border-radius:3px;padding:6px 8px;margin-top:auto;display:flex;flex-direction:column;gap:5px;">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-weight:700;color:#fbbf24;font-size:11px;">🪖 归建合并 (Merge Back)</span>
            <span style="font-size:10px;color:#a1a1aa;">临时组无损收拢回归母班</span>
          </div>
          <div style="font-size:10.5px;color:#d4d4d8;">
            左侧: ${escHtml(leftPiece?.name || "")} (${leftSoldiers.length}人) ⟷ 右侧: ${escHtml(rightPiece?.name || "")} (${rightSoldiers.length}人)
          </div>
          <div style="display:flex;justify-content:flex-end;">
            <button type="button" class="dfw-btn primary" id="btnOrbatMerge" ${!rightPiece || leftSoldiers.length + rightSoldiers.length > 15 ? "disabled" : ""}>
              🪖 将右侧分队并入当前编制 (合并归建)
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 中间人员穿梭调拨栏 -->
    <div class="orbat-trans-bar">
      <button type="button" class="dfw-btn" id="btnTransToRight" ${REORG_WIN_STATE.leftSoldierIds.size === 0 || leftSoldiers.length <= REORG_WIN_STATE.leftSoldierIds.size ? "disabled" : ""}>
        ➡ 调拨至右方 (${REORG_WIN_STATE.leftSoldierIds.size}人)
      </button>
      <button type="button" class="dfw-btn" id="btnTransSwap" ${REORG_WIN_STATE.leftSoldierIds.size === 0 || REORG_WIN_STATE.rightSoldierIds.size === 0 ? "disabled" : ""}>
        🔄 互换所选单兵
      </button>
      <button type="button" class="dfw-btn" id="btnTransToLeft" ${REORG_WIN_STATE.rightSoldierIds.size === 0 || rightSoldiers.length <= REORG_WIN_STATE.rightSoldierIds.size ? "disabled" : ""}>
        ⬅ 调拨至左方 (${REORG_WIN_STATE.rightSoldierIds.size}人)
      </button>
    </div>
  `;

  win.classList.add("open");
  makeWinDraggable(win, document.getElementById("reorgDragBar"));

  body.querySelectorAll("[data-orbat-pick-unit]").forEach(btn => {
    btn.onclick = () => {
      REORG_WIN_STATE.leftUnitId = btn.getAttribute("data-orbat-pick-unit");
      REORG_WIN_STATE.leftSoldierIds.clear();
      renderReorgSplitWin();
    };
  });

  body.querySelectorAll("[data-nom-type]").forEach(btn => {
    btn.onclick = () => {
      REORG_WIN_STATE.nominalContainer = btn.getAttribute("data-nom-type");
      const typeNames = {
        infantry: "步兵组",
        scout: "尖兵组",
        heavy_weapon: "机枪组",
        recon: "侦察组",
        engineer: "工兵组",
        medic: "医疗组",
      };
      const tName = typeNames[REORG_WIN_STATE.nominalContainer] || "战斗组";
      const inp = document.getElementById("obNewSplitName");
      if (inp) inp.value = `${leftPiece?.name || "分队"} · ${tName}`;
      REORG_WIN_STATE.newCustomName = inp ? inp.value : "";
      renderReorgSplitWin();
    };
  });

  const nameInp = document.getElementById("obNewSplitName");
  if (nameInp) nameInp.oninput = () => {
    REORG_WIN_STATE.newCustomName = nameInp.value;
  };

  body.querySelectorAll("[data-lsol-id]").forEach(chk => chk.onchange = () => {
    const sid = chk.getAttribute("data-lsol-id");
    if (chk.checked) REORG_WIN_STATE.leftSoldierIds.add(sid);
    else REORG_WIN_STATE.leftSoldierIds.delete(sid);
    renderReorgSplitWin();
  });

  body.querySelectorAll("[data-rsol-id]").forEach(chk => chk.onchange = () => {
    const sid = chk.getAttribute("data-rsol-id");
    if (chk.checked) REORG_WIN_STATE.rightSoldierIds.add(sid);
    else REORG_WIN_STATE.rightSoldierIds.delete(sid);
    renderReorgSplitWin();
  });

  document.getElementById("orbatLeftSelectAll")?.addEventListener("click", () => {
    if (REORG_WIN_STATE.leftSoldierIds.size > 0) REORG_WIN_STATE.leftSoldierIds.clear();
    else leftSoldiers.slice(0, Math.max(1, leftSoldiers.length - 1)).forEach(s => REORG_WIN_STATE.leftSoldierIds.add(s.id));
    renderReorgSplitWin();
  });
  document.getElementById("orbatRightSelectAll")?.addEventListener("click", () => {
    if (REORG_WIN_STATE.rightSoldierIds.size > 0) REORG_WIN_STATE.rightSoldierIds.clear();
    else rightSoldiers.slice(0, Math.max(1, rightSoldiers.length - 1)).forEach(s => REORG_WIN_STATE.rightSoldierIds.add(s.id));
    renderReorgSplitWin();
  });

  const rSel = document.getElementById("orbatRightUnitSel");
  if (rSel) rSel.onchange = () => {
    REORG_WIN_STATE.rightUnitId = rSel.value;
    REORG_WIN_STATE.rightSoldierIds.clear();
    renderReorgSplitWin();
  };

  document.getElementById("btnOrbatSplit")?.addEventListener("click", async () => {
    const selCount = REORG_WIN_STATE.leftSoldierIds.size;
    if (selCount === 0 || leftSoldiers.length <= selCount) {
      alert("请至少勾选 1 名且不可勾选全部分队人员");
      return;
    }
    let takeCadre = 0;
    for (const sid of REORG_WIN_STATE.leftSoldierIds) {
      const s = leftSoldiers.find(x => x.id === sid);
      if (s && s.is_cadre) takeCadre++;
    }
    const takeEnl = Math.max(0, selCount - takeCadre);
    const splitName = document.getElementById("obNewSplitName")?.value || `${leftPiece?.name} · 战斗组`;

    const r = await api("/api/unit_op", "POST", {
      op: "split_squad",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      piece_id: leftPiece.id,
      take_enlisted: Math.max(1, takeEnl),
      take_cadre: takeCadre,
    });
    if (!r.ok) { alert("拆分失败: " + ((r.data && r.data.reason) || r.status)); return; }

    if (r.data && r.data.new_piece_id && r.data.state) {
      const newP = (r.data.state.own_pieces || []).find(op => op.id === r.data.new_piece_id);
      if (newP) {
        newP.name = splitName;
        newP.custom_name = splitName;
        newP.container_type = REORG_WIN_STATE.nominalContainer;
        newP.level = "team";
      }
    }
    await refreshState();
    REORG_WIN_STATE.leftSoldierIds.clear();
    renderReorgSplitWin();
  });

  document.getElementById("btnOrbatMerge")?.addEventListener("click", async () => {
    if (!leftPiece || !rightPiece) return;
    const r = await api("/api/unit_op", "POST", {
      op: "merge_squad_pieces",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      target_piece_id: leftPiece.id,
      source_piece_id: rightPiece.id,
    });
    if (!r.ok) { alert("合并归建失败: " + ((r.data && r.data.reason) || r.status)); return; }
    await refreshState();
    renderReorgSplitWin();
  });

  document.getElementById("btnTransToRight")?.addEventListener("click", async () => {
    if (!leftPiece || !rightPiece || REORG_WIN_STATE.leftSoldierIds.size === 0) return;
    if (leftSoldiers.length <= REORG_WIN_STATE.leftSoldierIds.size) {
      alert("原分队至少需保留 1 人，无法全员调离");
      return;
    }
    const r = await api("/api/unit_op", "POST", {
      op: "transfer_soldiers",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      src_piece_id: leftPiece.id,
      dst_piece_id: rightPiece.id,
      soldier_ids: Array.from(REORG_WIN_STATE.leftSoldierIds),
    });
    if (!r.ok) { alert("调拨失败: " + ((r.data && r.data.reason) || r.status)); return; }
    await refreshState();
    REORG_WIN_STATE.leftSoldierIds.clear();
    renderReorgSplitWin();
  });

  document.getElementById("btnTransToLeft")?.addEventListener("click", async () => {
    if (!leftPiece || !rightPiece || REORG_WIN_STATE.rightSoldierIds.size === 0) return;
    if (rightSoldiers.length <= REORG_WIN_STATE.rightSoldierIds.size) {
      alert("友军分队至少需保留 1 人，无法全员调离");
      return;
    }
    const r = await api("/api/unit_op", "POST", {
      op: "transfer_soldiers",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      src_piece_id: rightPiece.id,
      dst_piece_id: leftPiece.id,
      soldier_ids: Array.from(REORG_WIN_STATE.rightSoldierIds),
    });
    if (!r.ok) { alert("调拨失败: " + ((r.data && r.data.reason) || r.status)); return; }
    await refreshState();
    REORG_WIN_STATE.rightSoldierIds.clear();
    renderReorgSplitWin();
  });

  document.getElementById("btnTransSwap")?.addEventListener("click", async () => {
    if (!leftPiece || !rightPiece || REORG_WIN_STATE.leftSoldierIds.size === 0 || REORG_WIN_STATE.rightSoldierIds.size === 0) return;
    const r1 = await api("/api/unit_op", "POST", {
      op: "transfer_soldiers",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      src_piece_id: leftPiece.id,
      dst_piece_id: rightPiece.id,
      soldier_ids: Array.from(REORG_WIN_STATE.leftSoldierIds),
    });
    if (!r1.ok) { alert("互换失败: " + ((r1.data && r1.data.reason) || r1.status)); return; }
    const r2 = await api("/api/unit_op", "POST", {
      op: "transfer_soldiers",
      player_commander_id: STATE.active_commander_id,
      commander_id: STATE.active_commander_id,
      src_piece_id: rightPiece.id,
      dst_piece_id: leftPiece.id,
      soldier_ids: Array.from(REORG_WIN_STATE.rightSoldierIds),
    });
    if (!r2.ok) { alert("互换部分失败: " + ((r2.data && r2.data.reason) || r2.status)); return; }
    await refreshState();
    REORG_WIN_STATE.leftSoldierIds.clear();
    REORG_WIN_STATE.rightSoldierIds.clear();
    renderReorgSplitWin();
  });
}

// ---------- 5. Standalone Heavy Weapon Deploy / Pack & Multi-Crew Table Modal ----------
function closeHeavyCrewWin() {
  HEAVY_WIN_STATE.open = false;
  const el = document.getElementById("heavyCrewWin");
  if (el) el.classList.remove("open");
}

function heavyBuffInfo(n) {
  const c = Math.max(0, Number(n || 0));
  if (c <= 0) return { mult: 0.0, tag: "无人操作 · 无法自行开火", color: "#f87171" };
  if (c === 1) return { mult: 0.70, tag: "[CREW_DEPLETED] 1人缺编操炮：0.70x 效能（射速减半/装填迟滞）", color: "#fb923c" };
  if (c === 2) return { mult: 1.00, tag: "[MINIMAL_CREW] 2人基线编制：1.00x 标准射速与装填", color: "#e7e5e4" };
  if (c === 3) return { mult: 1.18, tag: "[SUFFICIENT_CREW] 3人协同顺畅：1.18x (+18% 持续压制增益)", color: "#38bdf8" };
  return { mult: 1.32, tag: "[FULL_CREW_SYNERGY] 4人+满编协同：1.32x (+32% 压制射速与供弹协同)", color: "#4ade80" };
}

function openHeavyCrewWin(targetKind, targetId) {
  const ent = resolveTargetEntity(targetKind, targetId);
  if (!ent || !ent.piece) return;
  const p = ent.piece;
  const heavyModels = ["hmg", "mortar_81", "at_gun_50", "howitzer_105", "howitzer_152", "flak_88", "lmg"];
  const availWpn = (p.weapons || []).find(w => heavyModels.includes(w.model));
  const opPiece = p.operated_by ? (STATE.own_pieces || []).find(x => x.id === p.operated_by) : p;
  HEAVY_WIN_STATE = {
    open: true,
    targetKind,
    targetId,
    weapon: p.deployed_weapon || availWpn?.model || "hmg",
    mode: "unmanned",
    operatorPieceId: opPiece?.id || p.id,
    soldierIds: new Set(Array.isArray(p.operator_soldier_ids) && p.operator_soldier_ids.length > 0
      ? p.operator_soldier_ids
      : ((opPiece?.soldiers || []).slice(0, 2).map(s => s.id))),
    packTargetId: p.operated_by || "",
    immediate: STATE.turn === 0,
  };
  renderHeavyCrewWin();
}

function renderHeavyCrewWin() {
  const win = document.getElementById("heavyCrewWin");
  const body = document.getElementById("heavyBody");
  if (!win || !body || !HEAVY_WIN_STATE.open) return;
  const ent = resolveTargetEntity(HEAVY_WIN_STATE.targetKind, HEAVY_WIN_STATE.targetId);
  if (!ent || !ent.piece) { closeHeavyCrewWin(); return; }
  const p = ent.piece;
  const heavyModels = ["hmg", "mortar_81", "at_gun_50", "howitzer_105", "howitzer_152", "flak_88", "lmg"];
  const ownHeavyWpns = (p.weapons || []).filter(w => heavyModels.includes(w.model));
  const nearbyOwn = (STATE.own_pieces || []).filter(op => op.team === p.team && !op.is_heavy_emplacement && op.persons > 0 && Math.hypot((op.pos?.[0] ?? 0) - ent.pos[0], (op.pos?.[1] ?? 0) - ent.pos[1]) <= 2.2);
  const opPiece = (STATE.own_pieces || []).find(x => x.id === HEAVY_WIN_STATE.operatorPieceId) || p;
  const soldiers = opPiece.soldiers || [];
  const selectedCount = soldiers.filter(s => HEAVY_WIN_STATE.soldierIds.has(s.id) && !s.cannot_fire).length;
  const buff = heavyBuffInfo(selectedCount);
  const isEmplacement = Boolean(p.is_heavy_emplacement || p.unit_state === "deployed");

  document.getElementById("heavyTitle").textContent = `⚙ 重武器架设、打包 & 操炮编制 · ${ent.name}`;
  body.innerHTML = `
    <div class="mod-card-dark">
      <div class="mod-card-title">
        <span>当前重武器态势: ${isEmplacement ? `🛡 已架设阵地 (${weaponCnName(p.deployed_weapon || HEAVY_WIN_STATE.weapon)})` : "📦 随队机动携带"}</span>
        <small style="color:#38bdf8;">速度 ${Number(p.base_speed_kmh || 0).toFixed(1)} km/h · 当前操炮倍率 ×${Number(p.operator_buff_mult || 1.0).toFixed(2)}</small>
      </div>
      <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <label>操作/母班组:
          <select id="hwOpPieceSel">
            ${nearbyOwn.length === 0 ? `<option value="${p.id}">${escHtml(p.name)}</option>` : nearbyOwn.map(op =>
              `<option value="${op.id}" ${op.id === opPiece.id ? "selected" : ""}>${escHtml(op.name)} (${op.persons}人)</option>`
            ).join("")}
          </select>
        </label>
        <label>武器型号:
          <select id="hwWeaponSel" ${isEmplacement ? "disabled" : ""}>
            ${(ownHeavyWpns.length > 0 ? ownHeavyWpns : [{ model: HEAVY_WIN_STATE.weapon, count: 1 }]).map(w =>
              `<option value="${w.model}" ${w.model === HEAVY_WIN_STATE.weapon ? "selected" : ""}>${weaponCnName(w.model)} ×${w.count}</option>`
            ).join("")}
          </select>
        </label>
        ${!isEmplacement ? `
          <label><input type="radio" name="hwMode" value="unmanned" ${HEAVY_WIN_STATE.mode === "unmanned" ? "checked" : ""} /> 脱离班组(无人阵地)</label>
          <label><input type="radio" name="hwMode" value="manned" ${HEAVY_WIN_STATE.mode === "manned" ? "checked" : ""} /> 就地架设</label>
        ` : ""}
      </div>
    </div>

    <div class="mod-card-dark">
      <div class="mod-card-title"><span>操炮手单兵勾选 (${selectedCount}人有效)</span><small style="color:#a8a29e;">双手持重物/伤病人员禁操炮</small></div>
      <div style="max-height:170px;overflow-y:auto;">
        <table class="crew-tbl">
          <thead><tr><th>选</th><th>姓名</th><th>主武器</th><th>HP</th><th>状态提示</th></tr></thead>
          <tbody>
            ${soldiers.length === 0 ? `<tr><td colspan="5" style="color:#a8a29e;">暂无可指派单兵（请选择有人的母班组）</td></tr>` : soldiers.map(s => `
              <tr>
                <td><input type="checkbox" data-hw-sol="${s.id}" ${HEAVY_WIN_STATE.soldierIds.has(s.id) ? "checked" : ""} ${s.cannot_fire ? "disabled" : ""} /></td>
                <td style="font-weight:700;color:${s.is_cadre ? "#fbbf24" : "#f5f5f4"};">${escHtml(s.name)}</td>
                <td>${weaponCnName(s.weapon || "rifle")}</td>
                <td>${Math.round(s.hp || 100)}%</td>
                <td style="color:${s.cannot_fire ? "#f87171" : "#4ade80"};">${s.cannot_fire ? "双手占用·禁操炮" : "可操作"}</td>
              </tr>
            `).join("")}
          </tbody>
        </table>
      </div>
      <div class="crew-buff-box" style="color:${buff.color};font-weight:700;">${buff.tag}</div>
    </div>

    <div class="mod-card-dark" style="flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
      <label style="font-size:11px;display:inline-flex;align-items:center;gap:4px;"><input type="checkbox" id="hwChkImmediate" ${HEAVY_WIN_STATE.immediate ? "checked" : ""} /> 开局立即完成</label>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        ${!isEmplacement ? `<button type="button" class="dfw-btn primary" id="btnHwDeploy" ${ownHeavyWpns.length === 0 ? "disabled title='本单位无重武器装备'" : ""}>⚙ 架设重武器</button>` : ""}
        ${isEmplacement ? `<button type="button" class="dfw-btn primary" id="btnHwOperate">🎯 更新操炮手</button>` : ""}
        ${isEmplacement ? `<button type="button" class="dfw-btn" id="btnHwPack">🎒 打包并回母班</button>` : ""}
      </div>
    </div>
  `;
  win.classList.add("open");
  makeWinDraggable(win, document.getElementById("heavyDragBar"));

  document.getElementById("hwOpPieceSel")?.addEventListener("change", e => {
    HEAVY_WIN_STATE.operatorPieceId = e.target.value;
    const np = (STATE.own_pieces || []).find(x => x.id === e.target.value);
    HEAVY_WIN_STATE.soldierIds = new Set((np?.soldiers || []).slice(0, 2).map(s => s.id));
    renderHeavyCrewWin();
  });
  document.getElementById("hwWeaponSel")?.addEventListener("change", e => { HEAVY_WIN_STATE.weapon = e.target.value; });
  body.querySelectorAll('input[name="hwMode"]').forEach(rd => rd.onchange = () => { if (rd.checked) HEAVY_WIN_STATE.mode = rd.value; });
  body.querySelectorAll("[data-hw-sol]").forEach(chk => chk.onchange = () => {
    const sid = chk.getAttribute("data-hw-sol");
    if (chk.checked) HEAVY_WIN_STATE.soldierIds.add(sid); else HEAVY_WIN_STATE.soldierIds.delete(sid);
    renderHeavyCrewWin();
  });
  document.getElementById("hwChkImmediate")?.addEventListener("change", e => { HEAVY_WIN_STATE.immediate = e.target.checked; });

  document.getElementById("btnHwDeploy")?.addEventListener("click", async () => {
    const selIds = Array.from(HEAVY_WIN_STATE.soldierIds);
    await sendEventOp("deploy_heavy_unit", ent.pieceId, null, {
      weapon: HEAVY_WIN_STATE.weapon,
      unmanned: HEAVY_WIN_STATE.mode === "unmanned",
      keep_manned: HEAVY_WIN_STATE.mode !== "unmanned",
      operator_soldier_ids: selIds,
      operator_count: Math.max(1, selIds.length),
      immediate: HEAVY_WIN_STATE.immediate,
    });
    closeHeavyCrewWin();
    renderOrbatCard();
  });
  document.getElementById("btnHwOperate")?.addEventListener("click", async () => {
    const selIds = Array.from(HEAVY_WIN_STATE.soldierIds);
    await sendEventOp("operate_heavy_unit", HEAVY_WIN_STATE.operatorPieceId, null, {
      target_unit_id: ent.pieceId,
      operator_soldier_ids: selIds,
      operator_count: Math.max(1, selIds.length),
    });
    closeHeavyCrewWin();
    renderOrbatCard();
  });
  document.getElementById("btnHwPack")?.addEventListener("click", async () => {
    const targetMerge = (HEAVY_WIN_STATE.operatorPieceId && HEAVY_WIN_STATE.operatorPieceId !== p.id)
      ? HEAVY_WIN_STATE.operatorPieceId
      : (p.operated_by || nearbyOwn[0]?.id || "");
    await sendEventOp("pack_heavy_unit", targetMerge || ent.pieceId, null, {
      target_unit_id: ent.pieceId,
      detach_mobile: !targetMerge,
      immediate: HEAVY_WIN_STATE.immediate,
    });
    closeHeavyCrewWin();
    renderOrbatCard();
  });
}

async function refreshState() {
  const cid = document.getElementById("selCommander").value || "";
  const params = new URLSearchParams();
  if (cid) params.set("commander_id", cid);
  if (MP_STATE.seatToken) params.set("seat_token", MP_STATE.seatToken);
  const qs = params.toString();
  const url = qs ? `/api/state?${qs}` : "/api/state";
  const r = await api(url);
  if (!r.ok) return;
  STATE = r.data;
  MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
  syncUiFromState();
  if (!TILE_STREAM_SUPPORTED) {
    await ensureTerrainBinaryFallback();
    rebuildTerrainCanvasFallback();
  }
  if (!VIEW_INITIALIZED) {
    VIEW_INITIALIZED = true;
    const rect = canvas.parentElement.getBoundingClientRect();
    const cw = rect.width || window.innerWidth, ch = rect.height || window.innerHeight;
    const fitPx = !STATE.grid.large_grid
      ? Math.max(12, Math.floor(Math.min(cw, ch) * 0.72 / Math.max(STATE.grid.rows, STATE.grid.cols)))
      : 16;
    focusUnits(fitPx);
  } else {
    render();
  }
}

function formatUplinkText() {
  if (STATE.uplink_inbox) {
    const up = STATE.uplink_inbox;
    const omitted = (up.omitted_disconnected_ids || []).length;
    return (up.text || "(当前无直属在连上行作战日志)") +
      (omitted > 0 ? `\n\n[黑盒提示: ${omitted} 个直属单位/分队已断连 -> 上行作战日志完全空缺]` : "");
  }
  if (Array.isArray(STATE.uplink_logs) && STATE.uplink_logs.length > 0) {
    return STATE.uplink_logs.map(l =>
      `[${l.subordinate_id || l.from || "unit"}] (${l.via || "radio"}) ${l.summary || JSON.stringify(l)}`
    ).join("\n");
  }
  return "(当前无直属在连上行作战日志)";
}

function syncUiFromState() {
  const selC = document.getElementById("selCommander");
  const cur = STATE.active_commander_id;
  selC.innerHTML = "";
  for (const c of (STATE.commanders || [])) {
    const opt = document.createElement("option");
    opt.value = c.id;
    opt.textContent = `${c.name} (${c.echelon}${c.radio_silence ? "·静默" : ""})`;
    if (c.id === cur) opt.selected = true;
    selC.appendChild(opt);
  }
  selC.onchange = () => { DRILLED_IDS.clear(); refreshState(); };

  if (!ACTOR.id) {
    const cmds = STATE.commanders || [];
    const pcs = STATE.own_pieces || [];
    ACTOR = cmds.length ? { kind: "commander", id: STATE.active_commander_id || cmds[0].id } : (pcs.length ? { kind: "unit", id: pcs[0].id } : { kind: "commander", id: "" });
  }
  if (ACTOR.kind === "commander") {
    const curCmd = (STATE.commanders || []).find(c => c.id === ACTOR.id);
    const curDead = curCmd && (curCmd.alive === false || (curCmd.persons !== undefined && Number(curCmd.persons) <= 0));
    if (curDead) {
      const aliveSub = (STATE.own_pieces || []).find(p => !p.is_hq_piece && Number(p.persons || 0) > 0);
      if (aliveSub) {
        ACTOR = { kind: "unit", id: aliveSub.id };
        setActionHint(`【指挥移交】${curCmd.name} 已阵亡 (Depot)，控制身份已自动切换至 ${aliveSub.name}`);
      }
    }
  }
  for (const selId of ["selActor", "dbgActorSel"]) {
    const selA = document.getElementById(selId);
    if (!selA) continue;
    const curVal = `${ACTOR.kind}:${ACTOR.id}`;
    selA.innerHTML = "";
    for (const c of (STATE.commanders || [])) {
      const cDead = c.alive === false || (c.persons !== undefined && Number(c.persons) <= 0);
      const o = document.createElement("option");
      o.value = `commander:${c.id}`;
      o.textContent = cDead ? `${c.name} (已阵亡·Depot)` : `${c.name} (指挥官)`;
      if (o.value === curVal) o.selected = true;
      selA.appendChild(o);
    }
    for (const p of (STATE.own_pieces || [])) {
      if (p.is_hq_piece) continue;
      const o = document.createElement("option");
      o.value = `unit:${p.id}`;
      o.textContent = `${p.name} (班组)`;
      if (o.value === curVal) o.selected = true;
      selA.appendChild(o);
    }
  }
  const dbgClock = document.getElementById("dbgClock");
  if (dbgClock) {
    dbgClock.textContent = `T${STATE.turn} · ${Number(STATE.clock_hours || 0).toFixed(2)}h`;
  }
  const dbgFF = document.getElementById("dbgFriendlyFire");
  if (dbgFF) {
    dbgFF.checked = Boolean(STATE.debug_full_friendly_fire);
  }

  const pre = document.getElementById("lblPreGame");
  pre.textContent = STATE.pre_game_editable ? "开局可编辑" : "战局进行中(地形锁定)";
  pre.className = "pill " + (STATE.pre_game_editable ? "badge-ok" : "badge-warn");

  document.getElementById("lblTurn").textContent = `T${STATE.turn} · ${Number(STATE.clock_hours || 0).toFixed(2)}h · ${STATE.grid.cell_m}m/px`;
  const sc = STATE.readable_scope;
  if (sc) {
    document.getElementById("lblScopeCount").textContent =
      `可读线:${sc.readable_commander_ids.length + sc.readable_piece_ids.length} (邻近400m:${sc.proximity_commander_ids.length + sc.proximity_piece_ids.length})`;
  } else {
    const proxCnt = (STATE.commanders || []).filter(c => c.proximity_readable).length;
    document.getElementById("lblScopeCount").textContent =
      `可读线:${STATE.readable_count ?? (STATE.own_pieces || []).length} (邻近400m:${proxCnt})`;
  }

  const cat = STATE.feature_catalog || DEFAULT_FEATURE_CATALOG;
  for (const selId of ["selBrushFeat", "selImportFeat"]) {
    const el = document.getElementById(selId);
    if (el.options.length === 0) {
      for (const [fid, info] of Object.entries(cat)) {
        const o = document.createElement("option");
        o.value = fid;
        o.textContent = `${info.name} (${fid})`;
        el.appendChild(o);
      }
    }
  }

  document.getElementById("impW").value = STATE.grid.cols;
  document.getElementById("impH").value = STATE.grid.rows;
  document.getElementById("uplinkBox").textContent = formatUplinkText();

  rebuildVisTable();
  updateSelectedUnitPanel();
  updateDraftBox();
  updateMpBarUi();
  if (SELECTED_PIECE_ID || SELECTED_COMMANDER_ID) {
    renderOrbatCard();
  }
  const now = performance.now();
  for (const p of (STATE.own_pieces || [])) {
    if (p.delta_persons_5m < 0) {
      FLOAT_TEXTS.push({ r: p.pos[0], c: p.pos[1], text: `${p.delta_persons_5m} 兵力`, color: "#dc2626", born: now });
    }
    if (p.delta_org_5m < -0.25) {
      FLOAT_TEXTS.push({ r: p.pos[0], c: p.pos[1], text: `${p.delta_org_5m.toFixed(1)} 组织度`, color: "#d97706", born: now + 120 });
    }
  }
  for (const c of (STATE.commanders || [])) {
    const cpos = c.pos || c.px;
    if ((c.hq_delta_org_5m || 0) < -0.25) {
      FLOAT_TEXTS.push({ r: cpos[0], c: cpos[1], text: `${c.hq_delta_org_5m.toFixed(1)} 组织度`, color: "#d97706", born: now + 120 });
    }
  }
}

function rebuildTerrainCanvasFallback() {
  if (!STATE || !STATE.grid) return;
  const g = STATE.grid;
  const H = g.rows, W = g.cols;
  if (g.large_grid && (!TERRAIN_FLAT_U8 || !ELEV_FLAT_U16)) return;
  if (!g.large_grid && (!g.terrain || !g.elevation)) return;

  if (TERRAIN_CANVAS.width !== W || TERRAIN_CANVAS.height !== H) {
    TERRAIN_CANVAS.width = W;
    TERRAIN_CANVAS.height = H;
  }
  const tctx = TERRAIN_CANVAS.getContext("2d");
  const img = tctx.createImageData(W, H);
  const d32 = new Uint32Array(img.data.buffer);
  const minE = g.elev_min, spanE = Math.max(1.0, g.elev_max - minE);
  const invSpan = 1.0 / spanE;

  if (g.large_grid) {
    const tArr = TERRAIN_FLAT_U8;
    const eArr = ELEV_FLAT_U16;
    const total = H * W;
    for (let i = 0; i < total; i++) {
      const tc = tArr[i];
      const normE = (eArr[i] - minE) * invSpan;
      const rgb = TERRAIN_COLORS[tc] || [42, 48, 42];
      let rr, gg, bb;
      if (tc === 2 || normE > 0.78) {
        const k = Math.max(0.05, 1.0 - (normE - 0.65) * 2.2);
        rr = (rgb[0] * k + 0.5) | 0; gg = (rgb[1] * k + 0.5) | 0; bb = (rgb[2] * k + 0.5) | 0;
      } else {
        const shade = 0.75 + normE * 0.45;
        rr = Math.min(255, (rgb[0] * shade + 0.5) | 0);
        gg = Math.min(255, (rgb[1] * shade + 0.5) | 0);
        bb = Math.min(255, (rgb[2] * shade + 0.5) | 0);
      }
      d32[i] = (255 << 24) | (bb << 16) | (gg << 8) | rr;
    }
  } else {
    for (let r = 0; r < H; r++) {
      const tRow = g.terrain[r], eRow = g.elevation[r];
      const base = r * W;
      for (let c = 0; c < W; c++) {
        const tc = tRow[c];
        const normE = (eRow[c] - minE) * invSpan;
        const rgb = TERRAIN_COLORS[tc] || [42, 48, 42];
        let rr, gg, bb;
        if (tc === 2 || normE > 0.78) {
          const k = Math.max(0.05, 1.0 - (normE - 0.65) * 2.2);
          rr = (rgb[0] * k + 0.5) | 0; gg = (rgb[1] * k + 0.5) | 0; bb = (rgb[2] * k + 0.5) | 0;
        } else {
          const shade = 0.75 + normE * 0.45;
          rr = Math.min(255, (rgb[0] * shade + 0.5) | 0);
          gg = Math.min(255, (rgb[1] * shade + 0.5) | 0);
          bb = Math.min(255, (rgb[2] * shade + 0.5) | 0);
        }
        d32[base + c] = (255 << 24) | (bb << 16) | (gg << 8) | rr;
      }
    }
  }
  tctx.putImageData(img, 0, 0);
}

function currentZoomThreshold() {
  const px = VIEW.pxSize;
  if (px >= 14) return { tier: 0, label: "班(Squad)" };
  if (px >= 10) return { tier: 1, label: "排(Platoon)" };
  if (px >= 7) return { tier: 2, label: "连(Company)" };
  return { tier: 3, label: "营+(Battalion+)" };
}

function normalizeHQName(cmd) {
  if (!cmd) return "指挥部";
  let name = cmd.name || "";
  if (name.includes("指挥部")) return name;
  const ech = (cmd.echelon || "").toLowerCase();
  let tierName = "排";
  if (ech === "team" || ech === "trupp") tierName = "组";
  else if (ech === "squad" || ech === "gruppe") tierName = "班";
  else if (ech === "half_platoon" || ech === "halbzug") tierName = "半排";
  else if (ech === "platoon" || ech === "zug") tierName = "排";
  else if (ech === "company" || ech === "kompanie") tierName = "连";
  else if (ech === "battalion" || ech === "bataillon") tierName = "营";
  else if (ech === "regiment") tierName = "团";
  else if (ech === "brigade") tierName = "旅";
  else if (ech === "division") tierName = "师";

  const cleaned = name.replace(/[（(].*?[)）]/g, "").replace(/长$/, "").replace(/部$/, "").trim();
  if (!cleaned.endsWith(tierName)) {
    return `${cleaned ? cleaned + " " : ""}${tierName}指挥部`.trim();
  }
  return `${cleaned}指挥部`;
}

function computeDisplayCounters() {
  if (!STATE) return [];
  const lod = currentZoomThreshold();
  document.getElementById("lblLod").textContent = `LOD: ${lod.label} (${VIEW.pxSize.toFixed(1)}px/格)`;

  const out = [];
  const foldedPids = new Set();

  for (const c of (STATE.commanders || [])) {
    const cTier = ECHELON_ORDER[c.echelon] ?? 2;
    let foldedThisCmd = false;
    if (cTier <= lod.tier && !DRILLED_IDS.has(c.id)) {
      const subs = (STATE.own_pieces || []).filter(p => (c.subordinate_ids || []).includes(p.id));
      if (subs.length > 0 && lod.tier >= 2) {
        foldedThisCmd = true;
        let sr = 0, sc = 0, totP = 0;
        for (const sp of subs) {
          const bonus = (sp.counter && sp.counter.display_tier_bonus) || 0;
          const spTier = (ECHELON_ORDER[sp.level] ?? 0) + bonus;
          if (spTier < lod.tier && VIS_MODES[sp.id] !== "pin") {
            foldedPids.add(sp.id);
          }
          const spp = sp.pos || sp.px || [0, 0];
          sr += spp[0]; sc += spp[1]; totP += Number(sp.persons || 0);
        }
        if (VIS_MODES[c.id] !== "hide") {
          out.push({
            id: c.id, isAggregate: true, isHQ: true, name: normalizeHQName(c), level: c.echelon,
            pos: [sr / subs.length, sc / subs.length],
            persons: totP, team: c.team, readable_line: c.readable,
            badge: `★${c.echelon.toUpperCase()} (${subs.length}分队)`,
            color: c.is_self ? "#dc2626" : "#2563eb",
            bonus: 0,
            commander: c,
          });
        }
      }
    }
    if (!foldedThisCmd && VIS_MODES[c.id] !== "hide" && (c.pos || c.px)) {
      let rp = RENDER_POS[c.id];
      if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) {
        rp = c.pos || c.px;
      }
      if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) continue;
      const isDead = c.alive === false || (c.persons !== undefined && Number(c.persons) <= 0);
      out.push({
        id: c.id, isAggregate: false, isHQ: true, name: normalizeHQName(c), level: c.echelon,
        pos: rp,
        persons: c.persons ?? null, team: c.team, readable_line: c.readable,
        badge: isDead ? "DEPOT" : `${c.echelon.toUpperCase()} HQ`,
        color: isDead ? "#6b7280" : "#dc2626",
        bonus: 0,
        commander: c,
      });
    }
  }

  for (const p of (STATE.own_pieces || [])) {
    if (p.is_hq_piece) continue;
    const vm = VIS_MODES[p.id] || "auto";
    if (vm === "hide") continue;
    if (vm === "auto" && foldedPids.has(p.id)) continue;
    const ctr = p.counter || {};
    const bonus = ctr.display_tier_bonus || 0;
    const skinColor = ctr.color || (ctr.skin && ctr.skin.color) || (bonus > 0 ? "#f59e0b" : "#38bdf8");
    const isLocked = Boolean(p.is_name_locked || ctr.is_name_locked);
    const customLabel = isLocked ? (p.custom_name || ctr.custom_label || p.name) : (ctr.custom_label || (ctr.skin && ctr.skin.custom_label));
    const restr = ctr.restriction_tier || ctr.restricted_echelon || p.level;
    let rp = RENDER_POS[p.id];
    if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) {
      rp = p.pos || p.px;
    }
    if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) continue;
    out.push({
      id: p.id, isAggregate: false, name: customLabel || p.name,
      level: p.level || "squad", pos: rp, persons: p.persons, team: p.team,
      readable_line: p.readable_line !== undefined ? p.readable_line : true,
      badge: ctr.badge_label || ctr.primary_icon || (p.level || "squad").toUpperCase(),
      color: skinColor, restriction: restr,
      has_facing: p.has_facing !== undefined ? p.has_facing : Boolean(p.is_directional_hull),
      facing_deg: p.facing_deg, piece: p, bonus,
      container_type: p.container_type || ctr.container_type || "infantry",
      is_name_locked: isLocked,
    });
  }
  return out;
}

function pxToScreen(r, c) {
  return [VIEW.offsetX + (c + 0.5) * VIEW.pxSize, VIEW.offsetY + (r + 0.5) * VIEW.pxSize];
}
function screenToPx(sx, sy) {
  return [Math.floor((sy - VIEW.offsetY) / VIEW.pxSize), Math.floor((sx - VIEW.offsetX) / VIEW.pxSize)];
}

function drawFloatTexts() {
  // 飘字伤亡/压制动画
  const nowFt = performance.now();
  for (let i = FLOAT_TEXTS.length - 1; i >= 0; i--) {
    const ft = FLOAT_TEXTS[i];
    const age = nowFt - ft.born;
    if (age < 0) continue;
    if (age > 1500) {
      FLOAT_TEXTS.splice(i, 1);
      continue;
    }
    const [fx, fy] = pxToScreen(ft.r, ft.c);
    const alpha = Math.max(0, 1 - age / 1500);
    const dy = (age / 1500) * 28;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.font = "bold 12px Microsoft YaHei, Consolas, sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText(ft.text, fx - 20 + 1, fy - 16 - dy + 1);
    ctx.fillStyle = ft.color || "#dc2626";
    ctx.fillText(ft.text, fx - 20, fy - 16 - dy);
    ctx.restore();
  }
}

function drawPolylineWithNormal(pts, normal, color, dashed, label) {
  if (!pts || pts.length < 2) return;
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = dashed ? 2.2 : 2.8;
  ctx.setLineDash(dashed ? [6, 4] : []);
  ctx.beginPath();
  pts.forEach(([r, c], idx) => {
    const [sx, sy] = pxToScreen(r, c);
    if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
  });
  ctx.stroke();
  ctx.setLineDash([]);
  // 中点绘制朝敌法向量 N_line 箭头与标签
  const midIdx = Math.floor(pts.length / 2);
  const a = pts[Math.max(0, midIdx - 1)];
  const b = pts[Math.min(pts.length - 1, midIdx)];
  const mr = (a[0] + b[0]) * 0.5, mc = (a[1] + b[1]) * 0.5;
  const [mx, my] = pxToScreen(mr, mc);
  const nr = normal && normal.length === 2 ? Number(normal[0]) : 0.0;
  const nc = normal && normal.length === 2 ? Number(normal[1]) : 1.0;
  const nm = Math.hypot(nr, nc) || 1.0;
  const ax = mx + (nc / nm) * 16, ay = my + (nr / nm) * 16;
  ctx.beginPath(); ctx.moveTo(mx, my); ctx.lineTo(ax, ay); ctx.stroke();
  ctx.fillStyle = color;
  ctx.beginPath(); ctx.arc(ax, ay, 3.2, 0, Math.PI * 2); ctx.fill();
  if (label) {
    ctx.font = "bold 10px Consolas, monospace";
    ctx.fillText(label, mx + 6, my - 5);
  }
  ctx.restore();
}

function ensureC2DFieldCanvas(g, rev) {
  if (!g || g.large_grid || !g.terrain) return null;
  if (C2D_FIELD_CANVAS && C2D_FIELD_REV === rev) return C2D_FIELD_CANVAS;
  const rows = g.rows, cols = g.cols;
  const sub = Math.max(rows, cols) <= 32 ? 32 : 8;
  const W = cols * sub, H = rows * sub;
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const cctx = c.getContext("2d");
  const img = cctx.createImageData(W, H);
  const data = img.data;
  const fdGrid = g.forest_density || null;
  const field = new Float32Array(rows * cols);
  for (let r = 0; r < rows; r++) {
    const tRow = g.terrain[r];
    const fdRow = fdGrid ? fdGrid[r] : null;
    for (let col = 0; col < cols; col++) {
      const d = fdRow ? Number(fdRow[col] || 0) : 0;
      field[r * cols + col] = d > 0 ? Math.min(1.0, d) : (tRow[col] === 1 ? 0.5 : 0.0);
    }
  }
  const sampleBilinear = (gx, gy) => {
    const cx = Math.max(0, Math.min(cols - 1.0001, gx));
    const cy = Math.max(0, Math.min(rows - 1.0001, gy));
    const x0 = Math.floor(cx), y0 = Math.floor(cy);
    const x1 = Math.min(cols - 1, x0 + 1), y1 = Math.min(rows - 1, y0 + 1);
    const tx = cx - x0, ty = cy - y0;
    const v00 = field[y0 * cols + x0], v10 = field[y0 * cols + x1];
    const v01 = field[y1 * cols + x0], v11 = field[y1 * cols + x1];
    const a = v00 + (v10 - v00) * tx;
    const b = v01 + (v11 - v01) * tx;
    return a + (b - a) * ty;
  };
  const invSub = 1.0 / sub;
  const off = 0.48;
  const offD = off * 0.7071;
  for (let py = 0; py < H; py++) {
    const gy = (py + 0.5) * invSub - 0.5;
    const cellR = Math.max(0, Math.min(rows - 1, Math.floor((py + 0.5) * invSub)));
    const tRow = g.terrain[cellR];
    for (let px = 0; px < W; px++) {
      const gx = (px + 0.5) * invSub - 0.5;
      const cellC = Math.max(0, Math.min(cols - 1, Math.floor((px + 0.5) * invSub)));
      const tc = tRow ? tRow[cellC] : 0;
      const idx = (py * W + px) * 4;

      if (tc === 2) {
        // MOUNTAIN: Deep Cold Iron Black (#07080c) as King specified
        data[idx] = 7; data[idx + 1] = 8; data[idx + 2] = 12; data[idx + 3] = 255;
        continue;
      }
      if (tc === 4) {
        // WATER: Deep Blue (#163a6c)
        data[idx] = 22; data[idx + 1] = 58; data[idx + 2] = 108; data[idx + 3] = 255;
        continue;
      }
      if (tc === 3) {
        // SWAMP: Murky Green (#243834)
        data[idx] = 36; data[idx + 1] = 56; data[idx + 2] = 52; data[idx + 3] = 255;
        continue;
      }
      if (tc === 5) {
        // URBAN: Slate Grey (#48444c)
        data[idx] = 72; data[idx + 1] = 68; data[idx + 2] = 76; data[idx + 3] = 255;
        continue;
      }
      if (tc >= 10 && tc <= 13) {
        // ROADS/RAIL: Sand Road (#7a684f)
        data[idx] = 122; data[idx + 1] = 104; data[idx + 2] = 79; data[idx + 3] = 255;
        continue;
      }

      // Smooth Bilinear Forest over Plain Base (#f4f1ea)
      const fc  = sampleBilinear(gx, gy);
      const fl  = sampleBilinear(gx - off, gy);
      const fr  = sampleBilinear(gx + off, gy);
      const fu  = sampleBilinear(gx, gy - off);
      const fd  = sampleBilinear(gx, gy + off);
      const ful = sampleBilinear(gx - offD, gy - offD);
      const fur = sampleBilinear(gx + offD, gy - offD);
      const fdl = sampleBilinear(gx - offD, gy + offD);
      const fdr = sampleBilinear(gx + offD, gy + offD);
      const f = (fc * 1.6 + (fl + fr + fu + fd) + (ful + fur + fdl + fdr) * 0.7) / 8.4;
      let t = (f - 0.174) / (0.186 - 0.174);
      t = t <= 0 ? 0 : (t >= 1 ? 1 : t * t * (3 - 2 * t));

      // Plain base #f4f1ea (244, 241, 234) smoothly blending into forest #c3db90 (195, 219, 144)
      data[idx] = Math.round(244 + (195 - 244) * t);
      data[idx + 1] = Math.round(241 + (219 - 241) * t);
      data[idx + 2] = Math.round(234 + (144 - 234) * t);
      data[idx + 3] = 255;
    }
  }
  cctx.putImageData(img, 0, 0);
  C2D_FIELD_CANVAS = c;
  C2D_FIELD_REV = rev;
  return c;
}

function ensureC2DLOSCanvas(g, losData) {
  if (!g || !losData || !losData.cells) return null;
  if (C2D_LOS_CANVAS && C2D_LOS_KEY === losData) return C2D_LOS_CANVAS;
  const rows = g.rows, cols = g.cols;
  if (rows > 256 || cols > 256) return null; // fallback to viewport rects for ultra-massive maps
  const sub = Math.max(rows, cols) <= 32 ? 32 : 8;
  const W = cols * sub, H = rows * sub;
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const cctx = c.getContext("2d");
  const img = cctx.createImageData(W, H);
  const data = img.data;
  const field = new Float32Array(rows * cols);
  for (const [r, col, eff] of losData.cells) {
    if (r >= 0 && r < rows && col >= 0 && col < cols) {
      field[r * cols + col] = Math.max(0.0, Math.min(1.0, Number(eff) || 0.0));
    }
  }
  const sampleBilinear = (gx, gy) => {
    const cx = Math.max(0, Math.min(cols - 1.0001, gx));
    const cy = Math.max(0, Math.min(rows - 1.0001, gy));
    const x0 = Math.floor(cx), y0 = Math.floor(cy);
    const x1 = Math.min(cols - 1, x0 + 1), y1 = Math.min(rows - 1, y0 + 1);
    const tx = cx - x0, ty = cy - y0;
    const v00 = field[y0 * cols + x0], v10 = field[y0 * cols + x1];
    const v01 = field[y1 * cols + x0], v11 = field[y1 * cols + x1];
    const a = v00 + (v10 - v00) * tx;
    const b = v01 + (v11 - v01) * tx;
    return a + (b - a) * ty;
  };
  const invSub = 1.0 / sub;
  const off = 0.48;
  const offD = off * 0.7071;
  for (let py = 0; py < H; py++) {
    const gy = (py + 0.5) * invSub - 0.5;
    for (let px = 0; px < W; px++) {
      const gx = (px + 0.5) * invSub - 0.5;
      const fc  = sampleBilinear(gx, gy);
      const fl  = sampleBilinear(gx - off, gy);
      const fr  = sampleBilinear(gx + off, gy);
      const fu  = sampleBilinear(gx, gy - off);
      const fd  = sampleBilinear(gx, gy + off);
      const ful = sampleBilinear(gx - offD, gy - offD);
      const fur = sampleBilinear(gx + offD, gy - offD);
      const fdl = sampleBilinear(gx - offD, gy + offD);
      const fdr = sampleBilinear(gx + offD, gy + offD);
      const f = (fc * 1.6 + (fl + fr + fu + fd) + (ful + fur + fdl + fdr) * 0.7) / 8.4;
      let t = (0.22 - f) / 0.015;
      t = t <= 0 ? 0 : (t >= 1 ? 1 : t * t * (3 - 2 * t));
      const idx = (py * W + px) * 4;
      data[idx] = 100;
      data[idx + 1] = 116;
      data[idx + 2] = 139;
      data[idx + 3] = Math.round(t * 68);
    }
  }
  cctx.putImageData(img, 0, 0);
  C2D_LOS_CANVAS = c;
  C2D_LOS_KEY = losData;
  return c;
}

function render() {
  const rect = canvas.parentElement.getBoundingClientRect();
  const cw = Math.max(1, Math.floor(rect.width));
  const ch = Math.max(1, Math.floor(rect.height));
  const glCanvas = document.getElementById("glCanvas");
  if (canvas.width !== cw || canvas.height !== ch) {
    canvas.width = cw;
    canvas.height = ch;
  }
  if (glCanvas && (glCanvas.width !== cw || glCanvas.height !== ch)) {
    glCanvas.width = cw;
    glCanvas.height = ch;
  }
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  if (!STATE || !STATE.grid) return;

  const g = STATE.grid;
  const s = VIEW.pxSize;
  const rev = g.terrain_revision || 1;

  // === Layer 0: 小地图直走单层 Canvas2D 避免 WebGL2 跨层合成伪影；大图走 WebGL2 256x256 流式瓦片 ===
  if (g.large_grid && RENDERER_MODE === "WebGL2" && GL && GL_PROG) {
    if (glCanvas && glCanvas.style.display !== "block") glCanvas.style.display = "block";
    GL.viewport(0, 0, glCanvas.width, glCanvas.height);
    GL.clearColor(1.0, 1.0, 1.0, 1.0);
    GL.clear(GL.COLOR_BUFFER_BIT);
    GL.useProgram(GL_PROG);
    GL.bindVertexArray(GL_VAO);
    GL.uniform2f(GL_LOC_RES, glCanvas.width, glCanvas.height);
    GL.uniform1i(GL_LOC_TEX, 0);
    GL.uniform1i(GL_LOC_PLAIN_TEX, 1);
    GL.uniform1i(GL_LOC_FIELD_TEX, 2);
    GL.uniform1i(GL_LOC_HAS_PLAIN, (ENABLE_KRAFT_PAPER && GL_PLAIN_READY) ? 1 : 0);
    GL.uniform2f(GL_LOC_GRID_SZ, g.cols, g.rows);
    if (!g.large_grid && g.terrain && GL_FIELD_REV !== rev) {
      const buf = new Uint8Array(g.rows * g.cols * 4);
      const fdGrid = g.forest_density || null;
      for (let r = 0; r < g.rows; r++) {
        const row = g.terrain[r];
        const fdRow = fdGrid ? fdGrid[r] : null;
        for (let c = 0; c < g.cols; c++) {
          const d = fdRow ? Number(fdRow[c] || 0) : 0;
          const v = d > 0 ? Math.min(255, Math.round(d * 255)) : (row[c] === 1 ? 128 : 0);
          const idx = (r * g.cols + c) * 4;
          buf[idx] = v; buf[idx + 1] = v; buf[idx + 2] = v; buf[idx + 3] = 255;
        }
      }
      if (!GL_TEX_FIELD) GL_TEX_FIELD = GL.createTexture();
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_FIELD);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MIN_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MAG_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_S, GL.CLAMP_TO_EDGE);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_T, GL.CLAMP_TO_EDGE);
      GL.texImage2D(GL.TEXTURE_2D, 0, GL.RGBA, g.cols, g.rows, 0, GL.RGBA, GL.UNSIGNED_BYTE, buf);
      GL_FIELD_READY = true;
      GL_FIELD_REV = rev;
    }
    GL.uniform1i(GL_LOC_HAS_FIELD, (LAYER_FLAGS.forestFill && GL_FIELD_READY) ? 1 : 0);
    if (ENABLE_KRAFT_PAPER && GL_PLAIN_READY && GL_TEX_PLAIN) {
      GL.activeTexture(GL.TEXTURE1);
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_PLAIN);
    }
    if (GL_FIELD_READY && GL_TEX_FIELD) {
      GL.activeTexture(GL.TEXTURE2);
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_FIELD);
    }
    GL.activeTexture(GL.TEXTURE0);
    if (!g.large_grid) {
      GL.uniform4f(GL_LOC_RECT, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      GL.uniform4f(GL_LOC_TILE_UV, 0, 0, g.cols, g.rows);
      GL.drawArrays(GL.TRIANGLES, 0, 6);
    } else if (TILE_STREAM_SUPPORTED) {
      requestVisibleTiles();
      const bounds = getVisibleTileBounds();
      if (bounds) {
        for (let tr = bounds.trMin; tr <= bounds.trMax; tr++) {
          for (let tc = bounds.tcMin; tc <= bounds.tcMax; tc++) {
            const ent = TILE_CACHE.get(`${rev}:${tr}:${tc}`);
            if (!ent) continue;
            ensureTileUploaded(ent);
            if (!ent.tex) continue;
            GL.bindTexture(GL.TEXTURE_2D, ent.tex);
            const x0 = VIEW.offsetX + tc * TILE_SIZE * s;
            const y0 = VIEW.offsetY + tr * TILE_SIZE * s;
            GL.uniform4f(GL_LOC_RECT, x0, y0, ent.w * s, ent.h * s);
            GL.uniform4f(GL_LOC_TILE_UV, tc * TILE_SIZE, tr * TILE_SIZE, ent.w, ent.h);
            GL.drawArrays(GL.TRIANGLES, 0, 6);
          }
        }
      }
    }
  } else if (!g.large_grid) {
    if (glCanvas && glCanvas.style.display !== "none") glCanvas.style.display = "none";
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    const fieldCvs = LAYER_FLAGS.forestFill ? ensureC2DFieldCanvas(g, rev) : null;
    if (fieldCvs) {
      ctx.save();
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(fieldCvs, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.restore();
    } else {
      ctx.fillStyle = "#f7f7f4";
      ctx.fillRect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
    }
    if (ENABLE_KRAFT_PAPER && PLAIN_PATTERN) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.clip();
      ctx.globalCompositeOperation = "multiply";
      ctx.globalAlpha = 0.55;
      ctx.translate(VIEW.offsetX, VIEW.offsetY);
      const patScale = (s * 8.0) / Math.max(1, PLAIN_TEX_IMG.naturalWidth || 512);
      ctx.scale(patScale, patScale);
      ctx.fillStyle = PLAIN_PATTERN;
      ctx.fillRect(0, 0, (g.cols * s) / patScale, (g.rows * s) / patScale);
      ctx.restore();
    }
  } else if (TILE_STREAM_SUPPORTED) {
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#f7f7f4";
    ctx.fillRect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
    requestVisibleTiles();
    const bounds = getVisibleTileBounds();
    if (bounds) {
      ctx.save();
      ctx.imageSmoothingEnabled = s < 1.5;
      for (let tr = bounds.trMin; tr <= bounds.trMax; tr++) {
        for (let tc = bounds.tcMin; tc <= bounds.tcMax; tc++) {
          const ent = TILE_CACHE.get(`${rev}:${tr}:${tc}`);
          if (!ent) continue;
          ensureTileUploaded(ent);
          if (!ent.c2d) continue;
          const x0 = VIEW.offsetX + tc * TILE_SIZE * s;
          const y0 = VIEW.offsetY + tr * TILE_SIZE * s;
          ctx.drawImage(ent.c2d, x0, y0, ent.w * s, ent.h * s);
        }
      }
      ctx.restore();
    }
    if (ENABLE_KRAFT_PAPER && PLAIN_PATTERN) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.clip();
      ctx.globalCompositeOperation = "multiply";
      ctx.globalAlpha = 0.55;
      ctx.translate(VIEW.offsetX, VIEW.offsetY);
      const patScale = (s * 8.0) / Math.max(1, PLAIN_TEX_IMG.naturalWidth || 512);
      ctx.scale(patScale, patScale);
      ctx.fillStyle = PLAIN_PATTERN;
      ctx.fillRect(0, 0, (g.cols * s) / patScale, (g.rows * s) / patScale);
      ctx.restore();
    }
  } else {
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(TERRAIN_CANVAS, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
  }

  // === Layer 0.25: 军用方里网 (细锐利正交参考线，视口裁剪与自适应步长) ===
  if (LAYER_FLAGS.gridLines && s >= 8) {
    const step = s >= 20 ? 1 : (s >= 10 ? 2 : 4);
    const r0 = Math.max(0, Math.floor(-VIEW.offsetY / s));
    const r1 = Math.min(g.rows, Math.ceil((canvas.height - VIEW.offsetY) / s));
    const c0 = Math.max(0, Math.floor(-VIEW.offsetX / s));
    const c1 = Math.min(g.cols, Math.ceil((canvas.width - VIEW.offsetX) / s));
    const startR = Math.floor(r0 / step) * step;
    const startC = Math.floor(c0 / step) * step;

    ctx.save();
    ctx.strokeStyle = "rgba(0, 0, 0, 0.16)";
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    for (let r = Math.max(step, startR); r <= r1; r += step) {
      if (r > g.rows) break;
      const y = VIEW.offsetY + r * s;
      ctx.moveTo(VIEW.offsetX, y);
      ctx.lineTo(VIEW.offsetX + g.cols * s, y);
    }
    for (let c = Math.max(step, startC); c <= c1; c += step) {
      if (c > g.cols) break;
      const x = VIEW.offsetX + c * s;
      ctx.moveTo(x, VIEW.offsetY);
      ctx.lineTo(x, VIEW.offsetY + g.rows * s);
    }
    ctx.stroke();
    ctx.restore();
  }

  // === Layer 0.5: 矢量线条树枝贴图 (视口裁剪 + 按像素容器连续树密度 0.0..1.0 渲染) ===
  if (LAYER_FLAGS.forestTrees && FOREST_TREE_READY && !g.large_grid && g.terrain) {
    const rMin = Math.max(0, Math.floor(-VIEW.offsetY / s) - 1);
    const rMax = Math.min(g.rows - 1, Math.ceil((canvas.height - VIEW.offsetY) / s) + 1);
    const cMin = Math.max(0, Math.floor(-VIEW.offsetX / s) - 1);
    const cMax = Math.min(g.cols - 1, Math.ceil((canvas.width - VIEW.offsetX) / s) + 1);
    const fdGrid = g.forest_density || null;
    const treePlacements = [];
    for (let r = rMin; r <= rMax; r++) {
      const row = g.terrain[r];
      if (!row) continue;
      const fdRow = fdGrid ? fdGrid[r] : null;
      for (let c = cMin; c <= cMax; c++) {
        const rawD = fdRow ? Number(fdRow[c] || 0) : 0;
        const density = rawD > 0 ? Math.min(1.0, rawD) : (row[c] === 1 ? 0.5 : 0.0);
        if (density <= 0.0) continue;
        const h1 = ((r * 73856093) ^ (c * 19349663)) >>> 0;
        // Continuous density -> smooth tree count (0.0..1.0 -> 1..4 trees with stochastic fractional rounding)
        const expected = density * 3.6;
        const baseN = Math.floor(expected);
        const frac = expected - baseN;
        const extra = ((h1 & 0xff) / 255.0) < frac ? 1 : 0;
        const nTrees = Math.max(density >= 0.15 ? 1 : 0, baseN + extra);
        for (let k = 0; k < nTrees; k++) {
          const hk = ((h1 ^ (k * 83492791)) >>> 0);
          const vIdx = hk % 4;
          const spread = nTrees === 1 ? 0.24 : 0.42;
          const ox = (((hk & 0xff) / 255.0) - 0.5) * spread * s;
          const oy = ((((hk >> 8) & 0xff) / 255.0) - 0.5) * spread * s;
          const sc = (nTrees <= 1 ? 0.62 : 0.48) + (((hk >> 16) & 0xff) / 255.0) * 0.18;
          const rot = ((((hk >> 24) & 0xff) / 255.0) - 0.5) * 0.10;
          const cx = VIEW.offsetX + (c + 0.5) * s + ox;
          const cy = VIEW.offsetY + (r + 0.5) * s + oy;
          treePlacements.push({ vIdx, cx, cy, sc, rot });
        }
      }
    }
    treePlacements.sort((a, b) => a.cy - b.cy);
    for (const tp of treePlacements) {
      const img = FOREST_TREE_IMGS[tp.vIdx];
      if (!img || !img.complete || img.naturalWidth === 0) continue;
      const drawW = s * tp.sc * 0.80;
      const drawH = drawW * 1.32;
      ctx.save();
      ctx.translate(tp.cx, tp.cy);
      ctx.rotate(tp.rot);
      ctx.drawImage(img, -drawW * 0.5, -drawH * 0.78, drawW, drawH);
      ctx.restore();
    }
  }

  ctx.strokeStyle = "#334155";
  ctx.lineWidth = 1;
  ctx.strokeRect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);

  for (const st of (g.stashes || STATE.stashes || [])) {
    const [sx, sy] = pxToScreen(st.px[0], st.px[1]);
    ctx.fillStyle = "#fde047";
    ctx.strokeStyle = "#000";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.rect(sx - 5, sy - 5, 10, 10);
    ctx.fill(); ctx.stroke();
  }

  // === Layer 3: 武器射界与直瞄 LOS 平滑盲区阴影遮罩 (去方块化) ===
  if (LAYER_FLAGS.losShadow && document.getElementById("chkL3").checked && LOS_DATA && LOS_DATA.cells) {
    if (!g.large_grid) {
      const losCvs = ensureC2DLOSCanvas(g, LOS_DATA);
      if (losCvs) {
        ctx.save();
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(losCvs, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
        ctx.restore();
      }
    } else {
      for (const [r, c, eff] of LOS_DATA.cells) {
        const alpha = Math.min(0.45, 0.10 + eff * 0.35);
        ctx.fillStyle = LOS_DATA.indirect ? `rgba(249,115,22,${alpha})` : `rgba(239,68,68,${alpha})`;
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    for (const te of (LOS_DATA.targetable_enemies || [])) {
      const [ex, ey] = pxToScreen(te.px[0], te.px[1]);
      ctx.strokeStyle = "#f59e0b";
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(ex, ey, Math.max(9, s * 0.8), 0, Math.PI * 2); ctx.stroke();
    }
  }

  // === Layer 1: 已确认 AO、有效指挥半径与严格按单指挥官权限过滤的通联连线 ===
  if (document.getElementById("chkL1").checked) {
    for (const ao of (STATE.ao_zones || [])) {
      ctx.fillStyle = ao.writable ? "rgba(56,189,248,0.16)" : "rgba(34,197,94,0.12)";
      for (const [r, c] of (ao.cells || [])) {
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    ctx.strokeStyle = "rgba(250,204,21,0.55)";
    ctx.lineWidth = 1.5;
    for (const [a, b] of (g.wires || STATE.wires || [])) {
      const [x1, y1] = pxToScreen(a[0], a[1]);
      const [x2, y2] = pxToScreen(b[0], b[1]);
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    }
    const selfCmd = (STATE.commanders || []).find(c => c.is_self);
    if (LAYER_FLAGS.cmdRadius && selfCmd) {
      const cpos = selfCmd.pos || selfCmd.px;
      const [cx, cy] = pxToScreen(cpos[0], cpos[1]);
      const radPx = (selfCmd.radius_km * 1000.0 / g.cell_m) * s;
      ctx.strokeStyle = selfCmd.radio_silence ? "rgba(245,158,11,0.75)" : "rgba(56,189,248,0.6)";
      ctx.setLineDash([]);
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(cx, cy, radPx, 0, Math.PI * 2); ctx.stroke();
    }
    if (LAYER_FLAGS.cmdLinks && (STATE.layer1_links || []).length > 0) {
      ctx.save();
      ctx.setLineDash([6, 4]);
      ctx.lineDashOffset = -(performance.now() * 0.024) % 10;
      ctx.lineWidth = 2;
      for (const ln of STATE.layer1_links) {
        const [x1, y1] = pxToScreen(ln.from[0], ln.from[1]);
        const [x2, y2] = pxToScreen(ln.to[0], ln.to[1]);
        ctx.strokeStyle = ln.kind === "proximity" ? "#a855f7" : "#0ea5e9";
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
      }
      ctx.restore();
    }
    for (const fl of (STATE.typed_frontlines || [])) {
      const st = frontlineStyle(fl.unit_type_mask);
      drawPolylineWithNormal(fl.points_px, fl.front_normal, st.color, false, st.label);
    }
    for (const p of (STATE.own_pieces || [])) {
      if ((p.readable_line !== false) && p.planned_route && p.planned_route.path && p.planned_route.path.length > 1) {
        ctx.strokeStyle = "rgba(52,211,153,0.85)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        p.planned_route.path.forEach(([r, c], idx) => {
          const [px, py] = pxToScreen(r, c);
          if (idx === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        });
        ctx.stroke();
      }
    }
  }

  // === Layer 2: 下一回合草稿线、分兵种战线草稿 & 实时校验 AO 预览 ===
  if (document.getElementById("chkL2").checked) {
    if (DRAFTS.ao_preview && DRAFTS.ao_preview.cells) {
      ctx.fillStyle = DRAFTS.ao_preview.ok ? "rgba(45,212,191,0.28)" : "rgba(239,68,68,0.38)";
      for (const [r, c] of DRAFTS.ao_preview.cells) {
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    for (const ao of DRAFTS.ao_zones) {
      ctx.fillStyle = "rgba(45,212,191,0.22)";
      for (const [r, c] of ao.cells) ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
    }
    for (const fl of DRAFTS.typed_frontlines) {
      const st = frontlineStyle(fl.unit_type_mask);
      drawPolylineWithNormal(fl.points_px, fl.front_normal, st.color, true, `草稿:${st.label}`);
    }
    if (DRAFTS.active_frontline_pts.length > 0) {
      ctx.strokeStyle = "#fde047";
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      DRAFTS.active_frontline_pts.forEach(([r, c], idx) => {
        const [sx, sy] = pxToScreen(r, c);
        if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = "#fde047";
      for (const [r, c] of DRAFTS.active_frontline_pts) {
        const [sx, sy] = pxToScreen(r, c);
        ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
      }
    }
    for (const bo of DRAFTS.baguwen_orders) {
      const [tx, ty] = pxToScreen(bo.target_px[0], bo.target_px[1]);
      ctx.strokeStyle = "#f472b6";
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      const selfCmd = (STATE.commanders || []).find(c => c.is_self);
      if (selfCmd) {
        const [cx, cy] = pxToScreen(selfCmd.px[0], selfCmd.px[1]);
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(tx, ty); ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.fillStyle = "#f472b6";
      ctx.beginPath(); ctx.arc(tx, ty, 5, 0, Math.PI * 2); ctx.fill();
    }
  }

  // 敌军接触（高对比度红菱形）
  for (const ec of (STATE.enemy_contacts || STATE.visible_enemies || [])) {
    const [ex, ey] = pxToScreen(ec.px[0], ec.px[1]);
    ctx.fillStyle = "#ef4444";
    ctx.strokeStyle = "#ffffff";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(ex, ey - 8); ctx.lineTo(ex + 8, ey); ctx.lineTo(ex, ey + 8); ctx.lineTo(ex - 8, ey);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.fillStyle = "#fecaca";
    ctx.font = "bold 10px Consolas, monospace";
    const elabel = ec.name || (ec.est_persons ? `${ec.id} (~${ec.est_persons}人)` : ec.id) || "敌情";
    ctx.fillText(elabel, ex + 10, ey + 3);
  }

  // === 基础战术标志图层 (行军 / 进攻 / 占领线 / 进攻受阻 / 撤退) ===
  if (document.getElementById("chkL2").checked) {
    drawTacticalMarksShowcase(g, s);
  }

  // === 直控移动 / 攻击路径与正在绘制的战术线 ===
  const resolveLiveTargetPos = (tid) => {
    if (!tid) return null;
    if (RENDER_POS[tid]) return RENDER_POS[tid];
    const tc = (STATE.commanders || []).find(x => x.id === tid);
    if (tc && tc.alive !== false) return tc.pos || tc.px;
    const tp = (STATE.own_pieces || []).find(x => x.id === tid);
    if (tp && tp.persons > 0) return tp.pos || tp.px;
    return null;
  };
  const drawDirectPlan = (startPos, plan, rangeM = 450, pieceQueue = null, entId = null) => {
    try {
      if (!startPos || !Array.isArray(startPos) || startPos.length < 2 || Number.isNaN(startPos[0]) || Number.isNaN(startPos[1])) return;
      if (!plan && (!pieceQueue || pieceQueue.length === 0) && (!DIRECT_PICK || DIRECT_PICK.targetId !== entId)) return;
      const showL1 = document.getElementById("chkL1").checked;
      const showL2 = document.getElementById("chkL2").checked;

      if (plan && plan.action === "attack") {
        if (!showL1 && !showL2) return;
        const tp = resolveLiveTargetPos(plan.target_unit_id) || plan.target_pos;
        if (!tp || !Array.isArray(tp) || tp.length < 2 || Number.isNaN(tp[0]) || Number.isNaN(tp[1])) return;
        const [x1, y1] = pxToScreen(startPos[0], startPos[1]);
        const [x2, y2] = pxToScreen(tp[0], tp[1]);
        const now = performance.now();
        ctx.save();
        // 1. 武器有效射程圈
        const rangePx = (rangeM / g.cell_m) * s;
        ctx.strokeStyle = "rgba(220, 38, 38, 0.25)";
        ctx.lineWidth = 1.2;
        ctx.setLineDash([4, 4]);
        ctx.beginPath(); ctx.arc(x1, y1, rangePx, 0, Math.PI * 2); ctx.stroke();

        // 2. 散布圈 (Dispersion Circle) 跟随目标中心
        const outOfAmmo = Boolean(plan.out_of_ammo);
        const dispM = plan.dispersion_m || 35;
        const dispPx = Math.max(10, (dispM / g.cell_m) * s);
        ctx.fillStyle = outOfAmmo ? "rgba(28, 25, 23, 0.22)" : (plan.last_los_blocked ? "rgba(156, 163, 175, 0.14)" : "rgba(220, 38, 38, 0.14)");
        ctx.strokeStyle = outOfAmmo ? "#1c1917" : (plan.last_los_blocked ? "#9ca3af" : "rgba(220, 38, 38, 0.85)");
        ctx.lineWidth = outOfAmmo ? 2.0 : 1.6;
        ctx.setLineDash(outOfAmmo ? [] : [5, 3]);
        ctx.beginPath(); ctx.arc(x2, y2, dispPx, 0, Math.PI * 2); ctx.stroke();
        ctx.fill();

        // 3. 动态火线 + 曳光弹道脉冲 (弹药耗尽时变黑且无动画)
        ctx.strokeStyle = outOfAmmo ? "#1c1917" : (plan.last_los_blocked ? "#9ca3af" : "#dc2626");
        ctx.lineWidth = outOfAmmo ? 1.6 : 2.2;
        if (outOfAmmo) {
          ctx.setLineDash([4, 4]);
        } else {
          ctx.setLineDash([8, 5]);
          ctx.lineDashOffset = -(now * 0.06) % 13;
        }
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
        ctx.setLineDash([]);
        drawArrowHead(x1, y1, x2, y2, 8, ctx.strokeStyle, true);

        if (!outOfAmmo && !plan.last_los_blocked) {
          for (let k = 0; k < 2; k++) {
            const t = ((now * 0.0018) + k * 0.5) % 1;
            const bx = x1 + (x2 - x1) * t;
            const by = y1 + (y2 - y1) * t;
            ctx.fillStyle = "#fde047";
            ctx.beginPath(); ctx.arc(bx, by, 3.2, 0, Math.PI * 2); ctx.fill();
          }
          // 散布圈内随机弹着火花动画
          for (let k = 0; k < 3; k++) {
            const seed = Math.floor(now / 160) * 7 + k * 31;
            const ang = (seed * 1.91) % (Math.PI * 2);
            const rad = ((seed * 0.618) % 1) * dispPx * 0.8;
            const fx = x2 + Math.cos(ang) * rad;
            const fy = y2 + Math.sin(ang) * rad;
            ctx.fillStyle = "rgba(251, 146, 60, 0.85)";
            ctx.beginPath(); ctx.arc(fx, fy, 2.5, 0, Math.PI * 2); ctx.fill();
          }
        }
        if (!outOfAmmo && plan.last_fire_summary) {
          ctx.font = "bold 10.5px Consolas, Microsoft YaHei, sans-serif";
          ctx.fillStyle = "#991b1b";
          ctx.fillText(plan.last_fire_summary, x2 + dispPx + 6, y2 - 4);
        }
        ctx.restore();
        return;
      }
      if (!showL2) return;
      if (plan && plan.action === "retreat" && (!plan.waypoints || plan.waypoints.length === 0)) {
        const [sx0, sy0] = pxToScreen(startPos[0], startPos[1]);
        ctx.save();
        ctx.strokeStyle = "#7c3aed";
        ctx.lineWidth = 2.2;
        ctx.setLineDash([5, 3]);
        ctx.beginPath(); ctx.arc(sx0, sy0, 18, 0, Math.PI * 2); ctx.stroke();
        ctx.font = "bold 10px Microsoft YaHei, sans-serif";
        ctx.fillStyle = "#6d28d9";
        ctx.fillText("不可逆溃退", sx0 + 16, sy0 - 8);
        ctx.restore();
        return;
      }
      const steps = (Array.isArray(pieceQueue) && pieceQueue.length > 0)
        ? pieceQueue
        : (Array.isArray(plan && plan.segments) && plan.segments.length > 0
            ? plan.segments
            : (plan && plan.target_pos
                ? [{ goal: plan.target_pos, action: plan.action, move_mode: plan.move_mode, fire_mode: plan.fire_mode }]
                : []));

      const hasWaypoints = plan && Array.isArray(plan.waypoints) && plan.waypoints.length > 0;
      if (!hasWaypoints && steps.length === 0 && (!DIRECT_PICK || DIRECT_PICK.targetId !== entId)) return;

      const isAssault = (plan && plan.action === "assault") || (steps[0] && steps[0].action === "assault");
      const isRetreat = (plan && plan.action === "retreat") || (steps[0] && steps[0].action === "retreat");
      const color = isRetreat ? "#7c3aed" : (isAssault ? "#dc2626" : "#0284c7");

      ctx.save();
      let [sx, sy] = pxToScreen(startPos[0], startPos[1]);
      let prev = [sx, sy];
      let lastGoalPos = startPos;

      // 1. 绘制规划路径折线
      ctx.strokeStyle = color;
      ctx.lineWidth = isAssault ? 3.0 : 2.4;
      ctx.setLineDash(isAssault ? [10, 4] : [7, 4]);
      ctx.beginPath();
      ctx.moveTo(sx, sy);

      if (hasWaypoints) {
        for (let i = 0; i < plan.waypoints.length; i++) {
          const wp = plan.waypoints[i];
          if (!wp || !Array.isArray(wp) || wp.length < 2 || Number.isNaN(wp[0]) || Number.isNaN(wp[1])) continue;
          const [wx, wy] = pxToScreen(wp[0], wp[1]);
          ctx.lineTo(wx, wy);
          prev = [sx, sy];
          sx = wx; sy = wy;
        }
        lastGoalPos = plan.waypoints[plan.waypoints.length - 1] || startPos;
      } else if (steps.length > 0) {
        for (let i = 0; i < steps.length; i++) {
          const g = steps[i] && steps[i].goal;
          if (!g || !Array.isArray(g) || g.length < 2 || Number.isNaN(g[0]) || Number.isNaN(g[1])) continue;
          const [gx, gy] = pxToScreen(g[0], g[1]);
          ctx.lineTo(gx, gy);
          prev = [sx, sy];
          sx = gx; sy = gy;
        }
        lastGoalPos = (steps[steps.length - 1] && steps[steps.length - 1].goal) || startPos;
      }
      ctx.stroke();
      ctx.setLineDash([]);
      if (prev[0] !== sx || prev[1] !== sy) {
        drawArrowHead(prev[0], prev[1], sx, sy, isAssault ? 11 : 9, color, isAssault);
      }

      // 2. 在每个任务步骤的终点绘制 ①、②、③ 徽标与行动模式标签
      const BADGE_SYMBOLS = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨", "⑩", "⑪", "⑫", "⑬", "⑭", "⑮", "⑯"];
      for (let i = 0; i < steps.length; i++) {
        const st = steps[i];
        if (!st) continue;
        const g = st.goal || startPos;
        if (!g || !Array.isArray(g) || g.length < 2 || Number.isNaN(g[0]) || Number.isNaN(g[1])) continue;
        const [gx, gy] = pxToScreen(g[0], g[1]);
        const stAct = st.action || "move";
        const stMm = st.move_mode || "normal";
        const stFm = st.fire_mode || "stop_to_fire";
        const stColor = stAct === "assault" ? "#dc2626" : (stAct === "attack" ? "#ea580c" : (stAct === "stop" ? "#4b5563" : "#0284c7"));
        const badgeSym = BADGE_SYMBOLS[i] || `[${i + 1}]`;

        // 徽章圆圈
        ctx.fillStyle = stColor;
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(gx, gy, 7, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 9.5px Consolas, Microsoft YaHei, monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(badgeSym, gx, gy);

        // 药丸标牌 [动作·速度/开火]
        const actLabel = stAct === "assault" ? "进攻" : (stAct === "attack" ? "射击" : (stAct === "stop" ? "驻止" : "机动"));
        const mmLabel = stMm === "fast" ? "快" : (stMm === "slow" ? "渗透" : "常");
        const fmLabel = ""; // fire_on_the_move 已正式注销，转为跃进交替预制宏
        const pillText = `${actLabel}·${mmLabel}${fmLabel ? "·" + fmLabel : ""}`;

        ctx.font = "bold 9px Microsoft YaHei, sans-serif";
        const txtW = ctx.measureText(pillText).width;
        const pillX = gx + 9;
        const pillY = gy - 7;
        ctx.fillStyle = "rgba(255, 255, 255, 0.92)";
        ctx.strokeStyle = stColor;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect ? ctx.roundRect(pillX, pillY, txtW + 8, 14, 2) : ctx.rect(pillX, pillY, txtW + 8, 14);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = stColor;
        ctx.textAlign = "left";
        ctx.textBaseline = "middle";
        ctx.fillText(pillText, pillX + 4, pillY + 7);
      }

      // 3. 动态光标橡皮筋预览线 (Rubber-band Preview)
      if (DIRECT_PICK && DIRECT_PICK.targetId === entId && PLAN_HOVER_POS && Array.isArray(PLAN_HOVER_POS) && PLAN_HOVER_POS.length >= 2) {
        if (lastGoalPos && Array.isArray(lastGoalPos) && lastGoalPos.length >= 2 && !Number.isNaN(lastGoalPos[0]) && !Number.isNaN(lastGoalPos[1])) {
          const [lx, ly] = pxToScreen(lastGoalPos[0], lastGoalPos[1]);
          const [hx, hy] = pxToScreen(PLAN_HOVER_POS[0], PLAN_HOVER_POS[1]);
          const hoverDistKm = Math.hypot(PLAN_HOVER_POS[0] - lastGoalPos[0], PLAN_HOVER_POS[1] - lastGoalPos[1]) * (STATE.grid.cell_m / 1000.0);

          ctx.strokeStyle = "#0284c7";
          ctx.lineWidth = 2.2;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.moveTo(lx, ly);
          ctx.lineTo(hx, hy);
          ctx.stroke();
          ctx.setLineDash([]);
          drawArrowHead(lx, ly, hx, hy, 9, "#0284c7", false);

          // 光标处的幽灵徽标
          ctx.fillStyle = "rgba(2, 132, 199, 0.85)";
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(hx, hy, 7, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#ffffff";
          ctx.font = "bold 10px Consolas, monospace";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText("+", hx, hy);

          const previewText = `+ 第${steps.length + 1}步 · ${hoverDistKm.toFixed(2)}km`;
          ctx.font = "bold 9px Microsoft YaHei, sans-serif";
          const pw = ctx.measureText(previewText).width;
          ctx.fillStyle = "rgba(2, 132, 199, 0.9)";
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.roundRect ? ctx.roundRect(hx + 10, hy - 7, pw + 8, 14, 2) : ctx.rect(hx + 10, hy - 7, pw + 8, 14);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#ffffff";
          ctx.textAlign = "left";
          ctx.textBaseline = "middle";
          ctx.fillText(previewText, hx + 14, hy);
        }
      }

      ctx.restore();
    } catch (err) {
      console.error("drawDirectPlan error:", err);
      try { ctx.restore(); } catch (_) {}
    }
  };
  for (const c of (STATE.commanders || [])) {
    if (c.direct_order || (c.task_queue && c.task_queue.length > 0) || (DIRECT_PICK && DIRECT_PICK.targetId === c.id)) {
      drawDirectPlan(RENDER_POS[c.id] || c.pos || c.px, c.direct_order, c.primary_range_m || 400, c.task_queue, c.id);
    }
  }
  for (const p of (STATE.own_pieces || [])) {
    if (p.direct_order || (p.task_queue && p.task_queue.length > 0) || (DIRECT_PICK && DIRECT_PICK.targetId === p.id)) {
      drawDirectPlan(RENDER_POS[p.id] || p.pos || p.px, p.direct_order, p.primary_range_m || 450, p.task_queue, p.id);
    }
  }
  // V3.3 Draft Preview Overlay for Multi-Window Mission & Event Drafting (Layer 2)
  if (document.getElementById("chkL2").checked) {
    if (MISSION_WINDOWS.length > 0) {
      const chainTailByTarget = {};
      for (const mw of MISSION_WINDOWS) {
        const ent = resolveTargetEntity(mw.targetKind, mw.targetId);
        if (!ent) continue;
        let startPos = RENDER_POS[mw.targetId] || RENDER_POS[mw.pieceId] || ent.pos;
        if (mw.append && chainTailByTarget[mw.targetId]) {
          startPos = chainTailByTarget[mw.targetId];
        } else if (mw.append && ent.taskQueue && ent.taskQueue.length > 0) {
          const lastQ = ent.taskQueue[ent.taskQueue.length - 1];
          if (lastQ && Array.isArray(lastQ.goal)) startPos = lastQ.goal;
        }
        const isAct = mw.winId === (ACTIVE_MISSION_WIN_ID || MISSION_WINDOWS[MISSION_WINDOWS.length - 1].winId);
        const col = mw.action === "assault" ? "#ef4444" : (mw.action === "attack" ? "#f97316" : (mw.action === "retreat" ? "#8b5cf6" : "#06b6d4"));
        ctx.save();
        let [sx, sy] = pxToScreen(startPos[0], startPos[1]);
        let tailPos = startPos;
        if (mw.waypoints.length > 0) {
          ctx.strokeStyle = col;
          ctx.lineWidth = isAct ? 2.6 : 1.8;
          ctx.setLineDash([5, 4]);
          ctx.beginPath();
          ctx.moveTo(sx, sy);
          for (let i = 0; i < mw.waypoints.length; i++) {
            const wp = mw.waypoints[i];
            const [wx, wy] = pxToScreen(wp[0], wp[1]);
            ctx.lineTo(wx, wy);
            sx = wx; sy = wy;
            tailPos = wp;
          }
          ctx.stroke();
          ctx.setLineDash([]);
          mw.waypoints.forEach((wp, i) => {
            const [wx, wy] = pxToScreen(wp[0], wp[1]);
            ctx.fillStyle = col;
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 1.5;
            ctx.beginPath(); ctx.arc(wx, wy, 7, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
            ctx.fillStyle = "#ffffff";
            ctx.font = "bold 9px Consolas, sans-serif";
            ctx.textAlign = "center"; ctx.textBaseline = "middle";
            ctx.fillText(`#${mw.seq}.${i + 1}`, wx, wy - 13);
          });
        }
        if (isAct && PLAN_HOVER_POS && mw.action !== "stop" && mw.action !== "retreat") {
          const [lx, ly] = pxToScreen(tailPos[0], tailPos[1]);
          const [hx, hy] = pxToScreen(PLAN_HOVER_POS[0], PLAN_HOVER_POS[1]);
          ctx.strokeStyle = col;
          ctx.lineWidth = 2.0;
          ctx.setLineDash([4, 4]);
          ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(hx, hy); ctx.stroke();
          ctx.setLineDash([]);
          ctx.fillStyle = col;
          ctx.font = "bold 10px Microsoft YaHei, sans-serif";
          ctx.textAlign = "left";
          ctx.fillText(`草稿#${mw.seq} +点`, hx + 10, hy);
        }
        ctx.restore();
        chainTailByTarget[mw.targetId] = tailPos;
      }
    }
    for (const ew of EVENT_WINDOWS) {
      if (!ew.in_place && Array.isArray(ew.target_px)) {
        const [ex, ey] = pxToScreen(ew.target_px[0], ew.target_px[1]);
        ctx.save();
        ctx.strokeStyle = "#f59e0b";
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(ex, ey, 11, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = "#f59e0b";
        ctx.font = "bold 9.5px Microsoft YaHei, sans-serif";
        ctx.fillText(`事件#${ew.seq}`, ex + 12, ey);
        ctx.restore();
      }
    }
    if (CMD_DRAW && CMD_DRAW.pts && CMD_DRAW.pts.length > 0) {
      ctx.save();
      ctx.strokeStyle = CMD_DRAW.color || "#1d4ed8";
      ctx.lineWidth = 2.6;
      ctx.setLineDash([6, 4]);
      ctx.beginPath();
      CMD_DRAW.pts.forEach(([r, c], idx) => {
        const [sx, sy] = pxToScreen(r, c);
        if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = CMD_DRAW.color || "#1d4ed8";
      for (const [r, c] of CMD_DRAW.pts) {
        const [sx, sy] = pxToScreen(r, c);
        ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
    }
    if (ERASE_HOVER && ERASE_HOVER.pts && ERASE_HOVER.pts.length >= 2) {
      ctx.save();
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.strokeStyle = "rgba(251, 146, 60, 0.55)";
      ctx.lineWidth = 9;
      ctx.beginPath();
      ERASE_HOVER.pts.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.strokeStyle = "#fef08a";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ERASE_HOVER.pts.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      if (ERASE_HOVER.dispCircle) {
        const [cx, cy, cr] = ERASE_HOVER.dispCircle;
        ctx.strokeStyle = "#fef08a";
        ctx.fillStyle = "rgba(251, 146, 60, 0.25)";
        ctx.lineWidth = 2.4;
        ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      }
      ctx.restore();
    }
    if (ERASE_LINE_PTS && ERASE_LINE_PTS.length >= 2) {
      ctx.save();
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.strokeStyle = "rgba(249, 115, 22, 0.35)";
      ctx.lineWidth = 8;
      ctx.beginPath();
      ERASE_LINE_PTS.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.strokeStyle = "#ef4444";
      ctx.lineWidth = 2.6;
      ctx.setLineDash([7, 4]);
      ctx.beginPath();
      ERASE_LINE_PTS.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    }
  }

  // 地面掉落物（枪械=🔫、重伤失能=红骷髅💀、阵亡遗体=黑骷髅☠ - 归入 Layer 1 物理事实）
  if (document.getElementById("chkL1").checked) {
    for (let bi = 0; bi < (STATE.ground_bodies || []).length; bi++) {
      const gb = STATE.ground_bodies[bi];
      if (!gb.pos) continue;
      const [gx, gy] = pxToScreen(gb.pos[0], gb.pos[1]);
      const ox = ((bi % 3) - 1) * 9;
      const oy = (Math.floor(bi / 3) % 2 === 0 ? 11 : -11);
      const bx = gx + ox, by = gy + oy;
      const isRed = gb.kind === "wounded";
      const isWpn = gb.kind === "weapon";
      ctx.save();
      ctx.fillStyle = isWpn ? "rgba(180, 83, 9, 0.92)" : (isRed ? "rgba(220, 38, 38, 0.92)" : "rgba(24, 24, 27, 0.92)");
      ctx.strokeStyle = isWpn ? "#fde68a" : (isRed ? "#fecaca" : "#a1a1aa");
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(bx, by, 7.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = "#ffffff";
      ctx.font = "10px Segoe UI Emoji, sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(isWpn ? "🔫" : (isRed ? "💀" : "☠"), bx, by + 0.5);
      ctx.restore();
    }
  }

  // 我军聚合/分队兵牌（深黑底高对比边框 + 重武器 +1 显示标注）
  if (LAYER_FLAGS.units) {
  const counters = computeDisplayCounters();
  for (const u of counters) {
    const [ux, uy] = pxToScreen(u.pos[0], u.pos[1]);
    const w = u.isAggregate ? 26 : (u.isHQ ? 22 : 20);
    const h = u.isAggregate ? 18 : (u.isHQ ? 15 : 14);
    const isSel = (u.id === SELECTED_PIECE_ID || u.id === SELECTED_COMMANDER_ID);
    ctx.fillStyle = u.color;
    ctx.strokeStyle = isSel ? "#f59e0b" : "#0f172a";
    ctx.lineWidth = isSel ? 2.6 : 1.5;
    ctx.fillRect(ux - w / 2, uy - h / 2, w, h);
    ctx.strokeRect(ux - w / 2, uy - h / 2, w, h);
    // 二战德军 H.Dv. 272 方案 A 战术符号与层级点圈
    ctx.save();
    ctx.strokeStyle = "#0f172a";
    ctx.fillStyle = "#0f172a";
    const ech = (u.level || (u.isHQ ? "platoon" : "squad")).toLowerCase();

    if (u.isHQ) {
      // 1. 指挥部 (HQ / Gefechtsstand)：保持左下角延伸旗杆与对应层级点数
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(ux - w / 2, uy + h / 2);
      ctx.lineTo(ux - w / 2, uy + h / 2 + 7);
      ctx.stroke();

      if (ech === "team" || ech === "trupp") {
        // 组级指挥部：空心圆圈 ○
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.8, 0, Math.PI * 2); ctx.stroke();
      } else if (ech === "squad" || ech === "gruppe") {
        // 班级指挥部：1 个实心圆点 ●
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.6, 0, Math.PI * 2); ctx.fill();
      } else if (ech === "half_platoon" || ech === "halbzug") {
        // 半排指挥部：2 个实心圆点 ●● (dx = [-2.5, 2.5])
        for (const dx of [-2.5, 2.5]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else if (ech === "company" || ech === "kompanie") {
        // 连级指挥部：双竖线 ||
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ux - 2.5, uy - h / 2 - 7); ctx.lineTo(ux - 2.5, uy - h / 2 - 1);
        ctx.moveTo(ux + 2.5, uy - h / 2 - 7); ctx.lineTo(ux + 2.5, uy - h / 2 - 1);
        ctx.stroke();
      } else if (ech === "battalion" || ech === "bataillon") {
        // 营级指挥部：三竖线 |||
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ux - 4, uy - h / 2 - 7); ctx.lineTo(ux - 4, uy - h / 2 - 1);
        ctx.moveTo(ux, uy - h / 2 - 7); ctx.lineTo(ux, uy - h / 2 - 1);
        ctx.moveTo(ux + 4, uy - h / 2 - 7); ctx.lineTo(ux + 4, uy - h / 2 - 1);
        ctx.stroke();
      } else {
        // 排级指挥部 (Zug) 及默认：3 个实心圆点 ●●● (dx = [-4, 0, 4])
        for (const dx of [-4, 0, 4]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      }
    } else {
      // 2. 常规分队 H.Dv. 272 方案 A 层级符号
      if (ech === "team" || ech === "trupp") {
        // 组 (Trupp)：顶部 1 个空心圆圈 ○ (ctx.stroke() 且无 fill)
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.8, 0, Math.PI * 2); ctx.stroke();
      } else if (ech === "half_platoon" || ech === "halbzug") {
        // 半排 (Halbzug)：顶部 2 个实心圆点 ●● (dx = [-2.5, 2.5])
        for (const dx of [-2.5, 2.5]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else if (ech === "platoon" || ech === "zug") {
        // 排 (Zug)：顶部 3 个实心圆点 ●●● (dx = [-4, 0, 4])
        for (const dx of [-4, 0, 4]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else {
        // 班 (Gruppe)：顶部 1 个实心圆点 ● (dx = 0)
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.6, 0, Math.PI * 2); ctx.fill();
      }

      // 8 类名义班组容器内部符号渲染
      ctx.strokeStyle = "rgba(255,255,255,0.78)";
      ctx.fillStyle = "rgba(255,255,255,0.78)";
      ctx.lineWidth = 1.1;
      const cType = u.container_type || (u.piece && (u.piece.container_type || (u.piece.counter && u.piece.counter.container_type))) || "infantry";
      if (cType === "recon") {
        // 侦察班 [ ╱ ]
        ctx.beginPath();
        ctx.moveTo(ux - w / 2 + 3, uy + h / 2 - 3);
        ctx.lineTo(ux + w / 2 - 3, uy - h / 2 + 3);
        ctx.stroke();
      } else if (cType === "signal") {
        // 通讯班 [ ⚡ ]
        ctx.font = "9px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("⚡", ux, uy);
      } else if (cType === "artillery") {
        // 炮组 [ • ]
        ctx.beginPath();
        ctx.arc(ux, uy, 2.4, 0, Math.PI * 2);
        ctx.fill();
      } else if (cType === "vehicle") {
        // 车组 [ ⬭ ]
        ctx.beginPath();
        ctx.ellipse(ux, uy, w / 2 - 4, h / 2 - 4, 0, 0, Math.PI * 2);
        ctx.stroke();
      } else if (cType === "hq") {
        // 指挥班 [ ⚑ ]
        ctx.font = "9px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("⚑", ux, uy);
      } else if (cType === "medic") {
        // 医疗班 [ ✚ ]
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(ux - 3.5, uy); ctx.lineTo(ux + 3.5, uy);
        ctx.moveTo(ux, uy - 3.5); ctx.lineTo(ux, uy + 3.5);
        ctx.stroke();
      } else if (cType === "engineer") {
        // 工兵班 [ ⊓⊔ ]
        ctx.beginPath();
        ctx.moveTo(ux - 4.5, uy + 2.5); ctx.lineTo(ux - 4.5, uy - 2.5); ctx.lineTo(ux, uy - 2.5); ctx.lineTo(ux, uy + 2.5);
        ctx.lineTo(ux + 4.5, uy + 2.5); ctx.lineTo(ux + 4.5, uy - 2.5);
        ctx.stroke();
      } else {
        // 步兵班 [ ✕ ] (默认)
        ctx.beginPath();
        ctx.moveTo(ux - w / 2 + 2, uy - h / 2 + 2);
        ctx.lineTo(ux + w / 2 - 2, uy + h / 2 - 2);
        ctx.moveTo(ux + w / 2 - 2, uy - h / 2 + 2);
        ctx.lineTo(ux - w / 2 + 2, uy + h / 2 - 2);
        ctx.stroke();
      }
    }
    ctx.restore();

    if (u.has_facing && u.facing_deg !== null && u.facing_deg !== undefined) {
      const rad = u.facing_deg * Math.PI / 180.0;
      ctx.strokeStyle = "#fde047";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(ux, uy);
      ctx.lineTo(ux + Math.sin(rad) * 14, uy + Math.cos(rad) * 14);
      ctx.stroke();
    }
    const excl = u.piece && u.piece.exclamation_buff;
    if (excl === "RED_EXCLAMATION" || excl === "YELLOW_EXCLAMATION") {
      const bx = ux + w / 2 + 1, by = uy - h / 2 - 1;
      ctx.fillStyle = excl === "RED_EXCLAMATION" ? "#ef4444" : "#facc15";
      ctx.strokeStyle = "#0b0f17";
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(bx, by, 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = excl === "RED_EXCLAMATION" ? "#ffffff" : "#0b0f17";
      ctx.font = "bold 10px Consolas, monospace";
      ctx.fillText("!", bx - 3, by + 3.5);
    }
    const uLabel = u.persons != null ? `${u.name} [${u.persons}]${u.bonus > 0 ? "+1" : ""}` : u.name;
    ctx.save();
    ctx.font = "bold 11px Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "rgba(255, 255, 255, 0.92)";
    ctx.lineWidth = 3;
    ctx.strokeText(uLabel, ux, uy + h / 2 + 5);
    ctx.fillStyle = "#0f172a";
    ctx.fillText(uLabel, ux, uy + h / 2 + 5);
    ctx.restore();
  }
  }
  if (typeof drawFloatTexts === "function") drawFloatTexts();
}

function rebuildVisTable() {
  const tb = document.getElementById("visTableBody");
  tb.innerHTML = "";
  for (const p of (STATE.own_pieces || [])) {
    const tr = document.createElement("tr");
    const vm = VIS_MODES[p.id] || "auto";
    const ctr = p.counter || {};
    const restr = ctr.restriction_tier || ctr.restricted_echelon || p.level;
    tr.innerHTML = `
      <td><a href="#" onclick="selectPiece('${p.id}');return false;" style="color:#93c5fd;">${p.name}</a></td>
      <td>${p.level}${ctr.display_tier_bonus ? "+1" : ""}</td>
      <td>${restr}</td>
      <td>
        <select onchange="VIS_MODES['${p.id}']=this.value;render();">
          <option value="auto" ${vm==="auto"?"selected":""}>Auto</option>
          <option value="pin" ${vm==="pin"?"selected":""}>Pin</option>
          <option value="hide" ${vm==="hide"?"selected":""}>Hide</option>
        </select>
      </td>`;
    tb.appendChild(tr);
  }
}

