function weaponIconSvg(model) {
  if (model === "lmg") {
    return `<svg width="34" height="16" viewBox="0 0 34 16"><path d="M3 10h22l5-1M8 10l-3 4M17 10l1 4M13 10V7h4v3M21 10l3 4" stroke="#1c1917" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>`;
  }
  if (model === "radio") {
    return `<svg width="26" height="18" viewBox="0 0 26 18"><rect x="7" y="7" width="10" height="9" fill="#e7e5e4" stroke="#1c1917" stroke-width="1.3"/><line x1="15" y1="7" x2="17" y2="1" stroke="#1c1917" stroke-width="1.3"/><path d="M19 3a5 5 0 0 1 0 6M21.5 1.5a7.5 7.5 0 0 1 0 9" stroke="#0ea5e9" stroke-width="1.2" fill="none"/></svg>`;
  }
  return `<svg width="30" height="18" viewBox="0 0 30 18"><circle cx="10" cy="4" r="2.2" fill="#1c1917"/><path d="M10 6.5v5.5l-3 4.5M10 12l3 4.5M7 9l6-1.5 9-2" stroke="#1c1917" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>`;
}

function weaponCnName(model) {
  if (model === "rifle") return "步枪兵";
  if (model === "lmg") return "轻机枪";
  if (model === "radio") return "电台兵";
  return model;
}

function ratioBarColor(pct) {
  if (pct >= 70) return "#16a34a";
  if (pct >= 35) return "#d97706";
  return "#dc2626";
}

function openCombatLogWin(unitTitle, statusTxt) {
  const win = document.getElementById("combatLogWin");
  const titleEl = document.getElementById("combatLogTitle");
  const bodyEl = document.getElementById("combatLogBody");
  if (!win || !titleEl || !bodyEl || !STATE) return;
  titleEl.textContent = `作战日志 · ${unitTitle}`;
  const logs = [];
  const filterId = SELECTED_COMMANDER_ID || SELECTED_PIECE_ID;
  const subIds = SELECTED_COMMANDER_ID
    ? ((STATE.commanders || []).find(c => c.id === SELECTED_COMMANDER_ID)?.subordinate_ids || [])
    : [];
  const dlogs = (STATE.direct_combat_logs || []).filter(lg => {
    if (!filterId || typeof lg === "string") return true;
    if (lg.actor_id === filterId || lg.target_id === filterId) return true;
    return subIds.includes(lg.actor_id) || (lg.target_id && subIds.includes(lg.target_id));
  });
  for (const lg of dlogs.slice().reverse()) {
    if (typeof lg === "string") {
      logs.push({ time: "实时记录", text: lg, color: "#991b1b" });
    } else {
      const tag = lg.kind === "fire" ? "射击" : (lg.kind === "move" ? "机动" : "指令");
      const color = lg.kind === "fire" ? "#dc2626" : (lg.kind === "move" ? "#0369a1" : "#57534e");
      const detail = lg.kind === "fire"
        ? `<div style="color:#57534e;font-size:10.5px;margin-top:2px;">武器: <b>${weaponCnName(lg.weapon_model)}</b> | 距离: ${Math.round(lg.dist_m)}m | 散布: ${Math.round(lg.dispersion_m)}m | 命中率: ${Math.round(lg.hit_prob * 100)}% | 耗弹: ${(lg.ammo_used_t * 1000).toFixed(1)}kg</div>`
        : "";
      logs.push({
        time: `T${lg.turn} · ${Number(lg.clock_hours).toFixed(2)}h · [${tag}]`,
        text: `${lg.message}${detail}`,
        color,
      });
    }
  }
  for (const lg of (STATE.uplink_logs || [])) {
    logs.push({ time: `T${STATE.turn ?? 0}`, text: typeof lg === "string" ? lg : (lg.text || JSON.stringify(lg)), color: "#991b1b" });
  }
  if (logs.length === 0) {
    logs.push({
      time: `T${STATE.turn ?? 0} · ${Number(STATE.clock_hours || 0).toFixed(2)}h`,
      text: `${unitTitle} 已完成战备部署，当前状态：${statusTxt}。暂无接敌或行动记录。`,
      color: "#57534e",
    });
  }
  bodyEl.innerHTML = logs.map(item => `
    <div class="cl-entry" style="border-left-color:${item.color || '#991b1b'};">
      <div class="cl-time">${item.time}</div>
      <div>${item.text}</div>
    </div>
  `).join("");
  win.classList.add("open");
}

(function initCombatLogDrag() {
  const win = document.getElementById("combatLogWin");
  const bar = document.getElementById("combatLogDragBar");
  const closeBtn = document.getElementById("combatLogCloseBtn");
  if (!win || !bar) return;
  ["mousedown", "wheel", "dblclick"].forEach(ev => {
    win.addEventListener(ev, e => e.stopPropagation());
  });
  if (closeBtn) closeBtn.addEventListener("click", () => win.classList.remove("open"));
  let drag = null;
  bar.addEventListener("mousedown", e => {
    if (e.target === closeBtn) return;
    const r = win.getBoundingClientRect();
    win.style.left = r.left + "px";
    win.style.top = r.top + "px";
    win.style.bottom = "auto";
    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  });
  window.addEventListener("mousemove", e => {
    if (!drag) return;
    win.style.left = Math.max(0, Math.min(window.innerWidth - 120, e.clientX - drag.dx)) + "px";
    win.style.top = Math.max(0, Math.min(window.innerHeight - 60, e.clientY - drag.dy)) + "px";
  });
  window.addEventListener("mouseup", () => { drag = null; });
})();



(function initTarkovWinDrag() {
  const win = document.getElementById("tarkovWin");
  const bar = document.getElementById("tarkovDragBar");
  const closeBtn = document.getElementById("tarkovCloseBtn");
  if (!win || !bar) return;
  ["mousedown", "wheel", "dblclick"].forEach(ev => {
    win.addEventListener(ev, e => e.stopPropagation());
  });
  let drag = null;
  bar.addEventListener("mousedown", e => {
    if (e.target === closeBtn) return;
    const r = win.getBoundingClientRect();
    win.style.left = r.left + "px";
    win.style.top = r.top + "px";
    drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
  });
  window.addEventListener("mousemove", e => {
    if (!drag) return;
    win.style.left = Math.max(0, Math.min(window.innerWidth - 160, e.clientX - drag.dx)) + "px";
    win.style.top = Math.max(0, Math.min(window.innerHeight - 60, e.clientY - drag.dy)) + "px";
  });
  window.addEventListener("mouseup", () => { drag = null; });
})();

let RIGHT_DRAG = null; // { startX, startY, moved }

function openStackDrawer(candidates, screenX, screenY) {
  const drawer = document.getElementById("stackListDrawer");
  const body = document.getElementById("sldBody");
  const title = document.getElementById("sldTitle");
  if (!drawer || !body) return;
  title.textContent = `叠堆单位选择 (${candidates.length} 个单位)`;
  body.innerHTML = candidates.map(u => {
    const isSel = (u.id === SELECTED_PIECE_ID || u.id === SELECTED_COMMANDER_ID);
    const orgVal = u.isHQ ? (u.hq_org ?? 100) : (u.org ?? 100);
    const persVal = u.persons ?? 0;
    const kindTxt = u.isHQ ? "指挥部" : (u.level || "班组");
    return `
      <div class="sld-item ${isSel ? "active" : ""}" data-sld-id="${u.id}" data-sld-hq="${u.isHQ ? "1" : "0"}" data-sld-agg="${u.isAggregate ? "1" : "0"}">
        <div>
          <div class="sld-item-title">${u.name}</div>
          <div class="sld-item-sub">${kindTxt} · 兵员: ${persVal}人 · Org: ${Math.round(orgVal)}%</div>
        </div>
        <div style="font-size:11px;font-weight:700;color:${isSel ? '#dc2626' : '#0284c7'};">
          ${isSel ? "选中中" : "选择 ▸"}
        </div>
      </div>
    `;
  }).join("");
  body.querySelectorAll("[data-sld-id]").forEach(item => {
    item.addEventListener("click", () => {
      const id = item.getAttribute("data-sld-id");
      const isHq = item.getAttribute("data-sld-hq") === "1";
      const isAgg = item.getAttribute("data-sld-agg") === "1";
      if (isAgg) {
        DRILLED_IDS.add(id);
        render();
      } else if (isHq) {
        selectCommander(id);
      } else {
        selectPiece(id);
      }
      closeStackDrawer();
    });
  });
  drawer.classList.add("open");
}

function closeStackDrawer() {
  const drawer = document.getElementById("stackListDrawer");
  if (drawer) drawer.classList.remove("open");
}

function setActionHint(msg) {
  const el = document.getElementById("actionHint");
  if (!el) return;
  if (!msg) {
    el.style.display = "none"; el.textContent = "";
    SHOOT_HOVER = null;
    const tipEl = document.getElementById("shootCursorTip");
    if (tipEl) tipEl.style.display = "none";
  } else {
    el.style.display = "block"; el.textContent = msg;
  }
}

function onActorChange() {
  const val = (document.getElementById("selActor") && document.getElementById("selActor").value) || "";
  const [kind, id] = val.split(":");
  if (kind && id) ACTOR = { kind, id };
  DIRECT_PICK = null;
  CMD_DRAW = null;
  setActionHint("");
  renderOrbatCard();
  render();
}

function canDirectControl(targetKind, targetId) {
  if (!STATE) return { ok: false, reason: "状态未加载" };
  if (ACTOR.kind === "unit") {
    if (targetKind === "unit" && targetId === ACTOR.id) return { ok: true };
    return { ok: false, reason: "当前身份为班组，只能直接控制自己" };
  }
  if (ACTOR.kind === "commander") {
    const actorCmd = (STATE.commanders || []).find(c => c.id === ACTOR.id);
    const actorDead = !actorCmd || actorCmd.alive === false || (actorCmd.persons !== undefined && Number(actorCmd.persons) <= 0);
    if (targetKind === "commander") {
      if (actorDead) return { ok: false, reason: "排部已阵亡 (Depot)，无法行动或指挥" };
      return targetId === ACTOR.id ? { ok: true } : { ok: false, reason: "不能直接控制其他指挥官" };
    }
    if (targetKind === "unit") {
      if (actorDead) {
        const unit = (STATE.own_pieces || []).find(p => p.id === targetId);
        return unit && Number(unit.persons || 0) > 0 ? { ok: true } : { ok: false, reason: "班组不存在或已阵亡" };
      }
      const cmd = (STATE.commanders || []).find(c => c.id === ACTOR.id);
      const unit = (STATE.own_pieces || []).find(p => p.id === targetId);
      if (!cmd || !unit) return { ok: false, reason: "单位不存在" };
      if (!(cmd.subordinate_ids || []).includes(unit.id)) {
        return { ok: false, reason: "非直属班组，不可直接控制" };
      }
      const cpos = cmd.pos || cmd.px;
      const upos = unit.pos || unit.px;
      const distKm = Math.hypot(cpos[0] - upos[0], cpos[1] - upos[1]) * (STATE.grid.cell_m / 1000.0);
      if (distKm > (cmd.radius_km || 0) + 1e-4) {
        return { ok: false, reason: `超出指挥范围 (${distKm.toFixed(2)}km > ${(cmd.radius_km || 0).toFixed(2)}km)，请由指挥官【指挥】画线驱动` };
      }
      return { ok: true };
    }
  }
  return { ok: false, reason: "无控制权限" };
}

async function sendDirectAction(targetKind, targetId, action, goal = null, append = false, targetUnitId = null, opts = null) {
  let effActorKind = ACTOR.kind;
  let effActorId = ACTOR.id;
  if (effActorKind === "commander" && targetKind === "unit" && STATE) {
    const ac = (STATE.commanders || []).find(c => c.id === effActorId);
    if (!ac || ac.alive === false || (ac.persons !== undefined && Number(ac.persons) <= 0)) {
      effActorKind = "unit";
      effActorId = targetId;
    }
  }
  const useOpts = opts || DIRECT_OPTS || {};
  const r = await api("/api/unit_op", "POST", {
    op: "direct_action",
    player_commander_id: STATE && STATE.active_commander_id,
    actor_kind: effActorKind,
    actor_id: effActorId,
    target_kind: targetKind,
    target_id: targetId,
    action,
    goal,
    append,
    target_unit_id: targetUnitId || undefined,
    move_mode: useOpts.move_mode || "normal",
    fire_mode: useOpts.fire_mode || (action === "attack" ? "normal" : "stop_to_fire"),
    duration_sec: useOpts.duration_sec !== undefined ? Number(useOpts.duration_sec) : 16,
    priority_target: useOpts.priority_target || (targetUnitId ? `unit:${targetUnitId}` : "any"),
    follow_target: Boolean(useOpts.follow_target),
  });
  if (!r.ok) {
    setActionHint(`指令被拦截: ${(r.data && r.data.reason) || "无权限"}`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK && !REPICK_STEP) setActionHint(""); }, 2400);
    return false;
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
    syncUiFromState();
  } else {
    await refreshState();
  }
  render();
  renderOrbatCard();
  return true;
}

async function updateTaskStep(targetKind, targetId, stepIdx, changes) {
  const r = await api("/api/unit_op", "POST", {
    op: "update_queued_segment",
    player_commander_id: STATE && STATE.active_commander_id,
    target_kind: targetKind,
    target_id: targetId,
    piece_id: targetId,
    segment_index: stepIdx,
    step_index: stepIdx,
    ...changes,
  });
  if (!r.ok) {
    setActionHint(`修改步骤失败: ${(r.data && r.data.reason) || "未知错误"}`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK && !REPICK_STEP) setActionHint(""); }, 2400);
    return false;
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
    syncUiFromState();
  } else {
    await refreshState();
  }
  render();
  renderOrbatCard();
  return true;
}

async function reorderTaskStep(targetKind, targetId, fromIdx, toIdx) {
  const r = await api("/api/unit_op", "POST", {
