  "Soldier":   { width: 150, height: 50 }
};

let MASTER_ORBAT_TREE = null;
let ORBAT_LAYOUT_POSITIONS = new Map();
let CURRENT_ORBAT_LAYOUT = "vertical"; // "vertical" | "horizontal"
let ACTIVE_ORBAT_UNIT_ID = null;
let ORBAT_PAN_X = 100;
let ORBAT_PAN_Y = 100;
let ORBAT_SCALE = 0.70;
let IS_ORBAT_PANNING = false;
let ORBAT_START_X = 0;
let ORBAT_START_Y = 0;
let DRAGGED_ORBAT_SOLDIER = null;

function showOrbatToast(msg) {
  const t = document.getElementById("orbatToast");
  if (!t) return;
  t.innerHTML = msg;
  t.classList.add("show");
  setTimeout(() => { t.classList.remove("show"); }, 3000);
}

// 1. Build Master Faction Tree from live state + static military skeleton
function buildMasterOrbatTree(state, activeUnitId) {
  const ownPieces = (state && state.own_pieces) || [];
  const commanders = (state && state.commanders) || [];

  // Live units
  const hqPiece = ownPieces.find(p => p.is_hq_piece) || (commanders[0] ? { id: commanders[0].id, name: commanders[0].name, isHQ: true } : null);
  const liveSquads = ownPieces.filter(p => !p.is_hq_piece);

  function createLiveTruppNodes(p) {
    const sols = getUnitSoldierList(p);
    const mgSols = [];
    const rifleSols = [];
    sols.forEach(s => {
      const w = (s.weapon || "").toLowerCase();
      if (w.includes("mg") || w.includes("howitzer") || w.includes("gun") || w.includes("mortar") || w.includes("炮")) {
        mgSols.push(s);
      } else {
        rifleSols.push(s);
      }
    });

    const isArt = (p.name || "").includes("炮");
    const trupp1Name = isArt ? "⚡ 操炮组 (Geschütztrupp)" : "⚡ 机枪火力组 (MG-Trupp)";
    const trupp2Name = isArt ? "📦 弹药警戒组 (Munitionstrupp)" : "🎯 步枪突击组 (Schützentrupp)";

    return [
      {
        id: `${p.id}_trupp1`,
        name: trupp1Name,
        echelon: "Trupp",
        symbol: isArt ? "symbol-heavy-art" : "symbol-mg-squad",
        desc: `${mgSols.length}人 · 火力基干`,
        unitId: p.id,
        soldiers: mgSols,
        collapsed: false,
        children: []
      },
      {
        id: `${p.id}_trupp2`,
        name: trupp2Name,
        echelon: "Trupp",
        symbol: "symbol-trupp",
        desc: `${rifleSols.length}人 · 突击警戒`,
        unitId: p.id,
        soldiers: rifleSols,
        collapsed: false,
        children: []
      }
    ];
  }

  // Construct Platoon children from real units
  const platoonChildren = [];
  liveSquads.forEach(p => {
    const isHeavy = (p.name || "").includes("炮");
    const sols = getUnitSoldierList(p);
    const weaponsStr = (p.equipment && Object.keys(p.equipment).length > 0)
      ? Object.entries(p.equipment).map(([k, v]) => `${k}×${v}`).join(" · ")
      : "步枪/冲锋枪";

    platoonChildren.push({
      id: p.id,
      name: p.name,
      echelon: isHeavy ? "Battery" : "Squad",
      symbol: isHeavy ? "symbol-heavy-art" : "symbol-squad",
      desc: `${sols.length}人 · ${weaponsStr}`,
      unitId: p.id,
      soldiers: sols,
      collapsed: false,
      children: createLiveTruppNodes(p)
    });
  });

  // If no squad exists or platoon reserves
  platoonChildren.push({
    id: "reserve_squad_2",
    name: "红1排2班 (后方待机/预备队)",
    echelon: "Squad",
    symbol: "symbol-squad",
    desc: "10人 · 步枪兵 · 待命转隶",
    collapsed: true,
    children: []
  });

  const hqDesc = hqPiece ? `${getUnitSoldierList(hqPiece).length || 4}人 · 前线指挥中枢 · 电台兵` : "排长及传令组";

  // Master Tree Skeleton
  const root = {
    id: "heeresgruppe_sud",
    name: "👑 德军南方集团军群 (Heeresgruppe Süd)",
    echelon: "ArmyGroup",
    symbol: "flag-army-group",
    desc: "司令官中将中枢 · 战役全局序列",
    collapsed: false,
    children: [
      {
        id: "inf_div_1",
        name: "⚔ 第 1 步兵师 (1. Infanterie-Division)",
        echelon: "Division",
        symbol: "flag-div",
        desc: "编制 17,200人 · 普鲁士第一波战备师",
        collapsed: false,
        children: [
          {
            id: "div_staff_unit",
            name: "师直属机关 (Divisionsstab & Versorgung)",
            echelon: "Staff",
            symbol: "flag-staff",
            desc: "作战处Ia、军事情报处Ic、军需后勤、野战医院",
            collapsed: true,
            children: []
          },
          {
            id: "inf_reg_1",
            name: "✠ 步兵第 1 团 (Infanterie-Regiment 1)",
            echelon: "Regiment",
            symbol: "flag-reg",
            desc: "3,049人 · 辖3个步兵营及步兵炮连",
            collapsed: false,
            children: [
              {
                id: "inf_btl_1",
                name: "⚑ 第 I 步兵营 (I. Bataillon)",
                echelon: "Battalion",
                symbol: "flag-btl",
                desc: "860人 · 辖第1~3步兵连及机枪重武器连",
                collapsed: false,
                children: [
                  {
                    id: "inf_co_1",
                    name: "⚑ 第 1 步兵连 (1. Kompanie)",
                    echelon: "Company",
                    symbol: "symbol-inf-co",
                    desc: "191人 · 辖第1~3排及连属反坦克战防组",
                    collapsed: false,
                    children: [
                      {
                        id: hqPiece ? hqPiece.id : "red_1_zug_hq",
                        name: hqPiece ? `${hqPiece.name}` : "⚑ 第 1 排排部 (1. Zug · 实装战术中枢)",
                        echelon: "Platoon",
                        symbol: "symbol-platoon",
                        desc: hqDesc,
                        unitId: hqPiece ? hqPiece.id : null,
                        soldiers: hqPiece ? getUnitSoldierList(hqPiece) : [],
                        collapsed: false,
                        children: platoonChildren
                      },
                      {
                        id: "red_2_zug",
                        name: "⚑ 第 2 排 (2. Zug · 待命后援)",
                        echelon: "Platoon",
                        symbol: "symbol-platoon",
                        desc: "42人 · 步枪排 · 侧翼展开",
                        collapsed: true,
                        children: []
                      },
                      {
                        id: "red_3_zug",
                        name: "⚑ 第 3 排 (3. Zug · 待命后援)",
                        echelon: "Platoon",
                        symbol: "symbol-platoon",
                        desc: "42人 · 步枪排 · 侧翼展开",
                        collapsed: true,
                        children: []
                      }
                    ]
                  },
                  {
                    id: "inf_co_2",
                    name: "⚑ 第 2 步兵连 (2. Kompanie · 战役侧翼)",
                    echelon: "Company",
                    symbol: "symbol-inf-co",
                    desc: "191人 · 邻翼阵地部署",
                    collapsed: true,
                    children: []
                  },
                  {
                    id: "inf_co_3",
                    name: "⚑ 第 3 步兵连 (3. Kompanie · 战役侧翼)",
                    echelon: "Company",
                    symbol: "symbol-inf-co",
                    desc: "191人 · 侧翼支撑防御",
                    collapsed: true,
                    children: []
                  }
                ]
              },
              {
                id: "inf_btl_2",
                name: "⚑ 第 II 步兵营 (II. Bataillon · 纵深梯队)",
                echelon: "Battalion",
                symbol: "flag-btl",
                desc: "860人 · 二梯队接替突破",
                collapsed: true,
                children: []
              }
            ]
          },
          {
            id: "art_reg_1",
            name: "✠ 炮兵第 1 团 (Artillerie-Regiment 1 · 师属炮群)",
            echelon: "Regiment",
            symbol: "flag-art-reg",
            desc: "辖轻型105mm与重型150mm榴弹炮营",
            collapsed: true,
            children: []
          }
        ]
      }
    ]
  };

  // 2. Mark Command Spine, Active Focus and Blackout
  const activeTargetId = activeUnitId || (platoonChildren[0] && platoonChildren[0].id) || (hqPiece && hqPiece.id);

  function markSpineAndBlackout(node) {
    let hasActiveInSubtree = (node.id === activeTargetId || (node.unitId && node.unitId === activeTargetId));
    if (node.children) {
      for (const child of node.children) {
        if (markSpineAndBlackout(child)) {
          hasActiveInSubtree = true;
        }
      }
    }
    node.onSpine = hasActiveInSubtree;
    node.isActive = (node.id === activeTargetId || (node.unitId && node.unitId === activeTargetId));
    return hasActiveInSubtree;
  }
  markSpineAndBlackout(root);

  // If node is not on spine and not active or in active subtree -> Blackout
  function applyBlackoutFlags(node, parentActiveOrSubtree) {
    const isThisActiveSubtree = parentActiveOrSubtree || node.isActive;
    node.isBlackout = !node.onSpine && !isThisActiveSubtree;
    if (node.children) {
      node.children.forEach(c => applyBlackoutFlags(c, isThisActiveSubtree));
    }
  }
  applyBlackoutFlags(root, false);

  return root;
}

// 3. Tree Layout Calculations
function calculateOrbatLayout() {
  ORBAT_LAYOUT_POSITIONS.clear();
  if (!MASTER_ORBAT_TREE) return;

  if (CURRENT_ORBAT_LAYOUT === "horizontal") {
    let curY = 0;
    function computeH(node, depth) {
      const spec = MASTER_ECHELON_SPECS[node.echelon] || { width: 175, height: 72 };
      const w = spec.width;
      const h = spec.height;

      if (node.collapsed || !node.children || node.children.length === 0) {
        const x = depth * (w + 60);
        const y = curY;
        curY += h + 18;
        ORBAT_LAYOUT_POSITIONS.set(node.id, { x, y, width: w, height: h, depth, node });
        return { minY: y, maxY: y + h };
      }

      const childMinYs = [];
      const childMaxYs = [];
      node.children.forEach(child => {
        const res = computeH(child, depth + 1);
        childMinYs.push(res.minY);
        childMaxYs.push(res.maxY);
      });

      const firstY = childMinYs[0];
      const lastY = childMaxYs[childMaxYs.length - 1];
      const midY = (firstY + lastY) / 2 - h / 2;
      const x = depth * (w + 60);

      ORBAT_LAYOUT_POSITIONS.set(node.id, { x, y: midY, width: w, height: h, depth, node });
      return { minY: Math.min(firstY, midY), maxY: Math.max(lastY, midY + h) };
    }
    computeH(MASTER_ORBAT_TREE, 0);

  } else {
    // Vertical Top-to-Bottom
    function getSubtreeWidth(node) {
      const spec = MASTER_ECHELON_SPECS[node.echelon] || { width: 175, height: 72 };
      if (node.collapsed || !node.children || node.children.length === 0) {
        return spec.width;
      }
      let totalW = 0;
      node.children.forEach((c, idx) => {
        if (idx > 0) totalW += 24;
        totalW += getSubtreeWidth(c);
      });
      return Math.max(spec.width, totalW);
    }

    function computeV(node, depth, leftX) {
      const spec = MASTER_ECHELON_SPECS[node.echelon] || { width: 175, height: 72 };
      const w = spec.width;
      const h = spec.height;
      const y = depth * (86 + 65) + 60;
      const subW = getSubtreeWidth(node);

      if (node.collapsed || !node.children || node.children.length === 0) {
        const x = leftX + (subW - w) / 2;
        ORBAT_LAYOUT_POSITIONS.set(node.id, { x, y, width: w, height: h, depth, node });
        return;
      }

      let curChildX = leftX;
      const childCenters = [];
      node.children.forEach(child => {
        const childSubW = getSubtreeWidth(child);
        computeV(child, depth + 1, curChildX);
        const childPos = ORBAT_LAYOUT_POSITIONS.get(child.id);
        if (childPos) childCenters.push(childPos.x + childPos.width / 2);
        curChildX += childSubW + 24;
      });

      const firstCenter = childCenters[0];
      const lastCenter = childCenters[childCenters.length - 1];
      const midX = (firstCenter + lastCenter) / 2 - w / 2;

      ORBAT_LAYOUT_POSITIONS.set(node.id, { x: midX, y, width: w, height: h, depth, node });
    }

    computeV(MASTER_ORBAT_TREE, 0, 50);
  }
}

// 4. Render Master ORBAT Tree
function renderMasterOrbatTree() {
  if (!MASTER_ORBAT_TREE) return;
  calculateOrbatLayout();

  const container = document.getElementById("orbatNodesContainer");
  const svgLines = document.getElementById("orbatSvgLines");
  if (!container || !svgLines) return;

  container.innerHTML = "";
  svgLines.innerHTML = "";

  let maxCanvasX = 3000, maxCanvasY = 3000;
  ORBAT_LAYOUT_POSITIONS.forEach(p => {
    if (p.x + p.width > maxCanvasX) maxCanvasX = p.x + p.width + 600;
    if (p.y + p.height > maxCanvasY) maxCanvasY = p.y + p.height + 600;
  });
  svgLines.setAttribute("width", maxCanvasX);
  svgLines.setAttribute("height", maxCanvasY);

  // Stepped Orthogonal Lines
  function drawLinks(node) {
    if (node.collapsed || !node.children || node.children.length === 0) return;
    const parentPos = ORBAT_LAYOUT_POSITIONS.get(node.id);
    if (!parentPos) return;

    node.children.forEach(child => {
      const childPos = ORBAT_LAYOUT_POSITIONS.get(child.id);
      if (!childPos) return;

      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      let d = "";

      if (CURRENT_ORBAT_LAYOUT === "horizontal") {
        const x1 = parentPos.x + parentPos.width;
        const y1 = parentPos.y + parentPos.height / 2;
        const x2 = childPos.x;
        const y2 = childPos.y + childPos.height / 2;
        const midX = (x1 + x2) / 2;
        d = `M ${x1} ${y1} H ${midX} V ${y2} H ${x2}`;
      } else {
        const x1 = parentPos.x + parentPos.width / 2;
        const y1 = parentPos.y + parentPos.height;
        const x2 = childPos.x + childPos.width / 2;
        const y2 = childPos.y;
        const midY = (y1 + y2) / 2;
        d = `M ${x1} ${y1} V ${midY} H ${x2} V ${y2}`;
      }

      path.setAttribute("d", d);
      path.setAttribute("fill", "none");
      const isSpineLink = node.onSpine && child.onSpine;
      const isDimLink = child.isBlackout;
      path.setAttribute("stroke", isSpineLink ? "var(--line-spine)" : (isDimLink ? "var(--line-dim)" : "var(--line-color)"));
      path.setAttribute("stroke-width", isSpineLink ? "2.5" : "1.8");
      path.setAttribute("stroke-linejoin", "round");
      if (isDimLink) path.setAttribute("stroke-dasharray", "3,3");
      svgLines.appendChild(path);

      drawLinks(child);
    });
  }
  drawLinks(MASTER_ORBAT_TREE);

  // Render DOM nodes
  ORBAT_LAYOUT_POSITIONS.forEach((pos, id) => {
    const node = pos.node;
    const div = document.createElement("div");
    div.id = "orbat_card_" + node.id;

    let cls = `tree-node echelon-${node.echelon}`;
    if (node.isBlackout) cls += " node-blackout";
    if (node.onSpine) cls += " command-spine";
    if (node.isActive) cls += " active-focus";

    div.className = cls;
    div.style.left = `${pos.x}px`;
    div.style.top = `${pos.y}px`;
    div.style.width = `${pos.width}px`;
    div.style.height = `${pos.height}px`;

    const hasChildren = node.children && node.children.length > 0;
    const symbolSvg = ORBAT_SYMBOLS[node.symbol] || ORBAT_SYMBOLS["symbol-squad"];

    div.innerHTML = `
      <div class="node-top">
        <div class="node-symbol-wrap">${symbolSvg}</div>
        <span class="node-badge">${node.echelon}</span>
      </div>
      <div class="node-mid">
        <div class="node-title" title="${node.name}">${node.name}</div>
        <div class="node-details" title="${node.desc || ''}">${node.desc || ''}</div>
      </div>
      ${hasChildren ? `
        <div class="node-expander ${node.collapsed ? 'collapsed' : ''}" 
             title="${node.collapsed ? '展开编制' : '收起编制'}" 
             onclick="event.stopPropagation(); toggleOrbatNode('${node.id}')">
          ${node.collapsed ? '+' : '−'}
        </div>
      ` : ''}
    `;

    // Interaction only if not blackout
    if (!node.isBlackout) {
      div.addEventListener("click", (e) => {
        e.stopPropagation();
        openOrbatInspector(node);
      });
      div.addEventListener("dblclick", (e) => {
        e.stopPropagation();
        if (hasChildren) toggleOrbatNode(node.id);
      });
    }

    container.appendChild(div);
  });

  updateOrbatTransform();
}

function updateOrbatTransform() {
  const panGroup = document.getElementById("orbatPanGroup");
  const zoomIndicator = document.getElementById("orbatZoomIndicator");
  if (panGroup) {
    panGroup.style.transform = `translate(${ORBAT_PAN_X}px, ${ORBAT_PAN_Y}px) scale(${ORBAT_SCALE})`;
  }
  if (zoomIndicator) {
    zoomIndicator.innerText = `缩放: ${Math.round(ORBAT_SCALE * 100)}%`;
  }
}

function toggleOrbatNode(id) {
  function search(node) {
    if (node.id === id) {
      node.collapsed = !node.collapsed;
      return true;
    }
    if (node.children) {
      for (let c of node.children) {
        if (search(c)) return true;
      }
    }
    return false;
  }
  search(MASTER_ORBAT_TREE);
  renderMasterOrbatTree();
}

function setOrbatLayout(type) {
  CURRENT_ORBAT_LAYOUT = type;
  document.getElementById("btnOrbatHorizontal")?.classList.toggle("active", type === "horizontal");
  document.getElementById("btnOrbatVertical")?.classList.toggle("active", type === "vertical");
  renderMasterOrbatTree();
  resetOrbatView();
}

function resetOrbatView() {
  focusActiveSquadOrbat();
}

function focusActiveSquadOrbat() {
  if (!MASTER_ORBAT_TREE) return;
  let targetPos = null;
  ORBAT_LAYOUT_POSITIONS.forEach(pos => {
    if (pos.node.isActive) targetPos = pos;
  });
  if (!targetPos && MASTER_ORBAT_TREE) {
    targetPos = ORBAT_LAYOUT_POSITIONS.get(MASTER_ORBAT_TREE.id);
  }
  if (targetPos) {
    const viewport = document.getElementById("orbatViewport");
    const vw = viewport ? viewport.clientWidth : window.innerWidth;
    const vh = viewport ? viewport.clientHeight : window.innerHeight;
    ORBAT_SCALE = 0.75;
    ORBAT_PAN_X = vw / 2 - (targetPos.x + targetPos.width / 2) * ORBAT_SCALE;
    ORBAT_PAN_Y = vh / 2 - (targetPos.y + targetPos.height / 2) * ORBAT_SCALE;
    updateOrbatTransform();
  }
}

function collapseAllOrbat() {
  function collapse(node) {
    if (node !== MASTER_ORBAT_TREE) node.collapsed = true;
    if (node.children) node.children.forEach(collapse);
  }
  collapse(MASTER_ORBAT_TREE);
  renderMasterOrbatTree();
}

function expandAllOrbat() {
  function expand(node) {
    node.collapsed = false;
    if (node.children) node.children.forEach(expand);
  }
  expand(MASTER_ORBAT_TREE);
  renderMasterOrbatTree();
}

function toggleOrbatTheme() {
  const root = document.getElementById("orbatFullscreenRoot");
  if (root) {
    root.classList.toggle("theme-blueprint");
  }
}

function searchOrbatNodes(query) {
  const q = (query || "").trim().toLowerCase();
  ORBAT_LAYOUT_POSITIONS.forEach(pos => {
    const el = document.getElementById("orbat_card_" + pos.node.id);
    if (!el) return;
    if (!q) {
      el.style.outline = "";
      return;
    }
    const match = (pos.node.name || "").toLowerCase().includes(q) || (pos.node.desc || "").toLowerCase().includes(q);
    el.style.outline = match ? "3px solid #eab308" : "";
  });
}

// 5. Inspector Drawer
function openOrbatInspector(node) {
  const drawer = document.getElementById("orbatInspectorDrawer");
  const title = document.getElementById("orbatDrawerTitle");
  const body = document.getElementById("orbatDrawerBody");
  if (!drawer || !body) return;

  title.innerText = `⚙️ ${node.name}`;
  const sols = node.soldiers || [];

  let solsHtml = "";
  if (sols.length > 0) {
    solsHtml = sols.map((s, idx) => `
      <div style="background:var(--bg-canvas);border:1px solid var(--node-border);border-radius:3px;padding:6px 8px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div style="font-weight:800;font-size:11px;">#${idx+1} ${s.name || s.id} <span style="font-size:9px;color:var(--text-secondary);font-family:var(--font-mono);">${s.role || '列兵'}</span></div>
          <div style="font-size:10px;color:var(--text-secondary);">🔫 ${s.weapon || 'Kar98k'}</div>
        </div>
        <div style="text-align:right;">
          <div style="font-size:10px;font-weight:800;color:${(s.hp||100) > 60 ? '#16a34a' : '#ea580c'};">${Math.round(s.hp || 100)}%</div>
          <div style="width:50px;height:4px;background:#333;border-radius:2px;overflow:hidden;margin-top:2px;">
            <div style="width:${Math.round(s.hp || 100)}%;height:100%;background:${(s.hp||100) > 60 ? '#22c55e' : '#f97316'};"></div>
          </div>
        </div>
      </div>
    `).join("");
  } else {
    solsHtml = `<div style="font-size:11px;color:var(--text-muted);padding:8px 0;">该建制层级为战役推演骨架节点，兵力参数由下属连排聚合。</div>`;
  }

  body.innerHTML = `
    <div style="margin-bottom:12px;">
      <div style="font-size:11px;color:var(--text-secondary);font-family:var(--font-mono);">层级: ${node.echelon} · 符码标识: ${node.symbol}</div>
      <div style="font-size:12px;font-weight:700;margin-top:3px;">${node.desc || ''}</div>
    </div>
    <div style="font-size:11.5px;font-weight:900;margin-bottom:8px;border-bottom:1px dashed var(--node-border);padding-bottom:4px;">
      🎖 麾下建制人员明细 (${sols.length}人)
    </div>
    <div style="max-height:360px;overflow-y:auto;">
      ${solsHtml}
    </div>
    ${node.unitId ? `
      <div style="margin-top:14px;display:flex;gap:8px;">
        <button type="button" class="dfw-btn primary" onclick="focusSandboxOnUnit('${node.unitId}')" style="flex:1;">🔭 沙盘定位聚焦</button>
      </div>
    ` : ''}
  `;

  drawer.classList.add("open");
}

function closeOrbatInspector() {
  document.getElementById("orbatInspectorDrawer")?.classList.remove("open");
}

function focusSandboxOnUnit(unitId) {
  closeFullscreenOrbat();
  const ent = resolveTargetEntity("unit", unitId) || resolveTargetEntity("commander", unitId);
  if (ent && ent.pos) {
    const [r, c] = ent.pos;
    const [sx, sy] = pxToScreen(r, c);
    VIEW.offsetX += (window.innerWidth / 2 - sx);
    VIEW.offsetY += (window.innerHeight / 2 - sy);
    render();
  }
}

// 6. Pan & Zoom Event Binding
function initOrbatViewportEvents() {
  const viewport = document.getElementById("orbatViewport");
  if (!viewport || viewport._eventsBound) return;
  viewport._eventsBound = true;

  viewport.addEventListener("mousedown", (e) => {
    if (e.target.closest(".tree-node") || e.target.closest("button") || e.target.closest("#orbatInspectorDrawer")) return;
    IS_ORBAT_PANNING = true;
    ORBAT_START_X = e.clientX - ORBAT_PAN_X;
    ORBAT_START_Y = e.clientY - ORBAT_PAN_Y;
  });

  window.addEventListener("mousemove", (e) => {
    if (!IS_ORBAT_PANNING) return;
    ORBAT_PAN_X = e.clientX - ORBAT_START_X;
    ORBAT_PAN_Y = e.clientY - ORBAT_START_Y;
    updateOrbatTransform();
  });

  window.addEventListener("mouseup", () => {
    IS_ORBAT_PANNING = false;
  });

  viewport.addEventListener("wheel", (e) => {
    e.preventDefault();
    const zoomFactor = e.deltaY < 0 ? 1.12 : 0.89;
    const rect = viewport.getBoundingClientRect();
    const mouseX = e.clientX - rect.left;
    const mouseY = e.clientY - rect.top;

    const newScale = Math.min(2.5, Math.max(0.25, ORBAT_SCALE * zoomFactor));
    ORBAT_PAN_X = mouseX - (mouseX - ORBAT_PAN_X) * (newScale / ORBAT_SCALE);
    ORBAT_PAN_Y = mouseY - (mouseY - ORBAT_PAN_Y) * (newScale / ORBAT_SCALE);
    ORBAT_SCALE = newScale;
    updateOrbatTransform();
  }, { passive: false });
}

// 7. Global Lifecycle Functions
function openFullscreenOrbat(targetKind, targetId) {
  ACTIVE_ORBAT_UNIT_ID = targetId || SELECTED_PIECE_ID || SELECTED_COMMANDER_ID || (STATE && STATE.active_commander_id);
  MASTER_ORBAT_TREE = buildMasterOrbatTree(STATE, ACTIVE_ORBAT_UNIT_ID);

  const root = document.getElementById("orbatFullscreenRoot");
  if (root) {
    root.style.display = "block";
  }

  initOrbatViewportEvents();
  renderMasterOrbatTree();
  resetOrbatView();
}

function closeFullscreenOrbat() {
  const root = document.getElementById("orbatFullscreenRoot");
  if (root) {
    root.style.display = "none";
  }
  closeOrbatInspector();
}

// Compat legacy names
function openReorgSplitWin(targetKind, targetId) {
  openFullscreenOrbat(targetKind, targetId);
}
function closeReorgSplitWin() {
  closeFullscreenOrbat();
}
function renderReorgSplitWin() {
  renderMasterOrbatTree();
}

function closeHeavyCrewWin() {
  // Deprecated stub
}
function renderHeavyCrewWin() {
  // Deprecated stub
}


async function refreshState() {
  const cid = document.getElementById("selCommander").value || "";
  const params = new URLSearchParams();
  if (cid) params.set("commander_id", cid);
  if (MP_STATE.seatToken) params.set("seat_token", MP_STATE.seatToken);
  const qs = params.toString();
  const url = qs ? `/api/state?${qs}` : "/api/state";
  const r = await api(url);
  if (!r.ok) return;
  STATE = r.data;
  MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
  syncUiFromState();
  if (!TILE_STREAM_SUPPORTED) {
    await ensureTerrainBinaryFallback();
    rebuildTerrainCanvasFallback();
  }
  if (!VIEW_INITIALIZED) {
    VIEW_INITIALIZED = true;
    const rect = canvas.parentElement.getBoundingClientRect();
    const cw = rect.width || window.innerWidth, ch = rect.height || window.innerHeight;
    const fitPx = !STATE.grid.large_grid
      ? Math.max(12, Math.floor(Math.min(cw, ch) * 0.72 / Math.max(STATE.grid.rows, STATE.grid.cols)))
      : 16;
    focusUnits(fitPx);
  } else {
    render();
  }
}

function formatUplinkText() {
  if (STATE.uplink_inbox) {
    const up = STATE.uplink_inbox;
    const omitted = (up.omitted_disconnected_ids || []).length;
    return (up.text || "(当前无直属在连上行作战日志)") +
      (omitted > 0 ? `\n\n[黑盒提示: ${omitted} 个直属单位/分队已断连 -> 上行作战日志完全空缺]` : "");
  }
  if (Array.isArray(STATE.uplink_logs) && STATE.uplink_logs.length > 0) {
    return STATE.uplink_logs.map(l =>
      `[${l.subordinate_id || l.from || "unit"}] (${l.via || "radio"}) ${l.summary || JSON.stringify(l)}`
    ).join("\n");
  }
  return "(当前无直属在连上行作战日志)";
}

function syncUiFromState() {
  const selC = document.getElementById("selCommander");
  const cur = STATE.active_commander_id;
  selC.innerHTML = "";
  for (const c of (STATE.commanders || [])) {
    const opt = document.createElement("option");
    opt.value = c.id;
    opt.textContent = `${c.name} (${c.echelon}${c.radio_silence ? "·静默" : ""})`;
    if (c.id === cur) opt.selected = true;
    selC.appendChild(opt);
  }
  selC.onchange = () => { DRILLED_IDS.clear(); refreshState(); };

  if (!ACTOR.id) {
    const cmds = STATE.commanders || [];
    const pcs = STATE.own_pieces || [];
    ACTOR = cmds.length ? { kind: "commander", id: STATE.active_commander_id || cmds[0].id } : (pcs.length ? { kind: "unit", id: pcs[0].id } : { kind: "commander", id: "" });
  }
  if (ACTOR.kind === "commander") {
    const curCmd = (STATE.commanders || []).find(c => c.id === ACTOR.id);
    const curDead = curCmd && (curCmd.alive === false || (curCmd.persons !== undefined && Number(curCmd.persons) <= 0));
    if (curDead) {
      const aliveSub = (STATE.own_pieces || []).find(p => !p.is_hq_piece && Number(p.persons || 0) > 0);
      if (aliveSub) {
        ACTOR = { kind: "unit", id: aliveSub.id };
        setActionHint(`【指挥移交】${curCmd.name} 已阵亡 (Depot)，控制身份已自动切换至 ${aliveSub.name}`);
      }
    }
  }
  for (const selId of ["selActor", "dbgActorSel"]) {
    const selA = document.getElementById(selId);
    if (!selA) continue;
    const curVal = `${ACTOR.kind}:${ACTOR.id}`;
    selA.innerHTML = "";
    for (const c of (STATE.commanders || [])) {
      const cDead = c.alive === false || (c.persons !== undefined && Number(c.persons) <= 0);
      const o = document.createElement("option");
      o.value = `commander:${c.id}`;
      o.textContent = cDead ? `${c.name} (已阵亡·Depot)` : `${c.name} (指挥官)`;
      if (o.value === curVal) o.selected = true;
      selA.appendChild(o);
    }
    for (const p of (STATE.own_pieces || [])) {
      if (p.is_hq_piece) continue;
      const o = document.createElement("option");
      o.value = `unit:${p.id}`;
      o.textContent = `${p.name} (班组)`;
      if (o.value === curVal) o.selected = true;
      selA.appendChild(o);
    }
  }
  const dbgClock = document.getElementById("dbgClock");
  if (dbgClock) {
    dbgClock.textContent = `T${STATE.turn} · ${Number(STATE.clock_hours || 0).toFixed(2)}h`;
  }
  const dbgFF = document.getElementById("dbgFriendlyFire");
  if (dbgFF) {
    dbgFF.checked = Boolean(STATE.debug_full_friendly_fire);
  }

  const pre = document.getElementById("lblPreGame");
  pre.textContent = STATE.pre_game_editable ? "开局可编辑" : "战局进行中(地形锁定)";
  pre.className = "pill " + (STATE.pre_game_editable ? "badge-ok" : "badge-warn");

  document.getElementById("lblTurn").textContent = `T${STATE.turn} · ${Number(STATE.clock_hours || 0).toFixed(2)}h · ${STATE.grid.cell_m}m/px`;
  const sc = STATE.readable_scope;
  if (sc) {
    document.getElementById("lblScopeCount").textContent =
      `可读线:${sc.readable_commander_ids.length + sc.readable_piece_ids.length} (邻近400m:${sc.proximity_commander_ids.length + sc.proximity_piece_ids.length})`;
  } else {
    const proxCnt = (STATE.commanders || []).filter(c => c.proximity_readable).length;
    document.getElementById("lblScopeCount").textContent =
      `可读线:${STATE.readable_count ?? (STATE.own_pieces || []).length} (邻近400m:${proxCnt})`;
  }

  const cat = STATE.feature_catalog || DEFAULT_FEATURE_CATALOG;
  for (const selId of ["selBrushFeat", "selImportFeat"]) {
    const el = document.getElementById(selId);
    if (el.options.length === 0) {
      for (const [fid, info] of Object.entries(cat)) {
        const o = document.createElement("option");
        o.value = fid;
        o.textContent = `${info.name} (${fid})`;
        el.appendChild(o);
      }
    }
  }

  document.getElementById("impW").value = STATE.grid.cols;
  document.getElementById("impH").value = STATE.grid.rows;
  document.getElementById("uplinkBox").textContent = formatUplinkText();

  rebuildVisTable();
  updateSelectedUnitPanel();
  updateDraftBox();
  updateMpBarUi();
  if (SELECTED_PIECE_ID || SELECTED_COMMANDER_ID) {
    renderOrbatCard();
  }
  const now = performance.now();
  for (const p of (STATE.own_pieces || [])) {
    if (p.delta_persons_5m < 0) {
      FLOAT_TEXTS.push({ r: p.pos[0], c: p.pos[1], text: `${p.delta_persons_5m} 兵力`, color: "#dc2626", born: now });
    }
    if (p.delta_org_5m < -0.25) {
      FLOAT_TEXTS.push({ r: p.pos[0], c: p.pos[1], text: `${p.delta_org_5m.toFixed(1)} 组织度`, color: "#d97706", born: now + 120 });
    }
  }
  for (const c of (STATE.commanders || [])) {
    const cpos = c.pos || c.px;
    if ((c.hq_delta_org_5m || 0) < -0.25) {
      FLOAT_TEXTS.push({ r: cpos[0], c: cpos[1], text: `${c.hq_delta_org_5m.toFixed(1)} 组织度`, color: "#d97706", born: now + 120 });
    }
  }
}

function rebuildTerrainCanvasFallback() {
  if (!STATE || !STATE.grid) return;
  const g = STATE.grid;
  const H = g.rows, W = g.cols;
  if (g.large_grid && (!TERRAIN_FLAT_U8 || !ELEV_FLAT_U16)) return;
  if (!g.large_grid && (!g.terrain || !g.elevation)) return;

  if (TERRAIN_CANVAS.width !== W || TERRAIN_CANVAS.height !== H) {
    TERRAIN_CANVAS.width = W;
    TERRAIN_CANVAS.height = H;
  }
  const tctx = TERRAIN_CANVAS.getContext("2d");
  const img = tctx.createImageData(W, H);
  const d32 = new Uint32Array(img.data.buffer);
  const minE = g.elev_min, spanE = Math.max(1.0, g.elev_max - minE);
  const invSpan = 1.0 / spanE;

  if (g.large_grid) {
    const tArr = TERRAIN_FLAT_U8;
    const eArr = ELEV_FLAT_U16;
    const total = H * W;
    for (let i = 0; i < total; i++) {
      const tc = tArr[i];
      const normE = (eArr[i] - minE) * invSpan;
      const rgb = TERRAIN_COLORS[tc] || [42, 48, 42];
      let rr, gg, bb;
      if (tc === 2 || normE > 0.78) {
        const k = Math.max(0.05, 1.0 - (normE - 0.65) * 2.2);
        rr = (rgb[0] * k + 0.5) | 0; gg = (rgb[1] * k + 0.5) | 0; bb = (rgb[2] * k + 0.5) | 0;
      } else {
        const shade = 0.75 + normE * 0.45;
        rr = Math.min(255, (rgb[0] * shade + 0.5) | 0);
        gg = Math.min(255, (rgb[1] * shade + 0.5) | 0);
        bb = Math.min(255, (rgb[2] * shade + 0.5) | 0);
      }
      d32[i] = (255 << 24) | (bb << 16) | (gg << 8) | rr;
    }
  } else {
    for (let r = 0; r < H; r++) {
      const tRow = g.terrain[r], eRow = g.elevation[r];
      const base = r * W;
      for (let c = 0; c < W; c++) {
        const tc = tRow[c];
        const normE = (eRow[c] - minE) * invSpan;
        const rgb = TERRAIN_COLORS[tc] || [42, 48, 42];
        let rr, gg, bb;
        if (tc === 2 || normE > 0.78) {
          const k = Math.max(0.05, 1.0 - (normE - 0.65) * 2.2);
          rr = (rgb[0] * k + 0.5) | 0; gg = (rgb[1] * k + 0.5) | 0; bb = (rgb[2] * k + 0.5) | 0;
        } else {
          const shade = 0.75 + normE * 0.45;
          rr = Math.min(255, (rgb[0] * shade + 0.5) | 0);
          gg = Math.min(255, (rgb[1] * shade + 0.5) | 0);
          bb = Math.min(255, (rgb[2] * shade + 0.5) | 0);
        }
        d32[base + c] = (255 << 24) | (bb << 16) | (gg << 8) | rr;
      }
    }
  }
  tctx.putImageData(img, 0, 0);
}

function currentZoomThreshold() {
  const px = VIEW.pxSize;
  if (px >= 14) return { tier: 0, label: "班(Squad)" };
  if (px >= 10) return { tier: 1, label: "排(Platoon)" };
  if (px >= 7) return { tier: 2, label: "连(Company)" };
  return { tier: 3, label: "营+(Battalion+)" };
}

function normalizeHQName(cmd) {
  if (!cmd) return "指挥部";
  let name = cmd.name || "";
  if (name.includes("指挥部")) return name;
  const ech = (cmd.echelon || "").toLowerCase();
  let tierName = "排";
  if (ech === "team" || ech === "trupp") tierName = "组";
  else if (ech === "squad" || ech === "gruppe") tierName = "班";
  else if (ech === "half_platoon" || ech === "halbzug") tierName = "半排";
  else if (ech === "platoon" || ech === "zug") tierName = "排";
  else if (ech === "company" || ech === "kompanie") tierName = "连";
  else if (ech === "battalion" || ech === "bataillon") tierName = "营";
  else if (ech === "regiment") tierName = "团";
  else if (ech === "brigade") tierName = "旅";
  else if (ech === "division") tierName = "师";

  const cleaned = name.replace(/[（(].*?[)）]/g, "").replace(/长$/, "").replace(/部$/, "").trim();
  if (!cleaned.endsWith(tierName)) {
    return `${cleaned ? cleaned + " " : ""}${tierName}指挥部`.trim();
  }
  return `${cleaned}指挥部`;
}

function computeDisplayCounters() {
  if (!STATE) return [];
  const lod = currentZoomThreshold();
  document.getElementById("lblLod").textContent = `LOD: ${lod.label} (${VIEW.pxSize.toFixed(1)}px/格)`;

  const out = [];
  const foldedPids = new Set();

  for (const c of (STATE.commanders || [])) {
    const cTier = ECHELON_ORDER[c.echelon] ?? 2;
    let foldedThisCmd = false;
    if (cTier <= lod.tier && !DRILLED_IDS.has(c.id)) {
      const subs = (STATE.own_pieces || []).filter(p => (c.subordinate_ids || []).includes(p.id));
      if (subs.length > 0 && lod.tier >= 2) {
        foldedThisCmd = true;
        let sr = 0, sc = 0, totP = 0;
        for (const sp of subs) {
          const bonus = (sp.counter && sp.counter.display_tier_bonus) || 0;
          const spTier = (ECHELON_ORDER[sp.level] ?? 0) + bonus;
          if (spTier < lod.tier && VIS_MODES[sp.id] !== "pin") {
            foldedPids.add(sp.id);
          }
          const spp = sp.pos || sp.px || [0, 0];
          sr += spp[0]; sc += spp[1]; totP += Number(sp.persons || 0);
        }
        if (VIS_MODES[c.id] !== "hide") {
          out.push({
            id: c.id, isAggregate: true, isHQ: true, name: normalizeHQName(c), level: c.echelon,
            pos: [sr / subs.length, sc / subs.length],
            persons: totP, team: c.team, readable_line: c.readable,
            badge: `★${c.echelon.toUpperCase()} (${subs.length}分队)`,
            color: c.is_self ? "#dc2626" : "#2563eb",
            bonus: 0,
            commander: c,
          });
        }
      }
    }
    if (!foldedThisCmd && VIS_MODES[c.id] !== "hide" && (c.pos || c.px)) {
      let rp = RENDER_POS[c.id];
      if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) {
        rp = c.pos || c.px;
      }
      if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) continue;
      const isDead = c.alive === false || (c.persons !== undefined && Number(c.persons) <= 0);
      out.push({
        id: c.id, isAggregate: false, isHQ: true, name: normalizeHQName(c), level: c.echelon,
        pos: rp,
        persons: c.persons ?? null, team: c.team, readable_line: c.readable,
        badge: isDead ? "DEPOT" : `${c.echelon.toUpperCase()} HQ`,
        color: isDead ? "#6b7280" : "#dc2626",
        bonus: 0,
        commander: c,
      });
    }
  }

  for (const p of (STATE.own_pieces || [])) {
    if (p.is_hq_piece) continue;
    const vm = VIS_MODES[p.id] || "auto";
    if (vm === "hide") continue;
    if (vm === "auto" && foldedPids.has(p.id)) continue;
    const ctr = p.counter || {};
    const bonus = ctr.display_tier_bonus || 0;
    const skinColor = ctr.color || (ctr.skin && ctr.skin.color) || (bonus > 0 ? "#f59e0b" : "#38bdf8");
    const isLocked = Boolean(p.is_name_locked || ctr.is_name_locked);
    const customLabel = isLocked ? (p.custom_name || ctr.custom_label || p.name) : (ctr.custom_label || (ctr.skin && ctr.skin.custom_label));
    const restr = ctr.restriction_tier || ctr.restricted_echelon || p.level;
    let rp = RENDER_POS[p.id];
    if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) {
      rp = p.pos || p.px;
    }
    if (!rp || !Array.isArray(rp) || rp.length < 2 || Number.isNaN(rp[0]) || Number.isNaN(rp[1])) continue;
    out.push({
      id: p.id, isAggregate: false, name: customLabel || p.name,
      level: p.level || "squad", pos: rp, persons: p.persons, team: p.team,
      readable_line: p.readable_line !== undefined ? p.readable_line : true,
      badge: ctr.badge_label || ctr.primary_icon || (p.level || "squad").toUpperCase(),
      color: skinColor, restriction: restr,
      has_facing: p.has_facing !== undefined ? p.has_facing : Boolean(p.is_directional_hull),
      facing_deg: p.facing_deg, piece: p, bonus,
      container_type: p.container_type || ctr.container_type || "infantry",
      is_name_locked: isLocked,
    });
  }
  return out;
}

function pxToScreen(r, c) {
  return [VIEW.offsetX + (c + 0.5) * VIEW.pxSize, VIEW.offsetY + (r + 0.5) * VIEW.pxSize];
}
function screenToPx(sx, sy) {
  return [Math.floor((sy - VIEW.offsetY) / VIEW.pxSize), Math.floor((sx - VIEW.offsetX) / VIEW.pxSize)];
}

function drawFloatTexts() {
  // 飘字伤亡/压制动画
  const nowFt = performance.now();
  for (let i = FLOAT_TEXTS.length - 1; i >= 0; i--) {
    const ft = FLOAT_TEXTS[i];
    const age = nowFt - ft.born;
    if (age < 0) continue;
    if (age > 1500) {
      FLOAT_TEXTS.splice(i, 1);
      continue;
    }
    const [fx, fy] = pxToScreen(ft.r, ft.c);
    const alpha = Math.max(0, 1 - age / 1500);
    const dy = (age / 1500) * 28;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.font = "bold 12px Microsoft YaHei, Consolas, sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText(ft.text, fx - 20 + 1, fy - 16 - dy + 1);
    ctx.fillStyle = ft.color || "#dc2626";
    ctx.fillText(ft.text, fx - 20, fy - 16 - dy);
    ctx.restore();
  }
}

function drawPolylineWithNormal(pts, normal, color, dashed, label) {
  if (!pts || pts.length < 2) return;
  ctx.save();
  ctx.strokeStyle = color;
  ctx.lineWidth = dashed ? 2.2 : 2.8;
  ctx.setLineDash(dashed ? [6, 4] : []);
  ctx.beginPath();
  pts.forEach(([r, c], idx) => {
    const [sx, sy] = pxToScreen(r, c);
    if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
  });
  ctx.stroke();
  ctx.setLineDash([]);
  // 中点绘制朝敌法向量 N_line 箭头与标签
  const midIdx = Math.floor(pts.length / 2);
  const a = pts[Math.max(0, midIdx - 1)];
  const b = pts[Math.min(pts.length - 1, midIdx)];
  const mr = (a[0] + b[0]) * 0.5, mc = (a[1] + b[1]) * 0.5;
  const [mx, my] = pxToScreen(mr, mc);
  const nr = normal && normal.length === 2 ? Number(normal[0]) : 0.0;
  const nc = normal && normal.length === 2 ? Number(normal[1]) : 1.0;
  const nm = Math.hypot(nr, nc) || 1.0;
  const ax = mx + (nc / nm) * 16, ay = my + (nr / nm) * 16;
  ctx.beginPath(); ctx.moveTo(mx, my); ctx.lineTo(ax, ay); ctx.stroke();
  ctx.fillStyle = color;
  ctx.beginPath(); ctx.arc(ax, ay, 3.2, 0, Math.PI * 2); ctx.fill();
  if (label) {
    ctx.font = "bold 10px Consolas, monospace";
    ctx.fillText(label, mx + 6, my - 5);
  }
  ctx.restore();
}

function ensureC2DFieldCanvas(g, rev) {
  if (!g || g.large_grid || !g.terrain) return null;
  if (C2D_FIELD_CANVAS && C2D_FIELD_REV === rev) return C2D_FIELD_CANVAS;
  const rows = g.rows, cols = g.cols;
  const sub = Math.max(rows, cols) <= 32 ? 32 : 8;
  const W = cols * sub, H = rows * sub;
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const cctx = c.getContext("2d");
  const img = cctx.createImageData(W, H);
  const data = img.data;
  const fdGrid = g.forest_density || null;
  const field = new Float32Array(rows * cols);
  for (let r = 0; r < rows; r++) {
    const tRow = g.terrain[r];
    const fdRow = fdGrid ? fdGrid[r] : null;
    for (let col = 0; col < cols; col++) {
      const d = fdRow ? Number(fdRow[col] || 0) : 0;
      field[r * cols + col] = d > 0 ? Math.min(1.0, d) : (tRow[col] === 1 ? 0.5 : 0.0);
    }
  }
  const sampleBilinear = (gx, gy) => {
    const cx = Math.max(0, Math.min(cols - 1.0001, gx));
    const cy = Math.max(0, Math.min(rows - 1.0001, gy));
    const x0 = Math.floor(cx), y0 = Math.floor(cy);
    const x1 = Math.min(cols - 1, x0 + 1), y1 = Math.min(rows - 1, y0 + 1);
    const tx = cx - x0, ty = cy - y0;
    const v00 = field[y0 * cols + x0], v10 = field[y0 * cols + x1];
    const v01 = field[y1 * cols + x0], v11 = field[y1 * cols + x1];
    const a = v00 + (v10 - v00) * tx;
    const b = v01 + (v11 - v01) * tx;
    return a + (b - a) * ty;
  };
  const invSub = 1.0 / sub;
  const off = 0.48;
  const offD = off * 0.7071;
  for (let py = 0; py < H; py++) {
    const gy = (py + 0.5) * invSub - 0.5;
    const cellR = Math.max(0, Math.min(rows - 1, Math.floor((py + 0.5) * invSub)));
    const tRow = g.terrain[cellR];
    for (let px = 0; px < W; px++) {
      const gx = (px + 0.5) * invSub - 0.5;
      const cellC = Math.max(0, Math.min(cols - 1, Math.floor((px + 0.5) * invSub)));
      const tc = tRow ? tRow[cellC] : 0;
      const idx = (py * W + px) * 4;

      if (tc === 2) {
        // MOUNTAIN: Deep Cold Iron Black (#07080c) as King specified
        data[idx] = 7; data[idx + 1] = 8; data[idx + 2] = 12; data[idx + 3] = 255;
        continue;
      }
      if (tc === 4) {
        // WATER: Deep Blue (#163a6c)
        data[idx] = 22; data[idx + 1] = 58; data[idx + 2] = 108; data[idx + 3] = 255;
        continue;
      }
      if (tc === 3) {
        // SWAMP: Murky Green (#243834)
        data[idx] = 36; data[idx + 1] = 56; data[idx + 2] = 52; data[idx + 3] = 255;
        continue;
      }
      if (tc === 5) {
        // URBAN: Slate Grey (#48444c)
        data[idx] = 72; data[idx + 1] = 68; data[idx + 2] = 76; data[idx + 3] = 255;
        continue;
      }
      if (tc >= 10 && tc <= 13) {
        // ROADS/RAIL: Sand Road (#7a684f)
        data[idx] = 122; data[idx + 1] = 104; data[idx + 2] = 79; data[idx + 3] = 255;
        continue;
      }

      // Smooth Bilinear Forest over Plain Base (#f4f1ea)
      const fc  = sampleBilinear(gx, gy);
      const fl  = sampleBilinear(gx - off, gy);
      const fr  = sampleBilinear(gx + off, gy);
      const fu  = sampleBilinear(gx, gy - off);
      const fd  = sampleBilinear(gx, gy + off);
      const ful = sampleBilinear(gx - offD, gy - offD);
      const fur = sampleBilinear(gx + offD, gy - offD);
      const fdl = sampleBilinear(gx - offD, gy + offD);
      const fdr = sampleBilinear(gx + offD, gy + offD);
      const f = (fc * 1.6 + (fl + fr + fu + fd) + (ful + fur + fdl + fdr) * 0.7) / 8.4;
      let t = (f - 0.174) / (0.186 - 0.174);
      t = t <= 0 ? 0 : (t >= 1 ? 1 : t * t * (3 - 2 * t));

      // Plain base #f4f1ea (244, 241, 234) smoothly blending into forest #c3db90 (195, 219, 144)
      data[idx] = Math.round(244 + (195 - 244) * t);
      data[idx + 1] = Math.round(241 + (219 - 241) * t);
      data[idx + 2] = Math.round(234 + (144 - 234) * t);
      data[idx + 3] = 255;
    }
  }
  cctx.putImageData(img, 0, 0);
  C2D_FIELD_CANVAS = c;
  C2D_FIELD_REV = rev;
  return c;
}

function ensureC2DLOSCanvas(g, losData) {
  if (!g || !losData || !losData.cells) return null;
  if (C2D_LOS_CANVAS && C2D_LOS_KEY === losData) return C2D_LOS_CANVAS;
  const rows = g.rows, cols = g.cols;
  if (rows > 256 || cols > 256) return null; // fallback to viewport rects for ultra-massive maps
  const sub = Math.max(rows, cols) <= 32 ? 32 : 8;
  const W = cols * sub, H = rows * sub;
  const c = document.createElement("canvas");
  c.width = W; c.height = H;
  const cctx = c.getContext("2d");
  const img = cctx.createImageData(W, H);
  const data = img.data;
  const field = new Float32Array(rows * cols);
  for (const [r, col, eff] of losData.cells) {
    if (r >= 0 && r < rows && col >= 0 && col < cols) {
      field[r * cols + col] = Math.max(0.0, Math.min(1.0, Number(eff) || 0.0));
    }
  }
  const sampleBilinear = (gx, gy) => {
    const cx = Math.max(0, Math.min(cols - 1.0001, gx));
    const cy = Math.max(0, Math.min(rows - 1.0001, gy));
    const x0 = Math.floor(cx), y0 = Math.floor(cy);
    const x1 = Math.min(cols - 1, x0 + 1), y1 = Math.min(rows - 1, y0 + 1);
    const tx = cx - x0, ty = cy - y0;
    const v00 = field[y0 * cols + x0], v10 = field[y0 * cols + x1];
    const v01 = field[y1 * cols + x0], v11 = field[y1 * cols + x1];
    const a = v00 + (v10 - v00) * tx;
    const b = v01 + (v11 - v01) * tx;
    return a + (b - a) * ty;
  };
  const invSub = 1.0 / sub;
  const off = 0.48;
  const offD = off * 0.7071;
  for (let py = 0; py < H; py++) {
    const gy = (py + 0.5) * invSub - 0.5;
    for (let px = 0; px < W; px++) {
      const gx = (px + 0.5) * invSub - 0.5;
      const fc  = sampleBilinear(gx, gy);
      const fl  = sampleBilinear(gx - off, gy);
      const fr  = sampleBilinear(gx + off, gy);
      const fu  = sampleBilinear(gx, gy - off);
      const fd  = sampleBilinear(gx, gy + off);
      const ful = sampleBilinear(gx - offD, gy - offD);
      const fur = sampleBilinear(gx + offD, gy - offD);
      const fdl = sampleBilinear(gx - offD, gy + offD);
      const fdr = sampleBilinear(gx + offD, gy + offD);
      const f = (fc * 1.6 + (fl + fr + fu + fd) + (ful + fur + fdl + fdr) * 0.7) / 8.4;
      let t = (0.22 - f) / 0.015;
      t = t <= 0 ? 0 : (t >= 1 ? 1 : t * t * (3 - 2 * t));
      const idx = (py * W + px) * 4;
      data[idx] = 100;
      data[idx + 1] = 116;
      data[idx + 2] = 139;
      data[idx + 3] = Math.round(t * 68);
    }
  }
  cctx.putImageData(img, 0, 0);
  C2D_LOS_CANVAS = c;
  C2D_LOS_KEY = losData;
  return c;
}

let CLOUD_BLOB = null;
function ensureCloudBlob() {
  if (CLOUD_BLOB) return CLOUD_BLOB;
  const c = document.createElement("canvas");
  c.width = 256; c.height = 256;
  const cc = c.getContext("2d");
  const grd = cc.createRadialGradient(128, 128, 12, 128, 128, 128);
  grd.addColorStop(0, "rgba(42, 50, 38, 0.85)");
  grd.addColorStop(0.55, "rgba(42, 50, 38, 0.42)");
  grd.addColorStop(1, "rgba(42, 50, 38, 0)");
  cc.fillStyle = grd;
  cc.fillRect(0, 0, 256, 256);
  CLOUD_BLOB = c;
  return c;
}

function drawCloudShadows(g, s) {
  if (!LAYER_FLAGS.atmosphere) return;
  const blob = ensureCloudBlob();
  const t = performance.now() * 0.000016;
  const mx = VIEW.offsetX, my = VIEW.offsetY, mw = g.cols * s, mh = g.rows * s;
  ctx.save();
  ctx.beginPath(); ctx.rect(mx, my, mw, mh); ctx.clip();
  ctx.globalCompositeOperation = "multiply";
  ctx.globalAlpha = 0.14;
  for (let i = 0; i < 3; i++) {
    const ph = i * 2.1;
    const size = Math.max(mw, mh) * (0.55 + i * 0.24);
    const px = mx + (((t * (1.3 + i * 0.55) + ph * 0.37) % 1.6) - 0.3) * mw;
    const py = my + (0.22 + 0.30 * Math.sin(t * 2.2 + ph)) * mh;
    ctx.drawImage(blob, px - size / 2, py - size * 0.35, size, size * 0.7);
  }
  ctx.restore();
}

function drawMapFurniture(g, s) {
  const cw = canvas.width, ch = canvas.height;
  const mx = VIEW.offsetX, my = VIEW.offsetY;

  // 图廓坐标注记：沿图幅上缘/左缘的方里网编号
  if (LAYER_FLAGS.gridLines && s >= 8) {
    const step = s >= 20 ? 1 : (s >= 10 ? 2 : 4);
    ctx.save();
    ctx.font = "9px Consolas, monospace";
    ctx.fillStyle = "rgba(35, 32, 28, 0.58)";
    if (my >= -2 && my <= ch - 24) {
      ctx.textAlign = "center"; ctx.textBaseline = "top";
      const c0 = Math.max(step, Math.floor(-mx / s / step) * step);
      const c1 = Math.min(g.cols - 1, Math.ceil((cw - mx) / s));
      for (let c = c0; c <= c1; c += step) {
        const x = mx + c * s;
        if (x < 16 || x > cw - 16) continue;
        ctx.fillText(String(c).padStart(2, "0"), x, my + 3);
      }
    }
    if (mx >= -2 && mx <= cw - 30) {
      ctx.textAlign = "left"; ctx.textBaseline = "middle";
      const r0 = Math.max(step, Math.floor(-my / s / step) * step);
      const r1 = Math.min(g.rows - 1, Math.ceil((ch - my) / s));
      for (let r = r0; r <= r1; r += step) {
        const y = my + r * s;
        if (y < 16 || y > ch - 16) continue;
        ctx.fillText(String(r).padStart(2, "0"), mx + 4, y);
      }
    }
    ctx.restore();
  }

  // 罗盘玫瑰 (指北针)
  const rcx = cw - 62, rcy = 82;
  ctx.save();
  ctx.globalAlpha = 0.92;
  ctx.fillStyle = "rgba(246, 241, 227, 0.88)";
  ctx.strokeStyle = "#23201c";
  ctx.lineWidth = 1.2;
  ctx.beginPath(); ctx.arc(rcx, rcy, 26, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
  ctx.lineWidth = 0.6;
  ctx.strokeStyle = "rgba(35, 32, 28, 0.55)";
  ctx.beginPath(); ctx.arc(rcx, rcy, 21, 0, Math.PI * 2); ctx.stroke();
  for (let k = 0; k < 4; k++) {
    const a = k * Math.PI / 2 + Math.PI / 4;
    const tipX = rcx + Math.sin(a) * 13, tipY = rcy - Math.cos(a) * 13;
    const b1x = rcx + Math.sin(a + 0.5) * 4, b1y = rcy - Math.cos(a + 0.5) * 4;
    const b2x = rcx + Math.sin(a - 0.5) * 4, b2y = rcy - Math.cos(a - 0.5) * 4;
    ctx.fillStyle = "rgba(35, 32, 28, 0.55)";
    ctx.beginPath(); ctx.moveTo(tipX, tipY); ctx.lineTo(b1x, b1y); ctx.lineTo(b2x, b2y); ctx.closePath(); ctx.fill();
  }
  for (let k = 0; k < 4; k++) {
    const a = k * Math.PI / 2;
    const tipX = rcx + Math.sin(a) * 19, tipY = rcy - Math.cos(a) * 19;
    const b1x = rcx + Math.sin(a + 0.32) * 5, b1y = rcy - Math.cos(a + 0.32) * 5;
    const b2x = rcx + Math.sin(a - 0.32) * 5, b2y = rcy - Math.cos(a - 0.32) * 5;
    ctx.fillStyle = "#23201c";
    ctx.beginPath(); ctx.moveTo(tipX, tipY); ctx.lineTo(rcx, rcy); ctx.lineTo(b1x, b1y); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#f6f1e3";
    ctx.strokeStyle = "#23201c"; ctx.lineWidth = 0.7;
    ctx.beginPath(); ctx.moveTo(tipX, tipY); ctx.lineTo(rcx, rcy); ctx.lineTo(b2x, b2y); ctx.closePath(); ctx.fill(); ctx.stroke();
  }
  ctx.fillStyle = "#991b1b";
  ctx.beginPath(); ctx.arc(rcx, rcy, 2.2, 0, Math.PI * 2); ctx.fill();
  ctx.font = "bold 10px Consolas, monospace";
  ctx.textAlign = "center"; ctx.textBaseline = "bottom";
  ctx.lineJoin = "round";
  ctx.strokeStyle = "rgba(246, 241, 227, 0.9)";
  ctx.lineWidth = 3;
  ctx.strokeText("N", rcx, rcy - 28);
  ctx.fillStyle = "#23201c";
  ctx.fillText("N", rcx, rcy - 28);
  ctx.restore();

  // 比例尺 (依据 cell_m 与当前缩放自动取整)
  const cellM = g.cell_m || 200;
  const rawM = (180 / s) * cellM;
  const pow = Math.pow(10, Math.floor(Math.log10(Math.max(1, rawM))));
  let distM = pow;
  for (const m of [1, 2, 5, 10]) { if (m * pow <= rawM) distM = m * pow; }
  const barPx = Math.max(24, (distM / cellM) * s);
  const bx = Math.round(cw * 0.5 - barPx / 2), by = ch - 26;
  ctx.save();
  ctx.fillStyle = "rgba(246, 241, 227, 0.86)";
  ctx.strokeStyle = "rgba(35, 32, 28, 0.6)";
  ctx.lineWidth = 0.8;
  ctx.fillRect(bx - 12, by - 15, barPx + 24, 30);
  ctx.strokeRect(bx - 12, by - 15, barPx + 24, 30);
  const segs = 4, segW = barPx / segs;
  for (let i = 0; i < segs; i++) {
    ctx.fillStyle = i % 2 === 0 ? "#23201c" : "#f6f1e3";
    ctx.fillRect(bx + i * segW, by, segW, 5);
  }
  ctx.strokeStyle = "#23201c"; ctx.lineWidth = 1;
  ctx.strokeRect(bx, by, barPx, 5);
  ctx.font = "9px Consolas, monospace";
  ctx.fillStyle = "#23201c";
  ctx.textAlign = "left"; ctx.textBaseline = "bottom";
  ctx.fillText("0", bx - 1, by - 2);
  ctx.textAlign = "right";
  ctx.fillText(distM >= 1000 ? `${distM / 1000} km` : `${distM} m`, bx + barPx + 1, by - 2);
  ctx.textAlign = "center";
  ctx.textBaseline = "top";
  ctx.fillText(`${cellM}m/格`, bx + barPx / 2, by + 7);
  ctx.restore();
}

function render() {
  const rect = canvas.parentElement.getBoundingClientRect();
  const cw = Math.max(1, Math.floor(rect.width));
  const ch = Math.max(1, Math.floor(rect.height));
  const glCanvas = document.getElementById("glCanvas");
  if (canvas.width !== cw || canvas.height !== ch) {
    canvas.width = cw;
    canvas.height = ch;
  }
  if (glCanvas && (glCanvas.width !== cw || glCanvas.height !== ch)) {
    glCanvas.width = cw;
    glCanvas.height = ch;
  }
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  if (!STATE || !STATE.grid) return;

  const g = STATE.grid;
  const s = VIEW.pxSize;
  const rev = g.terrain_revision || 1;

  // === Layer 0: 小地图直走单层 Canvas2D 避免 WebGL2 跨层合成伪影；大图走 WebGL2 256x256 流式瓦片 ===
  if (g.large_grid && RENDERER_MODE === "WebGL2" && GL && GL_PROG) {
    if (glCanvas && glCanvas.style.display !== "block") glCanvas.style.display = "block";
    GL.viewport(0, 0, glCanvas.width, glCanvas.height);
    GL.clearColor(0.184, 0.180, 0.157, 1.0);
    GL.clear(GL.COLOR_BUFFER_BIT);
    GL.useProgram(GL_PROG);
    GL.bindVertexArray(GL_VAO);
    GL.uniform2f(GL_LOC_RES, glCanvas.width, glCanvas.height);
    GL.uniform1i(GL_LOC_TEX, 0);
    GL.uniform1i(GL_LOC_PLAIN_TEX, 1);
    GL.uniform1i(GL_LOC_FIELD_TEX, 2);
    GL.uniform1i(GL_LOC_HAS_PLAIN, (ENABLE_KRAFT_PAPER && GL_PLAIN_READY) ? 1 : 0);
    GL.uniform2f(GL_LOC_GRID_SZ, g.cols, g.rows);
    if (!g.large_grid && g.terrain && GL_FIELD_REV !== rev) {
      const buf = new Uint8Array(g.rows * g.cols * 4);
      const fdGrid = g.forest_density || null;
      for (let r = 0; r < g.rows; r++) {
        const row = g.terrain[r];
        const fdRow = fdGrid ? fdGrid[r] : null;
        for (let c = 0; c < g.cols; c++) {
          const d = fdRow ? Number(fdRow[c] || 0) : 0;
          const v = d > 0 ? Math.min(255, Math.round(d * 255)) : (row[c] === 1 ? 128 : 0);
          const idx = (r * g.cols + c) * 4;
          buf[idx] = v; buf[idx + 1] = v; buf[idx + 2] = v; buf[idx + 3] = 255;
        }
      }
      if (!GL_TEX_FIELD) GL_TEX_FIELD = GL.createTexture();
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_FIELD);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MIN_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_MAG_FILTER, GL.LINEAR);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_S, GL.CLAMP_TO_EDGE);
      GL.texParameteri(GL.TEXTURE_2D, GL.TEXTURE_WRAP_T, GL.CLAMP_TO_EDGE);
      GL.texImage2D(GL.TEXTURE_2D, 0, GL.RGBA, g.cols, g.rows, 0, GL.RGBA, GL.UNSIGNED_BYTE, buf);
      GL_FIELD_READY = true;
      GL_FIELD_REV = rev;
    }
    GL.uniform1i(GL_LOC_HAS_FIELD, (LAYER_FLAGS.forestFill && GL_FIELD_READY) ? 1 : 0);
    if (ENABLE_KRAFT_PAPER && GL_PLAIN_READY && GL_TEX_PLAIN) {
      GL.activeTexture(GL.TEXTURE1);
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_PLAIN);
    }
    if (GL_FIELD_READY && GL_TEX_FIELD) {
      GL.activeTexture(GL.TEXTURE2);
      GL.bindTexture(GL.TEXTURE_2D, GL_TEX_FIELD);
    }
    GL.activeTexture(GL.TEXTURE0);
    if (!g.large_grid) {
      GL.uniform4f(GL_LOC_RECT, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      GL.uniform4f(GL_LOC_TILE_UV, 0, 0, g.cols, g.rows);
      GL.drawArrays(GL.TRIANGLES, 0, 6);
    } else if (TILE_STREAM_SUPPORTED) {
      requestVisibleTiles();
      const bounds = getVisibleTileBounds();
      if (bounds) {
        for (let tr = bounds.trMin; tr <= bounds.trMax; tr++) {
          for (let tc = bounds.tcMin; tc <= bounds.tcMax; tc++) {
            const ent = TILE_CACHE.get(`${rev}:${tr}:${tc}`);
            if (!ent) continue;
            ensureTileUploaded(ent);
            if (!ent.tex) continue;
            GL.bindTexture(GL.TEXTURE_2D, ent.tex);
            const x0 = VIEW.offsetX + tc * TILE_SIZE * s;
            const y0 = VIEW.offsetY + tr * TILE_SIZE * s;
            GL.uniform4f(GL_LOC_RECT, x0, y0, ent.w * s, ent.h * s);
            GL.uniform4f(GL_LOC_TILE_UV, tc * TILE_SIZE, tr * TILE_SIZE, ent.w, ent.h);
            GL.drawArrays(GL.TRIANGLES, 0, 6);
          }
        }
      }
    }
  } else if (!g.large_grid) {
    if (glCanvas && glCanvas.style.display !== "none") glCanvas.style.display = "none";
    const fieldCvs = LAYER_FLAGS.forestFill ? ensureC2DFieldCanvas(g, rev) : null;
    if (fieldCvs) {
      ctx.save();
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(fieldCvs, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.restore();
    } else {
      ctx.fillStyle = "#f7f7f4";
      ctx.fillRect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
    }
    if (ENABLE_KRAFT_PAPER && PLAIN_PATTERN) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.clip();
      ctx.globalCompositeOperation = "multiply";
      ctx.globalAlpha = 0.55;
      ctx.translate(VIEW.offsetX, VIEW.offsetY);
      const patScale = (s * 8.0) / Math.max(1, PLAIN_TEX_IMG.naturalWidth || 512);
      ctx.scale(patScale, patScale);
      ctx.fillStyle = PLAIN_PATTERN;
      ctx.fillRect(0, 0, (g.cols * s) / patScale, (g.rows * s) / patScale);
      ctx.restore();
    }
  } else if (TILE_STREAM_SUPPORTED) {
    ctx.fillStyle = "#f7f7f4";
    ctx.fillRect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
    requestVisibleTiles();
    const bounds = getVisibleTileBounds();
    if (bounds) {
      ctx.save();
      ctx.imageSmoothingEnabled = s < 1.5;
      for (let tr = bounds.trMin; tr <= bounds.trMax; tr++) {
        for (let tc = bounds.tcMin; tc <= bounds.tcMax; tc++) {
          const ent = TILE_CACHE.get(`${rev}:${tr}:${tc}`);
          if (!ent) continue;
          ensureTileUploaded(ent);
          if (!ent.c2d) continue;
          const x0 = VIEW.offsetX + tc * TILE_SIZE * s;
          const y0 = VIEW.offsetY + tr * TILE_SIZE * s;
          ctx.drawImage(ent.c2d, x0, y0, ent.w * s, ent.h * s);
        }
      }
      ctx.restore();
    }
    if (ENABLE_KRAFT_PAPER && PLAIN_PATTERN) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
      ctx.clip();
      ctx.globalCompositeOperation = "multiply";
      ctx.globalAlpha = 0.55;
      ctx.translate(VIEW.offsetX, VIEW.offsetY);
      const patScale = (s * 8.0) / Math.max(1, PLAIN_TEX_IMG.naturalWidth || 512);
      ctx.scale(patScale, patScale);
      ctx.fillStyle = PLAIN_PATTERN;
      ctx.fillRect(0, 0, (g.cols * s) / patScale, (g.rows * s) / patScale);
      ctx.restore();
    }
  } else {
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(TERRAIN_CANVAS, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
  }

  // === Layer 0.25: 军用方里网 (细锐利正交参考线，视口裁剪与自适应步长) ===
  if (LAYER_FLAGS.gridLines && s >= 8) {
    const step = s >= 20 ? 1 : (s >= 10 ? 2 : 4);
    const r0 = Math.max(0, Math.floor(-VIEW.offsetY / s));
    const r1 = Math.min(g.rows, Math.ceil((canvas.height - VIEW.offsetY) / s));
    const c0 = Math.max(0, Math.floor(-VIEW.offsetX / s));
    const c1 = Math.min(g.cols, Math.ceil((canvas.width - VIEW.offsetX) / s));
    const startR = Math.floor(r0 / step) * step;
    const startC = Math.floor(c0 / step) * step;

    ctx.save();
    ctx.strokeStyle = "rgba(0, 0, 0, 0.16)";
    ctx.lineWidth = 0.8;
    ctx.beginPath();
    for (let r = Math.max(step, startR); r <= r1; r += step) {
      if (r > g.rows) break;
      const y = VIEW.offsetY + r * s;
      ctx.moveTo(VIEW.offsetX, y);
      ctx.lineTo(VIEW.offsetX + g.cols * s, y);
    }
    for (let c = Math.max(step, startC); c <= c1; c += step) {
      if (c > g.cols) break;
      const x = VIEW.offsetX + c * s;
      ctx.moveTo(x, VIEW.offsetY);
      ctx.lineTo(x, VIEW.offsetY + g.rows * s);
    }
    ctx.stroke();
    ctx.restore();
  }

  // === Layer 0.5: 矢量线条树枝贴图 (视口裁剪 + 按像素容器连续树密度 0.0..1.0 渲染) ===
  if (LAYER_FLAGS.forestTrees && FOREST_TREE_READY && !g.large_grid && g.terrain) {
    const rMin = Math.max(0, Math.floor(-VIEW.offsetY / s) - 1);
    const rMax = Math.min(g.rows - 1, Math.ceil((canvas.height - VIEW.offsetY) / s) + 1);
    const cMin = Math.max(0, Math.floor(-VIEW.offsetX / s) - 1);
    const cMax = Math.min(g.cols - 1, Math.ceil((canvas.width - VIEW.offsetX) / s) + 1);
    const fdGrid = g.forest_density || null;
    const treePlacements = [];
    for (let r = rMin; r <= rMax; r++) {
      const row = g.terrain[r];
      if (!row) continue;
      const fdRow = fdGrid ? fdGrid[r] : null;
      for (let c = cMin; c <= cMax; c++) {
        const rawD = fdRow ? Number(fdRow[c] || 0) : 0;
        const density = rawD > 0 ? Math.min(1.0, rawD) : (row[c] === 1 ? 0.5 : 0.0);
        if (density <= 0.0) continue;
        const h1 = ((r * 73856093) ^ (c * 19349663)) >>> 0;
        // Continuous density -> smooth tree count (0.0..1.0 -> 1..4 trees with stochastic fractional rounding)
        const expected = density * 3.6;
        const baseN = Math.floor(expected);
        const frac = expected - baseN;
        const extra = ((h1 & 0xff) / 255.0) < frac ? 1 : 0;
        const nTrees = Math.max(density >= 0.15 ? 1 : 0, baseN + extra);
        for (let k = 0; k < nTrees; k++) {
          const hk = ((h1 ^ (k * 83492791)) >>> 0);
          const vIdx = hk % 4;
          const spread = nTrees === 1 ? 0.24 : 0.42;
          const ox = (((hk & 0xff) / 255.0) - 0.5) * spread * s;
          const oy = ((((hk >> 8) & 0xff) / 255.0) - 0.5) * spread * s;
          const sc = (nTrees <= 1 ? 0.62 : 0.48) + (((hk >> 16) & 0xff) / 255.0) * 0.18;
          const rot = ((((hk >> 24) & 0xff) / 255.0) - 0.5) * 0.10;
          const cx = VIEW.offsetX + (c + 0.5) * s + ox;
          const cy = VIEW.offsetY + (r + 0.5) * s + oy;
          treePlacements.push({ vIdx, cx, cy, sc, rot });
        }
      }
    }
    treePlacements.sort((a, b) => a.cy - b.cy);
    for (const tp of treePlacements) {
      const img = FOREST_TREE_IMGS[tp.vIdx];
      if (!img || !img.complete || img.naturalWidth === 0) continue;
      const drawW = s * tp.sc * 0.80;
      const drawH = drawW * 1.32;
      ctx.save();
      ctx.translate(tp.cx, tp.cy);
      ctx.rotate(tp.rot);
      ctx.drawImage(img, -drawW * 0.5, -drawH * 0.78, drawW, drawH);
      ctx.restore();
    }
  }

  // === Layer 0.75: 漂移云影氛围 (multiply 叠加，仅落在图幅内) ===
  drawCloudShadows(g, s);

  // 双重图廓 (外粗内细 neatline)
  ctx.strokeStyle = "#23201c";
  ctx.lineWidth = 2;
  ctx.strokeRect(VIEW.offsetX - 1, VIEW.offsetY - 1, g.cols * s + 2, g.rows * s + 2);
  ctx.strokeStyle = "rgba(35, 32, 28, 0.5)";
  ctx.lineWidth = 0.8;
  ctx.strokeRect(VIEW.offsetX - 5, VIEW.offsetY - 5, g.cols * s + 10, g.rows * s + 10);

  for (const st of (g.stashes || STATE.stashes || [])) {
    const [sx, sy] = pxToScreen(st.px[0], st.px[1]);
    ctx.fillStyle = "#fde047";
    ctx.strokeStyle = "#000";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.rect(sx - 5, sy - 5, 10, 10);
    ctx.fill(); ctx.stroke();
  }

  // === Layer 3: 武器射界与直瞄 LOS 平滑盲区阴影遮罩 (去方块化) ===
  if (LAYER_FLAGS.losShadow && document.getElementById("chkL3").checked && LOS_DATA && LOS_DATA.cells) {
    if (!g.large_grid) {
      const losCvs = ensureC2DLOSCanvas(g, LOS_DATA);
      if (losCvs) {
        ctx.save();
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(losCvs, VIEW.offsetX, VIEW.offsetY, g.cols * s, g.rows * s);
        ctx.restore();
      }
    } else {
      for (const [r, c, eff] of LOS_DATA.cells) {
        const alpha = Math.min(0.45, 0.10 + eff * 0.35);
        ctx.fillStyle = LOS_DATA.indirect ? `rgba(249,115,22,${alpha})` : `rgba(239,68,68,${alpha})`;
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    for (const te of (LOS_DATA.targetable_enemies || [])) {
      const [ex, ey] = pxToScreen(te.px[0], te.px[1]);
      ctx.strokeStyle = "#f59e0b";
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(ex, ey, Math.max(9, s * 0.8), 0, Math.PI * 2); ctx.stroke();
    }
  }

  // === Layer 1: 已确认 AO、有效指挥半径与严格按单指挥官权限过滤的通联连线 ===
  if (document.getElementById("chkL1").checked) {
    for (const ao of (STATE.ao_zones || [])) {
      ctx.fillStyle = ao.writable ? "rgba(56,189,248,0.16)" : "rgba(34,197,94,0.12)";
      for (const [r, c] of (ao.cells || [])) {
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    ctx.strokeStyle = "rgba(250,204,21,0.55)";
    ctx.lineWidth = 1.5;
    for (const [a, b] of (g.wires || STATE.wires || [])) {
      const [x1, y1] = pxToScreen(a[0], a[1]);
      const [x2, y2] = pxToScreen(b[0], b[1]);
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    }
    const selfCmd = (STATE.commanders || []).find(c => c.is_self);
    if (LAYER_FLAGS.cmdRadius && selfCmd) {
      const cpos = selfCmd.pos || selfCmd.px;
      const [cx, cy] = pxToScreen(cpos[0], cpos[1]);
      const radPx = (selfCmd.radius_km * 1000.0 / g.cell_m) * s;
      ctx.strokeStyle = selfCmd.radio_silence ? "rgba(245,158,11,0.75)" : "rgba(56,189,248,0.6)";
      ctx.setLineDash([]);
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(cx, cy, radPx, 0, Math.PI * 2); ctx.stroke();
    }
    if (LAYER_FLAGS.cmdLinks && (STATE.layer1_links || []).length > 0) {
      ctx.save();
      ctx.setLineDash([6, 4]);
      ctx.lineDashOffset = -(performance.now() * 0.024) % 10;
      ctx.lineWidth = 2;
      for (const ln of STATE.layer1_links) {
        const [x1, y1] = pxToScreen(ln.from[0], ln.from[1]);
        const [x2, y2] = pxToScreen(ln.to[0], ln.to[1]);
        ctx.strokeStyle = ln.kind === "proximity" ? "#a855f7" : "#0ea5e9";
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
      }
      ctx.restore();
    }
    for (const fl of (STATE.typed_frontlines || [])) {
      const st = frontlineStyle(fl.unit_type_mask);
      drawPolylineWithNormal(fl.points_px, fl.front_normal, st.color, false, st.label);
    }
    for (const p of (STATE.own_pieces || [])) {
      if ((p.readable_line !== false) && p.planned_route && p.planned_route.path && p.planned_route.path.length > 1) {
        ctx.strokeStyle = "rgba(52,211,153,0.85)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        p.planned_route.path.forEach(([r, c], idx) => {
          const [px, py] = pxToScreen(r, c);
          if (idx === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        });
        ctx.stroke();
      }
    }
  }

  // === Layer 2: 下一回合草稿线、分兵种战线草稿 & 实时校验 AO 预览 ===
  if (document.getElementById("chkL2").checked) {
    if (DRAFTS.ao_preview && DRAFTS.ao_preview.cells) {
      ctx.fillStyle = DRAFTS.ao_preview.ok ? "rgba(45,212,191,0.28)" : "rgba(239,68,68,0.38)";
      for (const [r, c] of DRAFTS.ao_preview.cells) {
        ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
      }
    }
    for (const ao of DRAFTS.ao_zones) {
      ctx.fillStyle = "rgba(45,212,191,0.22)";
      for (const [r, c] of ao.cells) ctx.fillRect(VIEW.offsetX + c * s, VIEW.offsetY + r * s, s, s);
    }
    for (const fl of DRAFTS.typed_frontlines) {
      const st = frontlineStyle(fl.unit_type_mask);
      drawPolylineWithNormal(fl.points_px, fl.front_normal, st.color, true, `草稿:${st.label}`);
    }
    if (DRAFTS.active_frontline_pts.length > 0) {
      ctx.strokeStyle = "#fde047";
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      DRAFTS.active_frontline_pts.forEach(([r, c], idx) => {
        const [sx, sy] = pxToScreen(r, c);
        if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = "#fde047";
      for (const [r, c] of DRAFTS.active_frontline_pts) {
        const [sx, sy] = pxToScreen(r, c);
        ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
      }
    }
    for (const bo of DRAFTS.baguwen_orders) {
      const [tx, ty] = pxToScreen(bo.target_px[0], bo.target_px[1]);
      ctx.strokeStyle = "#f472b6";
      ctx.lineWidth = 2;
      ctx.setLineDash([4, 4]);
      const selfCmd = (STATE.commanders || []).find(c => c.is_self);
      if (selfCmd) {
        const [cx, cy] = pxToScreen(selfCmd.px[0], selfCmd.px[1]);
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(tx, ty); ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.fillStyle = "#f472b6";
      ctx.beginPath(); ctx.arc(tx, ty, 5, 0, Math.PI * 2); ctx.fill();
    }
  }

  // 敌军接触（实体红菱牌 + 呼吸威胁环）
  for (const ec of (STATE.enemy_contacts || STATE.visible_enemies || [])) {
    const [ex, ey] = pxToScreen(ec.px[0], ec.px[1]);
    const threatPulse = 0.5 + 0.5 * Math.sin(performance.now() * 0.005 + ex * 0.013);
    ctx.save();
    ctx.strokeStyle = `rgba(220, 38, 38, ${0.2 + threatPulse * 0.28})`;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(ex, ey, 12 + threatPulse * 4, 0, Math.PI * 2); ctx.stroke();
    ctx.shadowColor = "rgba(28, 25, 23, 0.4)";
    ctx.shadowBlur = 4;
    ctx.shadowOffsetY = 2;
    ctx.fillStyle = "#dc2626";
    ctx.beginPath();
    ctx.moveTo(ex, ey - 8); ctx.lineTo(ex + 8, ey); ctx.lineTo(ex, ey + 8); ctx.lineTo(ex - 8, ey);
    ctx.closePath(); ctx.fill();
    ctx.shadowColor = "transparent";
    ctx.strokeStyle = "#fff7ed";
    ctx.lineWidth = 1.8;
    ctx.stroke();
    ctx.strokeStyle = "rgba(28, 25, 23, 0.55)";
    ctx.lineWidth = 0.7;
    ctx.beginPath();
    ctx.moveTo(ex, ey - 5); ctx.lineTo(ex + 5, ey); ctx.lineTo(ex, ey + 5); ctx.lineTo(ex - 5, ey);
    ctx.closePath(); ctx.stroke();
    const elabel = ec.name || (ec.est_persons ? `${ec.id} (~${ec.est_persons}人)` : ec.id) || "敌情";
    ctx.font = "bold 10px Consolas, monospace";
    ctx.textAlign = "left"; ctx.textBaseline = "middle";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "rgba(255, 253, 245, 0.9)";
    ctx.lineWidth = 3;
    ctx.strokeText(elabel, ex + 12, ey);
    ctx.fillStyle = "#7f1d1d";
    ctx.fillText(elabel, ex + 12, ey);
    ctx.restore();
  }

  // === 基础战术标志图层 (行军 / 进攻 / 占领线 / 进攻受阻 / 撤退) ===
  if (document.getElementById("chkL2").checked) {
    drawTacticalMarksShowcase(g, s);
  }

  // === 直控移动 / 攻击路径与正在绘制的战术线 ===
  const resolveLiveTargetPos = (tid) => {
    if (!tid) return null;
    if (RENDER_POS[tid]) return RENDER_POS[tid];
    const tc = (STATE.commanders || []).find(x => x.id === tid);
    if (tc && tc.alive !== false) return tc.pos || tc.px;
    const tp = (STATE.own_pieces || []).find(x => x.id === tid);
    if (tp && tp.persons > 0) return tp.pos || tp.px;
    return null;
  };
  const drawDirectPlan = (startPos, plan, rangeM = 450, pieceQueue = null, entId = null) => {
    try {
      if (!startPos || !Array.isArray(startPos) || startPos.length < 2 || Number.isNaN(startPos[0]) || Number.isNaN(startPos[1])) return;
      if (!plan && (!pieceQueue || pieceQueue.length === 0) && (!DIRECT_PICK || DIRECT_PICK.targetId !== entId)) return;
      const showL1 = document.getElementById("chkL1").checked;
      const showL2 = document.getElementById("chkL2").checked;

      if (plan && plan.action === "attack") {
        if (!showL1 && !showL2) return;
        const tp = resolveLiveTargetPos(plan.target_unit_id) || plan.target_pos;
        if (!tp || !Array.isArray(tp) || tp.length < 2 || Number.isNaN(tp[0]) || Number.isNaN(tp[1])) return;
        const [x1, y1] = pxToScreen(startPos[0], startPos[1]);
        const [x2, y2] = pxToScreen(tp[0], tp[1]);
        const now = performance.now();
        ctx.save();
        // 1. 武器有效射程圈
        const rangePx = (rangeM / g.cell_m) * s;
        ctx.strokeStyle = "rgba(220, 38, 38, 0.25)";
        ctx.lineWidth = 1.2;
        ctx.setLineDash([4, 4]);
        ctx.beginPath(); ctx.arc(x1, y1, rangePx, 0, Math.PI * 2); ctx.stroke();

        // 2. 椭圆散布 (长轴沿射击方向)：通畅时落在目标中心，被遮挡时落在首个弹着点（遮蔽物处）
        const outOfAmmo = Boolean(plan.out_of_ammo);
        const dispM = plan.dispersion_m || 35;
        const dispPx = Math.max(10, (dispM / g.cell_m) * s);
        const dispRy = dispPx * 0.42;
        const dispAngle = Math.atan2(y2 - y1, x2 - x1);
        const los = computeLosSpans(startPos, tp);
        const losBlocked = Boolean(plan.last_los_blocked) || los.blocked;
        const tBlock = los.blocked ? Math.max(0.04, los.firstBlockT) : 1;
        const ix = x1 + (x2 - x1) * tBlock;
        const iy = y1 + (y2 - y1) * tBlock;
        const dispCx = los.blocked ? ix : x2;
        const dispCy = los.blocked ? iy : y2;
        drawDispersionEllipse(ctx, dispCx, dispCy, dispPx, dispRy, dispAngle,
          outOfAmmo ? "rgba(28, 25, 23, 0.22)" : (los.blocked ? "rgba(217, 119, 6, 0.12)" : (losBlocked ? "rgba(156, 163, 175, 0.14)" : "rgba(220, 38, 38, 0.14)")),
          outOfAmmo ? "#1c1917" : (los.blocked ? "rgba(217, 119, 6, 0.8)" : (losBlocked ? "#9ca3af" : "rgba(220, 38, 38, 0.85)")),
          outOfAmmo ? 2.0 : 1.6, outOfAmmo ? [] : [5, 3]);

        // 3. 动态火线分段：遮蔽之前保持活跃红色曳光线，遮蔽之后为黑色失效线
        const liveCol = outOfAmmo ? "#1c1917" : (losBlocked && !los.blocked ? "#9ca3af" : "#dc2626");
        ctx.strokeStyle = liveCol;
        ctx.lineWidth = outOfAmmo ? 1.6 : 2.2;
        if (outOfAmmo) {
          ctx.setLineDash([4, 4]);
        } else {
          ctx.setLineDash([8, 5]);
          ctx.lineDashOffset = -(now * 0.06) % 13;
        }
        ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(los.blocked ? ix : x2, los.blocked ? iy : y2); ctx.stroke();
        if (los.blocked && !outOfAmmo) {
          ctx.strokeStyle = "#1c1917";
          ctx.lineWidth = 1.4;
          ctx.setLineDash([3, 4]);
          ctx.lineDashOffset = 0;
          ctx.globalAlpha = 0.85;
          ctx.beginPath(); ctx.moveTo(ix, iy); ctx.lineTo(x2, y2); ctx.stroke();
          ctx.globalAlpha = 1;
        }
        ctx.setLineDash([]);
        drawArrowHead(x1, y1, x2, y2, 8, (los.blocked && !outOfAmmo) ? "#1c1917" : liveCol, true);

        // 射击遮挡区段：灰色阻断带 + 琥珀叉标 + 遮蔽标牌
        if (!outOfAmmo) drawLosOcclusion(ctx, x1, y1, x2, y2, los);

        if (!outOfAmmo) {
          for (let k = 0; k < 2; k++) {
            const t = (((now * 0.0018) + k * 0.5) % 1) * tBlock;
            const bx = x1 + (x2 - x1) * t;
            const by = y1 + (y2 - y1) * t;
            ctx.fillStyle = "#fde047";
            ctx.beginPath(); ctx.arc(bx, by, 3.2, 0, Math.PI * 2); ctx.fill();
          }
          // 椭圆散布内随机弹着火花动画（阻塞时环绕弹着点，通畅时环绕目标）
          const ca = Math.cos(dispAngle), sa = Math.sin(dispAngle);
          const sparkCol = los.blocked ? "rgba(251, 191, 36, 0.8)" : "rgba(251, 146, 60, 0.85)";
          const sparkR = los.blocked ? 1.8 : 2.5;
          for (let k = 0; k < 3; k++) {
            const seed = Math.floor(now / 160) * 7 + k * 31;
            const ang = (seed * 1.91) % (Math.PI * 2);
            const rad = Math.sqrt((seed * 0.618) % 1) * 0.8;
            const lx = Math.cos(ang) * rad * dispPx;
            const ly = Math.sin(ang) * rad * dispRy;
            const fx = dispCx + lx * ca - ly * sa;
            const fy = dispCy + lx * sa + ly * ca;
            ctx.fillStyle = sparkCol;
            ctx.beginPath(); ctx.arc(fx, fy, sparkR, 0, Math.PI * 2); ctx.fill();
          }
        }
        if (!outOfAmmo && plan.last_fire_summary) {
          ctx.font = "bold 10.5px Consolas, Microsoft YaHei, sans-serif";
          ctx.fillStyle = "#991b1b";
          ctx.fillText(plan.last_fire_summary, dispCx + dispPx + 6, dispCy - 4);
        }
        ctx.restore();
        const hasMoreQueue = (Array.isArray(pieceQueue) && pieceQueue.length > 1) || (plan && Array.isArray(plan.segments) && plan.segments.length > 1) || (plan && Array.isArray(plan.waypoints) && plan.waypoints.length > 0);
        if (!hasMoreQueue) return;
      }
      if (!showL2) return;
      if (plan && plan.action === "retreat" && (!plan.waypoints || plan.waypoints.length === 0)) {
        const [sx0, sy0] = pxToScreen(startPos[0], startPos[1]);
        ctx.save();
        ctx.strokeStyle = "#7c3aed";
        ctx.lineWidth = 2.2;
        ctx.setLineDash([5, 3]);
        ctx.beginPath(); ctx.arc(sx0, sy0, 18, 0, Math.PI * 2); ctx.stroke();
        ctx.font = "bold 10px Microsoft YaHei, sans-serif";
        ctx.fillStyle = "#6d28d9";
        ctx.fillText("不可逆溃退", sx0 + 16, sy0 - 8);
        ctx.restore();
        return;
      }
      const halted = plan && plan.action === "stop";
      const steps = halted ? [] : ((Array.isArray(pieceQueue) && pieceQueue.length > 0)
        ? pieceQueue
        : (Array.isArray(plan && plan.segments) && plan.segments.length > 0
            ? plan.segments
            : (plan && plan.target_pos
                ? [{ goal: plan.target_pos, action: plan.action, move_mode: plan.move_mode, fire_mode: plan.fire_mode }]
                : [])));

      const hasWaypoints = !halted && plan && Array.isArray(plan.waypoints) && plan.waypoints.length > 0;
      if (!hasWaypoints && steps.length === 0 && (!DIRECT_PICK || DIRECT_PICK.targetId !== entId)) return;

      const isAssault = (plan && plan.action === "assault") || (steps[0] && steps[0].action === "assault");
      const isRetreat = (plan && plan.action === "retreat") || (steps[0] && steps[0].action === "retreat");
      const color = isRetreat ? "#7c3aed" : (isAssault ? "#dc2626" : "#0284c7");

      ctx.save();
      let lastGoalPos = startPos;

      // 1. 规划路径折线（地形减速/不可通行覆盖层只叠加在机动段，射击/驻止段不减速）
      const pathPts = [startPos];
      const slowRuns = [];
      if (hasWaypoints) {
        for (let i = 0; i < plan.waypoints.length; i++) {
          const wp = plan.waypoints[i];
          if (!wp || !Array.isArray(wp) || wp.length < 2 || Number.isNaN(wp[0]) || Number.isNaN(wp[1])) continue;
          pathPts.push(wp);
        }
        lastGoalPos = pathPts[pathPts.length - 1] || startPos;
        if (pathPts.length >= 2) slowRuns.push(pathPts);
      } else if (steps.length > 0) {
        let run = [startPos];
        for (let i = 0; i < steps.length; i++) {
          const st = steps[i];
          const gp = st && st.goal;
          if (!gp || !Array.isArray(gp) || gp.length < 2 || Number.isNaN(gp[0]) || Number.isNaN(gp[1])) continue;
          pathPts.push(gp);
          const act = st.action || "move";
          if (act === "attack" || act === "stop") {
            if (run.length >= 2) slowRuns.push(run);
            run = [gp];
          } else {
            run.push(gp);
          }
        }
        if (run.length >= 2) slowRuns.push(run);
        lastGoalPos = pathPts[pathPts.length - 1] || startPos;
      }
      for (const run of slowRuns) drawMoveSlowdown(ctx, run);
      ctx.strokeStyle = color;
      ctx.lineWidth = isAssault ? 3.0 : 2.4;
      ctx.setLineDash(isAssault ? [10, 4] : [7, 4]);
      ctx.beginPath();
      for (let i = 0; i < pathPts.length; i++) {
        const [px, py] = pxToScreen(pathPts[i][0], pathPts[i][1]);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      if (pathPts.length >= 2) {
        const pa = pathPts[pathPts.length - 2], pb = pathPts[pathPts.length - 1];
        const [ax, ay] = pxToScreen(pa[0], pa[1]);
        const [bx, by] = pxToScreen(pb[0], pb[1]);
        if (ax !== bx || ay !== by) {
          drawArrowHead(ax, ay, bx, by, isAssault ? 11 : 9, color, isAssault);
        }
      }

      // 2. 在每个任务步骤的终点绘制 ①、②、③ 徽标与行动模式标签
      const BADGE_SYMBOLS = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨", "⑩", "⑪", "⑫", "⑬", "⑭", "⑮", "⑯"];
      for (let i = 0; i < steps.length; i++) {
        const st = steps[i];
        if (!st) continue;
        const g = st.goal || startPos;
        if (!g || !Array.isArray(g) || g.length < 2 || Number.isNaN(g[0]) || Number.isNaN(g[1])) continue;
        const [gx, gy] = pxToScreen(g[0], g[1]);
        const stAct = st.action || "move";
        const stMm = st.move_mode || "normal";
        const stFm = st.fire_mode || "stop_to_fire";
        const stColor = stAct === "assault" ? "#dc2626" : (stAct === "attack" ? "#ea580c" : (stAct === "stop" ? "#4b5563" : "#0284c7"));
        const badgeSym = BADGE_SYMBOLS[i] || `[${i + 1}]`;

        // 徽章圆圈
        ctx.fillStyle = stColor;
        ctx.strokeStyle = "#ffffff";
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.arc(gx, gy, 7, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = "#ffffff";
        ctx.font = "bold 9.5px Consolas, Microsoft YaHei, monospace";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(badgeSym, gx, gy);

        // 药丸标牌 [动作·速度/开火]
        const actLabel = stAct === "assault" ? "进攻" : (stAct === "attack" ? "射击" : (stAct === "stop" ? "驻止" : "机动"));
        const mmLabel = stMm === "fast" ? "快" : (stMm === "slow" ? "渗透" : "常");
        const fmLabel = ""; // fire_on_the_move 已正式注销，转为跃进交替预制宏
        const pillText = `${actLabel}·${mmLabel}${fmLabel ? "·" + fmLabel : ""}`;

        ctx.font = "bold 9px Microsoft YaHei, sans-serif";
        const txtW = ctx.measureText(pillText).width;
        const pillX = gx + 9;
        const pillY = gy - 7;
        ctx.fillStyle = "rgba(255, 255, 255, 0.92)";
        ctx.strokeStyle = stColor;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.roundRect ? ctx.roundRect(pillX, pillY, txtW + 8, 14, 2) : ctx.rect(pillX, pillY, txtW + 8, 14);
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = stColor;
        ctx.textAlign = "left";
        ctx.textBaseline = "middle";
        ctx.fillText(pillText, pillX + 4, pillY + 7);
      }

      // 3. 动态光标橡皮筋预览线 (Rubber-band Preview)
      if (DIRECT_PICK && DIRECT_PICK.targetId === entId && PLAN_HOVER_POS && Array.isArray(PLAN_HOVER_POS) && PLAN_HOVER_POS.length >= 2) {
        if (lastGoalPos && Array.isArray(lastGoalPos) && lastGoalPos.length >= 2 && !Number.isNaN(lastGoalPos[0]) && !Number.isNaN(lastGoalPos[1])) {
          const [lx, ly] = pxToScreen(lastGoalPos[0], lastGoalPos[1]);
          const [hx, hy] = pxToScreen(PLAN_HOVER_POS[0], PLAN_HOVER_POS[1]);
          const hoverDistKm = Math.hypot(PLAN_HOVER_POS[0] - lastGoalPos[0], PLAN_HOVER_POS[1] - lastGoalPos[1]) * (STATE.grid.cell_m / 1000.0);

          ctx.strokeStyle = "#0284c7";
          ctx.lineWidth = 2.2;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.moveTo(lx, ly);
          ctx.lineTo(hx, hy);
          ctx.stroke();
          ctx.setLineDash([]);
          drawArrowHead(lx, ly, hx, hy, 9, "#0284c7", false);

          // 光标处的幽灵徽标
          ctx.fillStyle = "rgba(2, 132, 199, 0.85)";
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(hx, hy, 7, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#ffffff";
          ctx.font = "bold 10px Consolas, monospace";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText("+", hx, hy);

          const previewText = `+ 第${steps.length + 1}步 · ${hoverDistKm.toFixed(2)}km`;
          ctx.font = "bold 9px Microsoft YaHei, sans-serif";
          const pw = ctx.measureText(previewText).width;
          ctx.fillStyle = "rgba(2, 132, 199, 0.9)";
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.roundRect ? ctx.roundRect(hx + 10, hy - 7, pw + 8, 14, 2) : ctx.rect(hx + 10, hy - 7, pw + 8, 14);
          ctx.fill();
          ctx.stroke();

          ctx.fillStyle = "#ffffff";
          ctx.textAlign = "left";
          ctx.textBaseline = "middle";
          ctx.fillText(previewText, hx + 14, hy);
        }
      }

      ctx.restore();
    } catch (err) {
      console.error("drawDirectPlan error:", err);
      try { ctx.restore(); } catch (_) {}
    }
  };
  for (const c of (STATE.commanders || [])) {
    if (c.direct_order || (c.task_queue && c.task_queue.length > 0) || (DIRECT_PICK && DIRECT_PICK.targetId === c.id)) {
      drawDirectPlan(RENDER_POS[c.id] || c.pos || c.px, c.direct_order, c.primary_range_m || 400, c.task_queue, c.id);
    }
  }
  for (const p of (STATE.own_pieces || [])) {
    if (p.direct_order || (p.task_queue && p.task_queue.length > 0) || (DIRECT_PICK && DIRECT_PICK.targetId === p.id)) {
      drawDirectPlan(RENDER_POS[p.id] || p.pos || p.px, p.direct_order, p.primary_range_m || 450, p.task_queue, p.id);
    }
  }
  // 射击瞄准悬停预览：火线 + 遮挡区段 + 椭圆散布
  if (SHOOT_HOVER && DIRECT_PICK && DIRECT_PICK.action === "attack" && document.getElementById("chkL1").checked) {
    const shooter = DIRECT_PICK.targetKind === "commander"
      ? (STATE.commanders || []).find(x => x.id === DIRECT_PICK.targetId)
      : (STATE.own_pieces || []).find(x => x.id === DIRECT_PICK.targetId);
    const sp = shooter && (RENDER_POS[shooter.id] || shooter.pos || shooter.px);
    if (sp && Array.isArray(sp) && sp.length >= 2 && !Number.isNaN(sp[0]) && !Number.isNaN(sp[1])) {
      const [x1, y1] = pxToScreen(sp[0], sp[1]);
      const [x2, y2] = pxToScreen(SHOOT_HOVER.r, SHOOT_HOVER.c);
      const now = performance.now();
      const los = SHOOT_HOVER.los || computeLosSpans(sp, [SHOOT_HOVER.r, SHOOT_HOVER.c]);
      const dead = SHOOT_HOVER.hitProb <= 0;
      const tBlock = los.blocked ? Math.max(0.04, los.firstBlockT) : 1;
      const ix = x1 + (x2 - x1) * tBlock;
      const iy = y1 + (y2 - y1) * tBlock;
      const dispCx = los.blocked ? ix : x2;
      const dispCy = los.blocked ? iy : y2;
      ctx.save();
      const rangePx = (SHOOT_HOVER.rangeM / g.cell_m) * s;
      ctx.strokeStyle = "rgba(220, 38, 38, 0.22)";
      ctx.lineWidth = 1.1;
      ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.arc(x1, y1, rangePx, 0, Math.PI * 2); ctx.stroke();
      ctx.strokeStyle = (dead && !los.blocked) ? "#9ca3af" : "#dc2626";
      ctx.lineWidth = 2;
      ctx.setLineDash([8, 5]);
      ctx.lineDashOffset = -(now * 0.06) % 13;
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(los.blocked ? ix : x2, los.blocked ? iy : y2); ctx.stroke();
      if (los.blocked) {
        ctx.strokeStyle = "#1c1917";
        ctx.lineWidth = 1.3;
        ctx.setLineDash([3, 4]);
        ctx.lineDashOffset = 0;
        ctx.globalAlpha = 0.85;
        ctx.beginPath(); ctx.moveTo(ix, iy); ctx.lineTo(x2, y2); ctx.stroke();
        ctx.globalAlpha = 1;
      }
      ctx.setLineDash([]);
      drawArrowHead(x1, y1, x2, y2, 8, los.blocked ? "#1c1917" : ((dead && !los.blocked) ? "#9ca3af" : "#dc2626"), true);
      drawLosOcclusion(ctx, x1, y1, x2, y2, los);
      const dispPx = Math.max(8, (SHOOT_HOVER.dispM / g.cell_m) * s);
      const dispAngle = Math.atan2(y2 - y1, x2 - x1);
      drawDispersionEllipse(ctx, dispCx, dispCy, dispPx, dispPx * 0.42, dispAngle,
        los.blocked ? "rgba(217, 119, 6, 0.12)" : (dead ? "rgba(156, 163, 175, 0.12)" : "rgba(220, 38, 38, 0.12)"),
        los.blocked ? "rgba(217, 119, 6, 0.8)" : (dead ? "#9ca3af" : "rgba(220, 38, 38, 0.8)"), 1.4, [5, 3]);
      if (!dead) {
        const tMax = los.blocked ? Math.max(0.04, los.firstBlockT) : 1;
        const t = ((now * 0.0018) % 1) * tMax;
        ctx.fillStyle = "#fde047";
        ctx.beginPath(); ctx.arc(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t, 3, 0, Math.PI * 2); ctx.fill();
      }
      ctx.font = "bold 10px Consolas, Microsoft YaHei, monospace";
      ctx.fillStyle = dead ? "#6b7280" : "#991b1b";
      ctx.textAlign = "left"; ctx.textBaseline = "middle";
      ctx.fillText(`${Math.round(SHOOT_HOVER.hitProb * 100)}% · ${Math.round(SHOOT_HOVER.distM)}m`, x2 + dispPx + 6, y2);
      ctx.restore();
    }
  }
  // V4.1 TaskDraftSession Preview Overlay: Ghost Tokens, Route Waypoints & Fire Rays (Layer 2)
  if (document.getElementById("chkL2").checked) {
    if (CURRENT_TASK_DRAFT && CURRENT_TASK_DRAFT.steps.length > 0) {
      const draft = CURRENT_TASK_DRAFT;
      const cellM = Number(STATE.grid?.cell_m || 200);

      draft.steps.forEach((st, idx) => {
        const isAct = (idx === draft.activeStepIdx);
        const col = st.action === "assault" ? "#ef4444" : (st.action === "attack" ? "#f97316" : "#0284c7");

        if (st.action === "move" || st.action === "assault") {
          ctx.save();
          let [sx, sy] = pxToScreen(st.startPos[0], st.startPos[1]);
          let tailPos = [...st.startPos];
          drawMoveSlowdown(ctx, [st.startPos, ...st.waypoints]);

          if (st.waypoints.length > 0) {
            ctx.strokeStyle = col;
            ctx.lineWidth = isAct ? 2.6 : 1.8;
            ctx.setLineDash([6, 4]);
            ctx.beginPath();
            ctx.moveTo(sx, sy);
            for (let i = 0; i < st.waypoints.length; i++) {
              const wp = st.waypoints[i];
              const [wx, wy] = pxToScreen(wp[0], wp[1]);
              ctx.lineTo(wx, wy);
              tailPos = [...wp];
            }
            ctx.stroke();
            ctx.setLineDash([]);

            // 绘制航路点圆圈
            st.waypoints.forEach((wp, i) => {
              const [wx, wy] = pxToScreen(wp[0], wp[1]);
              ctx.fillStyle = col;
              ctx.strokeStyle = "#ffffff";
              ctx.lineWidth = 1.5;
              ctx.beginPath(); ctx.arc(wx, wy, 5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
              ctx.fillStyle = "#ffffff";
              ctx.font = "bold 9px Consolas, sans-serif";
              ctx.textAlign = "center"; ctx.textBaseline = "middle";
              ctx.fillText(`${st.stepId}.${i + 1}`, wx, wy - 11);
            });
          }

          // 鼠标悬停加点橡皮筋
          if (isAct && PLAN_HOVER_POS) {
            const [lx, ly] = pxToScreen(tailPos[0], tailPos[1]);
            const [hx, hy] = pxToScreen(PLAN_HOVER_POS[0], PLAN_HOVER_POS[1]);
            ctx.strokeStyle = col;
            ctx.lineWidth = 1.8;
            ctx.setLineDash([4, 4]);
            ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(hx, hy); ctx.stroke();
            ctx.setLineDash([]);
            ctx.fillStyle = col;
            ctx.font = "bold 10px Microsoft YaHei, sans-serif";
            ctx.textAlign = "left";
            ctx.fillText(`+航迹点`, hx + 10, hy);
          }

          // === 终点虚拟幽灵残影 (Ghost Token Projection) ===
          if (st.waypoints.length > 0 || (st.goal && (st.goal[0] !== st.startPos[0] || st.goal[1] !== st.startPos[1]))) {
            const ghostPos = st.goal || tailPos;
            const [gx, gy] = pxToScreen(ghostPos[0], ghostPos[1]);
            const gw = 38, gh = 24;

            ctx.save();
            ctx.fillStyle = st.action === "assault" ? "rgba(239, 68, 68, 0.28)" : "rgba(2, 132, 199, 0.28)";
            ctx.strokeStyle = st.action === "assault" ? "#ef4444" : "#0284c7";
            ctx.lineWidth = 1.8;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.rect(gx - gw * 0.5, gy - gh * 0.5, gw, gh);
            ctx.fill();
            ctx.stroke();
            ctx.setLineDash([]);

            // 内部 NATO 步兵交叉斜线
            ctx.strokeStyle = st.action === "assault" ? "rgba(239, 68, 68, 0.7)" : "rgba(2, 132, 199, 0.7)";
            ctx.lineWidth = 1.2;
            ctx.beginPath();
            ctx.moveTo(gx - gw * 0.5 + 4, gy - gh * 0.5 + 3);
            ctx.lineTo(gx + gw * 0.5 - 4, gy + gh * 0.5 - 3);
            ctx.moveTo(gx + gw * 0.5 - 4, gy - gh * 0.5 + 3);
            ctx.lineTo(gx - gw * 0.5 + 4, gy + gh * 0.5 - 3);
            ctx.stroke();

            // 上方悬浮序号徽章
            ctx.fillStyle = isAct ? "#0284c7" : "#475569";
            ctx.beginPath();
            ctx.roundRect(gx - 26, gy - gh * 0.5 - 14, 52, 12, 2);
            ctx.fill();
            ctx.fillStyle = "#ffffff";
            ctx.font = "bold 9px Microsoft YaHei, sans-serif";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(`残影 #${st.stepId}`, gx, gy - gh * 0.5 - 8);
            ctx.restore();
          }

          ctx.restore();
        } else if (st.action === "attack") {
          // === 射击步骤直连火控线 (Direct Fire Linkage Ray) ===
          const fireOrigin = st.startPos; // 锚定在前序步骤终点残影或单位本体
          const fireTarget = st.targetPos || (isAct ? PLAN_HOVER_POS : null);

          if (fireOrigin && fireTarget) {
            ctx.save();
            const [ox, oy] = pxToScreen(fireOrigin[0], fireOrigin[1]);
            const [tx, ty] = pxToScreen(fireTarget[0], fireTarget[1]);
            const distM = Math.hypot(fireTarget[0] - fireOrigin[0], fireTarget[1] - fireOrigin[1]) * cellM;
            const los = computeLosSpans(fireOrigin, fireTarget);
            const rayCol = "#f97316";
            const tBlock = los.blocked ? Math.max(0.04, los.firstBlockT) : 1;
            const ix = ox + (tx - ox) * tBlock;
            const iy = oy + (ty - oy) * tBlock;
            const dispCx = los.blocked ? ix : tx;
            const dispCy = los.blocked ? iy : ty;

            // 椭圆散布预览（长轴沿射线方向；遮蔽时落于弹着点）
            const dispM = Math.max(15, Math.min(120, 12 + distM * 0.14));
            const dispPx = Math.max(8, (dispM / cellM) * s);
            drawDispersionEllipse(ctx, dispCx, dispCy, dispPx, dispPx * 0.42, Math.atan2(ty - oy, tx - ox),
              los.blocked ? "rgba(217, 119, 6, 0.12)" : "rgba(249, 115, 22, 0.12)",
              los.blocked ? "rgba(217, 119, 6, 0.8)" : "rgba(249, 115, 22, 0.8)", 1.4, [5, 3]);

            // 直连火控射线：遮蔽前保持橙色实线，遮蔽后黑色失效线
            ctx.strokeStyle = rayCol;
            ctx.lineWidth = 2.2;
            ctx.beginPath();
            ctx.moveTo(ox, oy);
            ctx.lineTo(los.blocked ? ix : tx, los.blocked ? iy : ty);
            ctx.stroke();
            if (los.blocked) {
              ctx.strokeStyle = "#1c1917";
              ctx.lineWidth = 1.4;
              ctx.setLineDash([3, 4]);
              ctx.globalAlpha = 0.85;
              ctx.beginPath(); ctx.moveTo(ix, iy); ctx.lineTo(tx, ty); ctx.stroke();
              ctx.setLineDash([]);
              ctx.globalAlpha = 1;
            }

            // 射线前进箭头
            drawArrowHead(ox, oy, tx, ty, 10, los.blocked ? "#1c1917" : rayCol, true);
            drawLosOcclusion(ctx, ox, oy, tx, ty, los);

            // 终点双环交火准星（遮蔽时置灰表示无毁伤）
            ctx.strokeStyle = los.blocked ? "#9ca3af" : "#dc2626";
            ctx.lineWidth = 1.6;
            ctx.beginPath();
            ctx.arc(tx, ty, 8, 0, Math.PI * 2);
            ctx.arc(tx, ty, 14, 0, Math.PI * 2);
            ctx.moveTo(tx - 18, ty); ctx.lineTo(tx + 18, ty);
            ctx.moveTo(tx, ty - 18); ctx.lineTo(tx, ty + 18);
            ctx.stroke();

            // 射线中段信息胶囊
            const midX = (ox + tx) * 0.5;
            const midY = (oy + ty) * 0.5;
            const infoText = `🎯 直连火控 #${st.stepId} · ${Math.round(distM)}m${los.blocked ? ` · 视线遮蔽 弹着${Math.round(distM * tBlock)}m` : ""}`;
            ctx.font = "bold 9.5px Microsoft YaHei, sans-serif";
            const tw = ctx.measureText(infoText).width;
            ctx.fillStyle = "rgba(24, 24, 27, 0.88)";
            ctx.beginPath();
            ctx.roundRect(midX - tw * 0.5 - 5, midY - 9, tw + 10, 18, 3);
            ctx.fill();
            ctx.strokeStyle = "#f97316";
            ctx.lineWidth = 1;
            ctx.stroke();
            ctx.fillStyle = "#fafaf9";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(infoText, midX, midY);

            ctx.restore();
          }
        }
      });
    }
    for (const ew of EVENT_WINDOWS) {
      if (!ew.in_place && Array.isArray(ew.target_px)) {
        const [ex, ey] = pxToScreen(ew.target_px[0], ew.target_px[1]);
        ctx.save();
        ctx.strokeStyle = "#f59e0b";
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(ex, ey, 11, 0, Math.PI * 2); ctx.stroke();
        ctx.fillStyle = "#f59e0b";
        ctx.font = "bold 9.5px Microsoft YaHei, sans-serif";
        ctx.fillText(`事件#${ew.seq}`, ex + 12, ey);
        ctx.restore();
      }
    }
    if (CMD_DRAW && CMD_DRAW.pts && CMD_DRAW.pts.length > 0) {
      ctx.save();
      ctx.strokeStyle = CMD_DRAW.color || "#1d4ed8";
      ctx.lineWidth = 2.6;
      ctx.setLineDash([6, 4]);
      ctx.beginPath();
      CMD_DRAW.pts.forEach(([r, c], idx) => {
        const [sx, sy] = pxToScreen(r, c);
        if (idx === 0) ctx.moveTo(sx, sy); else ctx.lineTo(sx, sy);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = CMD_DRAW.color || "#1d4ed8";
      for (const [r, c] of CMD_DRAW.pts) {
        const [sx, sy] = pxToScreen(r, c);
        ctx.beginPath(); ctx.arc(sx, sy, 4, 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
    }
    if (ERASE_HOVER && ERASE_HOVER.pts && ERASE_HOVER.pts.length >= 2) {
      ctx.save();
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.strokeStyle = "rgba(251, 146, 60, 0.55)";
      ctx.lineWidth = 9;
      ctx.beginPath();
      ERASE_HOVER.pts.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.strokeStyle = "#fef08a";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ERASE_HOVER.pts.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      if (ERASE_HOVER.dispCircle) {
        const [cx, cy, cr] = ERASE_HOVER.dispCircle;
        ctx.strokeStyle = "#fef08a";
        ctx.fillStyle = "rgba(251, 146, 60, 0.25)";
        ctx.lineWidth = 2.4;
        ctx.beginPath(); ctx.arc(cx, cy, cr, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      }
      ctx.restore();
    }
    if (ERASE_LINE_PTS && ERASE_LINE_PTS.length >= 2) {
      ctx.save();
      ctx.lineCap = "round";
      ctx.lineJoin = "round";
      ctx.strokeStyle = "rgba(249, 115, 22, 0.35)";
      ctx.lineWidth = 8;
      ctx.beginPath();
      ERASE_LINE_PTS.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.strokeStyle = "#ef4444";
      ctx.lineWidth = 2.6;
      ctx.setLineDash([7, 4]);
      ctx.beginPath();
      ERASE_LINE_PTS.forEach(([x, y], idx) => {
        if (idx === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      });
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    }
  }

  // 地面掉落物（枪械=🔫、重伤失能=红骷髅💀、阵亡遗体=黑骷髅☠ - 归入 Layer 1 物理事实）
  if (document.getElementById("chkL1").checked) {
    for (let bi = 0; bi < (STATE.ground_bodies || []).length; bi++) {
      const gb = STATE.ground_bodies[bi];
      if (!gb.pos) continue;
      const [gx, gy] = pxToScreen(gb.pos[0], gb.pos[1]);
      const ox = ((bi % 3) - 1) * 9;
      const oy = (Math.floor(bi / 3) % 2 === 0 ? 11 : -11);
      const bx = gx + ox, by = gy + oy;
      const isRed = gb.kind === "wounded";
      const isWpn = gb.kind === "weapon";
      ctx.save();
      ctx.fillStyle = isWpn ? "rgba(180, 83, 9, 0.92)" : (isRed ? "rgba(220, 38, 38, 0.92)" : "rgba(24, 24, 27, 0.92)");
      ctx.strokeStyle = isWpn ? "#fde68a" : (isRed ? "#fecaca" : "#a1a1aa");
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(bx, by, 7.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = "#ffffff";
      ctx.font = "10px Segoe UI Emoji, sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(isWpn ? "🔫" : (isRed ? "💀" : "☠"), bx, by + 0.5);
      ctx.restore();
    }
  }

  // 我军聚合/分队兵牌（深黑底高对比边框 + 重武器 +1 显示标注）
  if (LAYER_FLAGS.units) {
  const counters = computeDisplayCounters();
  for (const u of counters) {
    const [ux, uy] = pxToScreen(u.pos[0], u.pos[1]);
    const zc = Math.max(0.9, Math.min(1.7, s / 18));
    const w = (u.isAggregate ? 26 : (u.isHQ ? 22 : 20)) * zc;
    const h = (u.isAggregate ? 18 : (u.isHQ ? 15 : 14)) * zc;
    const isSel = (u.id === SELECTED_PIECE_ID || u.id === SELECTED_COMMANDER_ID);
    const chitX = ux - w / 2, chitY = uy - h / 2;
    // 实体兵棋纸牌：投影 + 冲切纸面高光/暗缘 + 内外双描线
    ctx.save();
    ctx.shadowColor = "rgba(28, 25, 23, 0.38)";
    ctx.shadowBlur = 5;
    ctx.shadowOffsetX = 1.5;
    ctx.shadowOffsetY = 2.5;
    ctx.fillStyle = u.color;
    ctx.fillRect(chitX, chitY, w, h);
    ctx.restore();
    ctx.fillStyle = "rgba(255, 255, 255, 0.26)";
    ctx.fillRect(chitX + 1, chitY + 1, w - 2, 2);
    ctx.fillStyle = "rgba(0, 0, 0, 0.16)";
    ctx.fillRect(chitX + 1, chitY + h - 3, w - 2, 2);
    ctx.strokeStyle = "#1c1917";
    ctx.lineWidth = 1.5;
    ctx.strokeRect(chitX, chitY, w, h);
    ctx.strokeStyle = "rgba(255, 253, 245, 0.45)";
    ctx.lineWidth = 0.8;
    ctx.strokeRect(chitX + 1.5, chitY + 1.5, w - 3, h - 3);
    if (isSel) {
      const pulse = 0.5 + 0.5 * Math.sin(performance.now() * 0.006);
      ctx.save();
      ctx.globalAlpha = 0.3 + pulse * 0.25;
      ctx.strokeStyle = "#f59e0b";
      ctx.lineWidth = 4;
      ctx.strokeRect(chitX - 2, chitY - 2, w + 4, h + 4);
      ctx.globalAlpha = 1;
      ctx.strokeStyle = "#d97706";
      ctx.lineWidth = 2;
      const bx = chitX - 4 - pulse * 1.5, by = chitY - 4 - pulse * 1.5;
      const bw = w + 8 + pulse * 3, bh = h + 8 + pulse * 3, cl = 6;
      ctx.beginPath();
      ctx.moveTo(bx, by + cl); ctx.lineTo(bx, by); ctx.lineTo(bx + cl, by);
      ctx.moveTo(bx + bw - cl, by); ctx.lineTo(bx + bw, by); ctx.lineTo(bx + bw, by + cl);
      ctx.moveTo(bx + bw, by + bh - cl); ctx.lineTo(bx + bw, by + bh); ctx.lineTo(bx + bw - cl, by + bh);
      ctx.moveTo(bx + cl, by + bh); ctx.lineTo(bx, by + bh); ctx.lineTo(bx, by + bh - cl);
      ctx.stroke();
      ctx.restore();
    }
    // 二战德军 H.Dv. 272 方案 A 战术符号与层级点圈
    ctx.save();
    ctx.strokeStyle = "#0f172a";
    ctx.fillStyle = "#0f172a";
    const ech = (u.level || (u.isHQ ? "platoon" : "squad")).toLowerCase();

    if (u.isHQ) {
      // 1. 指挥部 (HQ / Gefechtsstand)：保持左下角延伸旗杆与对应层级点数
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(ux - w / 2, uy + h / 2);
      ctx.lineTo(ux - w / 2, uy + h / 2 + 7);
      ctx.stroke();

      if (ech === "team" || ech === "trupp") {
        // 组级指挥部：空心圆圈 ○
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.8, 0, Math.PI * 2); ctx.stroke();
      } else if (ech === "squad" || ech === "gruppe") {
        // 班级指挥部：1 个实心圆点 ●
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.6, 0, Math.PI * 2); ctx.fill();
      } else if (ech === "half_platoon" || ech === "halbzug") {
        // 半排指挥部：2 个实心圆点 ●● (dx = [-2.5, 2.5])
        for (const dx of [-2.5, 2.5]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else if (ech === "company" || ech === "kompanie") {
        // 连级指挥部：双竖线 ||
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ux - 2.5, uy - h / 2 - 7); ctx.lineTo(ux - 2.5, uy - h / 2 - 1);
        ctx.moveTo(ux + 2.5, uy - h / 2 - 7); ctx.lineTo(ux + 2.5, uy - h / 2 - 1);
        ctx.stroke();
      } else if (ech === "battalion" || ech === "bataillon") {
        // 营级指挥部：三竖线 |||
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(ux - 4, uy - h / 2 - 7); ctx.lineTo(ux - 4, uy - h / 2 - 1);
        ctx.moveTo(ux, uy - h / 2 - 7); ctx.lineTo(ux, uy - h / 2 - 1);
        ctx.moveTo(ux + 4, uy - h / 2 - 7); ctx.lineTo(ux + 4, uy - h / 2 - 1);
        ctx.stroke();
      } else {
        // 排级指挥部 (Zug) 及默认：3 个实心圆点 ●●● (dx = [-4, 0, 4])
        for (const dx of [-4, 0, 4]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      }
    } else {
      // 2. 常规分队 H.Dv. 272 方案 A 层级符号
      if (ech === "team" || ech === "trupp") {
        // 组 (Trupp)：顶部 1 个空心圆圈 ○ (ctx.stroke() 且无 fill)
        ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.8, 0, Math.PI * 2); ctx.stroke();
      } else if (ech === "half_platoon" || ech === "halbzug") {
        // 半排 (Halbzug)：顶部 2 个实心圆点 ●● (dx = [-2.5, 2.5])
        for (const dx of [-2.5, 2.5]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else if (ech === "platoon" || ech === "zug") {
        // 排 (Zug)：顶部 3 个实心圆点 ●●● (dx = [-4, 0, 4])
        for (const dx of [-4, 0, 4]) {
          ctx.beginPath(); ctx.arc(ux + dx, uy - h / 2 - 4, 1.5, 0, Math.PI * 2); ctx.fill();
        }
      } else {
        // 班 (Gruppe)：顶部 1 个实心圆点 ● (dx = 0)
        ctx.beginPath(); ctx.arc(ux, uy - h / 2 - 4, 1.6, 0, Math.PI * 2); ctx.fill();
      }

      // 8 类名义班组容器内部符号渲染
      ctx.strokeStyle = "rgba(255,255,255,0.78)";
      ctx.fillStyle = "rgba(255,255,255,0.78)";
      ctx.lineWidth = 1.1;
      const cType = u.container_type || (u.piece && (u.piece.container_type || (u.piece.counter && u.piece.counter.container_type))) || "infantry";
      if (cType === "recon") {
        // 侦察班 [ ╱ ]
        ctx.beginPath();
        ctx.moveTo(ux - w / 2 + 3, uy + h / 2 - 3);
        ctx.lineTo(ux + w / 2 - 3, uy - h / 2 + 3);
        ctx.stroke();
      } else if (cType === "signal") {
        // 通讯班 [ ⚡ ]
        ctx.font = "9px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("⚡", ux, uy);
      } else if (cType === "artillery") {
        // 炮组 [ • ]
        ctx.beginPath();
        ctx.arc(ux, uy, 2.4, 0, Math.PI * 2);
        ctx.fill();
      } else if (cType === "vehicle") {
        // 车组 [ ⬭ ]
        ctx.beginPath();
        ctx.ellipse(ux, uy, w / 2 - 4, h / 2 - 4, 0, 0, Math.PI * 2);
        ctx.stroke();
      } else if (cType === "hq") {
        // 指挥班 [ ⚑ ]
        ctx.font = "9px sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText("⚑", ux, uy);
      } else if (cType === "medic") {
        // 医疗班 [ ✚ ]
        ctx.lineWidth = 1.8;
        ctx.beginPath();
        ctx.moveTo(ux - 3.5, uy); ctx.lineTo(ux + 3.5, uy);
        ctx.moveTo(ux, uy - 3.5); ctx.lineTo(ux, uy + 3.5);
        ctx.stroke();
      } else if (cType === "engineer") {
        // 工兵班 [ ⊓⊔ ]
        ctx.beginPath();
        ctx.moveTo(ux - 4.5, uy + 2.5); ctx.lineTo(ux - 4.5, uy - 2.5); ctx.lineTo(ux, uy - 2.5); ctx.lineTo(ux, uy + 2.5);
        ctx.lineTo(ux + 4.5, uy + 2.5); ctx.lineTo(ux + 4.5, uy - 2.5);
        ctx.stroke();
      } else {
        // 步兵班 [ ✕ ] (默认)
        ctx.beginPath();
        ctx.moveTo(ux - w / 2 + 2, uy - h / 2 + 2);
        ctx.lineTo(ux + w / 2 - 2, uy + h / 2 - 2);
        ctx.moveTo(ux + w / 2 - 2, uy - h / 2 + 2);
        ctx.lineTo(ux - w / 2 + 2, uy + h / 2 - 2);
        ctx.stroke();
      }
    }
    ctx.restore();

    if (u.has_facing && u.facing_deg !== null && u.facing_deg !== undefined) {
      const rad = u.facing_deg * Math.PI / 180.0;
      ctx.strokeStyle = "#fde047";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(ux, uy);
      ctx.lineTo(ux + Math.sin(rad) * 14, uy + Math.cos(rad) * 14);
      ctx.stroke();
    }
    const excl = u.piece && u.piece.exclamation_buff;
    if (excl === "RED_EXCLAMATION" || excl === "YELLOW_EXCLAMATION") {
      const bx = ux + w / 2 + 1, by = uy - h / 2 - 1;
      ctx.fillStyle = excl === "RED_EXCLAMATION" ? "#ef4444" : "#facc15";
      ctx.strokeStyle = "#0b0f17";
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.arc(bx, by, 6.5, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = excl === "RED_EXCLAMATION" ? "#ffffff" : "#0b0f17";
      ctx.font = "bold 10px Consolas, monospace";
      ctx.fillText("!", bx - 3, by + 3.5);
    }
    const uLabel = u.persons != null ? `${u.name} [${u.persons}]${u.bonus > 0 ? "+1" : ""}` : u.name;
    ctx.save();
    ctx.font = "bold 11px Consolas, monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "top";
    ctx.lineJoin = "round";
    ctx.strokeStyle = "rgba(255, 255, 255, 0.92)";
    ctx.lineWidth = 3;
    ctx.strokeText(uLabel, ux, uy + h / 2 + 5);
    ctx.fillStyle = "#0f172a";
    ctx.fillText(uLabel, ux, uy + h / 2 + 5);
    ctx.restore();
  }
  }
  drawMapFurniture(g, s);
  if (typeof drawFloatTexts === "function") drawFloatTexts();
}

function rebuildVisTable() {
  const tb = document.getElementById("visTableBody");
  tb.innerHTML = "";
  for (const p of (STATE.own_pieces || [])) {
    const tr = document.createElement("tr");
    const vm = VIS_MODES[p.id] || "auto";
    const ctr = p.counter || {};
    const restr = ctr.restriction_tier || ctr.restricted_echelon || p.level;
    tr.innerHTML = `
      <td><a href="#" onclick="selectPiece('${p.id}');return false;" style="color:#93c5fd;">${p.name}</a></td>
      <td>${p.level}${ctr.display_tier_bonus ? "+1" : ""}</td>
      <td>${restr}</td>
      <td>
        <select onchange="VIS_MODES['${p.id}']=this.value;render();">
          <option value="auto" ${vm==="auto"?"selected":""}>Auto</option>
          <option value="pin" ${vm==="pin"?"selected":""}>Pin</option>
          <option value="hide" ${vm==="hide"?"selected":""}>Hide</option>
        </select>
      </td>`;
    tb.appendChild(tr);
  }
}

function selectPiece(pid) {
  SELECTED_PIECE_ID = pid;
  SELECTED_COMMANDER_ID = null;
  updateSelectedUnitPanel();
  renderOrbatCard();
  fetchWeaponLos();
  render();
}

function selectCommander(cid) {
  SELECTED_COMMANDER_ID = cid;
  SELECTED_PIECE_ID = null;
  LOS_DATA = null;
