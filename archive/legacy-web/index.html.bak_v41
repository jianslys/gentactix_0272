  "ArmyGroup": { width: 280, height: 90 },
  "Division":  { width: 250, height: 86 },
  "Regiment":  { width: 230, height: 82 },
  "Staff":     { width: 210, height: 78 },
  "Battalion": { width: 200, height: 76 },
  "Company":   { width: 185, height: 74 },
  "Battery":   { width: 185, height: 74 },
