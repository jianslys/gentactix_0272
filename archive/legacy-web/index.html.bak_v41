    setActionHint(`调整顺序失败: ${(r.data && r.data.reason) || "未知错误"}`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK && !REPICK_STEP) setActionHint(""); }, 2400);
    return;
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
    syncUiFromState();
  } else {
    await refreshState();
  }
  renderOrbatCard();
  render();
}

async function deleteTaskStep(targetKind, targetId, stepIdx) {
  const ent = resolveTargetEntity(targetKind, targetId);
  const qLen = ent && Array.isArray(ent.taskQueue) ? ent.taskQueue.length : 1;
  const op = (qLen <= 1 || (stepIdx === 0 && qLen <= 1)) ? "clear_task_queue" : "delete_task_step";
  const r = await api("/api/unit_op", "POST", {
    op,
    player_commander_id: STATE && STATE.active_commander_id,
    target_kind: targetKind,
    target_id: targetId,
    piece_id: targetId,
    step_index: stepIdx,
    step_idx: stepIdx,
  });
  if (!r.ok) {
    setActionHint(`删除步骤失败: ${(r.data && r.data.reason) || "未知错误"}`);
    setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW && !EVENT_PICK && !REPICK_STEP) setActionHint(""); }, 2400);
    return;
  }
  if (ent && Array.isArray(ent.taskQueue)) {
    if (op === "clear_task_queue") ent.taskQueue = [];
    else ent.taskQueue.splice(stepIdx, 1);
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
    syncUiFromState();
  } else {
    await refreshState();
  }
  renderOrbatCard();
  render();
}

async function bodyOp(op, targetKind, targetId, bodyId) {
  const r = await api("/api/unit_op", "POST", {
    op,
    player_commander_id: STATE && STATE.active_commander_id,
    target_kind: targetKind,
    target_id: targetId,
    body_id: bodyId,
  });
  if (!r.ok) {
    setActionHint(`操作失败: ${(r.data && r.data.reason) || "距离过远或无效"}`);
    setTimeout(() => setActionHint(""), 2400);
    return;
  }
  if (r.data && r.data.state) {
    STATE = r.data.state;
    syncUiFromState();
  } else {
    await refreshState();
  }
  renderOrbatCard();
  renderTarkovModal();
  render();
}

let TARKOV_CTX = null; // { unitKind, unitId, soldierId, peerKind, peerId, peerSoldierId }
let TK_DRAG = null;

function openTarkovModal(unitKind, unitId, soldierId) {
