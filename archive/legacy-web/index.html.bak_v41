}

function renderTarkovModal() {
  const win = document.getElementById("tarkovWin");
  const body = document.getElementById("tarkovBody");
  if (!win || !body) return;
  if (!TARKOV_CTX || !STATE) {
    win.classList.remove("open");
    return;
  }
  const findUnitObj = (kind, id) => {
    if (kind === "commander") {
      const c = (STATE.commanders || []).find(x => x.id === id);
      return c ? { name: c.name, pos: c.pos || c.px, soldiers: c.hq_soldiers || [] } : null;
    }
    const p = (STATE.own_pieces || []).find(x => x.id === id);
    return p ? { name: p.name, pos: p.pos || p.px, soldiers: p.soldiers || [] } : null;
  };
  const leftU = findUnitObj(TARKOV_CTX.unitKind, TARKOV_CTX.unitId);
  if (!leftU || leftU.soldiers.length === 0) {
    win.classList.remove("open");
    return;
  }
  let leftSol = leftU.soldiers.find(s => s.id === TARKOV_CTX.soldierId) || leftU.soldiers[0];
  TARKOV_CTX.soldierId = leftSol.id;

  // Build nearby unit soldiers + ground bodies for right pane
  const nearTargets = [];
  for (const s of leftU.soldiers) {
    if (s.id !== leftSol.id) {
      nearTargets.push({ key: `s:${TARKOV_CTX.unitKind}:${TARKOV_CTX.unitId}:${s.id}`, label: `队友 · ${s.name} (${Math.round(s.hp)}%)`, type: "soldier", uk: TARKOV_CTX.unitKind, uid: TARKOV_CTX.unitId, sol: s });
    }
  }
  for (const p of (STATE.own_pieces || [])) {
    if (p.is_hq_piece || (TARKOV_CTX.unitKind === "unit" && p.id === TARKOV_CTX.unitId)) continue;
    const pp = p.pos || p.px;
    if (pp && leftU.pos && Math.hypot(pp[0] - leftU.pos[0], pp[1] - leftU.pos[1]) <= 1.35) {
      for (const s of (p.soldiers || [])) {
        nearTargets.push({ key: `s:unit:${p.id}:${s.id}`, label: `${p.name} · ${s.name}`, type: "soldier", uk: "unit", uid: p.id, sol: s });
      }
    }
  }
  for (const gb of (STATE.ground_bodies || [])) {
    if (!gb.pos || !leftU.pos) continue;
    if (Math.hypot(gb.pos[0] - leftU.pos[0], gb.pos[1] - leftU.pos[1]) <= 1.35) {
      const icon = gb.kind === "weapon" ? "🔫" : (gb.kind === "wounded" ? "💀" : "☠");
      nearTargets.push({ key: `g:${gb.id}`, label: `${icon} 地面 · ${gb.soldier?.name || gb.origin_unit_name}`, type: "ground", gb });
    }
  }
  if (!TARKOV_CTX.rightKey || !nearTargets.some(t => t.key === TARKOV_CTX.rightKey)) {
    TARKOV_CTX.rightKey = nearTargets.length > 0 ? nearTargets[0].key : "";
  }
  const rightTgt = nearTargets.find(t => t.key === TARKOV_CTX.rightKey) || null;

  const fmtItem = (it) => {
    const icon = it.kind === "weapon" ? "🔫" : (it.kind === "radio" ? "📻" : (it.kind === "ammo" ? "🧱" : "🥫"));
    const extra = (it.kind === "ammo" || it.kind === "ration") ? ` (${Number(it.ammo_t || 0).toFixed(3)}t)` : ` ×${it.count || 1}`;
    const gridTag = (it.grid_w && it.grid_h) ? ` [${it.grid_w}×${it.grid_h}]` : "";
    return `${icon} ${it.name}${extra}${gridTag}`;
  };

  const calcSolWeights = (sol) => {
    const items = sol?.items || [];
    let handKg = 0, packKg = 0, handN = 0;
    for (const it of items) {
      const w = Number(it.weight_kg || 0) * (it.count || 1);
      if (it.slot === "hand") { handKg += w; handN += 1; }
      else { packKg += w; }
    }
    return {
      handKg,
      packKg,
      handN,
      cols: sol?.pack_cols || 8,
      rows: sol?.pack_rows || 6,
      maxHand: sol?.max_hand_weight_kg,
      maxPack: sol?.max_pack_weight_kg,
    };
  };
  const wL = calcSolWeights(leftSol);

  const renderSoldierItems = (items, uk, uid, sid, isHand) => {
    const indexed = items.map((it, idx) => ({ it, idx })).filter(x => isHand ? x.it.slot === "hand" : x.it.slot !== "hand");
    if (indexed.length === 0) return `<div style="font-size:10.5px;color:#71717a;padding:4px;">${isHand ? "空手（拖入装备手持）" : "背包为空"}</div>`;
    return indexed.map(({ it, idx }) => `
      <div class="tk-item" draggable="true" data-drag-src="soldier" data-uk="${uk}" data-uid="${uid}" data-sid="${sid}" data-idx="${idx}">
        <span>${fmtItem(it)}</span>
        <span class="tk-item-btns">
          <button type="button" class="tk-btn" data-quick-drop="1" data-uk="${uk}" data-uid="${uid}" data-sid="${sid}" data-idx="${idx}">丢地上</button>
        </span>
      </div>
    `).join("");
  };

  const renderPackGrid = (sol, uk, uid) => {
    const cols = Math.max(1, Number(sol?.pack_cols || 8));
    const rows = Math.max(1, Number(sol?.pack_rows || 6));
    const items = (sol?.items || []).map((it, idx) => ({ it, idx })).filter(x => x.it.slot !== "hand");
    const occ = Array.from({ length: rows }, () => Array(cols).fill(false));
    const canOccupy = (gx, gy, gw, gh) => {
      if (gx < 0 || gy < 0 || gx + gw > cols || gy + gh > rows) return false;
      for (let r = gy; r < gy + gh; r++) {
        for (let c = gx; c < gx + gw; c++) {
          if (occ[r][c]) return false;
        }
      }
      return true;
    };
    const markOccupy = (gx, gy, gw, gh) => {
      for (let r = gy; r < Math.min(rows, gy + gh); r++) {
        for (let c = gx; c < Math.min(cols, gx + gw); c++) occ[r][c] = true;
      }
    };
    const placed = [];
    for (const { it, idx } of items) {
      const gw = Math.max(1, Math.min(cols, Number(it.grid_w || 1)));
      const gh = Math.max(1, Math.min(rows, Number(it.grid_h || 1)));
      let gx = Number(it.grid_x || 0);
      let gy = Number(it.grid_y || 0);
      if (!canOccupy(gx, gy, gw, gh)) {
        let found = false;
        for (let r = 0; r <= rows - gh && !found; r++) {
          for (let c = 0; c <= cols - gw && !found; c++) {
            if (canOccupy(c, r, gw, gh)) { gx = c; gy = r; found = true; }
          }
        }
        if (!found) { gx = 0; gy = 0; }
      }
      markOccupy(gx, gy, gw, gh);
      placed.push({ it, idx, gx, gy, gw, gh });
    }
    let cellsHtml = "";
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        cellsHtml += `<div class="tk-grid-cell" style="grid-column:${c + 1};grid-row:${r + 1};" data-drop-kind="soldier" data-uk="${uk}" data-uid="${uid}" data-sid="${sol.id}" data-slot="pack" data-gx="${c}" data-gy="${r}"></div>`;
      }
    }
    const itemsHtml = placed.map(({ it, idx, gx, gy, gw, gh }) => {
      const icon = it.kind === "weapon" ? "🔫" : (it.kind === "radio" ? "📻" : (it.kind === "ammo" ? "🧱" : "🥫"));
      const sub = (it.kind === "ammo" || it.kind === "ration") ? `${Number(it.ammo_t || 0).toFixed(2)}t` : `×${it.count || 1}`;
      return `
        <div class="tk-grid-item" style="grid-column:${gx + 1} / span ${gw};grid-row:${gy + 1} / span ${gh};" draggable="true" data-drag-src="soldier" data-uk="${uk}" data-uid="${uid}" data-sid="${sol.id}" data-idx="${idx}" title="${fmtItem(it)}">
          <div class="tk-grid-item-top">
            <span class="tk-grid-item-name">${icon}${it.name}</span>
            <button type="button" class="tk-grid-drop" data-quick-drop="1" data-uk="${uk}" data-uid="${uid}" data-sid="${sol.id}" data-idx="${idx}" title="丢到地面">×</button>
          </div>
          <div class="tk-grid-item-sub">
            <span>${sub}</span>
            <span>${gw}×${gh}</span>
          </div>
        </div>
      `;
    }).join("");
    return `<div class="tk-pack-grid" style="grid-template-columns:repeat(${cols},34px);grid-template-rows:repeat(${rows},34px);" data-drop-kind="soldier" data-uk="${uk}" data-uid="${uid}" data-sid="${sol.id}" data-slot="pack">${cellsHtml}${itemsHtml}</div>`;
  };

  document.getElementById("tarkovTitle").textContent = `单兵装备栏 · ${leftU.name} · ${leftSol.name}`;
  body.innerHTML = `
    <div class="tk-pane">
      <div class="tk-sec-lbl">
        <span>当前单兵 (HP ${Math.round(leftSol.hp)}%)</span>
        <select class="tk-sel" style="width:auto;" id="tkLeftSolSel">
          ${leftU.soldiers.map(s => `<option value="${s.id}" ${s.id === leftSol.id ? "selected" : ""}>${s.name} (${Math.round(s.hp)}%)</option>`).join("")}
        </select>
      </div>
      <div class="tk-sec-lbl"><span>手持槽 (Hand · 倒地必掉)</span><span style="font-family:Consolas,monospace;color:#52525b;">${wL.handKg.toFixed(1)}kg (不计背负)</span></div>
      ${(leftSol.cannot_fire || wL.handN >= 2) ? `<div style="background:#fef2f2;border:1px solid #ef4444;color:#b91c1c;padding:4px 6px;border-radius:4px;font-size:11px;font-weight:700;margin-bottom:4px;">⚠ 手持 ≥2 件物品：无法开火 / 无法操作重武器</div>` : ""}
      <div class="tk-dropzone hand" data-drop-kind="soldier" data-uk="${TARKOV_CTX.unitKind}" data-uid="${TARKOV_CTX.unitId}" data-sid="${leftSol.id}" data-slot="hand">
        ${renderSoldierItems(leftSol.items || [], TARKOV_CTX.unitKind, TARKOV_CTX.unitId, leftSol.id, true)}
      </div>
      <div class="tk-sec-lbl"><span>随身背包 (Backpack · 倒地留身)</span><span style="font-family:Consolas,monospace;color:#52525b;">${wL.packKg.toFixed(1)}kg · 格子 ${wL.cols}×${wL.rows}</span></div>
      ${renderPackGrid(leftSol, TARKOV_CTX.unitKind, TARKOV_CTX.unitId)}
      <div class="tk-dropzone ground-drop" data-drop-kind="ground">🗑 拖到此处丢弃到地面</div>
    </div>
    <div class="tk-pane">
      <div class="tk-sec-lbl"><span>交换 / 地面搜刮目标</span></div>
      <select class="tk-sel" id="tkRightSel">
        ${nearTargets.length === 0 ? `<option value="">附近无队友或地面物品</option>` : nearTargets.map(t => `<option value="${t.key}" ${t.key === TARKOV_CTX.rightKey ? "selected" : ""}>${t.label}</option>`).join("")}
      </select>
      ${(() => {
        if (!rightTgt) return `<div style="font-size:11px;color:#71717a;padding:12px;">附近没有可交互的队友或地面掉落物。</div>`;
        if (rightTgt.type === "soldier") {
          const rs = rightTgt.sol;
          const wR = calcSolWeights(rs);
          return `
            <div class="tk-sec-lbl"><span>对方手持槽 ${rs.cannot_fire ? '<b style="color:#dc2626;">[双手占用]</b>' : ''}</span><span style="font-family:Consolas,monospace;color:#52525b;">${wR.handKg.toFixed(1)}kg</span></div>
            <div class="tk-dropzone hand" data-drop-kind="soldier" data-uk="${rightTgt.uk}" data-uid="${rightTgt.uid}" data-sid="${rs.id}" data-slot="hand">
              ${renderSoldierItems(rs.items || [], rightTgt.uk, rightTgt.uid, rs.id, true)}
            </div>
            <div class="tk-sec-lbl"><span>对方随身背包</span><span style="font-family:Consolas,monospace;color:#52525b;">${wR.packKg.toFixed(1)}kg · ${wR.cols}×${wR.rows}</span></div>
            ${renderPackGrid(rs, rightTgt.uk, rightTgt.uid)}
          `;
        }
        const gb = rightTgt.gb;
        const gItems = gb.soldier?.items || [];
        return `
          <div class="tk-sec-lbl"><span>地面物品 / 倒地者随身物品</span></div>
          <div class="tk-dropzone" style="min-height:140px;">
            ${gItems.length === 0 ? `<div style="font-size:11px;color:#71717a;padding:6px;">已被搜刮一空</div>` : gItems.map((it, idx) => `
              <div class="tk-item" draggable="true" data-drag-src="ground" data-bid="${gb.id}" data-idx="${idx}">
                <span>${fmtItem(it)}</span>
                <span class="tk-item-btns">
                  <button type="button" class="tk-btn" data-loot-to="pack" data-bid="${gb.id}" data-idx="${idx}">入背包</button>
                  ${(it.kind === "weapon" || it.kind === "radio") ? `<button type="button" class="tk-btn" data-loot-to="hand" data-bid="${gb.id}" data-idx="${idx}">拿手上</button>` : ""}
                </span>
              </div>
            `).join("")}
          </div>
        `;
      })()}
    </div>
  `;
  win.classList.add("open");

  const lSel = document.getElementById("tkLeftSolSel");
  if (lSel) lSel.onchange = () => { TARKOV_CTX.soldierId = lSel.value; renderTarkovModal(); };
  const rSel = document.getElementById("tkRightSel");
  if (rSel) rSel.onchange = () => { TARKOV_CTX.rightKey = rSel.value; renderTarkovModal(); };

  body.querySelectorAll("[data-drag-src]").forEach(el => {
    el.addEventListener("dragstart", () => {
      const src = el.getAttribute("data-drag-src");
      if (src === "soldier") {
        TK_DRAG = {
          from_kind: "soldier",
          from_unit_kind: el.getAttribute("data-uk"),
          from_unit_id: el.getAttribute("data-uid"),
          from_soldier_id: el.getAttribute("data-sid"),
          item_index: Number(el.getAttribute("data-idx")),
        };
      } else {
        TK_DRAG = {
          from_kind: "ground",
          from_body_id: el.getAttribute("data-bid"),
          item_index: Number(el.getAttribute("data-idx")),
        };
      }
    });
  });

  body.querySelectorAll("[data-drop-kind]").forEach(dz => {
    dz.addEventListener("dragover", e => { e.preventDefault(); e.stopPropagation(); dz.classList.add("dragover"); });
    dz.addEventListener("dragleave", e => { e.stopPropagation(); dz.classList.remove("dragover"); });
    dz.addEventListener("drop", async e => {
      e.preventDefault();
      e.stopPropagation();
      dz.classList.remove("dragover");
      if (!TK_DRAG) return;
      const dragPayload = TK_DRAG;
      TK_DRAG = null;
      const dk = dz.getAttribute("data-drop-kind");
      if (dk === "ground") {
        if (dragPayload.from_kind === "soldier") {
          await moveSoldierItem({ ...dragPayload, to_kind: "ground" });
        }
      } else if (dk === "soldier") {
        const payload = {
          ...dragPayload,
          to_kind: "soldier",
          to_unit_kind: dz.getAttribute("data-uk"),
          to_unit_id: dz.getAttribute("data-uid"),
          to_soldier_id: dz.getAttribute("data-sid"),
          to_slot: dz.getAttribute("data-slot") || "pack",
        };
        const gx = dz.getAttribute("data-gx");
        const gy = dz.getAttribute("data-gy");
        if (gx !== null && gy !== null) {
          payload.to_grid_x = Number(gx);
          payload.to_grid_y = Number(gy);
        }
        await moveSoldierItem(payload);
      }
    });
  });

  body.querySelectorAll("[data-quick-hand], [data-quick-pack]").forEach(btn => {
    btn.addEventListener("click", () => moveSoldierItem({
      from_kind: "soldier",
      from_unit_kind: btn.getAttribute("data-uk"),
      from_unit_id: btn.getAttribute("data-uid"),
      from_soldier_id: btn.getAttribute("data-sid"),
      item_index: Number(btn.getAttribute("data-idx")),
      to_kind: "soldier",
      to_unit_kind: btn.getAttribute("data-uk"),
      to_unit_id: btn.getAttribute("data-uid"),
      to_soldier_id: btn.getAttribute("data-sid"),
      to_slot: btn.hasAttribute("data-quick-hand") ? "hand" : "pack",
    }));
  });
  body.querySelectorAll("[data-quick-drop]").forEach(btn => {
    btn.addEventListener("click", () => moveSoldierItem({
      from_kind: "soldier",
      from_unit_kind: btn.getAttribute("data-uk"),
      from_unit_id: btn.getAttribute("data-uid"),
      from_soldier_id: btn.getAttribute("data-sid"),
      item_index: Number(btn.getAttribute("data-idx")),
      to_kind: "ground",
    }));
  });
  body.querySelectorAll("[data-loot-to]").forEach(btn => {
    btn.addEventListener("click", () => moveSoldierItem({
      from_kind: "ground",
      from_body_id: btn.getAttribute("data-bid"),
      item_index: Number(btn.getAttribute("data-idx")),
      to_kind: "soldier",
      to_unit_kind: TARKOV_CTX.unitKind,
      to_unit_id: TARKOV_CTX.unitId,
      to_soldier_id: leftSol.id,
      to_slot: btn.getAttribute("data-loot-to") || "pack",
    }));
  });

  const inspectEl = document.getElementById("tkInspectBar");
  const showItemInspect = (it) => {
    if (!inspectEl || !it) return;
    const catItem = resolveCatalogItemForRuntime(it);
    if (catItem && Array.isArray(catItem.attrs)) {
      inspectEl.innerHTML = `<span style="color:#fde047;font-weight:700;">${catEsc(catItem.name)} [${catEsc(catItem.id)}]</span>`
        + catItem.attrs.map(a => `<span class="tk-attr-pill"><b>${catEsc(a.label || a.key)}:</b> ${catEsc(formatAttrVal(a.val))}</span>`).join("");
    } else {
      inspectEl.innerHTML = `<span style="color:#fde047;font-weight:700;">${catEsc(it.name)}</span>`
        + `<span class="tk-attr-pill"><b>kind:</b> ${catEsc(it.kind)}</span>`
        + `<span class="tk-attr-pill"><b>单重:</b> ${Number(it.weight_kg || 0).toFixed(2)}kg</span>`
        + `<span class="tk-attr-pill"><b>格数:</b> ${it.grid_w || 1}×${it.grid_h || 1}</span>`
        + `<span class="tk-attr-pill"><b>槽位:</b> ${catEsc(it.slot || "-")}</span>`;
    }
  };
  body.querySelectorAll(".tk-item, .tk-grid-item").forEach(el => {
    el.addEventListener("click", e => {
      if (e.target.closest("button")) return;
      const src = el.getAttribute("data-drag-src");
      const idx = Number(el.getAttribute("data-idx"));
      if (src === "soldier") {
        const sid = el.getAttribute("data-sid");
        const uk = el.getAttribute("data-uk");
        const uid = el.getAttribute("data-uid");
        let sol = (uk === TARKOV_CTX.unitKind && uid === TARKOV_CTX.unitId)
          ? (leftU.soldiers || []).find(s => s.id === sid)
          : (rightTgt && rightTgt.sol && rightTgt.sol.id === sid ? rightTgt.sol : null);
        if (sol && sol.items && sol.items[idx]) showItemInspect(sol.items[idx]);
      } else if (src === "ground" && rightTgt && rightTgt.gb) {
        const gItems = rightTgt.gb.soldier?.items || [];
        if (gItems[idx]) showItemInspect(gItems[idx]);
      }
    });
  });
}

async function submitCmdFrontline(pts, role, label) {
  if (!STATE || pts.length < 2) return;
  const cmdId = SELECTED_COMMANDER_ID || ACTOR.id || STATE.active_commander_id;
  const r = await api("/api/unit_op", "POST", {
    op: "write_typed_frontline",
    player_commander_id: STATE.active_commander_id,
    commander_id: cmdId,
    line_id: `fl-${cmdId}-${role}-${Date.now()}`,
    role,
    points_px: pts,
    unit_type_mask: 31,
    attraction_weight: 1.5,
  });
  if (!r.ok) {
    alert("战术标绘下发失败: " + (r.data.reason || "未知错误"));
    return;
  }
  setActionHint(`已下发【${label}】战术线（下属班组将自主沿线行动）`);
  setTimeout(() => { if (!DIRECT_PICK && !CMD_DRAW) setActionHint(""); }, 2200);
  await refreshState();
}

async function toggleFriendlyFire() {
  const cb = document.getElementById("dbgFriendlyFire");
  const val = cb ? cb.checked : false;
  const r = await api("/api/unit_op", "POST", {
    op: "set_debug_flags",
    player_commander_id: STATE && STATE.active_commander_id,
    debug_full_friendly_fire: val,
  });
  if (r.ok && r.data && r.data.state) {
    STATE = r.data.state;
    syncUiFromState();
  }
}

function toggleSimPlay() {
  toggleDebugPlay();
}

function setActorByValue(val) {
  const [kind, id] = String(val || "").split(":");
  if (!kind || !id) return;
  ACTOR = { kind, id };
  DIRECT_PICK = null;
  CMD_DRAW = null;
  setActionHint("");
  const s1 = document.getElementById("selActor");
  const s2 = document.getElementById("dbgActorSel");
  if (s1) s1.value = val;
  if (s2) s2.value = val;
  if (kind === "commander") selectCommander(id);
  else selectPiece(id);
}

function onDbgActorChange() {
  const val = document.getElementById("dbgActorSel").value;
  setActorByValue(val);
}

function randomSwitchActor() {
  if (!STATE) return;
  const pool = [
    ...(STATE.commanders || []).map(c => `commander:${c.id}`),
    ...(STATE.own_pieces || []).map(p => `unit:${p.id}`),
  ];
  if (pool.length === 0) return;
  const cur = `${ACTOR.kind}:${ACTOR.id}`;
  const candidates = pool.length > 1 ? pool.filter(x => x !== cur) : pool;
  const pick = candidates[Math.floor(Math.random() * candidates.length)];
  setActorByValue(pick);
}

function getDebugStepHours() {
  const el = document.getElementById("dbgStepHours");
  return el ? Number(el.value || (16 / 3600)) : (16 / 3600);
}

async function stepDebugTime() {
  await commitTurn(getDebugStepHours());
}

function toggleDebugPlay() {
  const btn = document.getElementById("dbgPlayBtn");
  const btn2 = document.getElementById("btnSimPlay");
  if (SIM_TIMER) {
    clearInterval(SIM_TIMER);
    SIM_TIMER = null;
    if (btn) { btn.textContent = "▶ 运行"; btn.classList.remove("active"); }
    if (btn2) { btn2.textContent = "▶ 运行"; btn2.classList.remove("active"); }
    return;
  }
  const ms = Number((document.getElementById("dbgPlayInterval") && document.getElementById("dbgPlayInterval").value) || 450);
  if (btn) { btn.textContent = "⏸ 暂停"; btn.classList.add("active"); }
  if (btn2) { btn2.textContent = "⏸ 暂停"; btn2.classList.add("active"); }
  SIM_TIMER = setInterval(async () => {
    await commitTurn(getDebugStepHours());
  }, ms);
}

function onDebugSpeedChange() {
  if (SIM_TIMER) {
    toggleDebugPlay();
    toggleDebugPlay();
  }
}

async function resetArt16Debug() {
  if (SIM_TIMER) toggleDebugPlay();
  await api("/api/unit_op", "POST", { op: "load_art16" });
  DIRECT_PICK = null;
  CMD_DRAW = null;
  EVENT_PICK = null;
  HIGHLIGHT_OVERLAY = null;
  OB_TAB = "mission";
  setActionHint("");
  await refreshState();
}

function renderOrbatCard() {
  const el = document.getElementById("orbatCard");
  if (!el || !STATE) return;
  const p = SELECTED_PIECE_ID ? (STATE.own_pieces || []).find(x => x.id === SELECTED_PIECE_ID) : null;
  const cmd = SELECTED_COMMANDER_ID ? (STATE.commanders || []).find(x => x.id === SELECTED_COMMANDER_ID) : null;
  if (!p && !cmd) {
    el.classList.remove("open");
    const clWin = document.getElementById("combatLogWin");
    if (clWin) clWin.classList.remove("open");
    return;
  }

  let title = "", echelonTxt = "", statusTxt = "", orgPct = 100, supplyPct = 100, strengthPct = 100;
  let personsTot = 0, fullStrength = 1, cadreTot = 0;
  let rifleCnt = 0, lmgCnt = 0, radioCnt = 0;
  let superiorCmd = null;
  let subBlocks = [];
  let isHQ = false;

  if (cmd) {
    isHQ = true;
    title = cmd.name;
    const hqPersons = cmd.persons !== undefined ? Number(cmd.persons) : 3;
    const hqDead = cmd.alive === false || hqPersons <= 0;
    echelonTxt = hqDead ? `已阵亡排部 (Depot)` : `排级指挥部 (${cmd.rank || "排长"})`;
    statusTxt = hqDead ? "已阵亡 · 留守物资点 (Depot)" : (cmd.radio_silence ? "静默" : `频道 ${cmd.radio_channel || "A"}`);
    const hqCadre = cmd.cadre !== undefined ? Number(cmd.cadre) : 1;
    let hqWeapons = cmd.weapons;
    if (!hqWeapons && Array.isArray(cmd.hq_soldiers)) {
      const cntMap = {};
      for (const s of cmd.hq_soldiers) {
        if (s.weapon) cntMap[s.weapon] = (cntMap[s.weapon] || 0) + 1;
      }
      hqWeapons = Object.entries(cntMap).map(([model, count]) => ({ model, count, range_m: model === "radio" ? 0 : 400 }));
    }
    if (!hqWeapons) hqWeapons = [];
    personsTot += hqPersons;
    cadreTot += hqCadre;
    for (const w of hqWeapons) {
      if (w.model === "rifle") rifleCnt += w.count;
      else if (w.model === "lmg") lmgCnt += w.count;
      else if (w.model === "radio") radioCnt += w.count;
    }
    subBlocks.push({
      id: null,
      name: `${cmd.name} · 指挥班`,
      pct: cmd.alive === false ? 0 : Math.round(((cmd.hq_org ?? 100) / Math.max(1, cmd.hq_org_cap ?? 100)) * 100),
      weapons: hqWeapons,
    });
    const subs = (STATE.own_pieces || []).filter(sp => !sp.is_hq_piece && (cmd.subordinate_ids || []).includes(sp.id));
    for (const sp of subs) {
      personsTot += Number(sp.persons || 0);
      cadreTot += Number(sp.cadre || 0);
      for (const w of (sp.weapons || [])) {
        if (w.model === "rifle") rifleCnt += w.count;
        else if (w.model === "lmg") lmgCnt += w.count;
        else if (w.model === "radio") radioCnt += w.count;
      }
      subBlocks.push({
        id: sp.id,
        name: sp.name,
        pct: Math.round((Number(sp.org || 100) / Math.max(1, Number(sp.org_cap || 100))) * 100),
        weapons: sp.weapons || [],
      });
    }
    fullStrength = Math.max(personsTot, 14);
    strengthPct = Math.round((personsTot / fullStrength) * 100);
    if (subBlocks.length > 0) {
      orgPct = Math.round(subBlocks.reduce((a, b) => a + b.pct, 0) / subBlocks.length);
    }
    supplyPct = cmd.supply_pct !== undefined ? Math.round(cmd.supply_pct) : 100;
  } else if (p) {
    title = p.name;
    echelonTxt = p.level === "squad" ? "步兵班" : p.level;
    statusTxt = p.was_disconnected ? "断连" : `通联正常 · ${typeof p.autonomy_state === "string" ? p.autonomy_state : (p.autonomy_state?.state || "待命")}`;
    personsTot = Number(p.persons || 0);
    cadreTot = Number(p.cadre || 0);
    fullStrength = Math.max(personsTot, 11);
    strengthPct = Math.round((personsTot / fullStrength) * 100);
    orgPct = Math.round((Number(p.org || 100) / Math.max(1, Number(p.org_cap || 100))) * 100);
    supplyPct = p.supply_pct !== undefined ? Math.round(p.supply_pct) : 100;
    superiorCmd = (STATE.commanders || []).find(c => (c.subordinate_ids || []).includes(p.id)) || null;
    for (const w of (p.weapons || [])) {
      if (w.model === "rifle") rifleCnt += w.count;
      else if (w.model === "lmg") lmgCnt += w.count;
      else if (w.model === "radio") radioCnt += w.count;
    }
    subBlocks.push({
      id: p.id,
      name: `${p.name} · 班内编制`,
      pct: orgPct,
      weapons: p.weapons || [],
    });
  }

  const heroSvg = isHQ
    ? `<svg width="300" height="68" viewBox="0 0 240 58"><g stroke="#44403c" stroke-width="1.3" fill="none" stroke-linecap="round"><path d="M18 48h204"/><rect x="84" y="26" width="52" height="18" fill="#d6d3cd"/><rect x="136" y="31" width="18" height="13" fill="#d6d3cd"/><circle cx="96" cy="46" r="4" fill="#57534e"/><circle cx="144" cy="46" r="4" fill="#57534e"/><line x1="100" y1="26" x2="100" y2="7"/><path d="M94 11l6-4 6 4M91 16a11 11 0 0 1 18 0" stroke="#78716c"/><path d="M46 48v-12l-4-6M46 36l5 12M180 48v-14l4-4M180 38l-4 10" stroke="#57534e"/></g></svg>`
    : `<svg width="300" height="68" viewBox="0 0 240 58"><g stroke="#44403c" stroke-width="1.4" fill="none" stroke-linecap="round"><path d="M14 48h212"/><circle cx="62" cy="26" r="2.8" fill="#44403c"/><path d="M62 29v10l-4 9M62 39l4 9M57 33l10-3 14-3"/><circle cx="114" cy="27" r="2.8" fill="#44403c"/><path d="M114 30v9l-4 9M114 39l5 9M108 34l12-2 15-1"/><circle cx="168" cy="26" r="2.8" fill="#44403c"/><path d="M168 29v10l-3 9M168 39l4 9M163 33l10-3 12-4"/></g></svg>`;

  const natoBadge = isHQ
    ? `<svg width="48" height="34" viewBox="0 0 48 34"><rect x="3" y="8" width="42" height="22" fill="#ef4444" stroke="#ffffff" stroke-width="1.8"/><circle cx="17" cy="4" r="2.1" fill="#ffffff"/><circle cx="24" cy="4" r="2.1" fill="#ffffff"/><circle cx="31" cy="4" r="2.1" fill="#ffffff"/></svg>`
    : `<svg width="48" height="34" viewBox="0 0 48 34"><rect x="3" y="8" width="42" height="22" fill="#ef4444" stroke="#ffffff" stroke-width="1.8"/><path d="M6 11l36 16M42 11L6 27" stroke="#ffffff" stroke-width="1.6"/><circle cx="24" cy="4" r="2.1" fill="#ffffff"/></svg>`;

  const supHtml = superiorCmd
    ? `<span class="ob-sup-link" id="obSupLink">${superiorCmd.name}</span>`
    : `<span class="ob-sup-none">${isHQ ? "独立建制 (无上级)" : "无直属上级"}</span>`;

  const ammoRatio = isHQ
    ? Math.max(0, Math.min(1, Number(cmd.hq_ammo_t ?? 1) / Math.max(0.001, Number(cmd.hq_ammo_cap_t ?? 1))))
    : Math.max(0, Math.min(1, Number(p.ammo_t ?? 1) / Math.max(0.001, Number(p.ammo_cap_t ?? 1))));
  const outOfAmmoFlag = isHQ ? (Number(cmd.hq_ammo_t ?? 1) <= 0.0005) : (Number(p.ammo_t ?? 1) <= 0.0005);
  if (outOfAmmoFlag) statusTxt = `${statusTxt} · 弹药耗尽`;
  const ammoPct = Math.round(ammoRatio * 100);
  const ammoRifle = Math.round(rifleCnt * 120 * ammoRatio);
  const ammoLmg = Math.round(lmgCnt * 600 * ammoRatio);
  const gearHtml = `
    <div class="ob-gear-box">
      <div class="ob-gear-head"><span>装备与携行物资清单</span><span style="${outOfAmmoFlag ? 'color:#dc2626;font-weight:800;' : ''}">${outOfAmmoFlag ? '弹药耗尽 (0%)' : `弹药余量 ${ammoPct}%`}</span></div>
      <div class="ob-gear-grid">
        <div class="ob-gear-item"><span>步枪弹药</span><b>${ammoRifle} 发</b></div>
        <div class="ob-gear-item"><span>机枪弹链</span><b>${ammoLmg} 发</b></div>
        <div class="ob-gear-item"><span>作战被服/盔</span><b>${personsTot} 套</b></div>
        <div class="ob-gear-item"><span>单兵携行具</span><b>${personsTot} 副</b></div>
        <div class="ob-gear-item"><span>野战口粮</span><b>${personsTot * 3} 日份</b></div>
        <div class="ob-gear-item"><span>无线电台</span><b>${radioCnt} 部</b></div>
      </div>
    </div>
  `;

  const listHtml = subBlocks.map(sb => `
    <div>
      <div class="ob-sub-title" ${sb.id ? `data-ob-jump="${sb.id}"` : `style="cursor:default;"`}>
        <span>${sb.name} <span class="ob-sub-pct">(${sb.pct}%)</span></span>
      </div>
      <div class="ob-unit-cards">
        ${sb.weapons.map(w => `
          <div class="ob-u-card" title="${weaponCnName(w.model)} ×${w.count}">
            <span class="ob-u-cnt">${w.count}</span>
            <span class="ob-u-star">★</span>
            ${weaponIconSvg(w.model)}
            <span class="ob-u-lbl">${weaponCnName(w.model)}</span>
          </div>
        `).join("")}
      </div>
    </div>
  `).join("");

  const tgtSoldiers = isHQ ? (cmd.hq_soldiers || []) : (p.soldiers || []);
  const tgtCarried = isHQ ? (cmd.hq_carried_bodies || []) : (p.carried_bodies || []);
  const tgtPos = isHQ ? (cmd.pos || cmd.px || [0, 0]) : (p.pos || p.px || [0, 0]);
  const tgtWeapons = isHQ
    ? (subBlocks[0] ? subBlocks[0].weapons : [])
    : (p.weapons || []);
  const tgtAmmo = isHQ ? Number(cmd.hq_ammo_t || 0) : Number(p.ammo_t || 0);
  const tgtFood = isHQ ? Number(cmd.hq_food_t || 0) : Number(p.food_t || 0);
  const tgtFuel = isHQ ? Number(cmd.hq_fuel_t || 0) : Number(p.fuel_t || 0);
  const nearBodies = (STATE.ground_bodies || []).filter(gb =>
    gb.pos && Math.hypot(gb.pos[0] - tgtPos[0], gb.pos[1] - tgtPos[1]) <= 1.35
  );
  const healthyN = tgtSoldiers.filter(s => s.status === "healthy").length;
  const lightN = tgtSoldiers.filter(s => s.status === "light").length;
  const subUnitsAccordion = (isHQ && subBlocks.length > 0) ? `
    <div class="ob-acc">
      <div class="ob-acc-head" data-acc="subunits">
        <span>直属下属分队编制 (${subBlocks.length}个单位)</span>
        <span>${OB_EXPAND.subunits ? "▾" : "▸"}</span>
      </div>
      ${OB_EXPAND.subunits ? `<div class="ob-acc-body">${listHtml}</div>` : ""}
    </div>
  ` : "";

  const accHtml = `
    ${subUnitsAccordion}
    <div class="ob-acc">
      <div class="ob-acc-head" data-acc="soldiers">
        <span>单兵花名册与血条 (${tgtSoldiers.length}人 · 健康${healthyN} 轻伤${lightN})</span>
        <span>${OB_EXPAND.soldiers ? "▾" : "▸"}</span>
      </div>
      ${OB_EXPAND.soldiers ? `<div class="ob-acc-body">
        ${tgtSoldiers.length === 0 ? `<div style="color:#78716c;">暂无存活单兵</div>` : tgtSoldiers.map(s => {
          const hp = Math.round(s.hp || 0);
          const barCol = hp > 70 ? "#16a34a" : (hp > 30 ? "#eab308" : "#dc2626");
          const stLbl = s.status === "light" ? "轻伤" : "健康";
          const itemsTxt = (s.items || []).map(it => {
            if (it.kind === "ammo" || it.kind === "ration") return `${it.name} ${Number(it.ammo_t || 0).toFixed(3)}t`;
            return `${it.name}×${it.count || 1}`;
          }).join(" · ");
          return `<div style="padding:3px 0;border-bottom:1px dashed #e7e5e4;cursor:pointer;" data-open-soldier="${s.id}" title="点击打开单兵装备与背包">
            <div class="ob-sol-row">
              <span style="font-weight:700;color:${s.is_cadre ? '#b45309' : '#1c1917'};">${s.name}</span>
              <span style="color:#57534e;">${weaponCnName(s.weapon || "rifle")}</span>
              <div class="ob-hp-track" title="${stLbl} ${hp}/100"><div class="ob-hp-fill" style="width:${hp}%;background:${barCol};"></div></div>
              <span style="font-family:Consolas,monospace;text-align:right;color:${barCol};">${hp}%</span>
            </div>
            ${(itemsTxt || s.cannot_fire) ? `<div style="font-size:10px;color:#57534e;padding-left:2px;margin-top:2px;">${itemsTxt ? `🎒 ${itemsTxt}` : ""}${s.cannot_fire ? ` <span style="color:#dc2626;font-weight:700;">[双手占用·禁开火/操炮]</span>` : ""} <span style="color:#b45309;font-weight:700;">[点开装备]</span></div>` : ""}
          </div>`;
        }).join("")}
      </div>` : ""}
    </div>
    ${(() => {
      const hasFuelTank = Boolean(
        (p && (p.container_type === "vehicle" || (p.weapons || []).some(w => (w.model || "").includes("vehicle") || (w.model || "").includes("tank")) || Number(p.fuel_tank_l || 0) > 0)) ||
        (isHQ && (cmd.container_type === "vehicle" || Number(cmd.fuel_tank_l || 0) > 0))
      );
      const GEAR_SPECS = {
        rifle: { name: "毛瑟 98k 步枪", unitKg: 4.1 },
        smg: { name: "MP40 冲锋枪", unitKg: 3.1 },
        lmg: { name: "MG42 轻机枪 (两脚架)", unitKg: 12.1 },
        hmg: { name: "MG42 重机枪 (重机枪三脚架)", unitKg: 38.0 },
        mortar_81: { name: "Granatwerfer 34 81mm 迫击炮", unitKg: 56.0 },
        at_gun_50: { name: "PaK 38 50mm 反坦克炮", unitKg: 950.0 },
        howitzer_105: { name: "leFH 18 105mm 榴弹炮", unitKg: 1985.0 },
        howitzer_152: { name: "152mm 重型榴弹炮", unitKg: 4300.0 },
        flak_88: { name: "FlaK 88 高平两用炮", unitKg: 5000.0 },
        radio: { name: "Torn.Fu.d2 步兵便携电台", unitKg: 12.0 },
        hq_radio: { name: "100W 排连骨干电台", unitKg: 25.0 },
        bandage: { name: "野战急救止血绷带包", unitKg: 0.2 },
        shovel: { name: "野战单兵工兵锹", unitKg: 1.4 },
        binocular: { name: "6×30 军用双筒望远镜", unitKg: 0.8 },
        ammo_box: { name: "7.92mm 班组备用弹药箱", unitKg: 10.0 },
      };
      const physicalGear = {};
      for (const s of tgtSoldiers) {
        const wModel = s.weapon || "rifle";
        const spec = GEAR_SPECS[wModel] || { name: weaponCnName(wModel), unitKg: 4.0 };
        if (!physicalGear[wModel]) physicalGear[wModel] = { name: spec.name, count: 0, unitKg: spec.unitKg };
        physicalGear[wModel].count++;

        for (const it of (s.items || [])) {
          if (it.kind === "ammo" || it.kind === "ration") continue;
          const k = it.name || it.model || "item";
          const ispec = GEAR_SPECS[k] || GEAR_SPECS[it.model] || { name: it.name || k, unitKg: Number(it.weight_kg || 1.0) };
          if (!physicalGear[k]) physicalGear[k] = { name: ispec.name, count: 0, unitKg: ispec.unitKg };
          physicalGear[k].count += (it.count || 1);
        }
      }
      for (const w of tgtWeapons) {
        if (physicalGear[w.model]) continue;
        const spec = GEAR_SPECS[w.model] || { name: weaponCnName(w.model), unitKg: 15.0 };
        physicalGear[w.model] = { name: spec.name, count: w.count || 1, unitKg: spec.unitKg };
      }

      return `
        <div class="ob-acc">
          <div class="ob-acc-head" data-acc="gear">
            <span>物资储备与班组装备清单 (弹药${ammoPct}%)</span>
            <span>${OB_EXPAND.gear ? "▾" : "▸"}</span>
          </div>
          ${OB_EXPAND.gear ? `<div class="ob-acc-body">
            <div style="background:#f5f5f4;border-radius:4px;padding:6px;margin-bottom:6px;font-size:10.5px;">
              <div class="ob-item-row" style="padding:2px 0;">
                <span>📦 <b>弹药储备 (7.92mm步/机枪弹)</b>: ${ammoRifle + ammoLmg} 发</span>
                <b>${tgtAmmo.toFixed(3)} t <small style="color:#78716c;">(${(tgtAmmo * 1000).toFixed(1)}kg)</small></b>
              </div>
              <div class="ob-item-row" style="padding:2px 0;">
                <span>🍞 <b>口粮储备 (野战应急口粮)</b>: ${tgtSoldiers.length * 3} 份</span>
                <b>${tgtFood.toFixed(3)} t <small style="color:#78716c;">(${(tgtFood * 1000).toFixed(1)}kg)</small></b>
              </div>
              ${hasFuelTank ? `
                <div class="ob-item-row" style="padding:2px 0;">
                  <span>⛽ <b>燃油储备 (车用燃油箱)</b>: ${Math.round(tgtFuel * 1250)} 升</span>
                  <b>${tgtFuel.toFixed(3)} t <small style="color:#78716c;">(${(tgtFuel * 1000).toFixed(1)}kg)</small></b>
                </div>
              ` : ""}
            </div>
            <div style="font-size:10px;font-weight:700;color:#57534e;margin:4px 0 2px 0;">班组物理装备总成:</div>
            ${Object.keys(physicalGear).length === 0 ? `<div style="color:#78716c;font-size:10.5px;">无装备登记</div>` : Object.values(physicalGear).map(g => {
              const totKg = (g.count * g.unitKg).toFixed(1);
              return `<div class="ob-item-row" style="font-size:10.5px;padding:2px 0;">
                <span>${escHtml(g.name)} × <b>${g.count}</b> <small style="color:#78716c;">(单重 ${g.unitKg}kg)</small></span>
                <b style="color:#1c1917;">${totKg} kg</b>
              </div>`;
            }).join("")}
            ${tgtCarried.length > 0 ? `
              <div style="font-size:10px;font-weight:700;color:#dc2626;margin:6px 0 2px 0;">随队携行人员负重 (${tgtCarried.length}):</div>
              ${tgtCarried.map(cb => {
                const icon = cb.kind === "wounded" ? "💀" : "☠";
                const lbl = cb.kind === "wounded" ? `重伤员 (${Math.round(cb.soldier?.hp || 0)}%)` : "阵亡遗体";
                return `<div class="ob-item-row" style="font-size:10.5px;padding:2px 0;">
                  <span>${icon} ${cb.origin_unit_name}·${cb.soldier?.name || ""} <small style="color:#78716c;">[${lbl}]</small></span>
                  <button type="button" class="ob-mini-btn ob-body-drop" data-body-id="${cb.id}">放下/丢弃</button>
                </div>`;
              }).join("")}
            ` : ""}
          </div>` : ""}
        </div>
      `;
    })()}
    ${nearBodies.length > 0 ? `<div class="ob-acc">
      <div class="ob-acc-head" data-acc="ground" style="background:#fef2f2;color:#991b1b;">
        <span>附近地面可拾取/搜刮 (${nearBodies.length})</span>
        <span>${OB_EXPAND.ground ? "▾" : "▸"}</span>
      </div>
      ${OB_EXPAND.ground ? `<div class="ob-acc-body">
        ${nearBodies.map(gb => {
          const isWpn = gb.kind === "weapon";
          const isW = gb.kind === "wounded";
          const icon = isWpn ? "🔫" : (isW ? "💀" : "☠");
          const remItems = (gb.soldier?.items || []).map(it =>
            (it.kind === "ammo" || it.kind === "ration") ? `${it.name}${Number(it.ammo_t || 0).toFixed(2)}t` : `${it.name}×${it.count || 1}`
          ).join(",");
          const tag = isWpn
            ? `掉落武器`
            : (isW ? `重伤 HP ${Math.round(gb.soldier?.hp || 0)}%${remItems ? " · " + remItems : ""}` : `阵亡${remItems ? " · 随身:" + remItems : ""}`);
          return `<div class="ob-item-row">
            <span>${icon} ${isWpn ? (gb.soldier?.name || weaponCnName(gb.soldier?.weapon)) : `${gb.origin_unit_name}·${gb.soldier?.name || ""}`} <small style="color:${isW ? '#dc2626' : '#57534e'};">[${tag}]</small></span>
            <button type="button" class="ob-mini-btn pick ob-body-pick" data-body-id="${gb.id}">${isWpn ? "拾取武器" : (isW ? "拾取" : "拾取搜刮")}</button>
          </div>`;
        }).join("")}
      </div>` : ""}
    </div>` : ""}
  `;

  el.innerHTML = `
    <div class="ob-head">
      <div class="ob-head-left">
        <div class="ob-name">${title}</div>
        <div class="ob-meta-row">
          <span>编制:</span><span class="ob-chip">${echelonTxt}</span>
        </div>
        <div class="ob-meta-row">
          <span>状态:</span><span class="ob-chip">${statusTxt}</span>
        </div>
      </div>
      <div class="ob-head-right">
        <div class="ob-emblem-row">
          ${natoBadge}
          <button class="ob-close" id="obCloseBtn" title="关闭">×</button>
        </div>
        <svg width="20" height="20" viewBox="0 0 24 24"><polygon points="12,2 14.9,8.6 22,9.3 16.6,14 18.2,21 12,17.3 5.8,21 7.4,14 2,9.3 9.1,8.6" fill="#fde047" stroke="#ffffff" stroke-width="1.2"/></svg>
      </div>
    </div>
    <div class="ob-hero">${heroSvg}</div>
    <div class="ob-sec">
      <div class="ob-sup-row">
        <span>直属上级:</span>
        ${supHtml}
      </div>
      ${(() => {
        const hqPiece = isHQ ? ((STATE.own_pieces || []).find(sp => sp.is_hq_piece && (sp.id === cmd.hq_piece_id || sp.direct_commander_id === cmd.id)) || null) : null;
        const ncoN = isHQ ? Number(cmd.hq_nco ?? (hqPiece ? hqPiece.nco : 0) ?? 0) : Number(p.nco ?? 0);
        const offN = isHQ ? Number(cmd.hq_officer ?? (hqPiece ? hqPiece.officer : 0) ?? 0) : Number(p.officer ?? 0);
        const selfPersons = isHQ ? Number(cmd.persons ?? (hqPiece ? hqPiece.persons : 0) ?? 0) : Number(p.persons ?? 0);
        const enlN = Math.max(0, selfPersons - ncoN - offN);
        const radioOk = isHQ ? (hqPiece ? hqPiece.can_operate_radio !== false : (ncoN + offN > 0)) : (p.can_operate_radio !== false);
        const heavyCap = isHQ ? Number(hqPiece ? hqPiece.heavy_op_cap : 1) : Number(p.heavy_op_cap ?? 1);
        const actNco = isHQ ? Boolean(cmd.is_acting_nco_deputy) : Boolean(p.is_acting_nco_cmd);
        const retRec = Number(isHQ ? (hqPiece ? hqPiece.retreat_recovery_hours : 0) : (p.retreat_recovery_hours || 0));
        return `
          <div class="ob-sup-row" style="flex-wrap:wrap;gap:4px;font-size:10.5px;">
            <span>四账本: <b>兵${enlN}</b> · <b style="color:#0369a1;">士${ncoN}</b> · <b style="color:#b45309;">官${offN}</b></span>
            <span>
              ${!radioOk ? `<span style="color:#dc2626;font-weight:700;">📻缺骨干禁电台</span> ` : ""}
              ${retRec > 0 ? `<span style="color:#7c3aed;font-weight:700;">🏃溃退锁定${retRec.toFixed(2)}h</span>` : ""}
            </span>
          </div>
        `;
      })()}
      <div class="ob-bars">
        <div class="ob-bar-row" title="受击当步停止恢复，待命时每5m恢复">
          <span class="ob-bar-lbl">组织度</span>
          <div class="ob-bar-track"><div class="ob-bar-fill" style="width:${Math.min(100, Math.max(0, orgPct))}%;background:${ratioBarColor(orgPct)};"></div></div>
          <span class="ob-bar-val">${orgPct}%${(() => { const d = isHQ ? (cmd.hq_delta_org_5m || 0) : (p.delta_org_5m || 0); return Math.abs(d) > 0.05 ? ` (${d > 0 ? "+" : ""}${d.toFixed(1)})` : ""; })()}</span>
        </div>
        <div class="ob-bar-row" title="补给弹药与口粮状态">
          <span class="ob-bar-lbl">补给</span>
          <div class="ob-bar-track"><div class="ob-bar-fill" style="width:${Math.min(100, Math.max(0, supplyPct))}%;background:${ratioBarColor(supplyPct)};"></div></div>
          <span class="ob-bar-val">${supplyPct}%</span>
        </div>
        <div class="ob-bar-row" title="满员/当前人员 + 伤亡累积(满1.0扣1人)">
          <span class="ob-bar-lbl">兵力</span>
          <div class="ob-bar-track"><div class="ob-bar-fill" style="width:${Math.min(100, Math.max(0, strengthPct))}%;background:${ratioBarColor(strengthPct)};"></div></div>
          <span class="ob-bar-val">${personsTot}/${fullStrength}${(() => { const cl = isHQ ? (cmd.hq_carry_loss || 0) : (p.carry_loss || 0); return cl > 0.01 ? ` (积${cl.toFixed(2)})` : ""; })()}</span>
        </div>
      </div>
      <div style="display:flex;gap:6px;margin:5px 0 2px 0;">
        <button type="button" class="btn-global-stop" id="obBtnStopAll" style="padding:4px 8px;font-size:10.5px;" title="原地急停并注销所有任务队列 (快捷键 X)">
          🛑 原地急停 / 注销 (X)
        </button>
        <button type="button" class="btn-global-retreat" id="obBtnRetreatAll" style="padding:4px 8px;font-size:10.5px;" title="紧急撤退脱离接触">
          🏃 紧急撤退
        </button>
      </div>
      <div class="ob-btn-row">
        ${(() => {
          const isDeadHQ = isHQ && (cmd.alive === false || (cmd.persons !== undefined && Number(cmd.persons) <= 0));
          return `
            <button type="button" class="ob-act-btn active" id="obOpenMissionWinBtn" ${isDeadHQ ? "disabled title='指挥部已阵亡 (Depot)'" : ""}>▶ 下达任务</button>
            <button type="button" class="ob-act-btn" id="obOpenReorgBtn" ${isDeadHQ ? "disabled title='指挥部已阵亡 (Depot)'" : ""}>🪖 编制 (全景母树)</button>
            <button type="button" class="ob-act-btn" id="obLogBtn">📜 日志</button>
          `;
        })()}
      </div>
      ${(() => {
        const tgtKind = isHQ ? "commander" : "unit";
        const tgtId = isHQ ? cmd.id : p.id;
        const hqPiece = isHQ ? ((STATE.own_pieces || []).find(sp => sp.is_hq_piece && (sp.id === cmd.hq_piece_id || sp.direct_commander_id === cmd.id)) || null) : null;
        const eventPieceId = isHQ ? (cmd.hq_piece_id || (hqPiece && hqPiece.id) || "") : p.id;
        const activePiece = isHQ ? hqPiece : p;
        const curPlan = isHQ ? cmd.direct_order : p.direct_order;
        const ncoN = isHQ ? Number(cmd.hq_nco ?? (hqPiece ? hqPiece.nco : 0) ?? 0) : Number(p.nco ?? 0);
        const offN = isHQ ? Number(cmd.hq_officer ?? (hqPiece ? hqPiece.officer : 0) ?? 0) : Number(p.officer ?? 0);
        const retRec = Number(isHQ ? (hqPiece ? hqPiece.retreat_recovery_hours : 0) : (p.retreat_recovery_hours || 0));
        const isRetreatLocked = retRec > 0 || (curPlan && curPlan.action === "retreat" && retRec > 0);
        const hasOfficer = isHQ && (cmd.has_officer !== undefined ? Boolean(cmd.has_officer) : offN > 0);
        const isActingNco = isHQ && Boolean(cmd.is_acting_nco_deputy || (!hasOfficer && ncoN > 0));
        const hasCmdAuthority = isHQ && (hasOfficer || isActingNco);
        const cmdAOs = isHQ ? (STATE.ao_zones || []).filter(z => z.commander === cmd.id) : [];
        const cmdLines = isHQ ? (STATE.typed_frontlines || []).filter(f => f.commander_id === cmd.id) : [];

        // 1. 单位双队列展示：任务执行队列 (task_queue 可拖拽重排/改模式/改点/删除)
        const rawQueue = (activePiece && Array.isArray(activePiece.task_queue))
          ? activePiece.task_queue
          : (curPlan && Array.isArray(curPlan.segments) && curPlan.segments.length > 0
              ? curPlan.segments.map((seg, sidx) => ({
                  step_id: sidx + 1,
                  action: seg.action || curPlan.action || "move",
                  goal: seg.goal || (curPlan.waypoints && curPlan.waypoints[0]) || tgtPos,
                  move_mode: seg.move_mode || curPlan.move_mode || "normal",
                  fire_mode: seg.fire_mode || curPlan.fire_mode || "stop_to_fire",
                  target_unit_id: seg.target_unit_id || curPlan.target_unit_id || null,
                  follow_target: Boolean(seg.follow_target !== undefined ? seg.follow_target : curPlan.follow_target),
                }))
              : []);

        const curClock = Number(STATE.clock_hours || 0);
        const baseKmh = Number(activePiece?.base_speed_kmh || 4.5);
        let accumHours = 0;
        let lastPos = tgtPos;
        const BADGES = ["①", "②", "③", "④", "⑤", "⑥", "⑦", "⑧", "⑨", "⑩", "⑪", "⑫", "⑬", "⑭", "⑮", "⑯"];

        const queueHtml = rawQueue.map((step, idx) => {
          const badge = BADGES[idx] || `[${idx + 1}]`;
          const act = step.action || "move";
          const g = step.goal || lastPos;
          const gTxt = `(${Number(g[0]).toFixed(1)}, ${Number(g[1]).toFixed(1)})`;
          const distM = Math.hypot(g[0] - lastPos[0], g[1] - lastPos[1]) * (STATE.grid.cell_m || 200);
          const distKm = distM / 1000.0;
          lastPos = g;
          const mm = step.move_mode || "normal";
          const fm = step.fire_mode || "stop_to_fire";
          const mult = mm === "fast" ? 1.2 : (mm === "slow" || mm === "stealth" ? 0.55 : 1.0);
          const spdKmh = Math.max(0.3, baseKmh * mult);
          const durH = (act === "attack" || act === "stop") ? ((step.duration_sec || 16) / 3600.0) : (distKm / spdKmh);
          const durMin = Math.round(durH * 60);
          const durSecTxt = (act === "attack" || act === "stop") ? `${step.duration_sec || 16}s` : `${durMin}分`;
          accumHours += durH;
          const etaH = curClock + accumHours;
          const etaHH = String(Math.floor(etaH) % 24).padStart(2, "0");
          const etaMM = String(Math.round((etaH % 1) * 60) % 60).padStart(2, "0");
          const etaStr = `${etaHH}:${etaMM}`;
          const isRepicking = REPICK_STEP && REPICK_STEP.targetId === tgtId && REPICK_STEP.stepIdx === idx;
          return `
            <div class="ob-tq-step ${idx === 0 ? "current" : ""} ${isRepicking ? "repicking" : ""}" draggable="true" data-tq-drag="${idx}" title="拖拽调整队列顺序">
              <span class="ob-tq-badge">${badge}</span>
              <div class="ob-tq-body">
                <div class="ob-tq-row1">
                  <div class="ob-pill-group">
                    <button type="button" class="ob-pill ${act === 'move' ? 'active blue' : ''}" data-step-act="move" data-step-idx="${idx}">机动</button>
                    <button type="button" class="ob-pill ${act === 'attack' ? 'active orange' : ''}" data-step-act="attack" data-step-idx="${idx}">🎯射击</button>
                    <button type="button" class="ob-pill ${act === 'stop' ? 'active gray' : ''}" data-step-act="stop" data-step-idx="${idx}">🛑驻止</button>
                  </div>
                  <span class="ob-tq-coord">${gTxt}</span>
                  <button type="button" class="ob-tq-btn ${isRepicking ? "active" : ""}" data-tq-repick="${idx}" title="地图改点">📍</button>
                  <div class="ob-tq-btns">
                    ${idx > 0 ? `<button type="button" class="ob-tq-btn" data-tq-up="${idx}" title="上移">▲</button>` : ""}
                    ${idx < rawQueue.length - 1 ? `<button type="button" class="ob-tq-btn" data-tq-down="${idx}" title="下移">▼</button>` : ""}
                    <button type="button" class="ob-tq-btn del" data-tq-del="${idx}" title="删除">✕</button>
                  </div>
                </div>
                <div class="ob-tq-row2">
                  <div class="ob-pill-group">
                    <button type="button" class="ob-pill-sm ${mm === 'normal' ? 'active' : ''}" data-step-mm="normal" data-step-idx="${idx}">常(${baseKmh.toFixed(1)}k)</button>
                    <button type="button" class="ob-pill-sm ${mm === 'fast' ? 'active yellow' : ''}" data-step-mm="fast" data-step-idx="${idx}">快</button>
                    <button type="button" class="ob-pill-sm ${mm === 'slow' || mm === 'stealth' ? 'active green' : ''}" data-step-mm="slow" data-step-idx="${idx}">渗透</button>
                  </div>
                  <div class="ob-pill-group">
                    <button type="button" class="ob-pill-sm ${fm === 'stop_to_fire' ? 'active' : ''}" data-step-fm="stop_to_fire" data-step-idx="${idx}">停射</button>
                  </div>
                  <span class="ob-tq-eta">${act === 'move' ? distKm.toFixed(2) + 'km·' : ''}${durSecTxt} (${etaStr})</span>
                </div>
              </div>
            </div>
          `;
        }).join("");

        // 2. 单位事件执行队列（来自 STATE.active_events，支持取消正在进行的事件）
        const pieceEvents = (STATE.active_events || []).filter(ev =>
          ev.actor_id === eventPieceId || (ev.payload && ev.payload.target_unit_id === eventPieceId)
        );
        const unitEventsHtml = pieceEvents.length === 0
          ? `<div style="font-size:10.5px;color:#78716c;padding:2px 0;">暂无进行中的定时事件（可右键兵牌或点「安排事件」发起）</div>`
          : pieceEvents.map(ev => {
              const tpx = ev.payload && ev.payload.target_px ? ` @ (${ev.payload.target_px[0]},${ev.payload.target_px[1]})` : "";
              return `<div class="ob-ev-q-row">
                <span><b>#${ev.id}</b> · ${escHtml(ev.kind)}${ev.payload?.op ? `(${escHtml(ev.payload.op)})` : ""}${tpx}</span>
                <span style="display:inline-flex;align-items:center;gap:5px;">
                  <b style="color:#0369a1;">余 ${Number(ev.remaining_hours || 0).toFixed(2)}h</b>
                  <button type="button" class="ob-tq-btn del" data-cancel-ev="${ev.id}" title="取消事件">✕ 取消</button>
                </span>
              </div>`;
            }).join("");

        const perm = canDirectControl(tgtKind, tgtId);
        const cmdMarksHtml = isHQ ? (hasCmdAuthority ? (() => {
          const marks = [
            { role: "move", label: "行军", color: "#0369a1" },
            { role: "attack", label: "进攻", color: "#dc2626" },
            { role: "deploy", label: "占领线", color: "#15803d" },
            { role: "hold", label: "受阻线", color: "#b45309" },
            { role: "retreat", label: "撤退线", color: "#6d28d9" },
          ];
          return `
            <div class="ob-dual-sec" style="display:flex;flex-direction:column;gap:4px;">
              <div style="font-size:10.5px;font-weight:700;color:#44403c;">指挥官绘线权限（AO ${cmdAOs.length}区 · 战线 ${cmdLines.length}条）</div>
              ${!hasOfficer && isActingNco ? `<div class="ob-panel-note nco">⚠ 士官代理排级临时指挥（AO 面积/半径按 0.65 折算）</div>` : ""}
              <div style="display:flex;flex-wrap:wrap;gap:4px;">
                <button type="button" class="ob-sub-menu-btn ${TOOL_MODE === "draft_ao" ? "active" : ""}" id="obCmdAo">画定AO</button>
                ${marks.map(m => `<button type="button" class="ob-sub-menu-btn ${CMD_DRAW && CMD_DRAW.role === m.role ? "active" : ""}" data-cmd-role="${m.role}" data-cmd-label="${m.label}" data-cmd-color="${m.color}">${m.label}</button>`).join("")}
                <button type="button" class="ob-sub-menu-btn ${ERASE_MODE ? "active" : ""}" id="obCmdErase">删线</button>
                <button type="button" class="ob-sub-menu-btn" id="obCmdClear">清战线</button>
              </div>
            </div>
          `;
        })() : `<div class="ob-panel-note warn">⛔ 指挥班已无军官/士官骨干：画 AO、画战线权限已锁定</div>`) : "";

        return `
          <div class="ob-dual-sec">
            <div style="font-size:10.5px;font-weight:700;color:#44403c;display:flex;justify-content:space-between;align-items:center;">
              <span>📌 任务执行队列 (${rawQueue.length}步 · 速 ${baseKmh.toFixed(1)}km/h)</span>
              <span style="font-weight:400;color:#78716c;font-size:10px;">支持拖拽排序 / 右键兵牌开窗</span>
            </div>
            ${isRetreatLocked ? `<div class="ob-panel-note warn">⛔ 不可逆撤退恢复期中（余 ${retRec.toFixed(2)}h）· 完全不可控制</div>` : ""}
            ${!perm.ok ? `<div class="ob-perm-note">${perm.reason}</div>` : ""}
            <div class="ob-task-queue" style="max-height:165px;overflow-y:auto;margin:4px 0;">
              ${rawQueue.length === 0 ? `<div style="font-size:10.5px;color:#78716c;padding:3px 0;">当前无队列任务（点击「▶ 下达任务」或右键兵牌起草）</div>` : queueHtml}
            </div>
          </div>
          <div class="ob-dual-sec">
            <div style="font-size:10.5px;font-weight:700;color:#44403c;margin-bottom:3px;">⏱ 事件执行队列 (${pieceEvents.length})</div>
            ${unitEventsHtml}
          </div>
          ${cmdMarksHtml}
        `;
      })()}
    </div>
    <div class="ob-list-head">${isHQ ? "编制明细与战地状态" : "班内编制与战地状态"}</div>
    <div class="ob-list">${accHtml}</div>
  `;

  el.classList.add("open");
  el.onmousedown = e => e.stopPropagation();
  el.onwheel = e => e.stopPropagation();
  const closeBtn = document.getElementById("obCloseBtn");
  if (closeBtn) closeBtn.addEventListener("click", clearSelection);
  document.getElementById("obBtnStopAll")?.addEventListener("click", () => globalHaltAndDeregister(tgtKind, tgtId));
  document.getElementById("obBtnRetreatAll")?.addEventListener("click", () => globalEmergencyRetreat(tgtKind, tgtId));
  const supLink = document.getElementById("obSupLink");
  if (supLink && superiorCmd) {
    supLink.addEventListener("click", () => selectCommander(superiorCmd.id));
  }
  const openMWinBtn = document.getElementById("obOpenMissionWinBtn");
  if (openMWinBtn) {
    openMWinBtn.addEventListener("click", () => openMissionWindow(tgtKind, tgtId));
  }
  const openEWinBtn = document.getElementById("obOpenEventWinBtn");
  if (openEWinBtn) {
    openEWinBtn.addEventListener("click", () => openEventWindow(tgtKind, tgtId));
  }
  const openReorgBtn = document.getElementById("obOpenReorgBtn");
  if (openReorgBtn) {
    openReorgBtn.addEventListener("click", () => openReorgSplitWin(tgtKind, tgtId));
  }
  const openHeavyBtn = document.getElementById("obOpenHeavyBtn");
  if (openHeavyBtn) {
    openHeavyBtn.addEventListener("click", () => openHeavyCrewWin(tgtKind, tgtId));
  }
  const logBtn = document.getElementById("obLogBtn");
  if (logBtn) {
    logBtn.addEventListener("click", () => openCombatLogWin(title, statusTxt));
  }
  const tgtKind = isHQ ? "commander" : "unit";
  const tgtId = isHQ ? cmd.id : p.id;
  const hqPieceRef = isHQ ? ((STATE.own_pieces || []).find(sp => sp.is_hq_piece && (sp.id === cmd.hq_piece_id || sp.direct_commander_id === cmd.id)) || null) : null;
  const eventPieceId = isHQ ? (cmd.hq_piece_id || (hqPieceRef && hqPieceRef.id) || "") : p.id;

  el.querySelectorAll("[data-acc]").forEach(hd => {
    hd.addEventListener("click", () => {
      const k = hd.getAttribute("data-acc");
      OB_EXPAND[k] = !OB_EXPAND[k];
      renderOrbatCard();
    });
  });
  el.querySelectorAll(".ob-body-pick").forEach(btn => {
    btn.addEventListener("click", () => bodyOp("pickup_body", tgtKind, tgtId, btn.getAttribute("data-body-id")));
  });
  el.querySelectorAll(".ob-body-drop").forEach(btn => {
    btn.addEventListener("click", () => bodyOp("drop_body", tgtKind, tgtId, btn.getAttribute("data-body-id")));
  });
  el.querySelectorAll("[data-open-soldier]").forEach(row => {
    row.addEventListener("click", () => openTarkovModal(tgtKind, tgtId, row.getAttribute("data-open-soldier")));
  });

  // 拖拽重排任务队列
  let dragSrcIdx = null;
  el.querySelectorAll("[data-tq-drag]").forEach(row => {
    row.addEventListener("dragstart", (e) => {
      dragSrcIdx = Number(row.getAttribute("data-tq-drag"));
      e.dataTransfer.effectAllowed = "move";
    });
    row.addEventListener("dragover", (e) => {
      e.preventDefault();
      row.classList.add("drag-over");
    });
    row.addEventListener("dragleave", () => row.classList.remove("drag-over"));
    row.addEventListener("drop", async (e) => {
      e.preventDefault();
      row.classList.remove("drag-over");
      const dstIdx = Number(row.getAttribute("data-tq-drag"));
      if (dragSrcIdx !== null && !Number.isNaN(dstIdx) && dragSrcIdx !== dstIdx) {
        await reorderTaskStep(tgtKind, tgtId, dragSrcIdx, dstIdx);
      }
      dragSrcIdx = null;
    });
  });

  el.querySelectorAll("[data-step-act]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      await updateTaskStep(tgtKind, tgtId, Number(btn.getAttribute("data-step-idx")), { action: btn.getAttribute("data-step-act") });
    });
  });
  el.querySelectorAll("[data-step-mm]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      await updateTaskStep(tgtKind, tgtId, Number(btn.getAttribute("data-step-idx")), { move_mode: btn.getAttribute("data-step-mm") });
    });
  });
  el.querySelectorAll("[data-step-fm]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      await updateTaskStep(tgtKind, tgtId, Number(btn.getAttribute("data-step-idx")), { fire_mode: btn.getAttribute("data-step-fm") });
    });
  });
  el.querySelectorAll("[data-tq-repick]").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const idx = Number(btn.getAttribute("data-tq-repick"));
      if (REPICK_STEP && REPICK_STEP.targetId === tgtId && REPICK_STEP.stepIdx === idx) {
        REPICK_STEP = null; setActionHint("");
      } else {
        DIRECT_PICK = null; CMD_DRAW = null; EVENT_PICK = null;
        REPICK_STEP = { targetKind: tgtKind, targetId: tgtId, stepIdx: idx };
        setActionHint(`【改点】请在地图左键点击设定步骤 #${idx + 1} 的新目标点（右键取消）`);
      }
      renderOrbatCard();
    });
  });
  el.querySelectorAll("[data-tq-up]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      const idx = Number(btn.getAttribute("data-tq-up"));
      await reorderTaskStep(tgtKind, tgtId, idx, idx - 1);
    });
  });
  el.querySelectorAll("[data-tq-down]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      const idx = Number(btn.getAttribute("data-tq-down"));
      await reorderTaskStep(tgtKind, tgtId, idx, idx + 1);
    });
  });
  el.querySelectorAll("[data-tq-del]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      await deleteTaskStep(tgtKind, tgtId, Number(btn.getAttribute("data-tq-del")));
    });
  });
  el.querySelectorAll("[data-cancel-ev]").forEach(btn => {
    btn.addEventListener("click", async (e) => {
      e.stopPropagation();
      await sendEventOp("cancel_event", eventPieceId || tgtId, null, { event_id: btn.getAttribute("data-cancel-ev") });
      renderOrbatCard();
    });
  });

  // Commander AO / Frontlines
  const cmdAoBtn = document.getElementById("obCmdAo");
  if (cmdAoBtn) {
    cmdAoBtn.addEventListener("click", () => {
      DIRECT_PICK = null; CMD_DRAW = null; EVENT_PICK = null;
      setToolMode("draft_ao");
      setActionHint("【划定AO】请在地图按住 Shift+左键拖拽矩形，或在鼠标左键直接框选 AO");
      renderOrbatCard();
    });
  }
  const cmdErase = document.getElementById("obCmdErase");
  if (cmdErase) cmdErase.addEventListener("click", () => toggleEraseMode());
  el.querySelectorAll("[data-cmd-role]").forEach(btn => {
    btn.addEventListener("click", () => {
      DIRECT_PICK = null; EVENT_PICK = null;
      const role = btn.getAttribute("data-cmd-role");
      const label = btn.getAttribute("data-cmd-label");
      const color = btn.getAttribute("data-cmd-color");
      CMD_DRAW = { role, label, color, pts: [] };
      setActionHint(`【指挥 · ${label}】左键在地图连续点绘战术线，右键或双击完成并下发`);
      renderOrbatCard();
      render();
    });
  });
  const cmdClear = document.getElementById("obCmdClear");
  if (cmdClear && isHQ) {
    cmdClear.addEventListener("click", async () => {
      CMD_DRAW = null;
      setActionHint("");
      await api("/api/unit_op", "POST", { op: "clear_frontlines", commander_id: cmd.id, player_commander_id: STATE.active_commander_id });
      await refreshState();
    });
  }

  if (isHQ) {
    el.querySelectorAll("[data-ob-jump]").forEach(node => {
      node.addEventListener("click", () => {
        const pid = node.getAttribute("data-ob-jump");
        if (pid) selectPiece(pid);
      });
    });
  }
}

function updateSelectedUnitPanel() {
  const box = document.getElementById("unitInfo");
  const wRow = document.getElementById("weaponRow");
  const sRow = document.getElementById("skinRow");
  const rRow = document.getElementById("reorgRow");
  const p = (STATE && STATE.own_pieces) ? STATE.own_pieces.find(x => x.id === SELECTED_PIECE_ID) : null;
  if (!p) {
    box.textContent = "点击沙盘兵牌（点击上级聚合牌可下钻展开直属下级）";
    wRow.style.display = sRow.style.display = rRow.style.display = "none";
    return;
  }
  const c = p.counter || {};
  const hasFacing = p.has_facing !== undefined ? p.has_facing : Boolean(p.is_directional_hull);
  const dirTxt = hasFacing ? `物理朝向: ${Number(p.facing_deg || 0).toFixed(1)}°` : "步兵不带物理朝向(矢量驱动)";
  const autoAct = typeof p.autonomy_state === "string"
    ? p.autonomy_state
    : ((p.autonomy_state && p.autonomy_state.action) || "hold");
  const atomAct = p.atomic_action || (p.autonomy_state && p.autonomy_state.atomic_action) || autoAct;
  const kcVal = p.k_C !== undefined ? p.k_C : (p.k_c !== undefined ? p.k_c : 1.0);
  const isDisc = p.is_disconnected !== undefined ? p.is_disconnected : Boolean(p.was_disconnected);
  const exclTxt = p.exclamation_buff || (isDisc ? "已断连" : "正常连通");
  const restr = c.restriction_tier || c.restricted_echelon || p.level;
  const cadreN = c.cadre !== undefined ? c.cadre : (p.cadre ?? 0);
  box.innerHTML = `<b>${p.name}</b> (${p.id}) | 层级:<b>${p.level}</b> | 限制:<b>${restr}</b><br/>
    兵员:${p.persons} (干部:${cadreN}) | 组织度:${Math.round(p.org)}/${Math.round(p.org_cap)} | 机动:${c.mobility || "-"}<br/>
    ${dirTxt} | 原子动作:<b>${atomAct}</b><br/>
    k_C:<b>${Number(kcVal).toFixed(2)}</b> | 通联状态:<b>${exclTxt}</b> | 可读线:${p.readable_line !== false ? "是" : "否"}`;
  wRow.style.display = sRow.style.display = rRow.style.display = "flex";
  const selW = document.getElementById("selWeapon");
  selW.innerHTML = "";
  for (const w of (p.weapons || [])) {
    const o = document.createElement("option");
    o.value = w.model;
    o.textContent = `${w.name || w.model} (${w.range_m}m${w.indirect ? " 曲射" : " 直瞄"})`;
    selW.appendChild(o);
  }
}

async function fetchWeaponLos() {
  if (!SELECTED_PIECE_ID) return;
  const wm = document.getElementById("selWeapon").value || undefined;
  const r = await api("/api/weapon_los", "POST", { piece_id: SELECTED_PIECE_ID, weapon_model: wm });
  if (r.ok) { LOS_DATA = r.data; render(); }
}
function clearWeaponLos() { LOS_DATA = null; render(); }

async function applySkin() {
  if (!SELECTED_PIECE_ID) return;
  const r = await api("/api/unit_op", "POST", {
    op: "set_counter_skin",
    piece_id: SELECTED_PIECE_ID,
    color: document.getElementById("inpSkinColor").value,
    custom_label: document.getElementById("inpSkinLabel").value || undefined,
  });
  if (!r.ok) alert(r.data.reason);
  await refreshState();
}

async function splitSelectedSquad() {
  if (!SELECTED_PIECE_ID || !STATE) return;
  const p = STATE.own_pieces.find(x => x.id === SELECTED_PIECE_ID);
  if (!p) return;
  const half = Math.max(1, Math.floor(p.persons / 2));
  const r = await api("/api/unit_op", "POST", {
    op: "split_squad", commander_id: STATE.active_commander_id, piece_id: p.id, take_enlisted: half, take_cadre: 0,
  });
  if (!r.ok) alert("拆分失败: " + r.data.reason);
  await refreshState();
}

async function mergeSquadPiecesUi() {
  if (!STATE) return;
  const sqIds = (STATE.own_pieces || []).filter(x => x.level === "squad").slice(0, 2).map(x => x.id);
  if (sqIds.length < 2) {
    alert("需要至少 2 个同位置班组才能直并");
    return;
  }
  const r = await api("/api/unit_op", "POST", {
    op: "merge_squad_pieces",
    commander_id: STATE.active_commander_id,
    target_piece_id: sqIds[0],
    source_piece_id: sqIds[1],
    source_pieces: sqIds,
  });
  alert(r.ok ? `直并成功: ${r.data.target_piece || sqIds[0]} (${r.data.persons ?? r.data.total_persons}人)` : `拦截: ${r.data.reason} (排以上需走定时整编事件)`);
  await refreshState();
}

async function startReorgEventUi() {
  if (!STATE) return;
  const sqIds = STATE.own_pieces.slice(0, 2).map(x => x.id);
  const r = await api("/api/unit_op", "POST", {
    op: "start_reorganize_echelon",
    commander_id: STATE.active_commander_id,
    source_unit_ids: sqIds,
    target_echelon: "platoon",
    name: "混编突击排(定时整编)",
  });
  alert(r.ok ? `已启动定时整编事件 ${r.data.event_id} (${r.data.duration_h}h)` : r.data.reason);
  await refreshState();
}

function stageBaguwenOrder() {
  if (!STATE) return;
  const parts = document.getElementById("inpOrderTarget").value.split(",").map(Number);
  if (parts.length !== 2 || Number.isNaN(parts[0]) || Number.isNaN(parts[1])) return;
  DRAFTS.baguwen_orders.push({
    commander_id: STATE.active_commander_id,
    doctrine: document.getElementById("selDoctrine").value,
    target_px: [parts[0], parts[1]],
    targets: SELECTED_PIECE_ID ? [SELECTED_PIECE_ID] : undefined,
  });
  updateDraftBox();
  render();
}

function finishFrontlineDraft() {
  if (!STATE || DRAFTS.active_frontline_pts.length < 2) {
    alert("请在地图上点击至少 2 个顶点后再完成战线绘制");
    return;
  }
  const mask = Number(document.getElementById("selLineMask").value || 31);
  const norm = document.getElementById("selLineNormal").value.split(",").map(Number);
  DRAFTS.typed_frontlines.push({
    line_id: `fl-${STATE.active_commander_id}-${Date.now()}`,
    commander_id: STATE.active_commander_id,
    points_px: DRAFTS.active_frontline_pts.slice(),
    unit_type_mask: mask,
    attraction_weight: 1.2,
    front_normal: norm.length === 2 ? norm : [0, 1],
  });
  DRAFTS.active_frontline_pts = [];
  updateDraftBox();
  render();
}

function clearActiveFrontlinePts() {
  DRAFTS.active_frontline_pts = [];
  render();
}

function updateDraftBox() {
  const box = document.getElementById("draftList");
  const lines = [];
  for (const bo of DRAFTS.baguwen_orders) {
    lines.push(`[作战日志草稿] ${bo.commander_id} -> ${bo.doctrine} (${bo.target_px.join(",")})`);
  }
  for (const ao of DRAFTS.ao_zones) {
    lines.push(`[AO草稿] ${ao.id} (${ao.cells.length}px)`);
  }
  for (const fl of DRAFTS.typed_frontlines) {
    lines.push(`[战线草稿] ${frontlineStyle(fl.unit_type_mask).label} (${fl.points_px.length}点)`);
  }
  box.textContent = lines.length ? lines.join("\n") : "草稿箱为空";
}

async function commitTurn(hours = 16 / 3600) {
  if (!STATE) return;
  const r = await api("/api/commit_turn", "POST", {
    player_commander_id: STATE.active_commander_id,
    hours,
    sync_barrier: Boolean(MP_STATE.syncBarrier),
    combat_log_orders: DRAFTS.baguwen_orders,
    typed_frontlines: DRAFTS.typed_frontlines,
    ao_zones: DRAFTS.ao_zones.map(a => ({ id: a.id, commander: a.commander, cells: a.cells })),
    radio_silence: QUEUED_TURN_OPS.radio_silence,
    lay_wire: QUEUED_TURN_OPS.lay_wire,
    cargo_transfer: QUEUED_TURN_OPS.cargo_transfer,
  });
  if (!r.ok) {
    if (r.status === 409 || (r.data && r.data.reason === "waiting_for_other_players_ready")) {
      setActionHint("⏳ 回合同步屏障等待中：仍有已认领席位未点击【准备】");
      setTimeout(() => setActionHint(""), 2600);
      await syncMpStatus();
      return;
    }
    alert("提交失败: " + (r.data && r.data.reason ? r.data.reason : r.status));
    return;
  }
  DRAFTS.baguwen_orders = [];
  DRAFTS.ao_zones = [];
  DRAFTS.typed_frontlines = [];
  DRAFTS.active_frontline_pts = [];
  DRAFTS.ao_preview = null;
  QUEUED_TURN_OPS = { radio_silence: [], lay_wire: [], cargo_transfer: [] };
  STATE = r.data.state;
  MP_STATE.lastRevision = Number(STATE.state_revision || MP_STATE.lastRevision || 0);
  syncUiFromState();
  if (!TILE_STREAM_SUPPORTED) {
    await ensureTerrainBinaryFallback();
    rebuildTerrainCanvasFallback();
  }
  render();
}

function bufToBase64(buf) {
  const bytes = new Uint8Array(buf);
  let bin = "";
  for (let i = 0; i < bytes.length; i += 0x8000) {
    bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
  }
  return btoa(bin);
}

async function importR16File() {
  const file = document.getElementById("fileR16").files[0];
  if (!file) { alert("请先选择 .r16 文件"); return; }
  const buf = await file.arrayBuffer();
  const payload = {
    raw_b64: bufToBase64(buf),
    width: Number(document.getElementById("impW").value),
    height: Number(document.getElementById("impH").value),
    bit_depth: file.name.endsWith(".r8") ? 8 : 16,
    elev_low_m: Number(document.getElementById("impLow").value),
    elev_high_m: Number(document.getElementById("impHigh").value),
    flip_y: document.getElementById("impFlipY").checked,
    feature_channels: [],
  };
  const ffile = document.getElementById("fileFeatR16").files[0];
  if (ffile) {
    const fbuf = await ffile.arrayBuffer();
    payload.feature_channels.push({
      feature_id: document.getElementById("selImportFeat").value,
      raw_b64: bufToBase64(fbuf),
      bit_depth: ffile.name.endsWith(".r8") ? 8 : 16,
      threshold: 0.5,
      flip_y: payload.flip_y,
    });
  }
  const r = await api("/api/import_r16", "POST", payload);
  if (!r.ok) { alert("导入失败(严禁降采样): " + r.data.reason); return; }
  await refreshState();
}

async function resetDemo() {
  await api("/api/unit_op", "POST", { op: "reset_demo" });
  DRAFTS = { baguwen_orders: [], ao_zones: [], ao_preview: null, typed_frontlines: [], active_frontline_pts: [] };
  LOS_DATA = null;
  DRILLED_IDS.clear();
  VIEW_INITIALIZED = false;
  await refreshState();
}

function setToolMode(m) {
  TOOL_MODE = m;
  for (const id of ["btnModeInspect", "btnModeMove", "btnModeAo", "btnModeFrontline", "btnModePixel"]) {
    document.getElementById(id).classList.remove("active");
  }
  const mapBtn = {
    inspect: "btnModeInspect", draft_order: "btnModeMove", draft_ao: "btnModeAo",
    draft_frontline: "btnModeFrontline", edit_pixel: "btnModePixel",
  };
